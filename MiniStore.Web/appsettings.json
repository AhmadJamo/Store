{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiniStoreDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },


  "AdminUser": {
    "Username": "admin",
    "Email": "admin@ministore.local",
    "Enabled": false
  },
  "PlatformOwner": {
    "Enabled": false,
    "Username": ""
  },
  "LegacyAudit": {
    "WriteEnabled": false
  },

  "RateLimiting": {
    "Registration": {
      "PermitLimit": 20,
      "WindowMinutes": 60
    }
  },

  "Observability": {
    "Enabled": true,
    "LogServerErrors": true,
    "SlowRequestThresholdMilliseconds": 1000
  },

  "PresentationCutover": {
    "AngularBasePath": "/app",
    "Surfaces": {
