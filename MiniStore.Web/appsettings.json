{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiniStoreDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },


  "AdminUser": {
    "Username": "admin",
    "Email": "admin@ministore.local",
    "Enabled": false
  },
  "PlatformOwner": {
    "Enabled": false,
    "Username": ""
  },

  "RateLimiting": {
    "Registration": {
      "PermitLimit": 20,
      "WindowMinutes": 60
    }
  },

  "AuditEvents": {
    "Enabled": false,
    "ActiveIntegrityKeyVersion": "",
    "IntegrityKeys": {},
    "AllowedChangeFields": {
      "Security.TenantRoleCreated": [ "RoleName", "PermissionSetFingerprint", "PermissionCount" ],
      "Security.TenantRoleUpdated": [ "RoleName", "PermissionSetFingerprint", "PermissionCount" ],
      "Security.TenantRolePermissionsChanged": [ "RoleName", "PermissionSetFingerprint", "PermissionCount" ],
      "Security.TenantRoleDeleted": [ "RoleName", "PermissionSetFingerprint", "PermissionCount" ],
      "Configuration.AccountingSettingsChanged": [ "PurchaseDiscountAccountId", "SalesDiscountAccountId", "SalesRevenueAccountId", "CostOfSalesAccountId", "GoodsReceivedNotInvoicedAccountId", "PurchasePriceVarianceAccountId", "LandedCostClearingAccountId", "RealizedExchangeGainAccountId", "RealizedExchangeLossAccountId" ],
      "Configuration.GeneralSettingsChanged": [ "Currency", "DecimalPlaces", "QuantityDecimalPlaces", "DateFormat", "TimeZone", "DefaultLanguage" ],
      "Configuration.DiscountSettingsChanged": [ "Enabled", "AllowLineDiscount", "AllowInvoiceDiscount", "AllowPercentageDiscount", "AllowFixedAmountDiscount", "DefaultDiscountType", "MaxLineDiscountPercent", "MaxLineDiscountAmount", "MaxInvoiceDiscountPercent", "MaxInvoiceDiscountAmount", "AllowDiscountAboveLimit", "DiscountOverridePermission" ],
      "Configuration.InventorySettingsChanged": [ "DefaultWarehouseType", "DefaultControlMode", "DefaultPickingStrategy", "DefaultAllowPosSales", "DefaultEnforceLocationCapacity", "DefaultRequireSourceLocationForTransfers", "DefaultRequireDestinationLocationForTransfers" ],
      "Configuration.PurchaseMatchingSettingsChanged": [ "QuantityTolerancePercent", "PriceTolerancePercent" ],
      "Configuration.PurchaseSourcingPolicyChanged": [ "AllowDirectRfq", "MaximumEstimatedAmountCompanyCurrency", "AllowedRoleName", "RequireActiveSuppliers" ]
    },
    "AllowedMetadataFields": {},
    "AllowedReasonTextEventTypes": []
  },




  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
