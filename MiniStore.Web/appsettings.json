      "UnassignedStock": "AngularDefault",
      "LocationMovements": "AngularDefault",
      "InventoryScanning": "AngularDefault",
      "Replenishment": "AngularDefault",
      "Branches": "AngularDefault",
      "PaymentMethods": "AngularDefault",
      "TaxRates": "AngularDefault",
      "ProductCategories": "AngularDefault",
      "ProductAttributes": "AngularDefault",
      "Warehouses": "AngularDefault",
      "AuditEvents": "AngularDefault",
      "Users": "AngularDefault",
      "Roles": "AngularDefault",
      "ProductTemplates": "AngularDefault",
      "Recipes": "AngularDefault",
      "PurchaseAnalytics": "AngularDefault",
      "PurchaseAccountingReconciliation": "AngularDefault",
      "PurchaseReplenishment": "AngularDefault",
      "PurchaseApprovalRules": "AngularDefault",
      "PurchaseTemplates": "AngularDefault",
      "PurchaseRequests": "AngularDefault",
      "PurchaseSourcing": "AngularDefault",
      "SupplierQuotations": "AngularDefault",
      "PurchaseOrders": "AngularDefault",
      "GoodsReceipts": "AngularDefault",
      "GoodsReceiptReturns": "AngularDefault",
      "VendorBills": "AngularDefault",
      "SupplierCreditNotes": "AngularDefault",
      "PurchaseDocumentReversals": "AngularDefault",
      "LandedCosts": "AngularDefault",
