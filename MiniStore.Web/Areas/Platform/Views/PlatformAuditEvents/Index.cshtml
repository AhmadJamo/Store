@model MiniStore.Application.Services.AuditEventPageDto
@using MiniStore.Application.Services
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@{ViewData["Title"]=L["Audit events"];var canExport=User.IsInRole("Owner")||User.IsInRole("Administrator");}

<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h1>@L["Platform and system audit events"]</h1><p class="text-muted">@L["Review administrative and security events outside tenant business data."]</p></div><span class="badge text-bg-secondary align-self-start">@L["Total"]: @Model.TotalCount</span></div>
@if(TempData["PlatformAuditError"] is string error){<div class="alert alert-danger">@error</div>}

<form method="get" action="/platform/audit-events" class="card card-body mb-3"><div class="row g-3 align-items-end">
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["From"]</label><input type="date" name="From" value="@Model.Query.From?.ToString("yyyy-MM-dd")" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["To"]</label><input type="date" name="To" value="@Model.Query.To?.ToString("yyyy-MM-dd")" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Category"]</label><select name="Category" class="form-select"><option value="">@L["All categories"]</option>@foreach(var item in Enum.GetValues<AuditEventCategory>()){<option value="@item" selected="@(Model.Query.Category==item)">@L[$"Audit category {item}"]</option>}</select></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Outcome"]</label><select name="Outcome" class="form-select"><option value="">@L["All outcomes"]</option>@foreach(var item in Enum.GetValues<AuditEventOutcome>()){<option value="@item" selected="@(Model.Query.Outcome==item)">@L[$"Audit outcome {item}"]</option>}</select></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Event type"]</label><input name="EventType" value="@Model.Query.EventType" maxlength="150" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Actor ID"]</label><input name="ActorId" value="@Model.Query.ActorId" maxlength="450" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Resource type"]</label><input name="ResourceType" value="@Model.Query.ResourceType" maxlength="150" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Resource ID"]</label><input name="ResourceId" value="@Model.Query.ResourceId" maxlength="150" class="form-control"></div>
<div class="col-sm-6 col-xl-3"><label class="form-label">@L["Correlation ID"]</label><input name="CorrelationId" value="@Model.Query.CorrelationId" maxlength="100" class="form-control"></div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["Page size"]</label><select name="PageSize" class="form-select">@foreach(var size in new[]{25,50,100}){<option value="@size" selected="@(Model.Query.PageSize==size)">@size</option>}</select></div>
<div class="col-12"><button class="btn btn-primary">@L["Apply"]</button> <a href="/platform/audit-events" class="btn btn-outline-secondary">@L["Reset"]</a></div>
</div></form>

@if(canExport){<form action="/platform/audit-events/export" method="post" class="card card-body mb-3">@Html.AntiForgeryToken()
<input type="hidden" name="From" value="@Model.Query.From?.ToString("yyyy-MM-dd")"><input type="hidden" name="To" value="@Model.Query.To?.ToString("yyyy-MM-dd")"><input type="hidden" name="Category" value="@Model.Query.Category"><input type="hidden" name="Outcome" value="@Model.Query.Outcome"><input type="hidden" name="EventType" value="@Model.Query.EventType"><input type="hidden" name="ActorId" value="@Model.Query.ActorId"><input type="hidden" name="ResourceType" value="@Model.Query.ResourceType"><input type="hidden" name="ResourceId" value="@Model.Query.ResourceId"><input type="hidden" name="CorrelationId" value="@Model.Query.CorrelationId">
<div class="d-flex flex-wrap gap-2 align-items-end"><div class="flex-grow-1"><label class="form-label">@L["Export purpose"]</label><select name="purpose" class="form-select" required><option value="">@L["Select purpose"]</option>@foreach(var purpose in AuditEventReadService.ExportPurposes){<option value="@purpose">@L[$"Audit export purpose {purpose}"]</option>}</select></div><button class="btn btn-outline-primary">@L["Export CSV"]</button></div><small class="text-muted mt-2">@L["Exports are limited to 5,000 filtered events and the export itself is audited."]</small></form>}

<div class="row g-3">@foreach(var item in Model.Items){var cls=item.Outcome==AuditEventOutcome.Succeeded?"text-bg-success":item.Outcome==AuditEventOutcome.Denied?"text-bg-warning":"text-bg-danger";<div class="col-12"><article class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><div><strong class="text-break">@item.EventType</strong><div class="small text-muted">@item.OccurredAtUtc.ToString("u") · @item.Scope · @L[$"Audit channel {item.SourceChannel}"]</div></div><span class="badge @cls align-self-start">@L[$"Audit outcome {item.Outcome}"]</span></div><div class="row g-2 small mt-2"><div class="col-md-4"><strong>@L["Actor"]:</strong> <span class="text-break">@item.ActorId</span></div><div class="col-md-4"><strong>@L["Resource"]:</strong> <span class="text-break">@item.ResourceType / @item.ResourceId</span></div><div class="col-md-4"><strong>@L["Correlation ID"]:</strong> <code class="text-break">@item.CorrelationId</code></div>@if(!string.IsNullOrEmpty(item.ReasonCode)){<div class="col-md-4"><strong>@L["Reason code"]:</strong> @item.ReasonCode</div>}</div>@if(Model.CanViewSensitive&&(!string.IsNullOrEmpty(item.SourceIpMasked)||!string.IsNullOrEmpty(item.UserAgentHash))){<div class="alert alert-light py-2 small mt-3 mb-0"><strong>@L["Restricted request evidence"]:</strong> @(item.SourceIpMasked??"—") · <code class="text-break">@(item.UserAgentHash??"—")</code></div>}@if(!string.IsNullOrEmpty(item.ChangesRedactedJson)||!string.IsNullOrEmpty(item.MetadataRedactedJson)){<details class="mt-3"><summary>@L["Redacted evidence"]</summary><pre class="small bg-light rounded p-2 mt-2 text-wrap">@item.ChangesRedactedJson
@item.MetadataRedactedJson</pre></details>}</div></article></div>}@if(Model.Items.Count==0){<div class="col-12"><div class="alert alert-info">@L["No matching audit events."]</div></div>}</div>

<form method="get" action="/platform/audit-events" class="d-flex justify-content-between align-items-center mt-3"><input type="hidden" name="From" value="@Model.Query.From?.ToString("yyyy-MM-dd")"><input type="hidden" name="To" value="@Model.Query.To?.ToString("yyyy-MM-dd")"><input type="hidden" name="Category" value="@Model.Query.Category"><input type="hidden" name="Outcome" value="@Model.Query.Outcome"><input type="hidden" name="EventType" value="@Model.Query.EventType"><input type="hidden" name="ActorId" value="@Model.Query.ActorId"><input type="hidden" name="ResourceType" value="@Model.Query.ResourceType"><input type="hidden" name="ResourceId" value="@Model.Query.ResourceId"><input type="hidden" name="CorrelationId" value="@Model.Query.CorrelationId"><input type="hidden" name="PageSize" value="@Model.Query.PageSize"><span>@L["Page"] @Model.Query.Page / @Model.TotalPages</span><div class="btn-group"><button name="Page" value="@(Model.Query.Page-1)" class="btn btn-outline-secondary" disabled="@(Model.Query.Page<=1)">@L["Previous"]</button><button name="Page" value="@(Model.Query.Page+1)" class="btn btn-outline-secondary" disabled="@(Model.Query.Page>=Model.TotalPages)">@L["Next"]</button></div></form>
