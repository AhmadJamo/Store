@model MiniStore.Application.Saas.CreatePromotionCodeDto
@using System.Globalization
@{ var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"]=ar?"إنشاء كود خصم":"Create promo code"; var plans=(IReadOnlyList<MiniStore.Application.Saas.PlanCardDto>)ViewBag.Plans; }
<h1>@(ar?"إنشاء كود خصم":"Create promo code")</h1><form method="post" class="card p-4 mt-4 border-0 shadow-sm">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row g-3">
<div class="col-md-4"><label>@(ar?"الكود":"Code")</label><input asp-for="Code" class="form-control" required></div><div class="col-md-4"><label>@(ar?"نسبة الخصم":"Discount percentage")</label><input asp-for="DiscountPercentage" type="number" min="0.01" max="100" step="0.01" class="form-control" required></div><div class="col-md-4"><label>@(ar?"أقصى عدد استخدام":"Maximum redemptions")</label><input asp-for="MaximumRedemptions" type="number" min="1" class="form-control"></div>
<div class="col-md-6"><label>@(ar?"يبدأ في":"Starts at")</label><input asp-for="StartsAt" type="datetime-local" class="form-control" required></div><div class="col-md-6"><label>@(ar?"ينتهي في":"Ends at")</label><input asp-for="EndsAt" type="datetime-local" class="form-control" required></div><div class="col-md-6"><label>@(ar?"الخطة المشمولة":"Applicable plan")</label><select asp-for="PlanId" class="form-select"><option value="">@(ar?"كل الخطط":"All plans")</option>@foreach(var p in plans){<option value="@p.Id">@(ar?p.NameArabic:p.NameEnglish)</option>}</select></div></div><button class="btn btn-primary mt-4">@(ar?"إنشاء الكود":"Create promo code")</button></form>
