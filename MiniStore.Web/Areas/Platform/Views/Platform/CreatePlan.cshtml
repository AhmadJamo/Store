@model MiniStore.Application.Saas.CreatePlanDto
@using System.Globalization
@{ var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"]=ar?"إنشاء خطة":"Create plan"; }
<h1>@(ar?"إنشاء خطة":"Create plan")</h1><form method="post" class="card p-4 mt-4 border-0 shadow-sm">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="row g-3">
<div class="col-md-4"><label>@(ar?"الرمز":"Code")</label><input asp-for="Code" class="form-control" required></div><div class="col-md-4"><label>@(ar?"الاسم الإنجليزي":"English name")</label><input asp-for="NameEnglish" class="form-control" required></div><div class="col-md-4"><label>@(ar?"الاسم العربي":"Arabic name")</label><input asp-for="NameArabic" class="form-control" required></div>
<div class="col-md-6"><label>@(ar?"الوصف الإنجليزي":"English description")</label><textarea asp-for="DescriptionEnglish" class="form-control"></textarea></div><div class="col-md-6"><label>@(ar?"الوصف العربي":"Arabic description")</label><textarea asp-for="DescriptionArabic" class="form-control"></textarea></div>
<div class="col"><label>@(ar?"السعر الشهري":"Monthly price")</label><input asp-for="MonthlyPrice" class="form-control"></div><div class="col"><label>@(ar?"السعر السنوي":"Annual price")</label><input asp-for="AnnualPrice" class="form-control"></div><div class="col"><label>@(ar?"العملة":"Currency")</label><input asp-for="Currency" class="form-control" value="USD"></div>
@foreach(var n in new[]{"MaxUsers","MaxWarehouses","MaxBranches","MaxPosTerminals","MaxProducts"}){<div class="col-md-4"><label>@n</label><input name="@n" type="number" min="1" class="form-control" required></div>}</div><button class="btn btn-primary mt-4">@(ar?"إنشاء الخطة":"Create plan")</button></form>
