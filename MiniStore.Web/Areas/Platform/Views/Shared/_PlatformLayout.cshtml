@using System.Globalization
@{ var ar = CultureInfo.CurrentUICulture.Name.StartsWith("ar"); }
<!doctype html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width">
    <title>@ViewData["Title"] - MiniStore Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap@(ar ? ".rtl" : "").min.css">
    <style>body{background:#f3f6fa}.side{width:250px;background:#111c2e;min-height:100vh}.side a{color:#bfcbe0;text-decoration:none;display:block;padding:.75rem 1rem;border-radius:.5rem}.side a:hover{background:#1e304d;color:#fff}</style>
</head>
<body><div class="d-flex">
    <aside class="side p-3"><h4 class="text-white mb-4">MiniStore Control</h4>
        <a href="/platform">@(ar ? "نظرة عامة" : "Overview")</a>
        <a href="/platform/companies">@(ar ? "الشركات" : "Companies")</a>
        <a href="/platform/plans">@(ar ? "الخطط" : "Plans")</a>
        <a href="/platform/promotions">@(ar ? "أكواد الخصم" : "Promo codes")</a>
        <a href="/platform/payments/pending">@(ar ? "الدفعات المعلقة" : "Pending payments")</a>
        <hr class="border-secondary">
        <form action="/Language/Set" method="post" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@Context.Request.Path"><input type="hidden" name="culture" value="@(ar?"en-US":"ar-JO")"><button class="btn btn-outline-info w-100">@(ar?"English":"العربية")</button></form>
        <form action="/platform/account/logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-light w-100">@(ar ? "تسجيل الخروج" : "Sign out")</button></form>
    </aside>
    <main class="container-fluid p-5">@RenderBody()</main>
</div></body></html>
