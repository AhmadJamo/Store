@model MiniStore.Application.Dtos.Sales.CustomerReturnReceiptDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Model.ReceiptNumber;var rv=Convert.ToBase64String(Model.RowVersion);var settings=await GeneralSettingsService.GetAsync();async Task<bool>Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Model.ReceiptNumber</h2><span class="badge @(Model.Status==MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Inspected?"bg-success":Model.Status==MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Cancelled?"bg-secondary":"bg-warning text-dark")">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex gap-2"><a asp-controller="CustomerReturnRequests" asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-primary">@Localizer["View return request"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["Inspection evidence is separate from inventory posting. Completing inspection freezes the decisions; the next step applies approved dispositions."]</div>
<div class="card card-body mb-3"><div class="row"><div class="col-md-4"><span class="text-muted">@Localizer["Return request"]</span><div>@Model.RequestNumber</div></div><div class="col-md-4"><span class="text-muted">@Localizer["Receipt date"]</span><div>@Model.ReceiptDate</div></div><div class="col-md-4"><span class="text-muted">@Localizer["Notes"]</span><div>@(Model.Notes??"—")</div></div></div></div>
<div class="row g-3">@foreach(var l in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><strong>@l.ProductCode — @l.ProductName</strong><div class="small text-muted">@l.WarehouseName · @l.LocationName</div><div class="row mt-2"><div class="col-4"><span class="text-muted">@Localizer["Received quantity"]</span><div>@l.ReceivedQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Disposition"]</span><div>@Localizer[l.Disposition.ToString()]</div></div><div class="col-4"><span class="text-muted">@Localizer["Inspection notes"]</span><div>@l.InspectionNotes</div></div></div>@if(l.TrackingAllocations is not null){<pre class="mt-2 mb-0">@l.TrackingAllocations</pre>}</div></div></div>}</div>
<div class="d-flex flex-wrap gap-2 mt-3">@if(Model.Status==MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Draft){if(await Can("CustomerReturnReceipts.Inspect")){<form asp-action="Inspect" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Complete inspection"]</button></form>}if(await Can("CustomerReturnReceipts.Cancel")){<form asp-action="Cancel" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel receipt draft"]</button></form>}}else if(Model.Status==MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Inspected){<span class="badge bg-success p-2">@Localizer["Inspection completed"]</span><span class="text-muted align-self-center">@Localizer["Next: post approved inventory dispositions."]</span>}else{<span class="badge bg-secondary p-2">@Localizer["Receipt draft cancelled"]</span>}</div>
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
