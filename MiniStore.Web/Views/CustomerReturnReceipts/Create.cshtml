@model MiniStore.Application.Dtos.Sales.CustomerReturnReceiptCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Localizer["Receive and inspect return"];var settings=await GeneralSettingsService.GetAsync();}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2>@Localizer["Receive and inspect return"]</h2><div class="text-muted">@Model.RequestNumber · @Model.CustomerName</div></div><a asp-controller="CustomerReturnRequests" asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">@Localizer["Back to return request"]</a></div>
<div class="alert alert-warning">@Localizer["Choose a disposition after physical inspection. This draft records the decision but does not increase available stock or post accounting."]</div>
<form asp-action="Create" method="post"><input type="hidden" name="CustomerReturnRequestId" value="@Model.RequestId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card card-body mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">@Localizer["Receipt date"]</label><input type="date" name="ReceiptDate" value="@Model.Form.ReceiptDate.ToString("yyyy-MM-dd")" min="@Model.RequestDate.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-8"><label class="form-label">@Localizer["Notes"]</label><input name="Notes" value="@Model.Form.Notes" maxlength="1000" class="form-control"/></div></div></div>
<div class="row g-3">@for(var i=0;i<Model.Lines.Count;i++){var line=Model.Lines[i];var old=Model.Form.Lines.FirstOrDefault(x=>x.CustomerReturnRequestLineId==line.RequestLineId);<div class="col-xl-6"><div class="card h-100"><div class="card-body"><input type="hidden" name="Lines[@i].CustomerReturnRequestLineId" value="@line.RequestLineId"/><strong>@line.ProductCode — @line.ProductName</strong><div class="small text-muted">@line.WarehouseName · @line.LocationName</div><div class="row mt-2"><div class="col-4"><span class="text-muted">@Localizer["Approved"]</span><div>@line.ApprovedQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Already received"]</span><div>@line.AlreadyReceivedQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Remaining"]</span><div>@line.RemainingQuantity.ToQuantityDisplay(settings)</div></div></div><div class="row g-2 mt-2"><div class="col-md-4"><label class="form-label">@Localizer["Received quantity"]</label><input type="number" name="Lines[@i].ReceivedQuantity" value="@(old?.ReceivedQuantity??0)" min="0" max="@line.RemainingQuantity" step="any" class="form-control"/></div><div class="col-md-4"><label class="form-label">@Localizer["Disposition"]</label><select name="Lines[@i].Disposition" class="form-select">@foreach(var value in Enum.GetValues<MiniStore.Domain.Entities.CustomerReturnDisposition>()){<option value="@((int)value)" selected="@(old?.Disposition==value)">@Localizer[value.ToString()]</option>}</select></div><div class="col-md-4"><label class="form-label">@Localizer["Inspection notes"]</label><input name="Lines[@i].InspectionNotes" value="@old?.InspectionNotes" maxlength="500" class="form-control"/></div></div>@if(line.TrackingPolicy!=MiniStore.Domain.Entities.ProductTrackingPolicy.None){<label class="form-label mt-2">@Localizer["Returned lot or serial allocations"]</label><textarea name="Lines[@i].TrackingAllocations" maxlength="4000" class="form-control" placeholder="@Localizer["LOT:QUANTITY or one serial per line"]">@old?.TrackingAllocations</textarea><div class="form-text">@Localizer["Tracking identities must come from the source delivery and exactly match the received quantity."]</div>}</div></div></div>}</div><button class="btn btn-primary mt-3" @(Model.Lines.Count==0?"disabled":null)>@Localizer["Create inspection draft"]</button></form>
