@model IReadOnlyCollection<MiniStore.Application.Dtos.Sales.CustomerReturnReceiptSummaryDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Localizer["Customer return receipts"];var settings=await GeneralSettingsService.GetAsync();}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2>@Localizer["Customer return receipts"]</h2><form method="get" class="d-flex gap-2"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Receipt number"]"/><button class="btn btn-outline-primary">@Localizer["Search"]</button></form></div>
<div class="alert alert-info">@Localizer["Return receipts record custody, inspection and disposition decisions. They do not yet increase available stock or create accounting entries."]</div>
<div class="row g-3">@foreach(var x in Model){<div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><strong>@x.ReceiptNumber</strong><span class="badge @(x.Status is MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Inspected or MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Posted?"bg-success":x.Status==MiniStore.Domain.Entities.CustomerReturnReceiptStatus.Cancelled?"bg-secondary":"bg-warning text-dark")">@Localizer[x.Status.ToString()]</span></div><div class="mt-2">@Localizer["Return request"]: @x.RequestNumber</div><div>@Localizer["Receipt date"]: @x.ReceiptDate</div><div>@Localizer["Quantity"]: @x.Quantity.ToQuantityDisplay(settings)</div><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-outline-primary mt-3">@Localizer["View details"]</a></div></div></div>}</div>
@if(Model.Count==0){<div class="alert alert-secondary">@Localizer["No customer return receipts were found. Start from an approved return request."] <a asp-controller="CustomerReturnRequests" asp-action="Index" class="alert-link">@Localizer["Open return requests"]</a></div>}
