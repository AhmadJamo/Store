@model List<MiniStore.Application.Dtos.Sales.CustomerInvoiceSummaryDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Localizer["Customer invoices"]; var settings = await GeneralSettingsService.GetAsync(); }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h2 class="mb-1">@Localizer["Customer invoices"]</h2><div class="text-muted">@Localizer["Review draft, approved and cancelled customer invoice documents."]</div></div>
</div>
<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-7"><label class="form-label">@Localizer["Invoice or order or customer"]</label><input name="search" value="@ViewBag.Search" class="form-control" /></div>
        <div class="col-lg-3"><label class="form-label">@Localizer["Status"]</label><select name="status" class="form-select"><option value="">@Localizer["All"]</option>@foreach(var status in Enum.GetValues<CustomerInvoiceStatus>()){<option value="@status" selected="@(ViewBag.Status?.ToString()==status.ToString())">@Localizer[status.ToString()]</option>}</select></div>
        <div class="col-lg-2"><button class="btn btn-primary w-100">@Localizer["Search"]</button></div>
    </div>
</form>

@if(Model.Count==0){<div class="alert alert-light border">@Localizer["No customer invoices found."]</div>}
<div class="row g-3">
@foreach(var invoice in Model)
{
    var badge=invoice.Status==CustomerInvoiceStatus.Approved?"bg-success":invoice.Status==CustomerInvoiceStatus.Cancelled?"bg-secondary":"bg-warning text-dark";
    <div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-body d-flex flex-column gap-2">
        <div class="d-flex justify-content-between gap-2"><strong>@invoice.InvoiceNumber</strong><span class="badge @badge">@Localizer[invoice.Status.ToString()]</span></div>
        <div><span class="text-muted">@Localizer["Sales order"]:</span> @invoice.OrderNumber</div>
        <div><span class="text-muted">@Localizer["Customer"]:</span> @invoice.CustomerCode — @invoice.CustomerName</div>
        <div class="row g-2"><div class="col-6"><span class="text-muted">@Localizer["Invoice date"]</span><div>@invoice.InvoiceDate</div></div><div class="col-6"><span class="text-muted">@Localizer["Due date"]</span><div>@invoice.DueDate</div></div></div>
        <div class="fs-5 mt-auto">@invoice.TotalAmount.ToMoneyDisplay(settings) @invoice.CurrencyCode</div>
        <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-outline-primary">@Localizer["Details"]</a>
    </div></div></div>
}
</div>
