@model MiniStore.Application.Dtos.Sales.CustomerInvoiceDetailsDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"]=Model.InvoiceNumber; var settings=await GeneralSettingsService.GetAsync(); var rv=Convert.ToBase64String(Model.RowVersion); async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded; var badge=Model.Status==CustomerInvoiceStatus.Approved?"bg-success":Model.Status==CustomerInvoiceStatus.Cancelled?"bg-secondary":"bg-warning text-dark"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@Model.InvoiceNumber</h2><span class="badge @badge">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex flex-wrap gap-2"><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-outline-primary">@Localizer["View sales order"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["Creating or approving this invoice does not change inventory, post accounting or record payment."]</div>
@if(Model.Status==CustomerInvoiceStatus.Approved){<div class="alert alert-warning">@Localizer["This invoice is approved but not posted to accounts receivable. SAL-080 will own revenue, tax and receivable posting."]</div>}

<div class="row g-3 mb-3"><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Customer snapshot"]</h5><strong>@Model.CustomerCode — @Model.CustomerName</strong>@if(Model.CustomerLegalName is not null){<div>@Model.CustomerLegalName</div>}@if(Model.CustomerTaxNumber is not null){<div>@Localizer["Tax number"]: @Model.CustomerTaxNumber</div>}@if(Model.Address is not null){<div class="mt-2">@Model.Address</div>}</div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Invoice terms"]</h5><div>@Localizer["Sales order"]: @Model.OrderNumber</div><div>@Localizer["Invoice date"]: @Model.InvoiceDate</div><div>@Localizer["Due date"]: @Model.DueDate</div><div>@Localizer["Payment terms"]: @Model.PaymentTermDays @Localizer["days"]</div><div>@Localizer["Invoice quantity basis"]: @Localizer[Model.QuantityPolicy.ToString()]</div></div></div></div></div>

<h5>@Localizer["Customer invoice lines"]</h5><div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><strong>@line.ProductCode — @line.ProductName</strong><span>@line.Quantity.ToQuantityDisplay(settings) @line.UnitName</span></div><div class="small text-muted">@Localizer[line.QuantityBasis.ToString()]</div><div class="row g-2 mt-2"><div class="col-6"><span class="text-muted">@Localizer["Unit price"]</span><div>@line.UnitPrice.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div><div class="col-6"><span class="text-muted">@Localizer["Net amount"]</span><div>@line.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Tax amount"]</span><div>@line.TaxAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Total"]</span><div>@line.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div>@if(line.Sources.Count>0){<div class="mt-3"><span class="text-muted">@Localizer["Source deliveries"]</span><div class="d-flex flex-wrap gap-2 mt-1">@foreach(var source in line.Sources){<a asp-controller="SalesDeliveries" asp-action="Details" asp-route-id="@source.SalesDeliveryId" class="badge bg-light text-primary text-decoration-none">@source.DeliveryNumber · @source.StockQuantity.ToQuantityDisplay(settings)</a>}</div></div>}</div></div></div>}</div>
<div class="card card-body my-3"><div class="row text-center"><div class="col-4"><span class="text-muted">@Localizer["Net amount"]</span><div class="fs-5">@Model.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Tax amount"]</span><div class="fs-5">@Model.TaxAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Total"]</span><div class="fs-5">@Model.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div></div>

<div class="d-flex flex-wrap gap-2 align-items-start">
@if(Model.Status==CustomerInvoiceStatus.Draft&&await Can("CustomerInvoices.Approve")){<form asp-action="Approve" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Approve customer invoice"]</button></form>}else if(Model.Status==CustomerInvoiceStatus.Approved){<span class="badge bg-success p-2">@Localizer["Approval completed"]</span>}else if(Model.Status==CustomerInvoiceStatus.Cancelled){<span class="badge bg-secondary p-2">@Localizer["Invoice cancelled"]</span>}
@if(Model.Status is CustomerInvoiceStatus.Draft or CustomerInvoiceStatus.Approved && await Can("CustomerInvoices.Cancel")){<form asp-action="Cancel" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel customer invoice"]</button></form>}
</div>
@if(Model.Notes is not null){<div class="card card-body mt-3"><strong>@Localizer["Notes"]</strong><div>@Model.Notes</div></div>}
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
