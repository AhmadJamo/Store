@using System.Globalization
@using System.Security.Claims
@model List<MiniStore.Application.DTOs.Security.TenantRoleListItemDto>
@{ var ar = CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"] = ar ? "الأدوار والصلاحيات" : "Roles & permissions"; var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? ""; var canCreate = await PermissionService.CanAsync(userId, "Roles.Create"); var canEdit = await PermissionService.CanAsync(userId, "Roles.Edit"); var canDelete = await PermissionService.CanAsync(userId, "Roles.Delete"); }

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2>@(ar ? "أدوار الشركة وصلاحياتها" : "Company roles and permissions")</h2><p class="text-muted mb-0">@(ar ? "هذه الأدوار خاصة بالشركة الحالية ولا تظهر لأي شركة أخرى." : "These roles belong only to the active company and are never shared with another company.")</p></div>
        @if (canCreate) { <a asp-action="Create" class="btn btn-primary">+ @(ar ? "إضافة دور" : "Add role")</a> }
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">@(ar ? "عدد الأدوار" : "Roles")</div><h3>@Model.Count</h3></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">@(ar ? "تعيينات المستخدمين" : "User assignments")</div><h3>@Model.Sum(x => x.UserCount)</h3></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">@(ar ? "الصلاحيات المعينة" : "Assigned permissions")</div><h3>@Model.Sum(x => x.PermissionCount)</h3></div></div></div>
    </div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>@(ar ? "الدور" : "Role")</th><th>@(ar ? "الوصف" : "Description")</th><th>@(ar ? "المستخدمون" : "Users")</th><th>@(ar ? "الصلاحيات" : "Permissions")</th><th></th></tr></thead><tbody>
    @foreach (var role in Model) { <tr><td><strong>@role.Name</strong> @if(role.IsSystem){<span class="badge text-bg-warning">@(ar ? "محمي" : "Protected")</span>}</td><td class="text-muted">@(role.Description ?? "—")</td><td>@role.UserCount</td><td>@role.PermissionCount</td><td class="text-end">
        @if (!role.IsSystem && canEdit) { <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">@(ar ? "تعديل" : "Edit")</a> }
        @if (!role.IsSystem && canDelete) { <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline" onsubmit="return confirm('@(ar ? "حذف هذا الدور؟" : "Delete this role?")');"><button class="btn btn-sm btn-outline-danger">@(ar ? "حذف" : "Delete")</button></form> }
    </td></tr> }
    </tbody></table></div></div>
</div>
