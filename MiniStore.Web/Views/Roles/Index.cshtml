@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@model List<IdentityRole>

@{
    ViewData["Title"] = "Roles";


var roleUsers =
    ViewBag.RoleUsers
    as Dictionary<string, int>
    ?? new Dictionary<string, int>();

    var rolePermissionCounts =
        ViewBag.RolePermissionCounts
        as Dictionary<string, int>
        ?? new Dictionary<string, int>();

    var userId =
        User.FindFirstValue(ClaimTypes.NameIdentifier)
        ?? "";

    var canCreate =
        await PermissionService.CanAsync(
            userId,
            "Roles.Create");

    var canEdit =
        await PermissionService.CanAsync(
            userId,
            "Roles.Edit");

    var canDelete =
        await PermissionService.CanAsync(
            userId,
            "Roles.Delete");


}

<div class="container-fluid">

    ```
    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Roles
            </h2>

            <p class="text-muted mb-0">
                Manage system roles and their permissions.
            </p>
        </div>

        @if (canCreate)
        {
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                Add Role

            </a>
        }

    </div>


    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success:</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Error:</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Summary -->

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Total Roles
                            </div>

                            <h3 class="mb-0">
                                @Model.Count
                            </h3>

                        </div>

                        <div class="text-primary fs-2">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Total Users Assigned
                            </div>

                            <h3 class="mb-0">
                                @roleUsers.Values.Sum()
                            </h3>

                        </div>

                        <div class="text-success fs-2">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Maximum Permissions
                            </div>

                            <h3 class="mb-0">
                                @(
                                    rolePermissionCounts.Values
                                        .DefaultIfEmpty()
                                        .Max()
                                )
                            </h3>

                            <small class="text-muted">
                                Maximum assigned to one role
                            </small>

                        </div>

                        <div class="text-warning fs-2">
                            <i class="bi bi-key"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Roles Table -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0">
                        System Roles
                    </h5>

                    <small class="text-muted">
                        Roles control what users can access and perform.
                    </small>

                </div>

                <span class="badge bg-secondary">
                    @Model.Count roles
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Role
                                </th>

                                <th class="text-center">
                                    Users
                                </th>

                                <th class="text-center">
                                    Permissions
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end"
                                    style="width: 300px;">

                                    Actions

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var role in Model)
                            {
                                var usersCount =
                                    roleUsers.TryGetValue(
                                        role.Id,
                                        out var users)
                                        ? users
                                        : 0;

                                var permissionsCount =
                                    rolePermissionCounts.TryGetValue(
                                        role.Id,
                                        out var permissions)
                                        ? permissions
                                        : 0;

                                var isAdmin =
                                    string.Equals(
                                        role.Name,
                                        "Admin",
                                        StringComparison.OrdinalIgnoreCase);

                                <tr>

                                    <!-- Role -->

                                    <td>

                                        <div class="fw-semibold">
                                            @role.Name
                                        </div>

                                        <small class="text-muted">
                                            Role ID:
                                            @role.Id
                                        </small>

                                    </td>


                                    <!-- Users -->

                                    <td class="text-center">

                                        <span class="badge bg-light text-dark border">

                                            <i class="bi bi-people"></i>

                                            @usersCount

                                        </span>

                                    </td>


                                    <!-- Permissions -->

                                    <td class="text-center">

                                        <span class="badge bg-light text-dark border">

                                            <i class="bi bi-key"></i>

                                            @permissionsCount

                                        </span>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (isAdmin)
                                        {
                                            <span class="badge bg-danger">
                                                System Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Custom Role
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end">

                                        <div class="d-inline-flex align-items-center gap-2">

                                            @if (canEdit && !isAdmin)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@role.Id"
                                                   class="btn btn-sm btn-warning">

                                                    <i class="bi bi-pencil"></i>
                                                    Edit

                                                </a>
                                            }

                                            @if (isAdmin)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        disabled
                                                        title="System role cannot be deleted.">

                                                    <i class="bi bi-shield-lock"></i>
                                                    Protected

                                                </button>
                                            }
                                            else if (usersCount > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        disabled
                                                        title="This role cannot be deleted because it is assigned to users.">

                                                    <i class="bi bi-lock"></i>
                                                    In Use

                                                </button>
                                            }
                                            else if (canDelete)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@role.Id"
                                                   class="btn btn-sm btn-danger"
                                                   onclick="return confirm('Are you sure you want to delete this role?');">

                                                    <i class="bi bi-trash"></i>
                                                    Delete

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <div class="fs-1 text-muted mb-3">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h5>
                        No roles found
                    </h5>

                    <p class="text-muted">
                        Create your first role to start
                        managing user permissions.
                    </p>

                    @if (canCreate)
                    {
                        <a asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-plus-lg"></i>
                            Create Role

                        </a>
                    }

                </div>
            }

        </div>

    </div>
    ```

</div>
