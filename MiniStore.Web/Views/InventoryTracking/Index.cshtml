@model MiniStore.Application.DTOs.Inventory.Tracking.InventoryTrackingPageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Lot and serial tracking"];}
<div class="container mt-4"><h2>@Localizer["Lot and serial tracking"]</h2><p class="text-muted">@Localizer["Opening allocation must cover every current inventory position before tracking is activated."]</p>
<div class="card card-body mb-4"><h5>@Localizer["Opening tracking allocation"]</h5><form asp-action="Open" method="post" id="trackingForm"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-2">
<div class="col-md-4"><label class="form-label">@Localizer["Product"]</label><select name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-3"><label class="form-label">@Localizer["Tracking policy"]</label><select name="Policy" class="form-select"><option value="1">@Localizer["Lot tracking"]</option><option value="2">@Localizer["Serial tracking"]</option></select></div>
<div class="col-md-5"><label class="form-label">@Localizer["Reference"]</label><input name="SourceReference" class="form-control" required maxlength="100" /></div></div>
<div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Manufacture date"]</th><th>@Localizer["Expiration date"]</th><th></th></tr></thead><tbody id="trackingLines"></tbody></table></div>
<button type="button" id="addTrackingLine" class="btn btn-outline-secondary">@Localizer["Add allocation"]</button> <button class="btn btn-primary">@Localizer["Activate tracking"]</button></form></div>
<div class="row g-3 mb-3"><div class="col-md-3"><div class="alert alert-danger mb-0">@Localizer["Expired tracked balances"]: <strong>@Model.ExpiredCount</strong></div></div><div class="col-md-3"><div class="alert alert-warning mb-0">@Localizer["Expiring soon"]: <strong>@Model.ExpiringSoonCount</strong></div></div></div>
<h4>@Localizer["Current tracked inventory"]</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["Tracking policy"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Expiration date"]</th><th>@Localizer["Expiration state"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>@foreach(var x in Model.Balances){<tr class="@(x.ExpirationState=="Expired"?"table-danger":x.ExpirationState=="Expiring soon"?"table-warning":null)"><td>@x.Product</td><td>@x.Warehouse</td><td>@Localizer[x.Location]</td><td>@Localizer[x.Policy.ToString()]</td><td><code>@x.Identifier</code></td><td>@x.Quantity.ToString("N3")</td><td>@x.ExpirationDate?.ToString("yyyy-MM-dd")</td><td>@Localizer[x.ExpirationState] @(x.DaysUntilExpiration.HasValue?$"({x.DaysUntilExpiration})":null)</td><td>@Localizer[x.Status.ToString()]</td></tr>}@if(Model.Balances.Count==0){<tr><td colspan="9" class="text-center text-muted">@Localizer["No tracked inventory found."]</td></tr>}</tbody></table></div>
<h4 class="mt-4">@Localizer["Tracking history"]</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Product"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Type"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Reference"]</th></tr></thead><tbody>@foreach(var x in Model.Transactions){<tr><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.Product</td><td><code>@x.Identifier</code></td><td>@Localizer[x.Type.ToString()]</td><td>@x.Quantity.ToString("+0.###;-0.###")</td><td>@x.Reference</td></tr>}</tbody></table></div></div>
<script>
let trackingIndex=0;const warehouses=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Warehouses.Select(x=>new{id=x.Id,name=x.Name})));const locations=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Locations.Select(x=>new{id=x.Id,warehouseId=x.WarehouseId,name=x.Name})));
document.getElementById('addTrackingLine').addEventListener('click',()=>{const i=trackingIndex++;const tr=document.createElement('tr');tr.innerHTML=`<td><select name="Lines[${i}].WarehouseId" class="form-select tracking-warehouse" required><option value="">—</option>${warehouses.map(x=>`<option value="${x.id}">${x.name}</option>`).join('')}</select></td><td><select name="Lines[${i}].StorageLocationId" class="form-select"><option value="">@Localizer["Unassigned (system)"]</option>${locations.map(x=>`<option value="${x.id}" data-warehouse="${x.warehouseId}">${x.name}</option>`).join('')}</select></td><td><input name="Lines[${i}].Identifier" class="form-control" required maxlength="100" /></td><td><input name="Lines[${i}].Quantity" type="number" min="0.000001" step="0.000001" class="form-control" required /></td><td><input name="Lines[${i}].ManufactureDate" type="date" class="form-control" /></td><td><input name="Lines[${i}].ExpirationDate" type="date" class="form-control" /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">×</button></td>`;document.getElementById('trackingLines').appendChild(tr);});document.getElementById('addTrackingLine').click();
</script>
