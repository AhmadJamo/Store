@model MiniStore.Application.DTOs.Inventory.Tracking.InventoryTrackingPageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Localizer["Lot and serial tracking"];var canManageQuarantine=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:InventoryTracking.ManageQuarantine")).Succeeded;var canManageRecall=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:InventoryTracking.ManageRecall")).Succeeded;}
<div class="container mt-4"><h2>@Localizer["Lot and serial tracking"]</h2><p class="text-muted">@Localizer["Opening allocation must cover every current inventory position before tracking is activated."]</p>
<div class="card card-body mb-4"><h5>@Localizer["Opening tracking allocation"]</h5><form asp-action="Open" method="post" id="trackingForm"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-2">
<div class="col-md-4"><label class="form-label">@Localizer["Product"]</label><select name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-3"><label class="form-label">@Localizer["Tracking policy"]</label><select name="Policy" class="form-select"><option value="1">@Localizer["Lot tracking"]</option><option value="2">@Localizer["Serial tracking"]</option></select></div>
<div class="col-md-5"><label class="form-label">@Localizer["Reference"]</label><input name="SourceReference" class="form-control" required maxlength="100" /></div></div>
<div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Manufacture date"]</th><th>@Localizer["Expiration date"]</th><th></th></tr></thead><tbody id="trackingLines"></tbody></table></div>
<button type="button" id="addTrackingLine" class="btn btn-outline-secondary">@Localizer["Add allocation"]</button> <button class="btn btn-primary">@Localizer["Activate tracking"]</button></form></div>
<div class="row g-3 mb-3"><div class="col-md-3"><div class="alert alert-danger mb-0">@Localizer["Expired tracked balances"]: <strong>@Model.ExpiredCount</strong></div></div><div class="col-md-3"><div class="alert alert-warning mb-0">@Localizer["Expiring soon"]: <strong>@Model.ExpiringSoonCount</strong></div></div></div>
<div class="card mb-4"><div class="card-header"><strong>@Localizer["Expiration alert center"]</strong></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>@Localizer["Severity"]</th><th>@Localizer["Product"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Expiration date"]</th><th>@Localizer["Days remaining"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>@foreach(var alert in Model.ExpirationAlerts){<tr class="@(alert.Severity=="Expired"?"table-danger":"table-warning")"><td>@Localizer[alert.Severity]</td><td>@alert.Product</td><td><code>@alert.Identifier</code></td><td>@alert.Warehouse</td><td>@Localizer[alert.Location]</td><td>@alert.Quantity.ToString("N3")</td><td>@alert.ExpirationDate.ToString("yyyy-MM-dd")</td><td>@alert.DaysUntilExpiration</td><td>@Localizer[alert.Status.ToString()]</td></tr>}@if(Model.ExpirationAlerts.Count==0){<tr><td colspan="9" class="text-center text-muted py-3">@Localizer["No expiration alerts."]</td></tr>}</tbody></table></div></div>
@if(canManageRecall){<div class="card card-body mb-4"><h5>@Localizer["Create inventory recall"]</h5><form asp-action="CreateRecall" method="post" class="row g-2"><div class="col-md-2"><label class="form-label">@Localizer["Reference"]</label><input name="reference" class="form-control" maxlength="50" required /></div><div class="col-md-3"><label class="form-label">@Localizer["Product"]</label><select name="productId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var p in Model.TrackedProducts){<option value="@p.Id">@p.Name</option>}</select></div><div class="col-md-2"><label class="form-label">@Localizer["Lot or serial number"]</label><input name="identifier" class="form-control" maxlength="100" required /></div><div class="col-md-4"><label class="form-label">@Localizer["Recall reason"]</label><input name="reason" class="form-control" maxlength="250" required /></div><div class="col-md-1 align-self-end"><button class="btn btn-danger w-100">@Localizer["Recall"]</button></div></form></div>}
<h4>@Localizer["Inventory recalls"]</h4><div class="table-responsive mb-4"><table class="table table-sm"><thead><tr><th>@Localizer["Reference"]</th><th>@Localizer["Product"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Recall reason"]</th><th>@Localizer["Affected documents"]</th><th>@Localizer["Status"]</th><th>@Localizer["Date"]</th>@if(canManageRecall){<th></th>}</tr></thead><tbody>@foreach(var recall in Model.Recalls){<tr class="@(recall.Status==InventoryRecallStatus.Active?"table-danger":null)"><td><code>@recall.Reference</code></td><td>@recall.Product</td><td><code>@recall.Identifier</code></td><td>@recall.Reason</td><td>@foreach(var reference in recall.AffectedReferences){<div><code>@reference</code></div>}</td><td>@Localizer[recall.Status.ToString()]</td><td>@recall.CreatedAt.ToLocalTime().ToString("g")</td>@if(canManageRecall){<td>@if(recall.Status==InventoryRecallStatus.Active){<form asp-action="CloseRecall" method="post" class="d-flex gap-1"><input type="hidden" name="recallId" value="@recall.Id" /><input name="notes" class="form-control form-control-sm" maxlength="250" required placeholder="@Localizer["Closure notes"]" /><button class="btn btn-sm btn-outline-success">@Localizer["Close recall"]</button></form>}</td>}</tr>}@if(Model.Recalls.Count==0){<tr><td colspan="@(canManageRecall?8:7)" class="text-center text-muted">@Localizer["No inventory recalls found."]</td></tr>}</tbody></table></div>
<h4>@Localizer["Current tracked inventory"]</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["Tracking policy"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Expiration date"]</th><th>@Localizer["Expiration state"]</th><th>@Localizer["Status"]</th>@if(canManageQuarantine){<th>@Localizer["Quarantine control"]</th>}</tr></thead><tbody>@foreach(var x in Model.Balances){<tr class="@(x.Status==InventoryTrackingStatus.Quarantined?"table-secondary":x.ExpirationState=="Expired"?"table-danger":x.ExpirationState=="Expiring soon"?"table-warning":null)"><td>@x.Product</td><td>@x.Warehouse</td><td>@Localizer[x.Location]</td><td>@Localizer[x.Policy.ToString()]</td><td><code>@x.Identifier</code></td><td>@x.Quantity.ToString("N3")</td><td>@x.ExpirationDate?.ToString("yyyy-MM-dd")</td><td>@Localizer[x.ExpirationState] @(x.DaysUntilExpiration.HasValue?$"({x.DaysUntilExpiration})":null)</td><td>@Localizer[x.Status.ToString()]</td>@if(canManageQuarantine){<td>@if(x.Quantity>0&&(x.Status==InventoryTrackingStatus.Available||x.Status==InventoryTrackingStatus.Quarantined)){<form asp-action="@(x.Status==InventoryTrackingStatus.Available?"Quarantine":"Release")" method="post" class="d-flex gap-1"><input type="hidden" name="balanceId" value="@x.Id" /><input name="reason" class="form-control form-control-sm" minlength="3" maxlength="90" required placeholder="@Localizer["Reason"]" /><button class="btn btn-sm @(x.Status==InventoryTrackingStatus.Available?"btn-outline-danger":"btn-outline-success")">@Localizer[x.Status==InventoryTrackingStatus.Available?"Quarantine":"Release"]</button></form>}</td>}</tr>}@if(Model.Balances.Count==0){<tr><td colspan="@(canManageQuarantine?10:9)" class="text-center text-muted">@Localizer["No tracked inventory found."]</td></tr>}</tbody></table></div>
<h4 class="mt-4">@Localizer["Tracking history"]</h4><div class="table-responsive"><table class="table table-sm"><thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Product"]</th><th>@Localizer["Lot or serial number"]</th><th>@Localizer["Type"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Reference"]</th></tr></thead><tbody>@foreach(var x in Model.Transactions){<tr><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.Product</td><td><code>@x.Identifier</code></td><td>@Localizer[x.Type.ToString()]</td><td>@x.Quantity.ToString("+0.###;-0.###")</td><td>@x.Reference</td></tr>}</tbody></table></div></div>
<script>
let trackingIndex=0;const warehouses=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Warehouses.Select(x=>new{id=x.Id,name=x.Name})));const locations=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Locations.Select(x=>new{id=x.Id,warehouseId=x.WarehouseId,name=x.Name})));
document.getElementById('addTrackingLine').addEventListener('click',()=>{const i=trackingIndex++;const tr=document.createElement('tr');tr.innerHTML=`<td><select name="Lines[${i}].WarehouseId" class="form-select tracking-warehouse" required><option value="">—</option>${warehouses.map(x=>`<option value="${x.id}">${x.name}</option>`).join('')}</select></td><td><select name="Lines[${i}].StorageLocationId" class="form-select"><option value="">@Localizer["Unassigned (system)"]</option>${locations.map(x=>`<option value="${x.id}" data-warehouse="${x.warehouseId}">${x.name}</option>`).join('')}</select></td><td><input name="Lines[${i}].Identifier" class="form-control" required maxlength="100" /></td><td><input name="Lines[${i}].Quantity" type="number" min="0.000001" step="0.000001" class="form-control" required /></td><td><input name="Lines[${i}].ManufactureDate" type="date" class="form-control" /></td><td><input name="Lines[${i}].ExpirationDate" type="date" class="form-control" /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">×</button></td>`;document.getElementById('trackingLines').appendChild(tr);});document.getElementById('addTrackingLine').click();
</script>
