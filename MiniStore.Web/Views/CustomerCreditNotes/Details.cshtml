@model MiniStore.Application.Dtos.Sales.CustomerCreditNoteDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ViewData["Title"]=Model.Number;var settings=await GeneralSettingsService.GetAsync();async Task<bool>Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between gap-2"><h2>@Model.Number <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div>@if(await Can("CustomerInvoices.View")){<a asp-controller="CustomerInvoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary">@Localizer["View customer invoice"]</a>} <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-3"><div class="col-md-3"><span class="text-muted">@Localizer["Customer"]</span><div>@Model.CustomerName</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Credit date"]</span><div>@Model.CreditDate</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Total"]</span><div>@Model.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Journal entry"]</span><div>@if(Model.JournalEntryId.HasValue&&await Can("JournalEntries.View")){<a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@Model.JournalEntryId">@Model.JournalEntryNumber</a>}else{@Model.JournalEntryNumber}</div></div><div class="col-12"><span class="text-muted">@Localizer["Reason"]</span><div>@Model.Reason</div></div></div></div>
<div class="row g-3">@foreach(var x in Model.Lines){<div class="col-lg-6"><div class="card card-body h-100"><strong>@x.ProductCode — @x.ProductName</strong><div class="small text-muted">@Localizer["Return receipt"]: @x.ReceiptNumber</div><div class="row mt-2"><div class="col-3">@Localizer["Quantity"]<div>@x.Quantity.ToQuantityDisplay(settings) @x.UnitName</div></div><div class="col-3">@Localizer["Net amount"]<div>@x.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-3">@Localizer["Tax"]<div>@x.TaxAmount.ToMoneyDisplay(settings)</div></div><div class="col-3">@Localizer["Total"]<div>@x.GrossAmount.ToMoneyDisplay(settings)</div></div></div></div></div>}</div>
<div class="alert alert-info mt-3">@Localizer["The customer credit is posted. Cash refund or application to another balance remains a separate controlled action."]</div>
