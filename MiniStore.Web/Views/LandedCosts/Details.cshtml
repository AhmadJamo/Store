@model MiniStore.Application.DTOs.Purchases.LandedCostDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.CostNumber; var numberSettings = await GeneralSettingsService.GetAsync(); var canReverse = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseDocumentReversals.Create")).Succeeded; var reversal = ViewBag.Reversal as MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto; }
<div class="d-flex flex-wrap justify-content-between gap-2"><h2>@Model.CostNumber <span class="badge bg-success">@L[Model.Status.ToString()]</span></h2><div class="d-flex gap-2">@if(Model.Status == MiniStore.Domain.Entities.LandedCostStatus.Posted && reversal is null && canReverse){<a asp-controller="PurchaseDocumentReversals" asp-action="Create" asp-route-documentType="LandedCost" asp-route-originalDocumentId="@Model.Id" class="btn btn-outline-danger">@L["Reverse document"]</a>}else if(reversal is not null){<a asp-controller="PurchaseDocumentReversals" asp-action="Details" asp-route-id="@reversal.Id" class="btn btn-outline-success">@L["Reversed"]</a>}<a asp-action="Index" class="btn btn-outline-secondary">@L["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-2"><div class="col-md-4"><strong>@L["Goods receipt"]:</strong> @Model.ReceiptNumber</div><div class="col-md-4"><strong>@L["Warehouse"]:</strong> @Model.WarehouseName</div><div class="col-md-4"><strong>@L["Date"]:</strong> @Model.CostDate</div><div class="col-md-4"><strong>@L["External reference"]:</strong> @Model.ExternalReference</div><div class="col-md-4"><strong>@L["Allocation method"]:</strong> @L[Model.AllocationMethod.ToString()]</div><div class="col-md-4"><strong>@L["Total"]:</strong> @Model.TotalAmount.ToMoneyDisplay(numberSettings)</div><div class="col-md-4"><strong>@L["Capitalized amount"]:</strong> @Model.CapitalizedAmount.ToMoneyDisplay(numberSettings)</div><div class="col-md-4"><strong>@L["Expensed amount"]:</strong> @Model.ExpensedAmount.ToMoneyDisplay(numberSettings)</div></div></div>
<h5>@L["Cost components"]</h5><div class="row g-3">@foreach(var x in Model.Components){<div class="col-12 col-md-6"><div class="card card-body h-100"><strong>@L[x.Type.ToString()]</strong><div>@L["Amount"]: @x.Amount.ToMoneyDisplay(numberSettings)</div><div class="text-muted">@x.Description</div></div></div>}</div>
<h5 class="mt-4">@L["Allocations"]</h5><div class="row g-3">@foreach(var x in Model.Allocations){<div class="col-12 col-xl-6"><div class="card card-body h-100"><strong>@x.Product</strong><div class="row g-2 small"><div class="col-6">@L["Allocation basis"]: @x.AllocationBasis.ToQuantityDisplay(numberSettings)</div><div class="col-6">@L["Allocated amount"]: @x.AllocatedAmount.ToMoneyDisplay(numberSettings)</div><div class="col-6">@L["Capitalized amount"]: @x.CapitalizedAmount.ToMoneyDisplay(numberSettings)</div><div class="col-6">@L["Expensed amount"]: @x.ExpensedAmount.ToMoneyDisplay(numberSettings)</div><div class="col-6">@L["Average cost before"]: @x.AverageUnitCostBefore.ToMoneyDisplay(numberSettings)</div><div class="col-6">@L["Average cost after"]: @x.AverageUnitCostAfter.ToMoneyDisplay(numberSettings)</div></div></div></div>}</div>
