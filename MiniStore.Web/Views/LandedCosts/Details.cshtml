@model MiniStore.Application.DTOs.Purchases.LandedCostDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@{ViewData["Title"]=Model.CostNumber;var numberSettings=await GeneralSettingsService.GetAsync();}
<div class="d-flex justify-content-between"><h2>@Model.CostNumber</h2><a asp-action="Index" class="btn btn-outline-secondary">@L["Back"]</a></div><div class="card card-body my-3"><div><strong>@L["Goods receipt"]:</strong> @Model.ReceiptNumber</div><div><strong>@L["Warehouse"]:</strong> @Model.WarehouseName</div><div><strong>@L["Date"]:</strong> @Model.CostDate</div><div><strong>@L["External reference"]:</strong> @Model.ExternalReference</div><div><strong>@L["Allocation method"]:</strong> @L[Model.AllocationMethod.ToString()]</div><div><strong>@L["Total"]:</strong> @Model.TotalAmount.ToMoneyDisplay(numberSettings)</div><div><strong>@L["Capitalized amount"]:</strong> @Model.CapitalizedAmount.ToMoneyDisplay(numberSettings)</div><div><strong>@L["Expensed amount"]:</strong> @Model.ExpensedAmount.ToMoneyDisplay(numberSettings)</div></div><h5>@L["Cost components"]</h5><table class="table"><thead><tr><th>@L["Type"]</th><th>@L["Amount"]</th><th>@L["Description"]</th></tr></thead><tbody>@foreach(var x in Model.Components){<tr><td>@L[x.Type.ToString()]</td><td>@x.Amount.ToMoneyDisplay(numberSettings)</td><td>@x.Description</td></tr>}</tbody></table><h5>@L["Allocations"]</h5><table class="table"><thead><tr><th>@L["Product"]</th><th>@L["Allocation basis"]</th><th>@L["Allocated amount"]</th><th>@L["Capitalized amount"]</th><th>@L["Expensed amount"]</th><th>@L["Average cost before"]</th><th>@L["Average cost after"]</th></tr></thead><tbody>@foreach(var x in Model.Allocations){<tr><td>@x.Product</td><td>@x.AllocationBasis.ToQuantityDisplay(numberSettings)</td><td>@x.AllocatedAmount.ToMoneyDisplay(numberSettings)</td><td>@x.CapitalizedAmount.ToMoneyDisplay(numberSettings)</td><td>@x.ExpensedAmount.ToMoneyDisplay(numberSettings)</td><td>@x.AverageUnitCostBefore.ToMoneyDisplay(numberSettings)</td><td>@x.AverageUnitCostAfter.ToMoneyDisplay(numberSettings)</td></tr>}</tbody></table>
