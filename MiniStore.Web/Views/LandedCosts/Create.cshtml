@model MiniStore.Application.DTOs.Purchases.LandedCostCreatePageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@{ViewData["Title"]=L["Allocate landed costs"];var numberSettings=await GeneralSettingsService.GetAsync();}
<h2>@L["Allocate landed costs"]</h2><div class="card card-body mb-3"><div><strong>@L["Goods receipt"]:</strong> @Model.ReceiptNumber</div><div><strong>@L["Purchase order"]:</strong> @Model.OrderNumber</div><div><strong>@L["Supplier"]:</strong> @Model.SupplierName</div><div><strong>@L["Warehouse"]:</strong> @Model.WarehouseName</div></div>
<table class="table table-sm"><thead><tr><th>@L["Product"]</th><th>@L["Stock quantity"]</th><th>@L["Receipt value"]</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.Product</td><td>@x.Quantity.ToQuantityDisplay(numberSettings)</td><td>@x.ReceiptValue.ToMoneyDisplay(numberSettings)</td></tr>}</tbody></table>
<form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Form.GoodsReceiptId" name="GoodsReceiptId"/><div class="row"><div class="col-md-4 mb-3"><label class="form-label">@L["Date"]</label><input asp-for="Form.CostDate" name="CostDate" type="date" class="form-control" required/></div><div class="col-md-4 mb-3"><label class="form-label">@L["External reference"]</label><input asp-for="Form.ExternalReference" name="ExternalReference" maxlength="100" class="form-control" required/></div><div class="col-md-4 mb-3"><label class="form-label">@L["Allocation method"]</label><select asp-for="Form.AllocationMethod" name="AllocationMethod" class="form-select"><option value="1">@L["By quantity"]</option><option value="2">@L["By receipt value"]</option></select></div></div>
<h5>@L["Cost components"]</h5>@for(var i=0;i<Model.Form.Components.Count;i++){<input type="hidden" name="Components[@i].Type" value="@((int)Model.Form.Components[i].Type)"/><div class="row mb-2"><div class="col-md-3"><label class="form-label">@L[Model.Form.Components[i].Type.ToString()]</label></div><div class="col-md-3"><input name="Components[@i].Amount" value="@Model.Form.Components[i].Amount.ToMoneyInput(numberSettings)" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Amount"]"/></div><div class="col-md-6"><input name="Components[@i].Description" value="@Model.Form.Components[i].Description" maxlength="250" class="form-control" placeholder="@L["Description"]"/></div></div>}<div class="mb-3"><label class="form-label">@L["Notes"]</label><textarea asp-for="Form.Notes" name="Notes" maxlength="1000" class="form-control"></textarea></div><button class="btn btn-primary">@L["Post landed cost"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a></form>
