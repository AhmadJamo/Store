@model MiniStore.Application.DTOs.Inventory.Replenishment.ReplenishmentPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Localizer["Replenishment"];var canManage=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:Inventory.Replenishment.Manage")).Succeeded;var canCreateTransfer=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:StockTransfers.Create")).Succeeded;var canCreatePurchaseRequest=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseRequests.Create")).Succeeded;}
<div class="container mt-4"><h2>@Localizer["Replenishment"]</h2><p class="text-muted">@Localizer["Suggestions are reviewed only and never change stock or create documents automatically."]</p>
@if(canManage){<div class="card card-body mb-3"><h5>@Localizer["Replenishment rule"]</h5><form asp-action="Save" method="post" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">@Localizer["Product"]</label><select name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-2"><label class="form-label">@Localizer["Destination warehouse"]</label><select name="WarehouseId" class="form-select" required><option value="">@Localizer["Select warehouse"]</option>@foreach(var x in Model.Warehouses){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-2"><label class="form-label">@Localizer["Preferred source"]</label><select name="PreferredSourceWarehouseId" class="form-select"><option value="">@Localizer["Purchase / no source"]</option>@foreach(var x in Model.Warehouses){<option value="@x.Id">@x.Name</option>}</select></div><div class="col"><label class="form-label">@Localizer["Minimum"]</label><input name="MinimumQuantity" type="number" min="0" step="0.001" class="form-control" required/></div><div class="col"><label class="form-label">@Localizer["Maximum"]</label><input name="MaximumQuantity" type="number" min="0.001" step="0.001" class="form-control" required/></div><div class="col"><label class="form-label">@Localizer["Safety stock"]</label><input name="SafetyStock" type="number" min="0" step="0.001" value="0" class="form-control" required/></div><div class="col"><label class="form-label">@Localizer["Lead days"]</label><input name="LeadTimeDays" type="number" min="0" max="3650" value="0" class="form-control" required/></div><div class="col"><button class="btn btn-primary w-100">@Localizer["Save"]</button></div></form></div>}
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><label class="form-label">@Localizer["Warehouse"]</label><select name="warehouseId" class="form-select"><option value="">@Localizer["All warehouses"]</option>@foreach(var x in Model.Warehouses){<option value="@x.Id" selected="@(Model.WarehouseId==x.Id)">@x.Name</option>}</select></div><div class="col-md-5"><label class="form-label">@Localizer["Product"]</label><input name="search" value="@Model.Search" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><label class="form-check"><input name="exceptionsOnly" value="true" type="checkbox" class="form-check-input"/> @Localizer["Needs replenishment only"]</label></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">@Localizer["Search"]</button></div></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Available"]</th><th>@Localizer["Confirmed incoming"]</th><th>@Localizer["Confirmed outgoing"]</th><th>@Localizer["Projected available"]</th><th>@Localizer["Min / Max"]</th><th>@Localizer["Safety stock"]</th><th>@Localizer["Suggested quantity"]</th><th>@Localizer["Preferred source"]</th><th>@Localizer["Lead days"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>@foreach(var x in Model.Rows){<tr class="@(x.NeedsReplenishment?"table-warning":null)"><td>@x.Product</td><td>@x.Warehouse</td><td>@x.Available.ToString("N3") <small class="text-muted">(@x.Reserved.ToString("N3") @Localizer["Reserved"])</small></td><td class="text-success">@x.ConfirmedIncoming.ToString("N3")</td><td class="text-danger">@x.ConfirmedOutgoing.ToString("N3")</td><td><strong>@x.ProjectedAvailable.ToString("N3")</strong><small class="d-block text-muted">@Localizer["Projected on hand"]: @x.ProjectedOnHand.ToString("N3")</small></td><td>@x.Minimum.ToString("N3") / @x.Maximum.ToString("N3")</td><td>@x.SafetyStock.ToString("N3")</td><td><strong>@(x.NeedsReplenishment?x.SuggestedQuantity.ToString("N3"):"—")</strong></td><td>@(x.SourceWarehouse??Localizer["Purchase / no source"]) @if(x.SourceAvailable.HasValue){<small>(@x.SourceAvailable.Value.ToString("N3"))</small>}</td><td>@x.LeadTimeDays</td><td>@(x.IsActive?Localizer["Active"]:Localizer["Inactive"])</td><td>@if(canManage){<form asp-action="SetActive" method="post" class="mb-1"><input type="hidden" name="id" value="@x.RuleId"/><input type="hidden" name="active" value="@(!x.IsActive)"/><button class="btn btn-sm @(x.IsActive?"btn-outline-danger":"btn-outline-success")">@(x.IsActive?Localizer["Deactivate"]:Localizer["Activate"])</button></form>}@if(x.OpenPurchaseRequestId.HasValue){<a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@x.OpenPurchaseRequestId" class="btn btn-sm btn-outline-secondary">@Localizer["Open purchase request"] @x.OpenPurchaseRequestNumber</a>}else if(canManage&&canCreateTransfer&&x.NeedsReplenishment&&x.SourceWarehouse is not null){<form asp-action="CreateTransferDraft" method="post"><input type="hidden" name="ruleId" value="@x.RuleId"/><button class="btn btn-sm btn-outline-primary">@Localizer["Create transfer draft"]</button></form>}else if(canManage&&canCreatePurchaseRequest&&x.NeedsReplenishment&&x.SourceWarehouse is null){<form asp-action="CreatePurchaseRequestDraft" method="post"><input type="hidden" name="ruleId" value="@x.RuleId"/><button class="btn btn-sm btn-outline-primary">@Localizer["Create purchase request draft"]</button></form>}</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="13" class="text-center text-muted">@Localizer["No replenishment rules found."]</td></tr>}</tbody></table></div></div>
