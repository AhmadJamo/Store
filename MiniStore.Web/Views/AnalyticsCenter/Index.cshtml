@model MiniStore.Application.Dtos.Analytics.AnalyticsCenterPageDto
@using MiniStore.Application.Dtos.Analytics
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = L["Analytics center"]; var settings=await GeneralSettingsService.GetAsync(); var rtl=System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft; string Title(MiniStore.Application.Dtos.Analytics.AnalyticsWidgetDataDto w)=>rtl&&!string.IsNullOrWhiteSpace(w.TitleArabic)?w.TitleArabic:w.Title; string FormatValue(MiniStore.Application.Dtos.Analytics.AnalyticsWidgetDataDto w)=>w.TextValue??(w.ValueFormat switch{AnalyticsValueFormat.Money=>w.Value.GetValueOrDefault().ToMoneyDisplay(settings),AnalyticsValueFormat.Percent=>$"{w.Value.GetValueOrDefault().ToDisplayNumber(settings.DecimalPlaces)}%",_=>w.Value.GetValueOrDefault().ToDisplayNumber(settings.QuantityDecimalPlaces)}); var maxPoints=Model.Dataset.Widgets.SelectMany(x=>x.Points).Select(x=>Math.Abs(x.Value)).DefaultIfEmpty(0).Max(); }
<style>.analytics-grid{display:grid;grid-template-columns:repeat(@Model.LayoutColumns,minmax(0,1fr));gap:1rem}.analytics-widget{min-width:0;border-top:4px solid var(--widget-accent,#2563eb)}.analytics-span-2{grid-column:span 2}.analytics-span-3{grid-column:span 3}.analytics-span-4{grid-column:span 4}.analytics-bar{height:.65rem;background:#e2e8f0;border-radius:999px;overflow:hidden}.analytics-bar>span{display:block;height:100%;background:var(--widget-accent,#2563eb)}@@media(max-width:991.98px){.analytics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.analytics-span-3,.analytics-span-4{grid-column:span 2}}@@media(max-width:575.98px){.analytics-grid{grid-template-columns:1fr}.analytics-widget{grid-column:span 1!important}}</style>
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3"><div><h2 class="mb-1">@L["Analytics center"]</h2><p class="text-muted mb-0">@L[rtl?Model.Module.DescriptionArabic:Model.Module.Description]</p></div>@if((await Authorization.AuthorizeAsync(User,null,"Permission:AnalyticsCenter.Customize")).Succeeded){<a asp-action="Create" class="btn btn-primary">@L["Create analytics workspace"]</a>}</div>
<form method="get" class="card card-body mb-4"><div class="row g-3 align-items-end">
<div class="col-md-6 col-xl-3"><label class="form-label">@L["Workspace"]</label><select name="WorkspaceId" class="form-select"><option value="">@L["Live module view"]</option>@foreach(var x in Model.Workspaces){<option value="@x.Id" selected="@(Model.Workspace?.Id==x.Id)">@(rtl&&!string.IsNullOrWhiteSpace(x.NameArabic)?x.NameArabic:x.Name) · @L[x.Visibility.ToString()]</option>}</select></div>
<div class="col-md-6 col-xl-3"><label class="form-label">@L["Analytics module"]</label><select name="ModuleKey" class="form-select" disabled="@(Model.Workspace is not null)">@foreach(var x in Model.Modules){<option value="@x.Key" selected="@(Model.Module.Key==x.Key)">@L[rtl?x.TitleArabic:x.Title]</option>}</select>@if(Model.Workspace is not null){<input type="hidden" name="ModuleKey" value="@Model.Module.Key" />}</div>
<div class="col-sm-6 col-xl-2"><label class="form-label">@L["From"]</label><input name="From" value="@Model.Query.From?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div><div class="col-sm-6 col-xl-2"><label class="form-label">@L["To"]</label><input name="To" value="@Model.Query.To?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div>
<div class="col-md-6 col-xl-2"><label class="form-label">@L["Group by"]</label><select name="Dimension" class="form-select">@foreach(var x in Model.Module.Dimensions){<option value="@x.Key" selected="@(Model.Query.Dimension==x.Key)">@L[rtl?x.LabelArabic:x.Label]</option>}</select></div>
@foreach(var f in Model.Module.Filters){<div class="col-md-6 col-xl-3"><label class="form-label">@L[rtl?f.LabelArabic:f.Label]</label>@if(f.Options.Count>0){<select class="form-select" name="Filters[@f.Key]"><option value="">@L["All"]</option>@foreach(var o in f.Options){<option value="@o.Value" selected="@(Model.Query.Filters.GetValueOrDefault(f.Key)==o.Value)">@o.Label</option>}</select>}else{<input class="form-control" name="Filters[@f.Key]" value="@Model.Query.Filters.GetValueOrDefault(f.Key)" />}</div>}
<div class="col-12"><button class="btn btn-primary">@L["Apply"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@L["Reset"]</a></div></div></form>
@if(Model.RefreshIntervalMinutes>0){<div class="alert alert-light border">@L["Automatic refresh"]: @Model.RefreshIntervalMinutes @L["minutes"]</div>}
<div class="analytics-grid">@foreach(var w in Model.Dataset.Widgets.OrderBy(x=>x.Sequence)){var span=Math.Min(w.ColumnSpan,Model.LayoutColumns);<section class="card card-body analytics-widget analytics-span-@span" style="--widget-accent:@(w.AccentColor??"#2563EB");grid-row:span @w.RowSpan"><div class="d-flex justify-content-between gap-2"><h3 class="h5">@Title(w)</h3><span class="badge bg-light text-dark">@L[w.Visualization.ToString()]</span></div>
@if(w.Value.HasValue||!string.IsNullOrWhiteSpace(w.TextValue)){<div class="display-6 fw-semibold">@FormatValue(w)</div>@if(!string.IsNullOrWhiteSpace(rtl?w.SecondaryTextArabic:w.SecondaryText)){<small class="text-muted">@(rtl?w.SecondaryTextArabic:w.SecondaryText)</small>}@if(w.ShowComparison&&w.ComparisonValue.HasValue){<div class="small mt-2"><span class="badge @(w.ComparisonDeltaPercent>=0?"bg-success":"bg-danger")">@(w.ComparisonDeltaPercent.HasValue?$"{w.ComparisonDeltaPercent:+0.##;-0.##;0}%":L["New"].Value)</span> @L["Compared with"] @w.ComparisonFrom?.ToString("yyyy-MM-dd") – @w.ComparisonTo?.ToString("yyyy-MM-dd")</div>}@if(w.TargetValue.HasValue){<div class="small mt-2">@L["Target"]: @w.TargetValue.Value.ToDisplayNumber(settings.DecimalPlaces)</div>}}
else if(w.Rows.Count>0){<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr>@foreach(var c in w.Columns){<th>@L[c]</th>}</tr></thead><tbody>@foreach(var row in w.Rows.Take(w.TopN)){<tr>@foreach(var cell in row.Cells){<td>@cell</td>}</tr>}</tbody></table></div>}
else if(w.Points.Count>0){<div class="d-grid gap-2">@foreach(var p in w.Points.Take(w.TopN)){var width=maxPoints==0?0:Math.Clamp(Math.Abs(p.Value)/maxPoints*100,0,100);<div><div class="d-flex justify-content-between gap-2"><span>@L[p.Label]</span><strong>@(w.ValueFormat==AnalyticsValueFormat.Money?p.Value.ToMoneyDisplay(settings):p.Value.ToDisplayNumber(settings.QuantityDecimalPlaces))</strong></div><div class="analytics-bar"><span style="width:@width.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></span></div></div>}</div>}
@if(Model.ShowDefinitions&&!string.IsNullOrWhiteSpace(rtl?w.DefinitionArabic:w.Definition)){<p class="small text-muted mt-3 mb-0">@L[rtl?w.DefinitionArabic!:w.Definition!]</p>}</section>}</div>
@if(Model.RefreshIntervalMinutes>0){<script nonce="@Context.Items["CspNonce"]">window.setTimeout(()=>window.location.reload(),@(Model.RefreshIntervalMinutes*60000));</script>}
