@model MiniStore.Application.Dtos.Accounting.JournalEntryDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Model.EntryNumber; var settings = await GeneralSettingsService.GetAsync(); }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h2 class="mb-1">@Model.EntryNumber</h2><span class="badge @(Model.Status == MiniStore.Domain.Entities.JournalEntryStatus.Posted ? "bg-success" : "bg-secondary")">@Localizer[Model.Status.ToString()]</span></div>
    <button type="button" class="btn btn-outline-secondary" onclick="history.back()">@Localizer["Back"]</button>
</div>
<div class="card card-body mb-3"><div class="row g-3">
    <div class="col-md-4"><span class="text-muted">@Localizer["Posting date"]</span><div>@Model.Date.ToString(settings.DateFormat)</div></div>
    <div class="col-md-4"><span class="text-muted">@Localizer["Source type"]</span><div>@Model.SourceType</div></div>
    <div class="col-md-4"><span class="text-muted">@Localizer["Source reference"]</span><div>@Model.SourceReference</div></div>
    @if(Model.Description is not null){<div class="col-12"><span class="text-muted">@Localizer["Description"]</span><div>@Model.Description</div></div>}
</div></div>
<div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><strong>@line.AccountDisplay</strong>@if(line.BranchName is not null){<div class="small text-muted mt-1">@Localizer["Branch"]: @line.BranchName@if(line.WarehouseName is not null){<span> · @Localizer["Warehouse"]: @line.WarehouseName</span>}</div>}<div class="row g-2 mt-2"><div class="col-6"><span class="text-muted">@Localizer["Debit"]</span><div>@line.Debit.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Credit"]</span><div>@line.Credit.ToMoneyDisplay(settings)</div></div></div>@if(line.Description is not null){<div class="small mt-2">@line.Description</div>}</div></div></div>}</div>
<div class="card card-body mt-3"><div class="row text-center"><div class="col-6"><span class="text-muted">@Localizer["Total debit"]</span><div class="fs-5">@Model.TotalDebit.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Total credit"]</span><div class="fs-5">@Model.TotalCredit.ToMoneyDisplay(settings)</div></div></div></div>
