@using MiniStore.Domain.Entities
@model MiniStore.Application.Dtos.Accounting.CreateAccountDto
@{ ViewData["Title"] = "Add Account"; var accounts = ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4"><h2>Add Account</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Code"></label><input asp-for="Code" class="form-control" /></div><div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div><div class="mb-3"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<AccountType>()" class="form-select"></select></div><div class="mb-3"><label asp-for="ParentAccountId">Parent account</label><select asp-for="ParentAccountId" class="form-select"><option value="">Top-level account</option>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select></div><button class="btn btn-primary">Save</button></form></div>
