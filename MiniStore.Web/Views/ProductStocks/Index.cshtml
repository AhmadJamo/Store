@model List<MiniStore.Application.DTOs.ProductStocks.ProductStockDto>

@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{
    ViewData["Title"] = "Stock";
}

<h1>Stock</h1>

<p class="text-muted">
    @Model.Count stock record(s) found.
</p>

<p>
    @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "ProductStock.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Stock
        </a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Product</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>@Localizer["Average unit cost"]</th>
            <th>@Localizer["Inventory value"]</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="7"
                    class="text-center text-muted">
                    No stock records found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var stock in Model)
            {
                <tr>
                    <td>
                        @stock.Id
                    </td>

                    <td>@stock.AverageUnitCost.ToString("0.########")</td>
                    <td>@stock.InventoryValue.ToString("0.########")</td>

                    <td>
                        @stock.ProductName
                    </td>

                    <td>
                        @stock.WarehouseName
                    </td>

                    <td>
                        @if (stock.Quantity < 0)
                        {
                            <span class="text-danger fw-bold">@stock.Quantity</span>
                            <span class="badge bg-danger ms-1">@Localizer["Requires reconciliation"]</span>
                        }
                        else
                        {
                            @stock.Quantity
                        }
                    </td>

                    <td>

                        @if (await PermissionService.CanAsync(
                       User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                       "ProductStock.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@stock.Id"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
                     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                     "ProductStock.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline" asp-route-id="@stock.Id" onsubmit="return confirm('Are you sure you want to delete this item?');">
<button type="submit" class="btn btn-sm btn-danger">Delete</button></form>
                        }

                    </td>
                </tr>
            }
        }

    </tbody>

</table>
