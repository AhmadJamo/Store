@model MiniStore.Application.DTOs.ProductStocks.CreateProductStockDto

@{
    ViewData["Title"] = "Create Stock";
}

<h1>Create Stock</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">

        <label asp-for="ProductId"
               class="form-label">
            Product
        </label>

        <select asp-for="ProductId"
                class="form-select">

            <option value="">
                -- Select Product --
            </option>

            @foreach (var product in ViewBag.Products)
            {
                <option value="@product.Id">
                    @product.Name
                </option>
            }

        </select>

        <span asp-validation-for="ProductId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="WarehouseId"
               class="form-label">
            Warehouse
        </label>

        <select asp-for="WarehouseId"
                class="form-select">

            <option value="">
                -- Select Warehouse --
            </option>

            @foreach (var warehouse in ViewBag.Warehouses)
            {
                <option value="@warehouse.Id">
                    @warehouse.Name
                </option>
            }

        </select>

        <span asp-validation-for="WarehouseId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Quantity"
               class="form-label">
            Quantity
        </label>

        <input asp-for="Quantity"
               type="number"
               step="0.001"
               class="form-control" />

        <span asp-validation-for="Quantity"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>