@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model MiniStore.Application.DTOs.ProductStocks.UpdateProductStockDto

@{
    ViewData["Title"] = "Edit Stock";
}

<h1>@Localizer["Edit Stock"]</h1>

<div class="mb-3">

    <label class="form-label">
        @Localizer["Product"]
    </label>

    <input type="text"
           class="form-control"
           value="@ViewBag.ProductName"
           disabled />

</div>

<div class="mb-3">

    <label class="form-label">
        @Localizer["Warehouse"]
    </label>

    <input type="text"
           class="form-control"
           value="@ViewBag.WarehouseName"
           disabled />

</div>

<form asp-action="Edit"
      method="post">

    <div class="mb-3">

        <label asp-for="Quantity"
               class="form-label">
            @Localizer["Quantity"]
        </label>

        <input asp-for="Quantity"
               type="number"
               step="0.001"
               class="form-control" />

        <span asp-validation-for="Quantity"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        @Localizer["Save Changes"]
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        @Localizer["Cancel"]
    </a>

</form>