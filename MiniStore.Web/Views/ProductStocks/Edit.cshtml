@model MiniStore.Application.DTOs.ProductStocks.UpdateProductStockDto

@{
    ViewData["Title"] = "Edit Stock";
}

<h1>Edit Stock</h1>

<div class="mb-3">

    <label class="form-label">
        Product
    </label>

    <input type="text"
           class="form-control"
           value="@ViewBag.ProductName"
           disabled />

</div>

<div class="mb-3">

    <label class="form-label">
        Warehouse
    </label>

    <input type="text"
           class="form-control"
           value="@ViewBag.WarehouseName"
           disabled />

</div>

<form asp-action="Edit"
      method="post">

    <div class="mb-3">

        <label asp-for="Quantity"
               class="form-label">
            Quantity
        </label>

        <input asp-for="Quantity"
               type="number"
               step="0.001"
               class="form-control" />

        <span asp-validation-for="Quantity"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>