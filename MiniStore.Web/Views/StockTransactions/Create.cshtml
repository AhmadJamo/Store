@model MiniStore.Application.DTOs.ProductStocks.CreateStockTransactionDto

@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{
    ViewData["Title"] = "Create Stock Transaction";
}

<h1>@Localizer["Create Stock Transaction"]</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">

        <label asp-for="ProductId"
               class="form-label">
            @Localizer["Product"]
        </label>

        <select asp-for="ProductId"
                class="form-select">

            <option value="">
                -- Select Product --
            </option>

            @foreach (var product in ViewBag.Products)
            {
                <option value="@product.Id">
                    @product.Name
                </option>
            }

        </select>

        <span asp-validation-for="ProductId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="WarehouseId"
               class="form-label">
            @Localizer["Warehouse"]
        </label>

        <select asp-for="WarehouseId"
                class="form-select">

            <option value="">
                -- Select Warehouse --
            </option>

            @foreach (var warehouse in ViewBag.Warehouses)
            {
                <option value="@warehouse.Id">
                    @warehouse.Name
                </option>
            }

        </select>

        <span asp-validation-for="WarehouseId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Type"
               class="form-label">
            @Localizer["Transaction Type"]
        </label>

        <select asp-for="Type"
                class="form-select">

            <option value="">
                -- Select Type --
            </option>

            <option value="6">
                @Localizer["Adjustment In"]
            </option>

            <option value="7">
                @Localizer["Adjustment Out"]
            </option>

            <option value="8">
                @Localizer["Kitchen waste or recipe variance"]
            </option>

        </select>

        <span asp-validation-for="Type"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Quantity"
               class="form-label">
            @Localizer["Quantity"]
        </label>

        <input asp-for="Quantity"
               type="number"
               step="0.001"
               class="form-control"
               placeholder="@Localizer["Example: 10"]" />

        <div class="form-text">
            Enter the quantity as a positive number.
            Choose whether the adjustment increases or decreases stock.
            @Localizer["Kitchen variance may create a controlled negative balance only when enabled on the ingredient."]
        </div>

        <span asp-validation-for="Quantity"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Reference"
               class="form-label">
            @Localizer["Adjustment reason"]
        </label>

        <input asp-for="Reference"
               class="form-control"
               required
               placeholder="@Localizer["Example: Physical count correction"]" />

        <span asp-validation-for="Reference"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        @Localizer["Save"]
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        @Localizer["Cancel"]
    </a>

</form>
