@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ var accounts=ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; var branches=ViewBag.Branches as List<MiniStore.Domain.Entities.Branch> ?? []; }
<div class="container mt-4"><h2>@Localizer["Branch Sales Accounts"]</h2><p class="text-muted">@Localizer["Link each branch to its dedicated sales-revenue subaccount."]</p><table class="table"><thead><tr><th>@Localizer["Branch"]</th><th>@Localizer["Sales revenue subaccount"]</th><th></th></tr></thead><tbody>@foreach(var branch in branches){<tr><td>@branch.Code — @branch.Name</td><td><form asp-action="BranchSalesAccounts" method="post" class="d-flex gap-2"><input type="hidden" name="branchId" value="@branch.Id" /><select name="accountId" class="form-select" required><option value="">@Localizer["Select account"]</option>@foreach(var account in accounts){<option value="@account.Id" selected="@(branch.SalesRevenueAccountId==account.Id)">@account.Code — @account.Name</option>}</select><button class="btn btn-primary">@Localizer["Save"]</button></form></td></tr>}</tbody></table><a asp-action="Accounting" class="btn btn-secondary">@Localizer["Back"]</a></div>
