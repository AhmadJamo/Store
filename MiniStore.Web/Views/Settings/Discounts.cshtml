@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model MiniStore.Application.Dtos.Settings.DiscountSettingsDto

@{
    ViewData["Title"] = "Discount Settings";
}

<div class="container-fluid">

    ```
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Localizer["Discount Settings"]</h2>
            <p class="text-muted mb-0">
                @Localizer["Configure how discounts are allowed and controlled in the system."]
            </p>
        </div>
    </div>

    <form asp-action="Discounts" method="post">

        <input asp-for="RowVersion" type="hidden" />

        <!-- General -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["General"]</h5>
            </div>

            <div class="card-body">

                <div class="form-check form-switch">
                    <input asp-for="Enabled"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Enabled" class="form-check-label">
                        @Localizer["Enable Discounts"]
                    </label>
                </div>

            </div>
        </div>

        <!-- Where discounts can be applied -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["Discount Application"]</h5>
            </div>

            <div class="card-body">

                <div class="form-check mb-3">
                    <input asp-for="AllowLineDiscount"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AllowLineDiscount"
                           class="form-check-label">
                        @Localizer["Allow Line Discount"]
                    </label>

                    <div class="form-text">
                        @Localizer["Allow discount to be applied to individual sale items."]
                    </div>
                </div>

                <div class="form-check">
                    <input asp-for="AllowInvoiceDiscount"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AllowInvoiceDiscount"
                           class="form-check-label">
                        @Localizer["Allow Invoice Discount"]
                    </label>

                    <div class="form-text">
                        @Localizer["Allow discount to be applied to the entire invoice."]
                    </div>
                </div>

            </div>
        </div>

        <!-- Discount Types -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["Discount Types"]</h5>
            </div>

            <div class="card-body">

                <div class="form-check mb-3">
                    <input asp-for="AllowPercentageDiscount"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AllowPercentageDiscount"
                           class="form-check-label">
                        @Localizer["Percentage Discount"]
                    </label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="AllowFixedAmountDiscount"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AllowFixedAmountDiscount"
                           class="form-check-label">
                        @Localizer["Fixed Amount Discount"]
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="DefaultDiscountType"
                           class="form-label">
                        @Localizer["Default Discount Type"]
                    </label>

                    <select asp-for="DefaultDiscountType"
                            class="form-select">

                        <option value="1">@Localizer["Percentage"]</option>
                        <option value="2">@Localizer["Fixed Amount"]</option>

                    </select>

                    <div class="form-text">
                        @Localizer["This type will be selected by default when creating a discount."]
                    </div>
                </div>

            </div>
        </div>

        <!-- Line Discount Limits -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["Line Discount Limits"]</h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxLineDiscountPercent"
                               class="form-label">
                            @Localizer["Maximum Line Discount %"]
                        </label>

                        <input asp-for="MaxLineDiscountPercent"
                               class="form-control"
                               type="number"
                               min="0"
                               max="100"
                               step="0.01" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxLineDiscountAmount"
                               class="form-label">
                            @Localizer["Maximum Line Discount Amount"]
                        </label>

                        <input asp-for="MaxLineDiscountAmount"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01" />
                    </div>

                </div>

            </div>
        </div>

        <!-- Invoice Discount Limits -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["Invoice Discount Limits"]</h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxInvoiceDiscountPercent"
                               class="form-label">
                            @Localizer["Maximum Invoice Discount %"]
                        </label>

                        <input asp-for="MaxInvoiceDiscountPercent"
                               class="form-control"
                               type="number"
                               min="0"
                               max="100"
                               step="0.01" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxInvoiceDiscountAmount"
                               class="form-label">
                            @Localizer["Maximum Invoice Discount Amount"]
                        </label>

                        <input asp-for="MaxInvoiceDiscountAmount"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01" />
                    </div>

                </div>

            </div>
        </div>

        <!-- Override -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">@Localizer["Discount Override"]</h5>
            </div>

            <div class="card-body">

                <div class="form-check mb-3">
                    <input asp-for="AllowDiscountAboveLimit"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="AllowDiscountAboveLimit"
                           class="form-check-label">
                        @Localizer["Allow Discount Above Limit"]
                    </label>

                    <div class="form-text">
                        @Localizer["Users with the configured permission can exceed the normal discount limits."]
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DiscountOverridePermission"
                           class="form-label">
                        @Localizer["Override Permission"]
                    </label>

                    <input asp-for="DiscountOverridePermission"
                           class="form-control" />

                    <div class="form-text">
                        @Localizer["Permission required to exceed the configured discount limits."]
                    </div>
                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Save"]
            </button>

            <a asp-controller="Settings"
               asp-action="Index"
               class="btn btn-secondary">
                @Localizer["Cancel"]
            </a>

        </div>

    </form>
    ```

</div>
