@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{
    ViewData["Title"] = "Settings";
    var cards = new[]
    {
        new { Icon = "🏢", Title = "General", Description = "Company information, currency, language and general system settings.", Controller = "Settings", Action = "General", Button = "Open Settings", Disabled = false },
        new { Icon = "🔢", Title = "Numbering", Description = "Configure centralized numbering for sales, transfers and accounting entries.", Controller = "Settings", Action = "DocumentNumbers", Button = "Open Settings", Disabled = false },
        new { Icon = "📒", Title = "Accounting", Description = "Choose the chart accounts used for discounts, revenue and cost of sales.", Controller = "Settings", Action = "Accounting", Button = "Open Settings", Disabled = false },
        new { Icon = "🏷️", Title = "Discounts", Description = "Configure discount types, limits and permissions.", Controller = "Settings", Action = "Discounts", Button = "Open Settings", Disabled = false },
        new { Icon = "🧮", Title = "Taxes", Description = "Configure tax rates, tax profiles and tax calculation rules.", Controller = "TaxRates", Action = "Index", Button = "Manage Taxes", Disabled = false },
        new { Icon = "📦", Title = "Inventory", Description = "Configure stock behavior, costing and inventory rules.", Controller = "Settings", Action = "Inventory", Button = "Open Settings", Disabled = false },
        new { Icon = "🛒", Title = "POS Experience", Description = "Choose a business profile and customize each terminal's layout.", Controller = "Settings", Action = "Pos", Button = "Open Settings", Disabled = false },
        new { Icon = "💳", Title = "Payments", Description = "Configure cash, card, bank transfer and credit payments.", Controller = "PaymentMethods", Action = "Index", Button = "Manage Payment Methods", Disabled = false },
        new { Icon = "🖨️", Title = "Printing", Description = "Configure invoice formats, paper sizes and printing behavior.", Controller = "", Action = "", Button = "Coming Soon", Disabled = true },
        new { Icon = "🔐", Title = "Security", Description = "Configure security, sessions and access rules.", Controller = "", Action = "", Button = "Coming Soon", Disabled = true },
        new { Icon = "📋", Title = "Audit", Description = "Configure system activity and audit logging.", Controller = "", Action = "", Button = "Coming Soon", Disabled = true }
    };
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="mb-1">⚙️ @Localizer["Settings"]</h2>
        <p class="text-muted mb-0">@Localizer["Manage system configuration and business rules."]</p>
    </div>

    <div class="row g-4">
        @foreach (var card in cards)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@card.Icon @Localizer[card.Title]</h5>
                        <p class="card-text text-muted flex-grow-1">@Localizer[card.Description]</p>
                        @if (card.Disabled)
                        {
                            <button class="btn btn-outline-primary align-self-start" disabled>@Localizer[card.Button]</button>
                        }
                        else
                        {
                            <a asp-controller="@card.Controller" asp-action="@card.Action" class="btn btn-primary align-self-start">@Localizer[card.Button]</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
