@model MiniStore.Application.Dtos.Settings.AccountingSettingsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = "Accounting Posting Settings"; var accounts = ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4">
    <h2>Accounting Posting Settings</h2>
    <p class="text-muted">Choose the chart-of-account destinations used when sales and purchases are posted. Tax accounts are set separately on each tax rate.</p>
    <form asp-action="Accounting" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="card mb-3"><div class="card-body"><h5>@Localizer["Customer receivable policy"]</h5><p class="text-muted">@Localizer["Choose how customer receivable accounts are assigned. The policy applies to future customers and never rewrites posted history."]</p>
            <div class="mb-3"><label asp-for="CustomerReceivableAccountMode" class="form-label">@Localizer["Receivable account mode"] <span title="@Localizer["Shared uses one control account; automatic creates a subaccount; manual asks during customer creation."]" role="img" aria-label="@Localizer["Help"]">❔</span></label><select asp-for="CustomerReceivableAccountMode" class="form-select"><option value="">@Localizer["Legacy manual behavior"]</option><option value="1">@Localizer["Shared control account"]</option><option value="2">@Localizer["Automatic individual account"]</option><option value="3">@Localizer["Manual account selection"]</option></select></div>
            <div class="row g-3"><div class="col-lg-6"><label asp-for="CustomerReceivableControlAccountId" class="form-label">@Localizer["Shared receivable control account"]</label><select asp-for="CustomerReceivableControlAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select><div class="form-text">@Localizer["Used by all future customers in shared-control mode; customer detail remains in the subledger."]</div></div>
            <div class="col-lg-6"><label asp-for="CustomerReceivableParentAccountId" class="form-label">@Localizer["Parent account for automatic customer accounts"]</label><select asp-for="CustomerReceivableParentAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select><div class="form-text">@Localizer["New individual customer accounts are created below this active asset account."]</div></div>
            <div class="col-md-6"><label asp-for="CustomerAccountCodePrefix" class="form-label">@Localizer["Automatic account code prefix"]</label><input asp-for="CustomerAccountCodePrefix" class="form-control"/><div class="form-text">@Localizer["Example: CUST-CUS-000123."]</div></div>
            <div class="col-md-6"><label asp-for="CustomerPolicyEffectiveFrom" class="form-label">@Localizer["Effective from"]</label><input asp-for="CustomerPolicyEffectiveFrom" type="date" class="form-control"/><div class="form-text">@Localizer["Existing customer accounts and posted documents remain unchanged."]</div></div></div>
        </div></div>
        <div class="card mb-3"><div class="card-body"><h5>@Localizer["Customer invoicing policy"]</h5>
            <label asp-for="SalesInvoiceQuantityPolicy" class="form-label">@Localizer["Invoice quantity basis"] <span title="@Localizer["Delivered quantity is the safe default for stocked products; ordered quantity permits invoicing before delivery. Services are invoiced from ordered quantity in both modes."]" role="img" aria-label="@Localizer["Help"]">❔</span></label>
            <select asp-for="SalesInvoiceQuantityPolicy" class="form-select"><option value="1">@Localizer["Delivered quantity"]</option><option value="2">@Localizer["Ordered quantity"]</option></select>
        </div></div>
        <div class="card mb-3"><div class="card-body"><h5>Discount accounts</h5>
            <div class="mb-3"><label asp-for="PurchaseDiscountAccountId" class="form-label">Purchase discount account</label><select asp-for="PurchaseDiscountAccountId" class="form-select"><option value="">Not configured</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">Used for supplier discounts when purchase posting is enabled.</div></div>
            <div class="mb-3"><label asp-for="SalesDiscountAccountId" class="form-label">Sales discount account</label><select asp-for="SalesDiscountAccountId" class="form-select"><option value="">Not configured</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">Used for line and invoice discounts when sale posting is enabled.</div></div>
        </div></div>
        <div class="card mb-3"><div class="card-body"><h5>Sales and inventory accounts</h5>
            <div class="mb-3"><label asp-for="SalesRevenueAccountId" class="form-label">Sales revenue account</label><select asp-for="SalesRevenueAccountId" class="form-select"><option value="">Not configured</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select></div>
            <div class="mb-3"><label asp-for="CostOfSalesAccountId" class="form-label">Cost of sales account</label><select asp-for="CostOfSalesAccountId" class="form-select"><option value="">Not configured</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select></div>
            <div class="mb-3"><label asp-for="GoodsReceivedNotInvoicedAccountId" class="form-label">@Localizer["Goods received not invoiced account"]</label><select asp-for="GoodsReceivedNotInvoicedAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">@Localizer["Credited when a new purchase-order goods receipt increases inventory."]</div></div>
            <div class="mb-3"><label asp-for="PurchasePriceVarianceAccountId" class="form-label">@Localizer["Purchase price variance account"]</label><select asp-for="PurchasePriceVarianceAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">@Localizer["Used when returned inventory cost differs from its original receipt value."]</div></div>
            <div class="mb-3"><label asp-for="LandedCostClearingAccountId" class="form-label">@Localizer["Landed cost clearing account"]</label><select asp-for="LandedCostClearingAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">@Localizer["Credited when landed costs are allocated to received inventory."]</div></div>
            <div class="mb-3"><label asp-for="RealizedExchangeGainAccountId" class="form-label">@Localizer["Realized exchange gain account"]</label><select asp-for="RealizedExchangeGainAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">@Localizer["Credited when paying a foreign supplier costs less in company currency than the payable carrying amount."]</div></div>
            <div class="mb-3"><label asp-for="RealizedExchangeLossAccountId" class="form-label">@Localizer["Realized exchange loss account"]</label><select asp-for="RealizedExchangeLossAccountId" class="form-select"><option value="">@Localizer["Not configured"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select><div class="form-text">@Localizer["Debited when paying a foreign supplier costs more in company currency than the payable carrying amount."]</div></div>
        </div></div>
        <button type="submit" class="btn btn-primary">Save accounting settings</button>
        <a asp-action="BranchSalesAccounts" class="btn btn-outline-primary">Branch sales accounts</a>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
