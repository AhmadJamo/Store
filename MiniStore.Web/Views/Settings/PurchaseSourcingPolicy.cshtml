@model MiniStore.Application.Dtos.Settings.PurchaseSourcingPolicyDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Purchase sourcing policy"]; }
<div class="container mt-4"><h2>@Localizer["Purchase sourcing policy"]</h2><p class="text-muted">@Localizer["Choose when a user may send an RFQ directly and when the full purchase request approval path is mandatory."]</p><form asp-action="PurchaseSourcingPolicy" method="post"><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-check form-switch mb-3"><input asp-for="AllowDirectRfq" class="form-check-input" /><label asp-for="AllowDirectRfq" class="form-check-label">@Localizer["Allow direct RFQ fast path"]</label></div><div class="row g-3"><div class="col-md-6"><label asp-for="MaximumEstimatedAmountCompanyCurrency" class="form-label">@Localizer["Maximum estimated direct RFQ amount"] (@Model.CompanyCurrencyCode)</label><input asp-for="MaximumEstimatedAmountCompanyCurrency" type="number" min="0" step="0.000001" class="form-control" /><div class="form-text">@Localizer["Amounts above this limit must use a purchase request and approval."]</div></div><div class="col-md-6"><label asp-for="AllowedRoleName" class="form-label">@Localizer["Required user role"]</label><select asp-for="AllowedRoleName" class="form-select"><option value="">@Localizer["Any user with direct RFQ permission"]</option>@foreach(var role in Model.AvailableRoles){<option value="@role">@role</option>}</select></div></div><div class="form-check mt-3"><input asp-for="RequireActiveSuppliers" class="form-check-input" /><label asp-for="RequireActiveSuppliers" class="form-check-label">@Localizer["Allow active suppliers only"]</label></div><div class="alert alert-info mt-3">@Localizer["The direct RFQ permission, amount limit, optional role and supplier status are checked again on the server before sending."]</div><button class="btn btn-primary">@Localizer["Save"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></form></div>
