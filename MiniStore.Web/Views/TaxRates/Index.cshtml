@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model List<MiniStore.Domain.Entities.TaxRate>
<div class="container mt-4"><div class="d-flex justify-content-between"><h2>@Localizer["Tax Rates"]</h2><a asp-action="Create" class="btn btn-primary">@Localizer["Add Tax Rate"]</a></div><table class="table mt-3"><thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Rate"]</th><th>@Localizer["Price inclusive"]</th></tr></thead><tbody>@foreach(var tax in Model){<tr><td>@tax.Name</td><td>@tax.Rate%</td><td>@tax.IsPriceInclusive</td></tr>}</tbody></table></div>
