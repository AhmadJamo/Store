@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ var accounts=ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4"><h2>@Localizer["Add Tax Rate"]</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>@Localizer["Name"]</label><input name="name" class="form-control" required /></div><div class="mb-3"><label>@Localizer["Rate %"]</label><input name="rate" type="number" step="0.01" class="form-control" required /></div><div class="mb-3"><label>@Localizer["Output tax account"]</label><select name="outputAccountId" class="form-select" required>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select></div><div class="mb-3"><label>@Localizer["Input tax account"]</label><select name="inputAccountId" class="form-select" required>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select></div><div class="form-check"><input name="isPriceInclusive" value="true" type="checkbox" class="form-check-input" /><label class="form-check-label">@Localizer["Prices include tax"]</label></div><button class="btn btn-primary mt-3">@Localizer["Save"]</button></form></div>
