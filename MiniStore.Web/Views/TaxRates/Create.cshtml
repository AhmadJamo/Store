@{ var accounts=ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4"><h2>Add Tax Rate</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>Name</label><input name="name" class="form-control" required /></div><div class="mb-3"><label>Rate %</label><input name="rate" type="number" step="0.01" class="form-control" required /></div><div class="mb-3"><label>Output tax account</label><select name="outputAccountId" class="form-select" required>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select></div><div class="mb-3"><label>Input tax account</label><select name="inputAccountId" class="form-select" required>@foreach(var account in accounts){<option value="@account.Id">@account.Code — @account.Name</option>}</select></div><div class="form-check"><input name="isPriceInclusive" value="true" type="checkbox" class="form-check-input" /><label class="form-check-label">Prices include tax</label></div><button class="btn btn-primary mt-3">Save</button></form></div>
