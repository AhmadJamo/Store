@model MiniStore.Application.DTOs.Purchases.SupplierPurchasingInfoPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Supplier purchasing data"];
    var canManage = await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System", "Purchases.SupplierTerms.Manage");
    var numberSettings = await GeneralSettingsService.GetAsync();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div><h2>@Localizer["Supplier purchasing data"]</h2><p class="text-muted mb-0">@Localizer["Choose one supplier, manage several products, then save them together."]</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-action="PriceExceptions" class="btn btn-outline-warning">@Localizer["Price exceptions"] <span class="badge text-bg-warning">@Model.PriceExceptionCount</span></a>@if(Model.SelectedSupplierId.HasValue){<a asp-action="ExportCsv" asp-route-supplierId="@Model.SelectedSupplierId" class="btn btn-outline-primary">@Localizer["Download CSV template"]</a>}<a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back to suppliers"]</a></div>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-6"><label for="supplierId" class="form-label">@Localizer["Supplier"]</label><select id="supplierId" name="supplierId" class="form-select" required><option value="">@Localizer["Select supplier"]</option>@foreach(var supplier in Model.Suppliers){<option value="@supplier.Id" selected="@(Model.SelectedSupplierId==supplier.Id)">@supplier.Label</option>}</select></div>
        <div class="col-lg-3"><button class="btn btn-primary w-100">@Localizer["Load supplier products"]</button></div>
    </div>
</form>

@if(!Model.SelectedSupplierId.HasValue)
{
    <div class="alert alert-info">@Localizer["Select a supplier to manage purchasing data for multiple products."]</div>
}
else if(canManage)
{
    <div class="card card-body mb-4">
        <div><h3 class="h5 mb-1">@Localizer["CSV import and export"]</h3><p class="text-muted mb-0">@Localizer["Download the current supplier rows as a template, edit them, then preview every row before importing."]</p></div>
        <form asp-action="PreviewCsv" method="post" enctype="multipart/form-data" class="row g-3 align-items-end mt-1">
            <input type="hidden" name="supplierId" value="@Model.SelectedSupplierId"/>
            <div class="col-lg-8"><label for="csvFile" class="form-label">@Localizer["Supplier purchasing CSV file"]</label><input id="csvFile" name="csvFile" type="file" accept=".csv,text/csv" class="form-control" required/><div class="form-text">@Localizer["Maximum 500 rows and 1 MB. Dates must use yyyy-MM-dd."]</div></div>
            <div class="col-lg-4"><button class="btn btn-primary w-100">@Localizer["Preview import"]</button></div>
        </form>
    </div>
    @if(Model.BulkForm.Rows.Count == 0)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@Localizer["No products are assigned to this supplier. Assign products from the supplier or product page first."]</span>
            <a asp-controller="Suppliers" asp-action="Edit" asp-route-id="@Model.SelectedSupplierId" class="btn btn-sm btn-primary">@Localizer["Edit supplier products"]</a>
        </div>
    }
    else
    {
    <form asp-action="SaveBulk" method="post" id="bulk-purchasing-form">
        <input type="hidden" asp-for="BulkForm.SupplierId" />
        <div class="card mb-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div><strong>@Localizer["Bulk product management"]</strong><div class="small text-muted">@Localizer["Select only the rows you want to save. Changing a field selects its row automatically."]</div></div>
                <div class="d-flex flex-wrap gap-2"><input id="product-filter" type="search" class="form-control" placeholder="@Localizer["Search products"]" style="max-width:240px"/><button type="button" id="select-visible" class="btn btn-outline-primary">@Localizer["Select visible"]</button><button type="button" id="clear-selection" class="btn btn-outline-secondary">@Localizer["Clear selection"]</button></div>
            </div>
            <div class="card-body bg-body-tertiary" id="bulk-products-list">
                @for(var i=0;i<Model.BulkForm.Rows.Count;i++)
                {
                    var row=Model.BulkForm.Rows[i];
                    <section class="card mb-3 product-row" data-product="@($"{row.ProductCode} {row.ProductName}".ToLowerInvariant())">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="form-check m-0"><input type="checkbox" asp-for="BulkForm.Rows[i].Selected" class="form-check-input row-selector"/><label asp-for="BulkForm.Rows[i].Selected" class="form-check-label fw-semibold"><code>@row.ProductCode</code> — @row.ProductName</label></div>
                            @if(row.Id>0){<span class="badge @(row.IsActive?"bg-success":"bg-secondary")">@(row.IsActive?Localizer["Saved"]:Localizer["Inactive"])</span>}
                            <input type="hidden" asp-for="BulkForm.Rows[i].Id"/><input type="hidden" asp-for="BulkForm.Rows[i].ProductId"/><input type="hidden" name="BulkForm.Rows[@i].CurrencyCode" value="@Model.BaseCurrency"/><input type="hidden" name="BulkForm.Rows[@i].RowVersion" value="@Convert.ToBase64String(row.RowVersion)"/>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].SupplierProductCode" class="form-label">@Localizer["Supplier product code"]</label><input asp-for="BulkForm.Rows[i].SupplierProductCode" class="form-control bulk-field" maxlength="100" required/></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].PurchaseMeasurementUnitId" class="form-label">@Localizer["Purchase unit"]</label><select asp-for="BulkForm.Rows[i].PurchaseMeasurementUnitId" class="form-select bulk-field">@foreach(var unit in row.UnitOptions){<option value="@unit.Id">@unit.Label</option>}</select></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].MinimumOrderQuantity" class="form-label">@Localizer["Minimum order quantity"]</label><input asp-for="BulkForm.Rows[i].MinimumOrderQuantity" value="@row.MinimumOrderQuantity.ToQuantityInput(numberSettings)" type="number" min="0.000001" step="0.000001" class="form-control bulk-field" required/></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].OrderMultiple" class="form-label">@Localizer["Order in multiples of"]</label> <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 align-baseline" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["Example: 6 means order 6, 12, 18 and so on."]" aria-label="@Localizer["Show explanation"]"><span class="badge rounded-pill text-bg-light border text-secondary">?</span></button><input asp-for="BulkForm.Rows[i].OrderMultiple" value="@row.OrderMultiple.ToQuantityInput(numberSettings)" type="number" min="0.000001" step="0.000001" class="form-control bulk-field" required/></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].UnitPrice" class="form-label">@Localizer["Supplier unit price"]</label><div class="input-group"><input asp-for="BulkForm.Rows[i].UnitPrice" value="@row.UnitPrice.ToMoneyInput(numberSettings)" type="number" min="0" step="0.0001" class="form-control bulk-field" required/><span class="input-group-text">@Model.BaseCurrency</span></div></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].LeadTimeDays" class="form-label">@Localizer["Supply lead time (days)"]</label> <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 align-baseline" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["Expected days from sending the purchase order until goods arrive."]" aria-label="@Localizer["Show explanation"]"><span class="badge rounded-pill text-bg-light border text-secondary">?</span></button><input asp-for="BulkForm.Rows[i].LeadTimeDays" type="number" min="0" max="3650" class="form-control bulk-field" required/></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].Priority" class="form-label">@Localizer["Selection order"]</label> <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 align-baseline" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["A lower number is selected first."]" aria-label="@Localizer["Show explanation"]"><span class="badge rounded-pill text-bg-light border text-secondary">?</span></button><input asp-for="BulkForm.Rows[i].Priority" type="number" min="0" max="9999" class="form-control bulk-field"/></div>
                                <div class="col-md-6 col-xl-3 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="BulkForm.Rows[i].IsPreferred" class="form-check-input bulk-field"/><label asp-for="BulkForm.Rows[i].IsPreferred" class="form-check-label">@Localizer["Preferred supplier for this product"]</label></div></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].ValidFrom" class="form-label">@Localizer["Price valid from"]</label> <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 align-baseline" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["The date when this supplier price starts."]" aria-label="@Localizer["Show explanation"]"><span class="badge rounded-pill text-bg-light border text-secondary">?</span></button><input asp-for="BulkForm.Rows[i].ValidFrom" type="date" class="form-control bulk-field" required/></div>
                                <div class="col-md-6 col-xl-3"><label asp-for="BulkForm.Rows[i].ValidTo" class="form-label">@Localizer["Price valid until (optional)"]</label> <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 align-baseline" data-bs-toggle="tooltip" data-bs-placement="top" title="@Localizer["Leave empty when the price has no specified end date."]" aria-label="@Localizer["Show explanation"]"><span class="badge rounded-pill text-bg-light border text-secondary">?</span></button><input asp-for="BulkForm.Rows[i].ValidTo" type="date" class="form-control bulk-field"/></div>
                                <div class="col-md-12 col-xl-6"><label asp-for="BulkForm.Rows[i].SupplierDescription" class="form-label">@Localizer["Supplier description"]</label><input asp-for="BulkForm.Rows[i].SupplierDescription" class="form-control bulk-field" maxlength="300"/></div>
                            </div>
                        </div>
                    </section>
                }
            </div>
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2"><span id="selected-count" class="text-muted"></span><span id="selected-products-label" class="d-none">@Localizer["Selected products"]</span><button class="btn btn-primary">@Localizer["Save selected products"]</button></div>
        </div>
    </form>
    }
}

@if(Model.SelectedSupplierId.HasValue&&Model.Rows.Count>0)
{
    <div class="card"><div class="card-header"><strong>@Localizer["Saved supplier purchasing rows"]</strong></div><div class="list-group list-group-flush">
    @foreach(var row in Model.Rows){<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3"><div><div class="fw-semibold"><code>@row.ProductCode</code> — @row.ProductName</div><div class="small text-muted">@Localizer["Purchase unit"]: @row.PurchaseUnit · @Localizer["Price"]: @row.UnitPrice.ToMoneyDisplay(numberSettings) @row.CurrencyCode · @Localizer["Price breaks"]: @row.PriceBreakCount</div></div><div class="d-flex flex-wrap align-items-center gap-2"><span class="badge @(row.IsActive?"bg-success":"bg-secondary")">@(row.IsActive?Localizer["Active"]:Localizer["Inactive"])</span><a asp-action="PriceHistory" asp-route-id="@row.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Price history"]</a><a asp-action="PriceBreaks" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">@(canManage?Localizer["Manage price breaks"]:Localizer["View price breaks"])</a>@if(canManage){<form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@row.Id"/><input type="hidden" name="supplierId" value="@Model.SelectedSupplierId"/><input type="hidden" name="isActive" value="@(!row.IsActive)"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(row.RowVersion)"/><button class="btn btn-sm @(row.IsActive?"btn-outline-danger":"btn-outline-success")">@(row.IsActive?Localizer["Deactivate"]:Localizer["Activate"])</button></form>}</div></div>}
    </div></div>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded',()=>{
    const list=document.getElementById('bulk-products-list');if(!list)return;
    const rows=[...list.querySelectorAll('.product-row')],count=document.getElementById('selected-count'),selectedLabel=document.getElementById('selected-products-label').textContent;
    const updateCount=()=>{const selected=rows.filter(row=>row.querySelector('.row-selector').checked).length;count.textContent=selected===0?'':selectedLabel+': '+selected;};
    rows.forEach(row=>{const selector=row.querySelector('.row-selector');selector.addEventListener('change',updateCount);row.querySelectorAll('.bulk-field').forEach(field=>field.addEventListener('change',()=>{selector.checked=true;updateCount();}));});
    document.getElementById('product-filter').addEventListener('input',event=>{const value=event.target.value.trim().toLowerCase();rows.forEach(row=>row.hidden=value.length>0&&!row.dataset.product.includes(value));});
    document.getElementById('select-visible').addEventListener('click',()=>{rows.filter(row=>!row.hidden).forEach(row=>row.querySelector('.row-selector').checked=true);updateCount();});
    document.getElementById('clear-selection').addEventListener('click',()=>{rows.forEach(row=>row.querySelector('.row-selector').checked=false);updateCount();});
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(element=>new bootstrap.Tooltip(element,{trigger:'hover focus'}));
    updateCount();
});
</script>
}
