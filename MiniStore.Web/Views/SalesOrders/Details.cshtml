@model MiniStore.Application.Dtos.Sales.SalesOrderDetailsDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Model.OrderNumber;var rv=Convert.ToBase64String(Model.RowVersion);var settings=await GeneralSettingsService.GetAsync();async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@Model.OrderNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex gap-2"><a asp-controller="SalesQuotations" asp-action="Details" asp-route-id="@Model.SourceQuotationId" class="btn btn-outline-primary">@Localizer["View source quotation"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["Confirming this sales order does not reserve or reduce stock and does not create accounting entries. Inventory reservation is a separate next step."]</div>
<div class="row g-3 mb-3"><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Customer snapshot"]</h5><div><strong>@Model.CustomerCode — @Model.CustomerName</strong></div>@if(Model.CustomerLegalName is not null){<div>@Model.CustomerLegalName</div>}@if(Model.CustomerTaxNumber is not null){<div>@Localizer["Tax number"]: @Model.CustomerTaxNumber</div>}@if(Model.Address is not null){<div class="mt-2">@Model.Address</div>}<div class="mt-2">@Localizer["Payment terms"]: @Model.PaymentTermDays @Localizer["days"]</div></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Order terms"]</h5><div>@Localizer["Source quotation"]: @Model.SourceQuotationNumber</div><div>@Localizer["Order date"]: @Model.OrderDate</div><div>@Localizer["Currency"]: @Model.CurrencyCode</div><div>@Localizer["Exchange rate"]: @Model.ExchangeRate.ToQuantityDisplay(settings) (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div>@if(Model.Notes is not null){<div class="mt-2">@Model.Notes</div>}</div></div></div></div>
<h5>@Localizer["Order lines"]</h5><div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><strong>@line.ProductCode — @line.ProductName</strong><span>@line.Quantity.ToQuantityDisplay(settings) @line.UnitName</span></div><div class="small text-muted">@line.PriceSourceCode · @line.TaxSourceCode</div><div class="row g-2 mt-2"><div class="col-6"><span class="text-muted">@Localizer["Unit price"]</span><div>@line.UnitPrice.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div><div class="col-6"><span class="text-muted">@Localizer["Net amount"]</span><div>@line.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Tax amount"]</span><div>@line.TaxAmount.ToMoneyDisplay(settings) @if(line.TaxName is not null){<small>(@line.TaxName @line.TaxRatePercent?.ToString("0.####")%)</small>}</div></div><div class="col-6"><span class="text-muted">@Localizer["Total"]</span><div>@line.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div>@if(line.Notes is not null){<div class="mt-2">@line.Notes</div>}</div></div></div>}</div>
<div class="card card-body my-3"><div class="row text-center"><div class="col-4"><span class="text-muted">@Localizer["Net amount"]</span><div class="fs-5">@Model.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Tax amount"]</span><div class="fs-5">@Model.TaxAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Total"]</span><div class="fs-5">@Model.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div></div>
@if(Model.Approval is not null){<div class="card card-body mb-3"><div class="d-flex flex-wrap justify-content-between gap-2"><div><h5>@Localizer["Sales control evaluation"]</h5><span class="badge bg-warning text-dark">@Localizer[Model.Approval.Status.ToString()]</span></div><span class="text-muted">@Model.Approval.RequestedAtUtc.ToLocalTime()</span></div><div class="row g-2 mt-2">@foreach(var finding in Model.Approval.Findings){<div class="col-lg-6"><div class="border rounded p-2 h-100"><strong>@finding.RuleName</strong><div>@Localizer[finding.Metric.ToString()] · @Localizer[finding.Comparison.ToString()] @finding.Threshold.ToQuantityDisplay(settings)</div><div class="text-muted">@Localizer["Actual value"]: @finding.ActualValue.ToQuantityDisplay(settings) · @Localizer[finding.Action.ToString()]</div></div></div>}</div>@if(Model.Approval.Steps.Count>0){<div class="mt-3"><strong>@Localizer["Approval steps"]</strong><div class="d-flex flex-wrap gap-2 mt-2">@foreach(var step in Model.Approval.Steps){<span class="badge bg-light text-dark">@step.Sequence. @step.RoleName — @Localizer[step.Status.ToString()]</span>}</div></div>}@if(Model.Approval.Status==SalesOrderApprovalStatus.Pending&&Model.Approval.CanCurrentUserDecide&&await Can("SalesOrders.ApproveException")){<div class="row g-2 mt-3"><div class="col-lg-6"><form asp-action="ApproveException" method="post" class="d-flex gap-2"><input type="hidden" name="SalesOrderId" value="@Model.Id"/><input name="Note" maxlength="500" class="form-control" placeholder="@Localizer["Approval note"]"/><button class="btn btn-success">@Localizer["Approve current step"]</button></form></div><div class="col-lg-6"><form asp-action="RejectException" method="post" class="d-flex gap-2"><input type="hidden" name="SalesOrderId" value="@Model.Id"/><input name="Note" maxlength="500" required class="form-control" placeholder="@Localizer["Rejection reason"]"/><button class="btn btn-outline-danger">@Localizer["Reject approval"]</button></form></div></div>}</div>}
<div class="d-flex flex-wrap gap-2 align-items-start">
@if(Model.Status==SalesOrderStatus.Draft&&Model.Approval?.Status!=SalesOrderApprovalStatus.Pending&&await Can("SalesOrders.Confirm")){<form asp-action="Confirm" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Evaluate and confirm sales order"]</button></form>}else if(Model.Approval?.Status==SalesOrderApprovalStatus.Pending){<span class="badge bg-warning text-dark p-2">@Localizer["Waiting for sales approval"]</span>}else if(Model.Status==SalesOrderStatus.Confirmed){<span class="badge bg-success p-2">@Localizer["Confirmation completed"]</span>}
@if(Model.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed){if(Model.Delivery.DeliveredStockQuantity>0){<span class="badge bg-secondary p-2">@Localizer["Cancellation unavailable after posted delivery"]</span>}else if(await Can("SalesOrders.Cancel")){<form asp-action="Cancel" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel sales order"]</button></form>}}else{<span class="badge bg-secondary p-2">@Localizer["Order step completed"]</span>}
</div>
@if(Model.Status==SalesOrderStatus.Confirmed){<div class="card card-body mt-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@Localizer[Model.Reservation.IsFullyReserved?"Reservation completed":"Inventory reservation"]</strong><div class="text-muted">@Localizer["Reserved"]: @Model.Reservation.ReservedStockQuantity.ToQuantityDisplay(settings) · @Localizer["Remaining"]: @Model.Reservation.RemainingStockQuantity.ToQuantityDisplay(settings)</div></div>@if(Model.Reservation.IsFullyReserved){<span class="badge bg-success p-2">@Localizer["Reservation completed"]</span>}else if(await Can("SalesOrders.Reserve")){<a asp-action="Reserve" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Reserve remaining inventory"]</a>}</div>@if(Model.Reservation.ActiveReservationCount>0){<div class="mt-2"><a asp-action="Reserve" asp-route-id="@Model.Id">@Localizer["View reservation history"]</a></div>}</div>}
@if(Model.Status==SalesOrderStatus.Confirmed){<div class="card card-body mt-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@Localizer[Model.Delivery.IsFullyDelivered?"Delivery completed":"Sales delivery"]</strong><div class="text-muted">@Localizer["Delivered"]: @Model.Delivery.DeliveredStockQuantity.ToQuantityDisplay(settings) · @Localizer["Remaining"]: @Model.Delivery.RemainingStockQuantity.ToQuantityDisplay(settings)</div></div>@if(Model.Delivery.IsFullyDelivered){<span class="badge bg-success p-2">@Localizer["Delivery completed"]</span>}else if(Model.Reservation.ActiveReservationCount>0&&await Can("SalesDeliveries.Create")){<a asp-controller="SalesDeliveries" asp-action="Create" asp-route-salesOrderId="@Model.Id" class="btn btn-primary">@Localizer["Prepare sales delivery"]</a>}</div>@if(Model.Delivery.PostedDeliveryCount+Model.Delivery.DraftDeliveryCount>0&&await Can("SalesDeliveries.View")){<div class="mt-2"><a asp-controller="SalesDeliveries" asp-action="Index" asp-route-search="@Model.OrderNumber">@Localizer["View delivery documents"]</a></div>}</div>}
@if(Model.Status==SalesOrderStatus.Confirmed){<div class="card card-body mt-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@Localizer[Model.Invoice.IsFullyInvoiced?"Customer invoicing completed":"Customer invoicing"]</strong><div class="text-muted">@Localizer["Invoiced lines"]: @Model.Invoice.FullyInvoicedLineCount / @Model.Invoice.TotalOrderLineCount · @Localizer["Committed amount"]: @Model.Invoice.CommittedAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div>@if(Model.Invoice.IsFullyInvoiced){<span class="badge bg-success p-2">@Localizer["Customer invoicing completed"]</span>}else if(Model.Invoice.HasEligibleRemaining&&await Can("CustomerInvoices.Create")){<a asp-controller="CustomerInvoices" asp-action="Create" asp-route-salesOrderId="@Model.Id" class="btn btn-primary">@Localizer["Create customer invoice"]</a>}else{<span class="badge bg-light text-dark p-2">@Localizer["No invoice quantity is currently eligible"]</span>}</div>@if(Model.Invoice.DraftInvoiceCount+Model.Invoice.ApprovedInvoiceCount>0&&await Can("CustomerInvoices.View")){<div class="mt-2"><a asp-controller="CustomerInvoices" asp-action="Index" asp-route-search="@Model.OrderNumber">@Localizer["View invoice documents"]</a> <span class="text-muted">· @Localizer["Draft"]: @Model.Invoice.DraftInvoiceCount · @Localizer["Approved"]: @Model.Invoice.ApprovedInvoiceCount</span></div>}</div>}
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
