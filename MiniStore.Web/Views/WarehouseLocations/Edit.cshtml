@model MiniStore.Application.DTOs.Warehouses.EditStorageLocationDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Edit storage location"];
    var parents = ViewBag.ParentLocations as List<StorageLocation> ?? [];
}
<div class="container mt-4">
    <h2>@Localizer["Edit storage location"]</h2>
    <p class="text-muted"><strong>@Model.Code</strong></p>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="WarehouseId" type="hidden" />
        <input asp-for="Code" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label">@Localizer["Location name"]</label><input asp-for="Name" class="form-control" required maxlength="120" /></div>
            <div class="col-md-6"><label asp-for="Barcode" class="form-label">@Localizer["Location barcode"]</label><input asp-for="Barcode" class="form-control" maxlength="100" /></div>
            <div class="col-md-6"><label asp-for="ParentLocationId" class="form-label">@Localizer["Parent location"]</label><select asp-for="ParentLocationId" class="form-select"><option value="">@Localizer["Root location"]</option>@foreach (var parent in parents) { <option value="@parent.Id">@parent.Code — @parent.Name</option> }</select></div>
            <div class="col-md-3"><label asp-for="Sequence" class="form-label">@Localizer["Sequence"]</label><input asp-for="Sequence" type="number" min="0" class="form-control" /></div>
        </div>
        <div class="card card-body mt-3"><h5>@Localizer["Operational capabilities"]</h5><div class="d-flex flex-wrap gap-3">
            <label><input asp-for="IsReceivable" /> @Localizer["Receivable"]</label><label><input asp-for="IsPickable" /> @Localizer["Pickable"]</label><label><input asp-for="IsReservable" /> @Localizer["Reservable"]</label><label><input asp-for="IsShippable" /> @Localizer["Shippable"]</label><label><input asp-for="IsCountable" /> @Localizer["Countable"]</label>
        </div></div>
        <div class="mt-4"><button class="btn btn-primary">@Localizer["Save changes"]</button> <a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-secondary">@Localizer["Cancel"]</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
