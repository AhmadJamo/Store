@model MiniStore.Application.DTOs.Warehouses.CreateStorageLocationDto
@using MiniStore.Domain.Entities
@using MiniStore.Application.DTOs.Warehouses
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Add Storage Location"];
    var warehouses = ViewBag.Warehouses as List<StorageLocationWarehouseOptionDto> ?? [];
    var parents = ViewBag.ParentLocations as List<StorageLocationOptionDto> ?? [];
}

<div class="container mt-4">
    <h2>@Localizer["Add Storage Location"]</h2>
    <p class="text-muted">
        @Localizer["Create a scannable warehouse position such as MAIN-DRY-A-R03-L02-B04."]
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="WarehouseId" class="form-label">@Localizer["Warehouse"]</label>
                <select asp-for="WarehouseId" id="warehouse-select" class="form-select" required>
                    <option value="">@Localizer["Select warehouse"]</option>
                    @foreach (var warehouse in warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Name</option>
                    }
                </select>
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">@Localizer["Location name"]</label>
                <input asp-for="Name" class="form-control" required maxlength="120" />
            </div>

            <div class="col-md-6">
                <label asp-for="Barcode" class="form-label">@Localizer["Location barcode"]</label>
                <input asp-for="Barcode" class="form-control" maxlength="100" />
            </div>

            <div class="col-md-6">
                <label asp-for="ParentLocationId" class="form-label">@Localizer["Parent location"]</label>
                <select asp-for="ParentLocationId" id="parent-location-select" class="form-select">
                    <option value="">@Localizer["Root location"]</option>
                    @foreach (var parent in parents)
                    {
                        <option value="@parent.Id" data-warehouse-id="@parent.WarehouseId">@parent.Label</option>
                    }
                </select>
                <div class="form-text">@Localizer["Only a location from the selected warehouse can be used as parent."]</div>
            </div>

            <div class="col-md-3">
                <label asp-for="Sequence" class="form-label">@Localizer["Sequence"]</label>
                <input asp-for="Sequence" type="number" min="0" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="Code" class="form-label">@Localizer["Location code / barcode"]</label>
                <input asp-for="Code"
                       class="form-control"
                       placeholder="MAIN-A-R03-L02-B04"
                       required />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Zone" class="form-label">@Localizer["Zone"]</label>
                <input asp-for="Zone" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Aisle" class="form-label">@Localizer["Aisle"]</label>
                <input asp-for="Aisle" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Rack" class="form-label">@Localizer["Rack"]</label>
                <input asp-for="Rack" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Level" class="form-label">@Localizer["Level / floor"]</label>
                <input asp-for="Level" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Bin" class="form-label">@Localizer["Bin"]</label>
                <input asp-for="Bin" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Type" class="form-label">@Localizer["Location type"]</label>
                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<StorageLocationType>()"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="MaximumQuantity" class="form-label">@Localizer["Maximum quantity"]</label>
                <input asp-for="MaximumQuantity"
                       type="number"
                       min="0"
                       step="0.001"
                       class="form-control" />
                <span asp-validation-for="MaximumQuantity" class="text-danger"></span>
            </div>
        </div>

        <div class="card card-body mt-3">
            <h5>@Localizer["Operational capabilities"]</h5>
            <div class="d-flex flex-wrap gap-3">
                <label><input asp-for="IsReceivable" /> @Localizer["Receivable"]</label>
                <label><input asp-for="IsPickable" /> @Localizer["Pickable"]</label>
                <label><input asp-for="IsReservable" /> @Localizer["Reservable"]</label>
                <label><input asp-for="IsShippable" /> @Localizer["Shippable"]</label>
                <label><input asp-for="IsCountable" /> @Localizer["Countable"]</label>
            </div>
        </div>

        <div class="mt-4">
            <button class="btn btn-primary">@Localizer["Save location"]</button>
            <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const warehouse = document.getElementById('warehouse-select');
            const parent = document.getElementById('parent-location-select');
            const refreshParents = () => {
                const warehouseId = warehouse.value;
                for (const option of parent.options) {
                    if (!option.value) continue;
                    option.hidden = option.dataset.warehouseId !== warehouseId;
                    option.disabled = option.hidden;
                }
                if (parent.selectedOptions[0]?.disabled) parent.value = '';
            };
            warehouse.addEventListener('change', refreshParents);
            refreshParents();
        })();
    </script>
}
