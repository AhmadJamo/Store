@model List<MiniStore.Application.DTOs.Purchases.PurchaseDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = Localizer["Legacy direct purchases"];
    var numberSettings = await GeneralSettingsService.GetAsync();
    var canCreateRequest = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseRequests.Create")).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h2 class="mb-1">@Localizer["Legacy direct purchases"]</h2>
        <p class="text-muted mb-0">@Localizer["Historical direct purchases remain available for reference. New purchasing starts from a purchase request."]</p>
    </div>
    @if(canCreateRequest){<a asp-controller="PurchaseRequests" asp-action="Create" class="btn btn-primary">@Localizer["Create purchase request"]</a>}
</div>

<div class="alert alert-info">
    <strong>@Localizer["New legacy purchase creation is retired"]</strong>
    <div>@Localizer["Use the controlled procure-to-pay workflow for new purchasing activity."]</div>
</div>

<div class="row g-3">
@foreach(var purchase in Model)
{
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card card-body h-100">
            <div class="d-flex justify-content-between gap-2"><strong>@purchase.InvoiceNumber</strong><span class="badge bg-secondary">@Localizer["Legacy"]</span></div>
            <div class="mt-2"><span class="text-muted">@Localizer["Supplier"]:</span> @purchase.SupplierName</div>
            <div><span class="text-muted">@Localizer["Warehouse"]:</span> @purchase.WarehouseName</div>
            <div><span class="text-muted">@Localizer["Date"]:</span> @purchase.Date.ToShortDateString()</div>
            <div class="fs-5 mt-2">@purchase.TotalAmount.ToMoneyDisplay(numberSettings)</div>
            <a asp-action="Details" asp-route-id="@purchase.Id" class="btn btn-sm btn-outline-primary mt-3 align-self-start">@Localizer["Details"]</a>
        </div>
    </div>
}
@if(Model.Count==0){<div class="col-12 text-center text-muted py-5">@Localizer["No legacy direct purchases found."]</div>}
</div>
