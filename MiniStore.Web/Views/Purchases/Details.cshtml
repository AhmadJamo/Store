@model MiniStore.Application.DTOs.Purchases.PurchaseDto

@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Purchase Details";
    var canCreateReturn = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseReturns.Create")).Succeeded;
}

<h1>Purchase Details</h1>

<div class="row mb-4">

    <div class="col-md-3">

        <strong>Invoice Number</strong>

        <div>
            @Model.InvoiceNumber
        </div>

    </div>

    <div class="col-md-3">

        <strong>Supplier</strong>

        <div>
            @Model.SupplierName
        </div>

    </div>

    <div class="col-md-3">

        <strong>Warehouse</strong>

        <div>
            @Model.WarehouseName
        </div>

    </div>

    <div class="col-md-3">

        <strong>Date</strong>

        <div>
            @Model.Date.ToShortDateString()
        </div>

    </div>

</div>


<h3>Items</h3>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Product</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>Purchase Price</th>
            <th>Total</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>
                    @item.ProductName
                </td>
                <td>@item.WarehouseName</td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.PurchasePrice.ToString("N2")
                </td>

                <td>
                    @item.Total.ToString("N2")
                </td>

            </tr>
        }

    </tbody>

    <tfoot>

        <tr>

            <th colspan="4"
                class="text-end">

                Grand Total

            </th>

            <th>

                @Model.TotalAmount.ToString("N2")

            </th>

        </tr>

    </tfoot>

</table>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-secondary">

        <strong>Notes:</strong>

        @Model.Notes

    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">

    Back

</a>

@if (ViewBag.IsPosted == true && canCreateReturn)
{
    <span class="badge bg-success ms-2">Posted to general ledger</span>
}
else
{
    <form asp-action="Post" method="post" class="d-inline ms-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">Post to general ledger</button>
    </form>
}

@if (ViewBag.IsPosted == true)
{
    <a asp-controller="PurchaseReturns" asp-action="Create" asp-route-purchaseId="@Model.Id" class="btn btn-outline-primary ms-2">@Localizer["Purchase return"]</a>
}
