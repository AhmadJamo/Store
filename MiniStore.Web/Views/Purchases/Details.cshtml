@model MiniStore.Application.DTOs.Purchases.PurchaseDto

@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localizer["Legacy direct purchase details"];
    var canCreateReturn = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseReturns.Create")).Succeeded;
    var numberSettings = await GeneralSettingsService.GetAsync();
}

<h1>@Localizer["Legacy direct purchase details"]</h1>
<div class="alert alert-secondary">@Localizer["This is a historical legacy record. New purchasing starts from a purchase request."]</div>

<div class="row mb-4">

    <div class="col-md-3">

        <strong>@Localizer["Invoice Number"]</strong>

        <div>
            @Model.InvoiceNumber
        </div>

    </div>

    <div class="col-md-3">

        <strong>@Localizer["Supplier"]</strong>

        <div>
            @Model.SupplierName
        </div>

    </div>

    <div class="col-md-3">

        <strong>@Localizer["Warehouse"]</strong>

        <div>
            @Model.WarehouseName
        </div>

    </div>

    <div class="col-md-3">

        <strong>@Localizer["Date"]</strong>

        <div>
            @Model.Date.ToShortDateString()
        </div>

    </div>

</div>


<h3>@Localizer["Items"]</h3>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>@Localizer["Product"]</th>
            <th>@Localizer["Warehouse"]</th>
            <th>@Localizer["Quantity"]</th>
            <th>@Localizer["Purchase Price"]</th>
            <th>@Localizer["Total"]</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>
                    @item.ProductName
                </td>
                <td>@item.WarehouseName</td>

                <td>
                    @item.Quantity.ToQuantityDisplay(numberSettings)
                </td>

                <td>
                    @item.PurchasePrice.ToMoneyDisplay(numberSettings)
                </td>

                <td>
                    @item.Total.ToMoneyDisplay(numberSettings)
                </td>

            </tr>
        }

    </tbody>

    <tfoot>

        <tr>

            <th colspan="4"
                class="text-end">

                @Localizer["Grand total"]

            </th>

            <th>

                @Model.TotalAmount.ToMoneyDisplay(numberSettings)

            </th>

        </tr>

    </tfoot>

</table>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="alert alert-secondary">

        <strong>@Localizer["Notes:"]</strong>

        @Model.Notes

    </div>
}

<a asp-action="Index"
   class="btn btn-secondary">

    @Localizer["Back"]

</a>

@if (ViewBag.IsPosted == true)
{
    <span class="badge bg-success ms-2">@Localizer["Posted to general ledger"]</span>
}
else
{
    <form asp-action="Post" method="post" class="d-inline ms-2">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-primary">@Localizer["Post to general ledger"]</button>
    </form>
}

@if (ViewBag.IsPosted == true && canCreateReturn)
{
    <a asp-controller="PurchaseReturns" asp-action="Create" asp-route-purchaseId="@Model.Id" class="btn btn-outline-primary ms-2">@Localizer["Purchase return"]</a>
}
