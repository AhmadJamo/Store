@model MiniStore.Application.DTOs.Purchases.SupplierIntegrationDashboardDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Localizer["Supplier portal and integrations"];var canManage=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierIntegrations.Manage")).Succeeded;var canRetry=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierIntegrations.Retry")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><h2>@Localizer["Supplier portal and integrations"]</h2><p class="text-muted mb-0">@Localizer["Manage supplier API access, callbacks, reliable delivery and external audit evidence."]</p></div></div>
@if(canManage){<form asp-action="CreateCredential" method="post" class="card card-body my-3"><h3 class="h5">@Localizer["Create supplier integration credential"]</h3><div class="row g-2"><div class="col-md-3"><label class="form-label">@Localizer["Supplier"]</label><select name="SupplierId" class="form-select" required><option value="">@Localizer["Select supplier"]</option>@foreach(var supplier in Model.Suppliers){<option value="@supplier.Id">@supplier.Label</option>}</select></div><div class="col-md-3"><label class="form-label">@Localizer["Integration name"]</label><input name="Name" maxlength="150" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["HTTPS callback URL"]</label><input name="CallbackUrl" type="url" maxlength="1000" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Callback bearer token"]</label><input name="CallbackBearerToken" type="password" maxlength="2000" class="form-control" autocomplete="new-password"/></div><div class="col-md-3"><label class="form-label">@Localizer["Expires at"]</label><input name="ExpiresAtUtc" type="datetime-local" class="form-control"/></div><div class="col-12"><label class="form-label">@Localizer["Integration permissions"]</label><div class="d-flex flex-wrap gap-3">@foreach(var scope in MiniStore.Application.Services.SupplierIntegrationService.AllowedScopes){<label><input type="checkbox" name="Scopes" value="@scope" class="form-check-input"/> @Localizer[scope]</label>}</div></div><div class="col-12"><button class="btn btn-primary">@Localizer["Create credential"]</button></div></div></form>}
<h3 class="h5 mt-4">@Localizer["Supplier API credentials"]</h3><div class="row g-3">@foreach(var item in Model.Credentials){<div class="col-12 col-lg-6"><div class="card card-body h-100"><div class="d-flex flex-wrap justify-content-between gap-2"><div><strong>@item.Name</strong><div>@item.SupplierName</div></div><span class="badge @(item.IsActive?"bg-success":"bg-secondary")">@(item.IsActive?Localizer["Active"]:Localizer["Inactive"])</span></div><div class="small text-muted mt-2">@Localizer["Key prefix"]: <code>@item.KeyPrefix</code></div><div class="small text-break">@Localizer["Integration permissions"]: @item.Scopes</div>@if(!string.IsNullOrWhiteSpace(item.CallbackUrl)){<div class="small text-break">@Localizer["Callback"]: @item.CallbackUrl</div>}@if(item.LastUsedAtUtc.HasValue){<div class="small">@Localizer["Last used"]: @item.LastUsedAtUtc.Value.ToLocalTime()</div>}@if(item.IsActive&&canManage){<form asp-action="DeactivateCredential" method="post" class="mt-2"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)"/><button class="btn btn-sm btn-outline-danger">@Localizer["Deactivate"]</button></form>}</div></div>}</div>
<h3 class="h5 mt-4">@Localizer["Reliable delivery outbox"]</h3><div class="row g-3">@if(Model.Outbox.Count==0){<div class="text-muted">@Localizer["No external deliveries have been queued."]</div>}@foreach(var item in Model.Outbox){<div class="col-12 col-lg-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@item.MessageType — @item.SupplierName</strong><span class="badge bg-secondary">@Localizer[item.Status.ToString()]</span></div><div class="small">@item.AggregateType #@item.AggregateId · @Localizer["Attempts"]: @item.AttemptCount</div>@if(item.DeliveredAtUtc.HasValue){<div class="small text-success">@Localizer["Delivered at"] @item.DeliveredAtUtc.Value.ToLocalTime()</div>}@if(!string.IsNullOrWhiteSpace(item.LastError)){<div class="small text-danger text-break">@item.LastError</div>}@if(item.Status!=MiniStore.Domain.Entities.SupplierOutboxStatus.Delivered&&canRetry){<form asp-action="Retry" method="post" class="mt-2"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-primary">@Localizer["Retry now"]</button></form>}</div></div>}</div>
<h3 class="h5 mt-4">@Localizer["External submission audit"]</h3><div class="row g-3">@if(Model.Submissions.Count==0){<div class="text-muted">@Localizer["No external supplier submissions have been received."]</div>}@foreach(var item in Model.Submissions){<div class="col-12 col-lg-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@item.SupplierName</strong><span class="badge bg-info text-dark">@Localizer[item.Type.ToString()]</span></div><div>@Localizer[item.Channel.ToString()] · @item.DocumentReference</div><div class="small text-muted">@item.CreatedAtUtc.ToLocalTime() @if(!string.IsNullOrWhiteSpace(item.ExternalReference)){<text> · @item.ExternalReference</text>}</div><a asp-action="Submission" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mt-2 align-self-start">@Localizer["Review submission evidence"]</a></div></div>}</div>
<h3 class="h5 mt-4">@Localizer["External security audit"]</h3><div class="row g-3 mb-4">@if(Model.AuditEvents.Count==0){<div class="text-muted">@Localizer["No external security events have been recorded."]</div>}@foreach(var item in Model.AuditEvents){<div class="col-12 col-lg-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@item.SupplierName — @item.Action</strong><span class="badge bg-secondary">@item.Outcome</span></div><div class="small">@Localizer[item.Channel.ToString()] · @item.Actor</div><div class="small text-muted text-break">@item.CreatedAtUtc.ToLocalTime() · @item.CorrelationId @if(!string.IsNullOrWhiteSpace(item.RemoteAddress)){<text> · @item.RemoteAddress</text>}</div></div></div>}</div>
