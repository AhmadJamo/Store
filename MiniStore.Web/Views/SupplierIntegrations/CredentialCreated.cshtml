@model MiniStore.Application.DTOs.Purchases.CreatedSupplierIntegrationCredentialDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Supplier API credential created"];}
<div class="card card-body mx-auto" style="max-width:760px"><h2>@Localizer["Supplier API credential created"]</h2><div class="alert alert-warning">@Localizer["Copy this API key now. It is stored only as a secure hash and cannot be shown again."]</div><label class="form-label">@Localizer["API key"]</label><textarea class="form-control font-monospace" rows="3" readonly>@ViewBag.ApiKey</textarea><a asp-action="Index" class="btn btn-primary mt-3 align-self-start">@Localizer["Return to integrations"]</a></div>
