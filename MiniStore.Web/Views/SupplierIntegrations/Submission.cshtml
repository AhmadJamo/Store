@model MiniStore.Application.DTOs.Purchases.SupplierExternalSubmissionDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["External supplier submission"];}
<div class="d-flex flex-wrap justify-content-between gap-2"><h2>@Localizer["External supplier submission"] #@Model.Id</h2><div><a asp-action="DownloadSubmission" asp-route-id="@Model.Id" class="btn btn-outline-primary">@Localizer["Download original payload"]</a> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-2"><div class="col-md-4"><strong>@Localizer["Supplier"]</strong><div>@Model.SupplierName</div></div><div class="col-md-4"><strong>@Localizer["Submission type"]</strong><div>@Localizer[Model.Type.ToString()]</div></div><div class="col-md-4"><strong>@Localizer["Channel"]</strong><div>@Localizer[Model.Channel.ToString()]</div></div><div class="col-md-4"><strong>@Localizer["Source document"]</strong><div>@Localizer[Model.DocumentType.ToString()] #@Model.DocumentId</div></div><div class="col-md-4"><strong>@Localizer["External reference"]</strong><div>@(Model.ExternalReference??"—")</div></div><div class="col-md-4"><strong>@Localizer["Received at"]</strong><div>@Model.CreatedAtUtc.ToLocalTime()</div></div><div class="col-12"><strong>@Localizer["Idempotency key"]</strong><div class="text-break font-monospace">@Model.IdempotencyKey</div></div><div class="col-12"><strong>@Localizer["Request fingerprint"]</strong><div class="text-break font-monospace">@Model.RequestHash</div></div></div></div>
<div class="card card-body"><h3 class="h5">@Localizer["Original payload for review"]</h3><pre class="text-break" style="white-space:pre-wrap;max-height:32rem;overflow:auto">@Model.Payload</pre></div>
