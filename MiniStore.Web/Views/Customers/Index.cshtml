@model MiniStore.Application.Dtos.Customers.CustomerListPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = Localizer["Customers"]; var canCreate=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Create")).Succeeded; var canEdit=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Edit")).Succeeded; }
<div class="container py-4">
 <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@Localizer["Customers"]</h2><p class="text-muted mb-0">@Localizer["Search and manage active and archived customer profiles."]</p></div>@if(canCreate){<a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> @Localizer["Add customer"]</a>}</div>
 <form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-lg-5"><label asp-for="Query.Search" class="form-label">@Localizer["Search"]</label><input asp-for="Query.Search" name="Search" class="form-control" placeholder="@Localizer["Code, name, phone, email or tax number"]" /></div><div class="col-lg-3"><label asp-for="Query.SortBy" class="form-label">@Localizer["Sort by"]</label><select asp-for="Query.SortBy" name="SortBy" class="form-select"><option value="name">@Localizer["Name"]</option><option value="code">@Localizer["Code"]</option><option value="type">@Localizer["Type"]</option><option value="status">@Localizer["Status"]</option></select></div><div class="col-lg-2 form-check ms-2 mb-2"><input asp-for="Query.IncludeArchived" name="IncludeArchived" class="form-check-input"/><label asp-for="Query.IncludeArchived" class="form-check-label">@Localizer["Include archived"]</label></div><div class="col-lg-1"><button class="btn btn-outline-primary w-100">@Localizer["Search"]</button></div></div></form>
 <div class="row g-3">
 @foreach(var item in Model.Items){<div class="col-12 col-md-6 col-xl-4"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between gap-2"><div><span class="text-muted small">@item.CustomerCode</span><h5 class="mb-1">@item.Name</h5></div><span class="badge @(item.IsActive?"bg-success":"bg-secondary") align-self-start">@(item.IsActive?Localizer["Active"]:Localizer["Archived"])</span></div><div class="small text-muted mb-2">@Localizer[item.Type.ToString()]</div>@if(!string.IsNullOrWhiteSpace(item.Phone)){<div><i class="bi bi-telephone"></i> @item.Phone</div>}@if(!string.IsNullOrWhiteSpace(item.Email)){<div class="text-break"><i class="bi bi-envelope"></i> @item.Email</div>}<div class="small mt-2 text-muted">@Localizer["Receivable account"]: @item.AccountName</div></div><div class="card-footer bg-transparent d-flex gap-2"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a>@if(canEdit){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Edit"]</a>}</div></div></div>}
 @if(Model.Items.Count==0){<div class="col-12"><div class="alert alert-info">@Localizer["No customers found."]</div></div>}
 </div>
 @if(Model.TotalPages>1){<nav class="mt-4" aria-label="@Localizer["Customer pages"]"><ul class="pagination justify-content-center">@for(var pageNumber=1;pageNumber<=Model.TotalPages;pageNumber++){<li class="page-item @(pageNumber==Model.Query.Page?"active":"")"><a class="page-link" asp-route-page="@pageNumber" asp-route-search="@Model.Query.Search" asp-route-sortBy="@Model.Query.SortBy" asp-route-includeArchived="@Model.Query.IncludeArchived">@pageNumber</a></li>}</ul></nav>}
</div>
