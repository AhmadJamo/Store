@model MiniStore.Application.Dtos.Customers.CustomerDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ ViewData["Title"] = Model.Name; var canEdit=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Edit")).Succeeded; var canArchive=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Archive")).Succeeded; }
<div class="container py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><span class="text-muted">@Model.CustomerCode</span><h2 class="mb-0">@Model.Name</h2></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a>@if(canEdit){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Edit"]</a>}</div></div>
 <div class="row g-3"><div class="col-lg-7"><div class="card h-100"><div class="card-header d-flex justify-content-between"><strong>@Localizer["Customer profile"]</strong><span class="badge @(Model.IsActive?"bg-success":"bg-secondary")">@(Model.IsActive?Localizer["Active"]:Localizer["Archived"])</span></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">@Localizer["Customer type"]</dt><dd class="col-sm-8">@Localizer[Model.Type.ToString()]</dd><dt class="col-sm-4">@Localizer["Legal name"]</dt><dd class="col-sm-8">@(Model.LegalName??"—")</dd><dt class="col-sm-4">@Localizer["Phone"]</dt><dd class="col-sm-8">@(Model.Phone??"—")</dd><dt class="col-sm-4">@Localizer["Email"]</dt><dd class="col-sm-8 text-break">@(Model.Email??"—")</dd><dt class="col-sm-4">@Localizer["Website"]</dt><dd class="col-sm-8 text-break">@(Model.Website??"—")</dd><dt class="col-sm-4">@Localizer["Tax number"]</dt><dd class="col-sm-8">@(Model.TaxNumber??"—")</dd><dt class="col-sm-4">@Localizer["Registration number"]</dt><dd class="col-sm-8">@(Model.RegistrationNumber??"—")</dd></dl></div></div></div>
 <div class="col-lg-5"><div class="card mb-3"><div class="card-header"><strong>@Localizer["Commercial settings"]</strong></div><div class="card-body"><div><strong>@Localizer["Receivable account"]:</strong> @Model.AccountName</div><div><strong>@Localizer["Preferred language"]:</strong> @Localizer[Model.PreferredLanguage]</div><div><strong>@Localizer["Time Zone"]:</strong> @Model.TimeZoneId</div></div></div><div class="card"><div class="card-header"><strong>@Localizer["Notes"]</strong></div><div class="card-body" style="white-space:pre-wrap">@(Model.Notes??"—")</div></div></div></div>
 @if(canArchive){<div class="card card-body mt-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2">@if(Model.IsActive){<span>@Localizer["Archiving prevents this customer from being selected for new sales while preserving history."]</span><form asp-action="Archive" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">@Localizer["Archive customer"]</button></form>}else{<span>@Localizer["This customer is archived and remains available in historical documents."]</span><form asp-action="Restore" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-success">@Localizer["Restore customer"]</button></form>}</div></div>}
</div>
