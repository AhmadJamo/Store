@model MiniStore.Application.Dtos.Customers.CustomerDetailsDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ViewData["Title"]=Model.Name;var canEdit=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Edit")).Succeeded;var canArchive=(await Authorization.AuthorizeAsync(User,null,"Permission:Customers.Archive")).Succeeded;}
<div class="container py-4">
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><span class="text-muted">@Model.CustomerCode</span><h2>@Model.Name</h2></div><div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a> @if(canEdit){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Edit"]</a>}</div></div>
<div class="row g-3"><div class="col-lg-7"><div class="card h-100"><div class="card-header d-flex justify-content-between"><strong>@Localizer["Customer profile"]</strong><span class="badge @(Model.IsActive?"bg-success":"bg-secondary")">@(Model.IsActive?Localizer["Active"]:Localizer["Archived"])</span></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">@Localizer["Customer type"]</dt><dd class="col-sm-8">@Localizer[Model.Type.ToString()]</dd><dt class="col-sm-4">@Localizer["Legal name"]</dt><dd class="col-sm-8">@(Model.LegalName??"—")</dd><dt class="col-sm-4">@Localizer["Phone"]</dt><dd class="col-sm-8">@(Model.Phone??"—")</dd><dt class="col-sm-4">@Localizer["Email"]</dt><dd class="col-sm-8 text-break">@(Model.Email??"—")</dd><dt class="col-sm-4">@Localizer["Tax number"]</dt><dd class="col-sm-8">@(Model.TaxNumber??"—")</dd><dt class="col-sm-4">@Localizer["Receivable account"]</dt><dd class="col-sm-8">@Model.AccountName</dd><dt class="col-sm-4">@Localizer["Payment terms (days)"]</dt><dd class="col-sm-8">@Model.PaymentTermDays</dd><dt class="col-sm-4">@Localizer["Preferred currency"]</dt><dd class="col-sm-8">@(Model.PreferredCurrencyCode??Localizer["Use company currency"].Value)</dd><dt class="col-sm-4">@Localizer["Default price list"]</dt><dd class="col-sm-8">@(Model.DefaultSalesPriceListName??Localizer["Use product channel price"].Value)</dd><dt class="col-sm-4">@Localizer["Tax status"]</dt><dd class="col-sm-8">@(Model.IsTaxExempt?Localizer["Tax exempt"]:(Model.DefaultTaxRateName??Localizer["No default tax rate"].Value))</dd>@if(Model.IsTaxExempt){<dt class="col-sm-4">@Localizer["Tax exemption reason"]</dt><dd class="col-sm-8">@Model.TaxExemptionReason</dd>}</dl></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-header"><strong>@Localizer["Notes"]</strong></div><div class="card-body" style="white-space:pre-wrap">@(Model.Notes??"—")</div></div></div></div>

<div class="row g-3 mt-1"><div class="col-lg-6"><div class="card h-100"><div class="card-header"><strong>@Localizer["Customer contacts"]</strong></div><div class="card-body">
@foreach(var c in Model.Contacts){<div class="border rounded p-2 mb-2 @(c.IsActive?"":"bg-light text-muted")"><form asp-action="SaveContact" method="post" class="row g-2"><input type="hidden" name="CustomerId" value="@Model.Id"/><input type="hidden" name="Id" value="@c.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(c.RowVersion)"/><div class="col-md-6"><input class="form-control" name="Name" value="@c.Name" aria-label="@Localizer["Contact name"]" @(canEdit?null:"disabled")/></div><div class="col-md-6"><input class="form-control" name="Role" value="@c.Role" placeholder="@Localizer["Role"]" @(canEdit?null:"disabled")/></div><div class="col-md-6"><input class="form-control" name="Phone" value="@c.Phone" placeholder="@Localizer["Phone"]" @(canEdit?null:"disabled")/></div><div class="col-md-6"><input class="form-control" name="Email" value="@c.Email" placeholder="@Localizer["Email"]" @(canEdit?null:"disabled")/></div><div class="col-12 d-flex flex-wrap gap-2 align-items-center"><label><input type="checkbox" name="IsPrimary" value="true" checked="@c.IsPrimary" disabled="@(!canEdit)"/> @Localizer["Primary contact"]</label>@if(canEdit&&c.IsActive){<button class="btn btn-sm btn-outline-primary ms-auto">@Localizer["Save"]</button>}</div></form>@if(canArchive){<form asp-action="@(c.IsActive?"ArchiveContact":"RestoreContact")" method="post" class="mt-2"><input type="hidden" name="CustomerId" value="@Model.Id"/><input type="hidden" name="Id" value="@c.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(c.RowVersion)"/><button class="btn btn-sm @(c.IsActive?"btn-outline-danger":"btn-outline-success")">@(c.IsActive?Localizer["Archive"]:Localizer["Restore"])</button></form>}</div>}
@if(canEdit&&Model.IsActive){<hr/><form asp-action="SaveContact" method="post" class="row g-2"><input type="hidden" name="CustomerId" value="@Model.Id"/><div class="col-md-6"><input name="Name" class="form-control" required placeholder="@Localizer["Contact name"]"/></div><div class="col-md-6"><input name="Role" class="form-control" placeholder="@Localizer["Role"]"/></div><div class="col-md-6"><input name="Phone" class="form-control" placeholder="@Localizer["Phone"]"/></div><div class="col-md-6"><input name="Email" type="email" class="form-control" placeholder="@Localizer["Email"]"/></div><div class="col-12"><label><input type="checkbox" name="IsPrimary" value="true"/> @Localizer["Primary contact"]</label><button class="btn btn-primary float-end">@Localizer["Add contact"]</button></div></form>}</div></div></div>

<div class="col-lg-6"><div class="card h-100"><div class="card-header"><strong>@Localizer["Customer addresses"]</strong></div><div class="card-body">
@foreach(var a in Model.Addresses){<div class="border rounded p-2 mb-2 @(a.IsActive?"":"bg-light text-muted")"><strong>@a.Label</strong> <span class="badge bg-light text-dark">@Localizer[a.Type.ToString()]</span>@if(a.IsDefault){<span class="badge bg-primary">@Localizer["Default"]</span>}<div>@a.Snapshot</div>
@if(canEdit&&a.IsActive){<details class="mt-2"><summary class="btn btn-sm btn-outline-primary">@Localizer["Edit"]</summary><form asp-action="SaveAddress" method="post" class="row g-2 mt-1"><input type="hidden" name="CustomerId" value="@Model.Id"/><input type="hidden" name="Id" value="@a.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(a.RowVersion)"/><div class="col-md-6"><input name="Label" value="@a.Label" required class="form-control"/></div><div class="col-md-6"><select name="Type" class="form-select">@foreach(var t in Enum.GetValues<CustomerAddressType>()){<option value="@t" selected="@(t==a.Type)">@Localizer[t.ToString()]</option>}</select></div><div class="col-12"><input name="AddressLine1" value="@a.AddressLine1" required class="form-control"/></div><div class="col-12"><input name="AddressLine2" value="@a.AddressLine2" class="form-control"/></div><div class="col-md-6"><input name="City" value="@a.City" required class="form-control"/></div><div class="col-md-6"><input name="StateOrProvince" value="@a.StateOrProvince" class="form-control"/></div><div class="col-md-6"><input name="PostalCode" value="@a.PostalCode" class="form-control"/></div><div class="col-md-6"><input name="CountryCode" value="@a.CountryCode" maxlength="2" required class="form-control"/></div><div class="col-12"><label><input type="checkbox" name="IsDefault" value="true" checked="@a.IsDefault"/> @Localizer["Default address"]</label><button class="btn btn-sm btn-primary float-end">@Localizer["Save"]</button></div></form></details>}
@if(canArchive){<form asp-action="@(a.IsActive?"ArchiveAddress":"RestoreAddress")" method="post" class="mt-2"><input type="hidden" name="CustomerId" value="@Model.Id"/><input type="hidden" name="Id" value="@a.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(a.RowVersion)"/><button class="btn btn-sm @(a.IsActive?"btn-outline-danger":"btn-outline-success")">@(a.IsActive?Localizer["Archive"]:Localizer["Restore"])</button></form>}</div>}
@if(canEdit&&Model.IsActive){<hr/><form asp-action="SaveAddress" method="post" class="row g-2"><input type="hidden" name="CustomerId" value="@Model.Id"/><div class="col-md-6"><input name="Label" required class="form-control" placeholder="@Localizer["Address label"]"/></div><div class="col-md-6"><select name="Type" class="form-select">@foreach(var t in Enum.GetValues<CustomerAddressType>()){<option value="@t">@Localizer[t.ToString()]</option>}</select></div><div class="col-12"><input name="AddressLine1" required class="form-control" placeholder="@Localizer["Address line 1"]"/></div><div class="col-12"><input name="AddressLine2" class="form-control" placeholder="@Localizer["Address line 2"]"/></div><div class="col-md-6"><input name="City" required class="form-control" placeholder="@Localizer["City"]"/></div><div class="col-md-6"><input name="StateOrProvince" class="form-control" placeholder="@Localizer["State or province"]"/></div><div class="col-md-6"><input name="PostalCode" class="form-control" placeholder="@Localizer["Postal code"]"/></div><div class="col-md-6"><input name="CountryCode" value="JO" maxlength="2" required class="form-control" placeholder="@Localizer["Country code"]"/></div><div class="col-12"><label><input type="checkbox" name="IsDefault" value="true"/> @Localizer["Default address"]</label><button class="btn btn-primary float-end">@Localizer["Add address"]</button></div></form>}</div></div></div></div>

@if(canArchive){<div class="card card-body mt-3">@if(Model.IsActive){<form asp-action="Archive" method="post" class="d-flex justify-content-between"><span>@Localizer["Archiving prevents this customer from being selected for new sales while preserving history."]</span><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">@Localizer["Archive customer"]</button></form>}else{<form asp-action="Restore" method="post" class="d-flex justify-content-between"><span>@Localizer["This customer is archived and remains available in historical documents."]</span><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-success">@Localizer["Restore customer"]</button></form>}</div>}
</div>
