@model MiniStore.Application.DTOs.Purchases.PurchaseSourcingCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Start sourcing"]; }
<h2>@Localizer["Start sourcing"]</h2>
<p class="text-muted">@Localizer["Create a supplier invitation from an approved purchase request. This does not change inventory or accounting."]</p>
<div class="card card-body mb-3"><strong>@Model.Request!.RequestNumber</strong><span>@Localizer["Needed by"]: @Model.Request.NeededByDate</span><ul class="mb-0">@foreach(var line in Model.Request.Lines){<li>@line.ProductCode — @line.ProductName: @line.RequestedQuantity @line.UnitName</li>}</ul></div>
<form asp-action="Create" method="post"><input type="hidden" asp-for="Form.PurchaseRequestId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">@Localizer["Invitation message"]</label><textarea asp-for="Form.InvitationMessage" class="form-control" maxlength="1000"></textarea></div><div class="mb-3"><label class="form-label">@Localizer["Notes"]</label><textarea asp-for="Form.Notes" class="form-control" maxlength="1000"></textarea></div><label class="form-label">@Localizer["Suppliers to invite"]</label><div class="card card-body mb-3">@foreach(var supplier in Model.Suppliers){<div class="form-check"><input class="form-check-input" type="checkbox" name="Form.SupplierIds" value="@supplier.Id" id="supplier-@supplier.Id"/><label class="form-check-label" for="supplier-@supplier.Id">@supplier.Label</label></div>}</div><button class="btn btn-primary">@Localizer["Send sourcing invitations"]</button><a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.Request.Id" class="btn btn-outline-secondary">@Localizer["Back"]</a></form>
