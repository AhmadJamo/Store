@model MiniStore.Application.DTOs.Purchases.PurchaseSourcingDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ Layout = null; var numberSettings = await GeneralSettingsService.GetAsync(); }
<!doctype html><html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")"><head><meta charset="utf-8" /><title>@Model.SourcingNumber</title><style>body{font-family:Arial,sans-serif;margin:28px;color:#222}.header{display:flex;justify-content:space-between;border-bottom:2px solid #333;padding-bottom:12px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0}table{width:100%;border-collapse:collapse}th,td{border:1px solid #999;padding:8px;text-align:start}.actions{margin-bottom:18px}@@media print{.actions{display:none}body{margin:0}}</style></head><body><div class="actions"><button onclick="window.print()">@Localizer["Print / Save PDF"]</button></div><div class="header"><div><h1>@Localizer["Request for quotation"]</h1><strong>@Model.SourcingNumber</strong></div><div>@Localizer[Model.Path.ToString()]</div></div><div class="meta"><div><strong>@Localizer["Warehouse"]:</strong> @Model.WarehouseName</div><div><strong>@Localizer["Buyer reference"]:</strong> @(Model.BuyerReference ?? "—")</div><div><strong>@Localizer["Supplier response deadline"]:</strong> @Model.SupplierResponseDeadline</div><div><strong>@Localizer["Expected delivery date"]:</strong> @Model.RequestedByDate</div></div><table><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Unit"]</th><th>@Localizer["Notes"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductCode — @line.ProductName</td><td>@line.RequestedQuantity.ToQuantityDisplay(numberSettings)</td><td>@line.UnitName</td><td>@Localizer[line.Notes ?? string.Empty]</td></tr>}</tbody></table><h3>@Localizer["Suppliers"]</h3><ul>@foreach(var supplier in Model.Invitations){<li>@supplier.SupplierName</li>}</ul></body></html>
