@model MiniStore.Application.DTOs.Purchases.DirectPurchaseSourcingCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Direct RFQ"]; }
<div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2>@Localizer["Direct RFQ"]</h2><p class="text-muted mb-0">@Localizer["Send a request for quotation directly when it is inside the configured company policy."]</p></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
@if(!Model.Policy.AllowDirectRfq){<div class="alert alert-warning">@Localizer["Direct RFQ creation is disabled by company policy. Create a purchase request instead."] <a asp-controller="PurchaseRequests" asp-action="Create" class="alert-link">@Localizer["Create purchase request"]</a></div>}
else
{
<div class="alert alert-info">@Localizer["Direct RFQ limit"]: <strong>@Model.Policy.MaximumEstimatedAmountCompanyCurrency @Model.CompanyCurrencyCode</strong>@if(!string.IsNullOrWhiteSpace(Model.Policy.AllowedRoleName)){<span> — @Localizer["Required role"]: @Model.Policy.AllowedRoleName</span>}</div>
<form asp-action="Direct" method="post" enctype="multipart/form-data" id="direct-rfq-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label">@Localizer["Destination warehouse"]</label><select asp-for="Form.WarehouseId" class="form-select" required><option value="">@Localizer["Select warehouse"]</option>@foreach(var item in Model.Warehouses){<option value="@item.Id">@item.Label</option>}</select></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Supplier response deadline"]</label><input asp-for="Form.SupplierResponseDeadline" type="date" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Expected delivery date"]</label><input asp-for="Form.ExpectedDeliveryDate" type="date" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Buyer reference"]</label><input asp-for="Form.BuyerReference" maxlength="100" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Estimated amount"] (@Model.CompanyCurrencyCode)</label><input asp-for="Form.EstimatedAmountCompanyCurrency" type="number" min="0.000001" max="@Model.Policy.MaximumEstimatedAmountCompanyCurrency" step="0.000001" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Attachments"]</label><input name="attachments" type="file" multiple class="form-control" /><div class="form-text">@Localizer["Up to 10 files, 5 MB per file."]</div></div>
        <div class="col-md-6"><label class="form-label">@Localizer["Invitation message"]</label><textarea asp-for="Form.InvitationMessage" maxlength="1000" class="form-control"></textarea></div>
        <div class="col-md-6"><label class="form-label">@Localizer["Internal notes"]</label><textarea asp-for="Form.Notes" maxlength="1000" class="form-control"></textarea></div>
    </div>
    <h5 class="mt-4">@Localizer["Requested items"]</h5><div id="direct-lines">@for(var index=0; index<Model.Form.Lines.Count; index++){var line=Model.Form.Lines[index];<div class="row g-2 mb-2 direct-line"><div class="col-md-4"><select name="Form.Lines[@index].ProductId" data-name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var item in Model.Products){<option value="@item.Id" selected="@(item.Id==line.ProductId)">@item.Label</option>}</select></div><div class="col-md-3"><select name="Form.Lines[@index].MeasurementUnitId" data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var item in Model.Units){<option value="@item.Id" selected="@(item.Id==line.MeasurementUnitId)">@item.Label</option>}</select></div><div class="col-md-2"><input name="Form.Lines[@index].RequestedQuantity" data-name="RequestedQuantity" value="@line.RequestedQuantity" type="number" min="0.000001" step="0.000001" class="form-control" required /></div><div class="col-md-2"><input name="Form.Lines[@index].Notes" data-name="Notes" value="@line.Notes" maxlength="500" class="form-control" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-direct-line">×</button></div></div>}</div><button type="button" id="add-direct-line" class="btn btn-outline-secondary mb-3">@Localizer["Add line"]</button>
    <h5>@Localizer["Suppliers to invite"]</h5><div class="card card-body mb-3">@foreach(var supplier in Model.Suppliers){<div class="form-check"><input class="form-check-input" type="checkbox" name="Form.SupplierIds" value="@supplier.Id" id="direct-supplier-@supplier.Id" checked="@(Model.Form.SupplierIds.Contains(supplier.Id))" /><label class="form-check-label" for="direct-supplier-@supplier.Id">@supplier.Label</label></div>}</div>
    <button class="btn btn-primary">@Localizer["Send direct RFQ"]</button> <a asp-controller="PurchaseRequests" asp-action="Create" class="btn btn-outline-secondary">@Localizer["Use approval path"]</a>
</form>
<template id="direct-line-template"><div class="row g-2 mb-2 direct-line"><div class="col-md-4"><select data-name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var item in Model.Products){<option value="@item.Id">@item.Label</option>}</select></div><div class="col-md-3"><select data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var item in Model.Units){<option value="@item.Id">@item.Label</option>}</select></div><div class="col-md-2"><input data-name="RequestedQuantity" type="number" min="0.000001" step="0.000001" class="form-control" placeholder="@Localizer["Quantity"]" required /></div><div class="col-md-2"><input data-name="Notes" maxlength="500" class="form-control" placeholder="@Localizer["Notes"]" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-direct-line">×</button></div></div></template>
<script>document.addEventListener('DOMContentLoaded',()=>{const box=document.getElementById('direct-lines'),tpl=document.getElementById('direct-line-template');function reindex(){[...box.children].forEach((row,index)=>row.querySelectorAll('[data-name]').forEach(input=>input.name=`Form.Lines[${index}].${input.dataset.name}`));}function add(){box.append(tpl.content.cloneNode(true));reindex();}document.getElementById('add-direct-line').addEventListener('click',add);box.addEventListener('click',event=>{if(event.target.classList.contains('remove-direct-line')){event.target.closest('.direct-line').remove();reindex();}});if(box.children.length===0)add();});</script>
}
