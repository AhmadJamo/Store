@model List<MiniStore.Application.DTOs.Purchases.PurchaseSourcingDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Localizer["Purchase sourcing"]; var canCreateDirect = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseSourcing.CreateDirect")).Succeeded; }
<div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h2>@Localizer["Purchase sourcing"]</h2><p class="text-muted mb-0">@Localizer["Approved requests and policy-controlled direct RFQs sent to suppliers."]</p></div>@if(canCreateDirect){<a asp-action="Direct" class="btn btn-primary">@Localizer["New direct RFQ"]</a>}</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="status" class="form-select"><option value="">@Localizer["All statuses"]</option>@foreach(var value in Enum.GetValues<PurchaseSourcingStatus>()){<option value="@value" selected="@(ViewBag.Status?.ToString()==value.ToString())">@Localizer[value.ToString()]</option>}</select></div><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Search"]" /></div><div class="col-md-2"><button class="btn btn-outline-primary">@Localizer["Filter"]</button></div></form>
<div class="row g-3">@foreach(var item in Model){<div class="col-md-6 col-xl-4"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between gap-2"><h5 class="card-title">@item.SourcingNumber</h5><span class="badge bg-secondary">@Localizer[item.Status.ToString()]</span></div><div class="small text-muted mb-2">@Localizer[item.Path.ToString()]</div><dl class="row mb-2"><dt class="col-5">@Localizer["Purchase request"]</dt><dd class="col-7">@(item.PurchaseRequestNumber ?? Localizer["Direct path"].Value)</dd><dt class="col-5">@Localizer["Warehouse"]</dt><dd class="col-7">@item.WarehouseName</dd><dt class="col-5">@Localizer["Response deadline"]</dt><dd class="col-7">@item.SupplierResponseDeadline</dd><dt class="col-5">@Localizer["Suppliers"]</dt><dd class="col-7">@item.Invitations.Count</dd></dl><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></div></div></div>}</div>
@if(Model.Count==0){<div class="alert alert-info">@Localizer["No sourcing events found."]</div>}
