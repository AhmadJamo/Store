@model List<MiniStore.Application.DTOs.Purchases.PurchaseSourcingDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Purchase sourcing"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>@Localizer["Purchase sourcing"]</h2><p class="text-muted mb-0">@Localizer["Approved requests sent to suppliers for quotations."]</p></div></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="status" class="form-select"><option value="">@Localizer["All statuses"]</option>@foreach(var value in Enum.GetValues<PurchaseSourcingStatus>()){<option value="@value" selected="@(ViewBag.Status?.ToString()==value.ToString())">@Localizer[value.ToString()]</option>}</select></div><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Search"]" /></div><div class="col-md-2"><button class="btn btn-outline-primary">@Localizer["Filter"]</button></div></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Localizer["Sourcing number"]</th><th>@Localizer["Purchase request"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Status"]</th><th>@Localizer["Suppliers"]</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.SourcingNumber</td><td>@item.PurchaseRequestNumber</td><td>@item.WarehouseName</td><td>@Localizer[item.Status.ToString()]</td><td>@item.Invitations.Count</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr>}</tbody></table></div>
@if(Model.Count==0){<div class="alert alert-info">@Localizer["No sourcing events found."]</div>}
