@model MiniStore.Application.DTOs.Purchases.PurchaseSourcingDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.SourcingNumber; var canCreateQuotation = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierQuotations.Create")).Succeeded; var canViewComparison = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierQuotations.View")).Succeeded; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex justify-content-between align-items-start gap-3"><div><h2>@Model.SourcingNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span> <span class="badge bg-info text-dark">@Localizer[Model.Path.ToString()]</span></div><div><a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary">@Localizer["Print / Save PDF"]</a> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-2"><div class="col-md-6"><strong>@Localizer["Purchase request"]:</strong> @(Model.PurchaseRequestNumber ?? Localizer["Direct path"].Value)</div><div class="col-md-6"><strong>@Localizer["Warehouse"]:</strong> @Model.WarehouseName</div><div class="col-md-6"><strong>@Localizer["Supplier response deadline"]:</strong> @Model.SupplierResponseDeadline</div><div class="col-md-6"><strong>@Localizer["Expected delivery date"]:</strong> @Model.RequestedByDate</div><div class="col-md-6"><strong>@Localizer["Buyer reference"]:</strong> @(Model.BuyerReference ?? "—")</div><div class="col-md-6"><strong>@Localizer["Estimated amount"]:</strong> @Model.EstimatedAmountCompanyCurrency.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode</div>@if(!string.IsNullOrWhiteSpace(Model.Notes)){<div class="col-12"><strong>@Localizer["Internal notes"]:</strong> @Model.Notes</div>}</div></div>
<h5>@Localizer["Requested items"]</h5><div class="row g-2">@foreach(var line in Model.Lines){<div class="col-md-6"><div class="card card-body h-100"><strong>@line.ProductCode — @line.ProductName</strong><span>@Localizer["Requested quantity"]: @line.RequestedQuantity.ToQuantityDisplay(numberSettings) @line.UnitName</span>@if(!string.IsNullOrWhiteSpace(line.Notes)){<small class="text-muted">@line.Notes</small>}</div></div>}</div>
<h5 class="mt-3">@Localizer["Invited suppliers"]</h5><ul class="list-group">@foreach(var invitation in Model.Invitations){<li class="list-group-item">@invitation.SupplierName @if(invitation.Message is not null){<span>— @invitation.Message</span>}</li>}</ul>
@if(Model.Attachments.Count>0){<h5 class="mt-3">@Localizer["Attachments"]</h5><ul class="list-group">@foreach(var attachment in Model.Attachments){<li class="list-group-item d-flex justify-content-between"><span>@attachment.FileName <small class="text-muted">(@(attachment.Size / 1024) KB)</small></span><a asp-action="Attachment" asp-route-id="@Model.Id" asp-route-attachmentId="@attachment.Id">@Localizer["Download"]</a></li>}</ul>}
<div class="mt-3">@if(canCreateQuotation){<a asp-controller="SupplierQuotations" asp-action="Create" asp-route-sourcingEventId="@Model.Id" class="btn btn-primary">@Localizer["Enter supplier quotation"]</a>}@if(canViewComparison){<a asp-controller="SupplierQuotations" asp-action="Comparison" asp-route-sourcingEventId="@Model.Id" class="btn btn-outline-primary">@Localizer["Quotation comparison"]</a>}</div>
