@model MiniStore.Application.DTOs.Purchases.PurchaseSourcingDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject MiniStore.Application.Services.SupplierCommunicationService SupplierCommunicationService
@inject MiniStore.Application.Services.SupplierIntegrationService SupplierIntegrationService
@{ ViewData["Title"] = Model.SourcingNumber; var canCreateQuotation = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierQuotations.Create")).Succeeded; var canViewComparison = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierQuotations.View")).Succeeded; var canPrepareEmail=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierCommunications.Prepare")).Succeeded; var canViewSupplierCommunication=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierCommunications.View")).Succeeded; var canManageIntegration=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierIntegrations.Manage")).Succeeded; var communications=canViewSupplierCommunication?await SupplierCommunicationService.GetByDocumentAsync(SupplierCommunicationDocumentType.Rfq,Model.Id):new List<MiniStore.Application.DTOs.Purchases.SupplierCommunicationDto>(); var portalAccesses=canManageIntegration?await SupplierIntegrationService.GetPortalAccessesAsync(SupplierExternalDocumentType.Rfq,Model.Id):new List<MiniStore.Application.DTOs.Purchases.SupplierPortalAccessDto>(); var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex justify-content-between align-items-start gap-3"><div><h2>@Model.SourcingNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span> <span class="badge bg-info text-dark">@Localizer[Model.Path.ToString()]</span></div><div><a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary">@Localizer["Print / Save PDF"]</a> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-2"><div class="col-md-6"><strong>@Localizer["Purchase request"]:</strong> @(Model.PurchaseRequestNumber ?? Localizer["Direct path"].Value)</div><div class="col-md-6"><strong>@Localizer["Warehouse"]:</strong> @Model.WarehouseName</div><div class="col-md-6"><strong>@Localizer["Supplier response deadline"]:</strong> @Model.SupplierResponseDeadline</div><div class="col-md-6"><strong>@Localizer["Expected delivery date"]:</strong> @Model.RequestedByDate</div><div class="col-md-6"><strong>@Localizer["Buyer reference"]:</strong> @(Model.BuyerReference ?? "—")</div><div class="col-md-6"><strong>@Localizer["Estimated amount"]:</strong> @Model.EstimatedAmountCompanyCurrency.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode</div>@if(!string.IsNullOrWhiteSpace(Model.Notes)){<div class="col-12"><strong>@Localizer["Internal notes"]:</strong> @Model.Notes</div>}</div></div>
<h5>@Localizer["Requested items"]</h5><div class="row g-2">@foreach(var line in Model.Lines){<div class="col-md-6"><div class="card card-body h-100"><strong>@line.ProductCode — @line.ProductName</strong><span>@Localizer["Requested quantity"]: @line.RequestedQuantity.ToQuantityDisplay(numberSettings) @line.UnitName</span>@if(!string.IsNullOrWhiteSpace(line.Notes)){<small class="text-muted">@Localizer[line.Notes]</small>}</div></div>}</div>
<h5 class="mt-3">@Localizer["Invited suppliers"]</h5><div class="row g-2">@foreach(var invitation in Model.Invitations){var supplierAccesses=portalAccesses.Where(x=>x.SupplierId==invitation.SupplierId).ToList();var hasActivePortalAccess=supplierAccesses.Any(x=>!x.IsRevoked&&x.ExpiresAtUtc>DateTime.UtcNow);<div class="col-md-6"><div class="card card-body h-100"><strong>@invitation.SupplierName</strong>@if(invitation.Message is not null){<span>@invitation.Message</span>}@if((canPrepareEmail||canManageIntegration)&&Model.Status is PurchaseSourcingStatus.Sent or PurchaseSourcingStatus.Closed){<div class="d-flex flex-wrap gap-2 mt-2">@if(canPrepareEmail){<form asp-controller="SupplierCommunications" asp-action="Prepare" method="post"><input type="hidden" name="DocumentType" value="Rfq"/><input type="hidden" name="DocumentId" value="@Model.Id"/><input type="hidden" name="SupplierId" value="@invitation.SupplierId"/><input type="hidden" name="PreferredLanguage" value="ar-JO"/><button class="btn btn-sm btn-outline-primary">@Localizer["Prepare Arabic RFQ email"]</button></form><form asp-controller="SupplierCommunications" asp-action="Prepare" method="post"><input type="hidden" name="DocumentType" value="Rfq"/><input type="hidden" name="DocumentId" value="@Model.Id"/><input type="hidden" name="SupplierId" value="@invitation.SupplierId"/><input type="hidden" name="PreferredLanguage" value="en-US"/><button class="btn btn-sm btn-outline-primary">@Localizer["Prepare English RFQ email"]</button></form>}@if(canManageIntegration&&!hasActivePortalAccess){<form asp-controller="SupplierIntegrations" asp-action="CreatePortalAccess" method="post"><input type="hidden" name="DocumentType" value="Rfq"/><input type="hidden" name="DocumentId" value="@Model.Id"/><input type="hidden" name="SupplierId" value="@invitation.SupplierId"/><input type="hidden" name="ValidDays" value="14"/><button class="btn btn-sm btn-outline-success">@Localizer["Create private supplier portal link"]</button></form>}</div>}@foreach(var access in supplierAccesses){<div class="border-top mt-2 pt-2 small"><span class="badge @(access.IsRevoked||access.ExpiresAtUtc<=DateTime.UtcNow?"bg-secondary":"bg-success")">@(access.IsRevoked?Localizer["Revoked"]:access.ExpiresAtUtc<=DateTime.UtcNow?Localizer["Expired"]:Localizer["Active portal access"])</span> · @Localizer["Expires at"] @access.ExpiresAtUtc.ToLocalTime() @if(!access.IsRevoked&&access.ExpiresAtUtc>DateTime.UtcNow){<form asp-controller="SupplierIntegrations" asp-action="RevokePortalAccess" method="post" class="d-inline"><input type="hidden" name="id" value="@access.Id"/><input type="hidden" name="documentType" value="Rfq"/><input type="hidden" name="documentId" value="@Model.Id"/><button class="btn btn-sm btn-link text-danger">@Localizer["Revoke"]</button></form>}</div>}</div></div>}</div>
@if(communications.Count>0){<div class="card card-body mt-3"><h5>@Localizer["Communication history"]</h5><div class="row g-2">@foreach(var communication in communications){<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@communication.SupplierName</strong><span class="badge bg-secondary">@Localizer[communication.Status.ToString()]</span></div><div class="small text-muted">@communication.PreferredLanguage · @communication.CreatedAtUtc.ToLocalTime()</div><a asp-controller="SupplierCommunications" asp-action="Details" asp-route-id="@communication.Id" class="btn btn-sm btn-outline-secondary mt-2">@Localizer["Open communication"]</a></div></div>}</div></div>}
@if(Model.Attachments.Count>0){<h5 class="mt-3">@Localizer["Attachments"]</h5><ul class="list-group">@foreach(var attachment in Model.Attachments){<li class="list-group-item d-flex justify-content-between"><span>@attachment.FileName <small class="text-muted">(@(attachment.Size / 1024) KB)</small></span><a asp-action="Attachment" asp-route-id="@Model.Id" asp-route-attachmentId="@attachment.Id">@Localizer["Download"]</a></li>}</ul>}
<div class="mt-3">@if(canCreateQuotation){<a asp-controller="SupplierQuotations" asp-action="Create" asp-route-sourcingEventId="@Model.Id" class="btn btn-primary">@Localizer["Enter supplier quotation"]</a>}@if(canViewComparison){<a asp-controller="SupplierQuotations" asp-action="Comparison" asp-route-sourcingEventId="@Model.Id" class="btn btn-outline-primary">@Localizer["Quotation comparison"]</a>}</div>
