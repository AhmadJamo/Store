@using System.Globalization
@{ var ar = CultureInfo.CurrentUICulture.Name.StartsWith("ar"); var culture = ar ? "en-US" : "ar-JO"; }
<!doctype html><html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - MiniStore ERP</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap@(ar ? ".rtl" : "").min.css"><style>body{background:#07111f;color:#eef5ff}.glass{background:#101e30;border:1px solid #253650;border-radius:24px}.hero{padding:7rem 0}.muted{color:#a9b8ca}.accent{color:#55d6be}.plan{transition:.2s}.plan:hover{transform:translateY(-5px);border-color:#55d6be}.navbar{background:#07111fee}.btn-accent{background:#55d6be;color:#07111f;font-weight:700}</style></head><body><nav class="navbar navbar-expand-lg navbar-dark sticky-top"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Public" asp-action="Index">MiniStore</a><div class="d-flex gap-2"><a class="btn btn-link text-light" asp-controller="Public" asp-action="Pricing">@(ar ? "الأسعار" : "Pricing")</a><a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">@(ar ? "تسجيل الدخول" : "Login")</a><form asp-controller="Language" asp-action="Set" method="post"><input type="hidden" name="culture" value="@culture"><input type="hidden" name="returnUrl" value="@Context.Request.Path"><button class="btn btn-accent">@(ar ? "English" : "العربية")</button></form></div></div></nav><main>@RenderBody()</main><footer class="container py-5 muted border-top border-secondary mt-5">© @DateTime.UtcNow.Year MiniStore ERP</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
