@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@if (TempData["NotificationMessage"] is { } notification)
{
    var type = TempData["NotificationType"]?.ToString() ?? "info";
    var title = type switch { "success" => "Success", "error" => "Error", "warning" => "Warning", _ => "Information" };
    var alertClass = type switch { "success" => "alert-success", "error" => "alert-danger", "warning" => "alert-warning", _ => "alert-info" };
    var message = notification.ToString() ?? string.Empty;

    <div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer[title]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body"><div class="alert @alertClass mb-0">@Localizer[message]</div></div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button></div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () =>
            new bootstrap.Modal(document.getElementById('notificationModal')).show());
    </script>
}
