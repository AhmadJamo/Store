@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{
    var culture = CultureInfo.CurrentUICulture;
    var isArabic = culture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var direction = isArabic ? "rtl" : "ltr";
    var targetCulture = isArabic
        ? MiniStore.Web.Localization.SupportedUiCultures.English
        : MiniStore.Web.Localization.SupportedUiCultures.Arabic;
    var languageLabel = isArabic ? Localizer["Switch to English"] : Localizer["Switch to Arabic"];
    var pageTitle = ViewData["Title"]?.ToString() ?? "MiniStore";
}

<!DOCTYPE html>
<html lang="@culture.Name" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer[pageTitle] - MiniStore</title>
    <link rel="stylesheet"
          href="@(isArabic ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar { box-shadow: 0 2px 8px rgba(0, 0, 0, .08); }
        .navbar-brand { font-weight: 700; letter-spacing: .3px; }
        .navbar-nav .nav-link { font-weight: 500; padding-inline: .8rem; }
        .navbar-nav .nav-link:hover { color: #fff; }
        .dropdown-menu { border: 0; border-radius: 10px; box-shadow: 0 8px 25px rgba(0, 0, 0, .12); padding: .5rem; min-width: 220px; }
        .dropdown-item { border-radius: 7px; padding: .6rem .75rem; font-weight: 500; }
        .dropdown-item:hover { background-color: #f1f3f5; }
        .dropdown-item.active { font-weight: 600; }
        .dropdown-item i { width: 22px; margin-inline-end: 6px; }
        .user-menu { border-inline-start: 1px solid rgba(255, 255, 255, .15); padding-inline-start: 1rem; }
        .user-name { color: rgba(255, 255, 255, .9); font-weight: 500; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-shop"></i> MiniStore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                @{
                    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @foreach (var group in NavigationDefinitions.All.OrderBy(x => x.Order))
                    {
                        var visibleItems = new List<NavigationItem>();
                        foreach (var item in group.Items)
                        {
                            if (await PermissionService.CanAsync(currentUserId ?? "System", item.Permission))
                                visibleItems.Add(item);
                        }

                        if (visibleItems.Count == 0) continue;

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi @group.Icon"></i> @Localizer[group.Title]
                            </a>
                            <ul class="dropdown-menu">
                                @foreach (var item in visibleItems)
                                {
                                    var isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                                    <li>
                                        <a class="dropdown-item @(isActive ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action">
                                            <i class="bi @item.Icon"></i> @Localizer[item.Title]
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 user-menu">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-outline-light btn-sm" href="/subscription"><i class="bi bi-credit-card"></i> @Localizer["Subscription"]</a>
                    }
                    <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
                        <input type="hidden" name="culture" value="@targetCulture" />
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}")" />
                        <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-translate"></i> @languageLabel</button>
                    </form>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="user-name"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @await Html.PartialAsync("_Notification")
        @await Html.PartialAsync("_ConfirmDelete")
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
