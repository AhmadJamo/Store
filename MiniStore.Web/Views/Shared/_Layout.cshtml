<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">MiniStore</a>

            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav me-auto">
                    @if (await PermissionService.CanAsync(User, "Products.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "Warehouses.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Warehouses" asp-action="Index">Warehouses</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "ProductStock.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="ProductStocks" asp-action="Index">Product Stock</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "StockTransactions.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="StockTransactions" asp-action="Index">Stock Transactions</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "Suppliers.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "Purchases.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Purchases" asp-action="Index">Purchases</a></li>
                    }
                    @if (await PermissionService.CanAsync(User, "Sales.View"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Index">Sales</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Roles" asp-action="Index">Roles</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Settings" asp-action="Invoices">Invoice Settings</a></li>
                    }
                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text me-3">Hello, @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @await Html.PartialAsync("_Notification")
        @await Html.PartialAsync("_ConfirmDelete")
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
