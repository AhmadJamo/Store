@model MiniStore.Application.DTOs.Purchases.PurchaseReturnDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"]=Localizer["Purchase return details"]; }
<div class="container mt-4"><div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="h3">@Localizer["Purchase return details"]</h1><div class="text-muted">@Model.ReturnNumber · @Model.PurchaseInvoiceNumber</div></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<div class="row g-3 mb-4"><div class="col-md-3"><strong>@Localizer["Supplier"]</strong><div>@Model.SupplierName</div></div><div class="col-md-3"><strong>@Localizer["Date"]</strong><div>@Model.Date.ToString("yyyy-MM-dd")</div></div><div class="col-md-3"><strong>@Localizer["Supplier credit"]</strong><div>@Model.PayableAmount.ToString("0.00") JOD</div></div><div class="col-md-3"><strong>@Localizer["Removed inventory cost"]</strong><div>@Model.RemovedInventoryCost.ToString("0.00") JOD</div></div></div>
<div class="alert alert-secondary"><strong>@Localizer["Return reason"]:</strong> @Model.Reason</div><div class="table-responsive"><table class="table table-bordered align-middle"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Return quantity"]</th><th>@Localizer["Supplier credit"]</th><th>@Localizer["Removed inventory cost"]</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.ProductName</td><td>@item.WarehouseName</td><td>@item.Quantity</td><td>@item.PayableAmount.ToString("0.00")</td><td>@item.RemovedInventoryCost.ToString("0.00")</td></tr>}</tbody></table></div></div>
