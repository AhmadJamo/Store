@model List<MiniStore.Application.DTOs.Purchases.PurchaseReturnDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Purchase returns"]; }
<div class="container mt-4">
    <h1 class="h3 mb-4">@Localizer["Purchase returns"]</h1>
    <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>@Localizer["Return number"]</th><th>@Localizer["Original purchase"]</th><th>@Localizer["Supplier"]</th><th>@Localizer["Date"]</th><th>@Localizer["Supplier credit"]</th><th></th></tr></thead>
        <tbody>@foreach (var item in Model) { <tr><td>@item.ReturnNumber</td><td>@item.PurchaseInvoiceNumber</td><td>@item.SupplierName</td><td>@item.Date.ToString("yyyy-MM-dd")</td><td>@item.PayableAmount.ToString("0.00") JOD</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr> }</tbody>
    </table></div></div>
</div>
