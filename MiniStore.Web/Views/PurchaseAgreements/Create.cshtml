@model MiniStore.Application.DTOs.Purchases.PurchaseAgreementCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Create purchase agreement"];var numberSettings=await GeneralSettingsService.GetAsync();}
<h2>@Localizer["Create purchase agreement"]</h2><div class="card card-body mb-3"><div>@Localizer["Quotation number"]: @Model.QuotationNumber</div><div>@Localizer["Supplier"]: @Model.SupplierName</div><div>@Localizer["Warehouse"]: @Model.WarehouseName</div></div>
<form asp-action="Create" method="post"><input type="hidden" name="SourcingEventId" value="@Model.SourcingEventId"/><div class="row g-2 mb-3"><div class="col-md-3"><label class="form-label">@Localizer["Valid from"]</label><input type="date" name="ValidFrom" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Valid until"]</label><input type="date" name="ValidUntil" value="@DateOnly.FromDateTime(DateTime.Today.AddYears(1)).ToString("yyyy-MM-dd")" class="form-control" required/></div></div><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Quoted quantity"]</th><th>@Localizer["Maximum contracted quantity"]</th></tr></thead><tbody>@for(var i=0;i<Model.Lines.Count;i++){<tr><td>@Model.Lines[i].Product</td><td>@Model.Lines[i].QuotedQuantity.ToQuantityDisplay(numberSettings) @Model.Lines[i].UnitName</td><td><input type="hidden" name="Lines[@i].SupplierQuotationLineId" value="@Model.Lines[i].SupplierQuotationLineId"/><input type="number" name="Lines[@i].MaximumQuantity" value="@Model.Lines[i].QuotedQuantity.ToQuantityInput(numberSettings)" min="0" step="0.001" class="form-control"/></td></tr>}</tbody></table><button class="btn btn-primary">@Localizer["Create agreement"]</button></form>
