@model MiniStore.Application.DTOs.Purchases.PurchaseAgreementDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Model.AgreementNumber;var rv=Convert.ToBase64String(Model.RowVersion);var canActivate=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseAgreements.Activate")).Succeeded;var canRelease=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseAgreements.Release")).Succeeded;var canCancel=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseAgreements.Cancel")).Succeeded;var numberSettings=await GeneralSettingsService.GetAsync();var hasRemainingQuantity=Model.Lines.Any(x=>x.RemainingQuantity>0);}
<div class="d-flex justify-content-between"><h2>@Model.AgreementNumber <span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></h2><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div><div class="card card-body my-3"><div>@Localizer["Supplier"]: @Model.SupplierName</div><div>@Localizer["Warehouse"]: @Model.WarehouseName</div><div>@Localizer["Validity"]: @Model.ValidFrom — @Model.ValidUntil</div></div>
<form asp-action="Release" method="post"><input type="hidden" name="AgreementId" value="@Model.Id"/><div class="mb-2 col-md-3"><label class="form-label">@Localizer["Expected date"]</label><input type="date" name="ExpectedDate" value="@DateOnly.FromDateTime(DateTime.Today.AddDays(7)).ToString("yyyy-MM-dd")" class="form-control"/></div><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Contracted quantity"]</th><th>@Localizer["Released quantity"]</th><th>@Localizer["Remaining quantity"]</th><th>@Localizer["Release quantity"]</th><th>@Localizer["Unit price"]</th></tr></thead><tbody>@for(var i=0;i<Model.Lines.Count;i++){var x=Model.Lines[i];<tr><td>@x.Product</td><td>@x.MaximumQuantity.ToQuantityDisplay(numberSettings) @x.UnitName</td><td>@x.ReleasedQuantity.ToQuantityDisplay(numberSettings)</td><td>@x.RemainingQuantity.ToQuantityDisplay(numberSettings)</td><td><input type="hidden" name="Lines[@i].AgreementLineId" value="@x.Id"/><input type="number" name="Lines[@i].Quantity" min="0" max="@x.RemainingQuantity.ToInputNumber()" step="0.001" value="0" class="form-control" disabled="@(!hasRemainingQuantity)"/></td><td>@x.UnitPrice.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td></tr>}</tbody></table>@if(Model.Status==PurchaseAgreementStatus.Active&&hasRemainingQuantity&&canRelease){<button class="btn btn-primary">@Localizer["Create release order draft"]</button>}else if(Model.Status==PurchaseAgreementStatus.Active&&!hasRemainingQuantity){<span class="badge bg-success">@Localizer["Agreement completed"]</span>}</form>
<div class="mt-3">@if(Model.Status==PurchaseAgreementStatus.Draft&&canActivate){<form asp-action="Activate" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Activate agreement"]</button></form>}else if(Model.Status==PurchaseAgreementStatus.Active){<span class="badge bg-success">@Localizer["Agreement activated"]</span>}@if(Model.Status!=PurchaseAgreementStatus.Cancelled&&canCancel){<form asp-action="Cancel" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rv"/><input name="reason" required maxlength="1000" class="form-control d-inline-block w-auto" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel"]</button></form>}</div>
