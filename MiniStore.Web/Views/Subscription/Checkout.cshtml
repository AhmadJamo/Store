@model MiniStore.Application.Saas.CheckoutQuoteDto
@using System.Globalization
@{ ViewData["Title"]="Checkout"; var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); }
<div class="card border-0 shadow-sm p-4 mx-auto" style="max-width:650px"><h1>@(ar?"طلب الدفع":"Checkout request")</h1><p class="text-muted">@(ar?"تم إنشاء طلب آمن لمدة 30 دقيقة. لا يتم تفعيل الخطة إلا بعد تأكيد عملية الدفع.":"A secure 30-minute checkout was created. The plan activates only after payment confirmation.")</p><table class="table"><tr><th>@(ar?"الخطة":"Plan")</th><td>@Model.PlanName</td></tr><tr><th>@(ar?"المبلغ":"Subtotal")</th><td>@Model.Subtotal @Model.Currency</td></tr><tr><th>@(ar?"الخصم":"Discount")</th><td>-@Model.DiscountAmount @Model.Currency</td></tr><tr class="fw-bold"><th>@(ar?"الإجمالي":"Total")</th><td>@Model.Total @Model.Currency</td></tr></table><div class="alert alert-info">@(ar?"لم يتم إعداد مزود دفع إلكتروني بعد. يظهر الطلب حالياً في مركز المنصة ليؤكده موظف الفوترة بعد استلام الدفع.":"No online payment provider is configured yet. The request is available to platform billing staff for confirmation after payment is received.")</div><code>@Model.SessionId</code></div>
