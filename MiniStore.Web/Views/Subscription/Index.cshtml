@model IReadOnlyList<MiniStore.Application.Saas.PlanCardDto>
@using System.Globalization
@{ ViewData["Title"]="Subscription"; var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); }
<div class="d-flex justify-content-between align-items-start"><div><h1>@(ar?"الاشتراك والخطة":"Subscription & plan")</h1><p class="text-muted">@(ar?"اختر دورة الفوترة ويمكنك إدخال كود خصم قبل إنشاء طلب الدفع.":"Choose a billing cycle and optionally apply a promo code before creating checkout.")</p></div></div>
<div class="row g-4 mt-2">@foreach(var p in Model){<div class="col-lg-4"><form asp-action="Checkout" method="post" class="card shadow-sm h-100 border-0 p-4"><input type="hidden" name="planId" value="@p.Id"><h3>@(ar?p.NameArabic:p.NameEnglish)</h3><p class="text-muted">@(ar?p.DescriptionArabic:p.DescriptionEnglish)</p><label class="form-label">@(ar?"دورة الفوترة":"Billing cycle")</label><select name="cycle" class="form-select"><option value="1">@(ar?"شهري":"Monthly") — @p.MonthlyPrice @p.Currency</option><option value="2">@(ar?"سنوي":"Annual") — @p.AnnualPrice @p.Currency</option></select><label class="form-label mt-3">@(ar?"كود الخصم":"Promo code")</label><input name="promotionCode" class="form-control" maxlength="40"><button class="btn btn-primary mt-4">@(ar?"متابعة للدفع":"Continue to checkout")</button></form></div>}</div>
