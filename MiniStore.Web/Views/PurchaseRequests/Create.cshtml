@model MiniStore.Application.DTOs.Purchases.PurchaseRequestCreatePageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["New purchase request"];}
<h2>@Localizer["New purchase request"]</h2><div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Create" method="post" id="request-form"><div class="row g-3"><div class="col-md-4"><label class="form-label">@Localizer["Destination warehouse"]</label><select name="WarehouseId" class="form-select" required><option value="">@Localizer["Select warehouse"]</option>@foreach(var x in Model.Warehouses){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-4"><label class="form-label">@Localizer["Needed by"]</label><input name="NeededByDate" type="date" value="@Model.Form.NeededByDate.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="col-md-4"><label class="form-label">@Localizer["Priority"]</label><select name="Priority" class="form-select">@foreach(var x in Enum.GetValues<PurchaseRequestPriority>()){<option value="@x">@Localizer[x.ToString()]</option>}</select></div><div class="col-12"><label class="form-label">@Localizer["Justification"]</label><textarea name="Justification" maxlength="500" class="form-control" required>@Model.Form.Justification</textarea></div><div class="col-12"><label class="form-label">@Localizer["Notes"]</label><textarea name="Notes" maxlength="1000" class="form-control">@Model.Form.Notes</textarea></div></div>
<h5 class="mt-4">@Localizer["Request lines"]</h5><div id="lines"></div><button type="button" id="add-line" class="btn btn-outline-secondary mb-3">@Localizer["Add line"]</button><div><button class="btn btn-primary">@Localizer["Create draft"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a></div></form>
<template id="line-template"><div class="row g-2 mb-2 request-line"><div class="col-md-3"><select data-name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-2"><select data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var x in Model.Units){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-2"><input data-name="RequestedQuantity" type="number" min="0.000001" step="0.000001" class="form-control" placeholder="@Localizer["Quantity"]" required /></div><div class="col-md-2"><select data-name="SuggestedSupplierId" class="form-select"><option value="">@Localizer["Suggested supplier"]</option>@foreach(var x in Model.Suppliers){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-2"><input data-name="Notes" maxlength="500" class="form-control" placeholder="@Localizer["Notes"]" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-line">×</button></div></div></template>
<script>document.addEventListener('DOMContentLoaded',()=>{const box=document.getElementById('lines'),tpl=document.getElementById('line-template');function reindex(){[...box.children].forEach((r,i)=>r.querySelectorAll('[data-name]').forEach(x=>x.name=`Lines[${i}].${x.dataset.name}`));}function add(){box.append(tpl.content.cloneNode(true));reindex();}document.getElementById('add-line').onclick=add;box.addEventListener('click',e=>{if(e.target.classList.contains('remove-line')){e.target.closest('.request-line').remove();reindex();}});add();});</script>
