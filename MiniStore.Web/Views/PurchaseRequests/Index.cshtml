@model List<MiniStore.Application.DTOs.Purchases.PurchaseRequestDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Purchase requests"];}
<div class="d-flex justify-content-between mb-3"><div><h2>@Localizer["Purchase requests"]</h2><p class="text-muted">@Localizer["Internal demand only; no stock or accounting effect."]</p></div><a asp-action="Create" class="btn btn-primary">@Localizer["New purchase request"]</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Request number"]" /></div><div class="col-md-4"><select name="status" class="form-select"><option value="">@Localizer["All statuses"]</option>@foreach(var s in Enum.GetValues<PurchaseRequestStatus>()){<option value="@s">@Localizer[s.ToString()]</option>}</select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">@Localizer["Search"]</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>@Localizer["Request number"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Needed by"]</th><th>@Localizer["Priority"]</th><th>@Localizer["Status"]</th><th>@Localizer["Lines"]</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><a asp-action="Details" asp-route-id="@r.Id">@r.RequestNumber</a></td><td>@r.WarehouseName</td><td>@r.NeededByDate</td><td>@Localizer[r.Priority.ToString()]</td><td>@Localizer[r.Status.ToString()]</td><td>@r.Lines.Count</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center text-muted">@Localizer["No purchase requests found."]</td></tr>}</tbody></table></div>
