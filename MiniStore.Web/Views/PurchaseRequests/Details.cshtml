@model MiniStore.Application.DTOs.Purchases.PurchaseRequestDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Model.RequestNumber;var rv=Convert.ToBase64String(Model.RowVersion);var canApprove=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseRequests.Approve")).Succeeded;var canReject=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseRequests.Reject")).Succeeded;}
<div class="d-flex justify-content-between"><div><h2>@Model.RequestNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div><div class="card card-body my-3"><div><strong>@Localizer["Warehouse"]:</strong> @Model.WarehouseName</div><div><strong>@Localizer["Needed by"]:</strong> @Model.NeededByDate</div><div><strong>@Localizer["Priority"]:</strong> @Localizer[Model.Priority.ToString()]</div><div><strong>@Localizer["Justification"]:</strong> @Model.Justification</div></div>
<table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Requested quantity"]</th><th>@Localizer["Stock quantity"]</th><th>@Localizer["Suggested supplier"]</th></tr></thead><tbody>@foreach(var l in Model.Lines){<tr><td>@l.ProductCode — @l.ProductName</td><td>@l.RequestedQuantity @l.UnitName</td><td>@l.StockQuantity</td><td>@l.SuggestedSupplierName</td></tr>}</tbody></table>
@if(Model.Status==PurchaseRequestStatus.Draft){<form asp-action="Submit" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rv"/><button class="btn btn-primary">@Localizer["Submit"]</button></form>}@if(Model.Status is PurchaseRequestStatus.Draft or PurchaseRequestStatus.Submitted){<form asp-action="Cancel" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rv"/><input name="reason" maxlength="500" required class="form-control d-inline-block w-auto" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel request"]</button></form>}
@if(Model.Status==PurchaseRequestStatus.Approved){<a asp-controller="PurchaseSourcing" asp-action="Create" asp-route-purchaseRequestId="@Model.Id" class="btn btn-primary">@Localizer["Start sourcing"]</a>}
@if(Model.Approval is not null){<div class="card card-body mt-4"><h5>@Localizer["Approval"] — @Model.Approval.RuleName</h5><ol>@foreach(var step in Model.Approval.Steps){<li>@step.RoleName — @Localizer[step.Status.ToString()] @if(step.DecidedByUserId is not null){<span>— @step.DecidedByUserId</span>}</li>}</ol>@if(Model.Approval.Status==PurchaseApprovalStatus.Pending && Model.Approval.CanCurrentUserDecide){<div class="d-flex gap-2"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id"/><input name="note" maxlength="500" class="form-control mb-2" placeholder="@Localizer["Decision note"]"/>@if(canApprove){<button class="btn btn-success">@Localizer["Approve"]</button>}</form><form asp-action="Reject" method="post"><input type="hidden" name="id" value="@Model.Id"/><input name="reason" maxlength="500" required class="form-control mb-2" placeholder="@Localizer["Rejection reason"]"/>@if(canReject){<button class="btn btn-danger">@Localizer["Reject"]</button>}</form></div>}</div>}
<h5 class="mt-4">@Localizer["History"]</h5><ul class="list-group">@foreach(var h in Model.History){<li class="list-group-item">@Localizer[h.Action.ToString()] — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason!=null){<span>— @h.Reason</span>}</li>}</ul>
