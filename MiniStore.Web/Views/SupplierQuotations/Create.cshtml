@model MiniStore.Application.DTOs.Purchases.SupplierQuotationCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Enter supplier quotation"];}
<h2>@Localizer["Enter supplier quotation"]</h2><p class="text-muted">@Model.SourcingEvent!.SourcingNumber — @Localizer["Currency"]: @Model.CurrencyCode</p>
<form asp-action="Create" method="post"><input type="hidden" asp-for="Form.PurchaseSourcingEventId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 mb-3"><div class="col-md-4"><label class="form-label">@Localizer["Supplier"]</label><select asp-for="Form.SupplierId" class="form-select" required><option value="">@Localizer["Select supplier"]</option>@foreach(var supplier in Model.Suppliers){<option value="@supplier.Id">@supplier.Label</option>}</select></div><div class="col-md-4"><label class="form-label">@Localizer["Supplier reference"]</label><input asp-for="Form.SupplierReference" class="form-control" maxlength="100"/></div><div class="col-md-2"><label class="form-label">@Localizer["Quotation date"]</label><input asp-for="Form.QuotationDate" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Valid until"]</label><input asp-for="Form.ValidUntilDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Lead time days"]</label><input asp-for="Form.LeadTimeDays" class="form-control" min="0" max="3650"/></div><div class="col-md-9"><label class="form-label">@Localizer["Payment terms"]</label><input asp-for="Form.PaymentTerms" class="form-control" maxlength="500"/></div></div>
<table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Quoted quantity"]</th><th>@Localizer["Unit price"]</th><th>@Localizer["Discount %"]</th><th>@Localizer["Tax %"]</th></tr></thead><tbody>@for(var i=0;i<Model.Form.Lines.Count;i++){var source=Model.SourcingEvent.Lines.Single(x=>x.Id==Model.Form.Lines[i].PurchaseSourcingLineId);<tr><td>@source.ProductCode — @source.ProductName<input type="hidden" asp-for="Form.Lines[i].PurchaseSourcingLineId"/></td><td><input asp-for="Form.Lines[i].QuotedQuantity" class="form-control" min="0.000001" step="0.000001"/></td><td><input asp-for="Form.Lines[i].UnitPrice" class="form-control" min="0" step="0.000001"/></td><td><input asp-for="Form.Lines[i].DiscountPercent" class="form-control" min="0" max="100" step="0.01"/></td><td><input asp-for="Form.Lines[i].TaxPercent" class="form-control" min="0" max="100" step="0.01"/></td></tr>}</tbody></table><div class="mb-3"><label class="form-label">@Localizer["Notes"]</label><textarea asp-for="Form.Notes" class="form-control" maxlength="1000"></textarea></div><button class="btn btn-primary">@Localizer["Submit quotation"]</button></form>
