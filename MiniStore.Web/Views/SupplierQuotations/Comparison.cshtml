@model List<MiniStore.Application.DTOs.Purchases.SupplierQuotationDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Quotation comparison"];}
<h2>@Localizer["Quotation comparison"]</h2><p class="text-muted">@Localizer["Select one submitted quotation with a recorded reason before creating a Purchase Order."]</p><table class="table"><thead><tr><th>@Localizer["Supplier"]</th><th>@Localizer["Quotation number"]</th><th>@Localizer["Valid until"]</th><th>@Localizer["Lead time days"]</th><th>@Localizer["Net amount"]</th><th>@Localizer["Tax amount"]</th><th>@Localizer["Gross amount"]</th><th></th></tr></thead><tbody>@foreach(var quote in Model.OrderBy(x=>x.GrossAmount)){<tr><td>@quote.SupplierName</td><td>@quote.QuotationNumber</td><td>@quote.ValidUntilDate</td><td>@quote.LeadTimeDays</td><td>@quote.NetAmount @quote.CurrencyCode</td><td>@quote.TaxAmount</td><td>@quote.GrossAmount</td><td><form asp-action="Award" method="post"><input type="hidden" name="sourcingEventId" value="@Context.Request.Query["sourcingEventId"]"/><input type="hidden" name="quotationId" value="@quote.Id"/><input required name="reason" maxlength="1000" class="form-control form-control-sm mb-1" placeholder="@Localizer["Award reason"]"/><button class="btn btn-sm btn-success">@Localizer["Award"]</button></form></td></tr>}</tbody></table>@if(Model.Count==0){<div class="alert alert-info">@Localizer["No supplier quotations have been entered."]</div>}else{<form asp-controller="PurchaseOrders" asp-action="CreateFromAward" method="post"><input type="hidden" name="sourcingEventId" value="@Context.Request.Query["sourcingEventId"]"/><button class="btn btn-outline-primary">@Localizer["Create purchase order from awarded quotation"]</button></form>}
