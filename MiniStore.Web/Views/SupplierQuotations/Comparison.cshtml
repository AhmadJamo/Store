@model MiniStore.Application.DTOs.Purchases.SupplierQuotationComparisonPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Quotation comparison"];var numberSettings=await GeneralSettingsService.GetAsync();}
<h2>@Localizer["Quotation comparison"]</h2><p class="text-muted">@Localizer["Select one submitted quotation with a recorded reason before creating a Purchase Order."]</p><table class="table"><thead><tr><th>@Localizer["Supplier"]</th><th>@Localizer["Quotation number"]</th><th>@Localizer["Valid until"]</th><th>@Localizer["Lead time days"]</th><th>@Localizer["Net amount"]</th><th>@Localizer["Tax amount"]</th><th>@Localizer["Gross amount"]</th><th></th></tr></thead><tbody>@foreach(var quote in Model.Quotations.OrderBy(x=>x.GrossAmount)){<tr><td>@quote.SupplierName</td><td>@quote.QuotationNumber</td><td>@quote.ValidUntilDate</td><td>@quote.LeadTimeDays</td><td>@quote.NetAmount.ToMoneyDisplay(numberSettings) @quote.CurrencyCode</td><td>@quote.TaxAmount.ToMoneyDisplay(numberSettings)</td><td>@quote.GrossAmount.ToMoneyDisplay(numberSettings)</td><td>@if(Model.CanAward){<form asp-action="Award" method="post"><input type="hidden" name="sourcingEventId" value="@Model.SourcingEventId"/><input type="hidden" name="quotationId" value="@quote.Id"/><input required name="reason" maxlength="1000" class="form-control form-control-sm mb-1" placeholder="@Localizer["Award reason"]"/><button class="btn btn-sm btn-success">@Localizer["Award"]</button></form>}else if(Model.AwardedQuotationId==quote.Id){<span class="badge bg-success">@Localizer["Award completed"]</span>}else{<span class="text-muted">—</span>}</td></tr>}</tbody></table>
@if(Model.Quotations.Count==0){<div class="alert alert-info">@Localizer["No supplier quotations have been entered."]</div>}
else if(!Model.AwardedQuotationId.HasValue){<div class="alert alert-info">@Localizer["Award a quotation before creating the next purchase document."]</div>}
else if(Model.PurchaseOrderId.HasValue){<a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId" class="btn btn-outline-success">@Localizer["Purchase order created — view"]</a>}
else if(Model.PurchaseAgreementId.HasValue){<a asp-controller="PurchaseAgreements" asp-action="Details" asp-route-id="@Model.PurchaseAgreementId" class="btn btn-outline-success">@Localizer["Purchase agreement created — view"]</a>}
else if(Model.CanCreatePurchaseDocument){<div class="d-flex gap-2"><form asp-controller="PurchaseOrders" asp-action="CreateFromAward" method="post"><input type="hidden" name="sourcingEventId" value="@Model.SourcingEventId"/><button class="btn btn-outline-primary">@Localizer["Create purchase order from awarded quotation"]</button></form><a asp-controller="PurchaseAgreements" asp-action="Create" asp-route-sourcingEventId="@Model.SourcingEventId" class="btn btn-outline-primary">@Localizer["Create purchase agreement from award"]</a></div>}
