@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model List<MiniStore.Application.DTOs.Sales.SaleListDto>

@{
    ViewData["Title"] = "Sales";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>@Localizer["Sales"]</h2>

        <div class="d-flex gap-2">
            <a asp-action="Pos"
               class="btn btn-primary">
                @Localizer["Open POS"]
            </a>

            <a asp-action="Create"
               class="btn btn-outline-primary">
                @Localizer["New Sale"]
            </a>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @Localizer["No sales found."]
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>@Localizer["Invoice Number"]</th>
                    <th>@Localizer["Date"]</th>
                    <th>@Localizer["Warehouse"]</th>
                    <th>@Localizer["Total"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var sale in Model)
                {
                    <tr>

                        <td>
                            @sale.InvoiceNumber
                        </td>

                        <td>
                            @sale.Date.ToString("yyyy-MM-dd")
                        </td>

                        <td>
                            @sale.WarehouseId
                        </td>

                        <td>
                            @sale.TotalAmount.ToString("0.00")
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@sale.Id"
                               class="btn btn-sm btn-info">
                                @Localizer["Details"]
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>
