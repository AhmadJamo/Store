@model MiniStore.Application.DTOs.Sale.SaleDetailsDto

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Sale Details</h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

    <div class="card mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <strong>Invoice Number:</strong>

                    <div>
                        @Model.InvoiceNumber
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Date:</strong>

                    <div>
                        @Model.Date.ToString("yyyy-MM-dd")
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Warehouse:</strong>

                    <div>
                        @Model.WarehouseId
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <hr />

                <strong>Notes:</strong>

                <p>
                    @Model.Notes
                </p>
            }

        </div>

    </div>

    <h4>Items</h4>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Sale Price</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {
                <tr>

                    <td>
                        @item.ProductId
                    </td>

                    <td>
                        @item.Quantity
                    </td>

                    <td>
                        @item.SalePrice.ToString("0.00")
                    </td>

                    <td>
                        @item.Total.ToString("0.00")
                    </td>

                </tr>
            }

        </tbody>

        <tfoot>

            <tr>

                <th colspan="3"
                    class="text-end">

                    Grand Total

                </th>

                <th>
                    @Model.TotalAmount.ToString("0.00")
                </th>

            </tr>

        </tfoot>

    </table>

</div>