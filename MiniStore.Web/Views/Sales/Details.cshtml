@using MiniStore.Domain.Enums
@model MiniStore.Application.DTOs.Sales.SaleDetailsDto

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Sale @Model.InvoiceNumber</h2>
            <div class="text-muted">@Model.Date.ToString("yyyy-MM-dd")</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Sales</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4"><div class="text-muted small">Warehouse</div><strong>@Model.WarehouseId</strong></div>
                @if (Model.PosTerminalId.HasValue)
                {
                    <div class="col-md-4"><div class="text-muted small">POS Terminal</div><strong>@Model.PosTerminalId</strong></div>
                }
                @if (Model.PosOrderType.HasValue)
                {
                    <div class="col-md-4"><div class="text-muted small">Order Type</div><strong>@Model.PosOrderType</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ServiceReference))
                {
                    <div class="col-md-4"><div class="text-muted small">Table / Service Reference</div><strong>@Model.ServiceReference</strong></div>
                }
                @if (Model.GuestCount.HasValue)
                {
                    <div class="col-md-4"><div class="text-muted small">Guests</div><strong>@Model.GuestCount</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="col-12"><div class="text-muted small">Sale Notes</div><div>@Model.Notes</div></div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white"><strong>Items</strong></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Product</th><th>Quantity</th><th>Price</th><th>Gross</th><th>Discount</th><th>Total</th><th>Preparation Notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.SalePrice.ToString("0.00")</td>
                            <td>@item.GrossTotal.ToString("0.00")</td>
                            <td>
                                @if (item.DiscountValue <= 0)
                                {
                                    <span>-</span>
                                }
                                else if (item.DiscountType == DiscountType.Percentage)
                                {
                                    <span>@item.DiscountValue.ToString("0.##")% (@item.DiscountAmount.ToString("0.00"))</span>
                                }
                                else
                                {
                                    <span>@item.DiscountAmount.ToString("0.00")</span>
                                }
                            </td>
                            <td class="fw-semibold">@item.Total.ToString("0.00")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between"><span>Subtotal</span><strong>@Model.Subtotal.ToString("0.00") JOD</strong></div>
                    <div class="d-flex justify-content-between mt-2"><span>Invoice Discount</span><strong>@Model.InvoiceDiscountAmount.ToString("0.00") JOD</strong></div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5"><span>Total</span><strong class="text-primary">@Model.TotalAmount.ToString("0.00") JOD</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>
