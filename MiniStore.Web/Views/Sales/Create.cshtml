```cshtml
@using System.Globalization
@using MiniStore.Domain.Enums
@model MiniStore.Application.DTOs.Sales.CreateSaleDto

@{
    ViewData["Title"] = "Create Sale";
}

<div class="container mt-4">

    <h2>Create Sale</h2>

    <hr />

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="channel" value="Wholesale" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Sale Information -->

        <div class="row">

            <div class="col-md-4">

                <div class="mb-3">

                    <label asp-for="Date"
                           class="form-label">
                        Date
                    </label>

                    <input asp-for="Date"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Date"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="mb-3">

                    <label asp-for="WarehouseId"
                           class="form-label">
                        Warehouse
                    </label>

                    <select asp-for="WarehouseId"
                            class="form-select">

                        <option value="">
                            -- Select Warehouse --
                        </option>

                        @foreach (var warehouse in ViewBag.Warehouses)
                        {
                            <option value="@warehouse.Id">
                                @warehouse.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="WarehouseId"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <div class="mb-3">

            <label asp-for="Notes"
                   class="form-label">
                Notes
            </label>

            <textarea asp-for="Notes"
                      class="form-control">
            </textarea>

        </div>

        <hr />

        <!-- Add Item -->

        <h4>Sale Items</h4>

        <div class="row align-items-end">

            <div class="col-md-4">

                <div class="mb-3">

                    <label class="form-label">
                        Product
                    </label>

                    <input id="productSearch"
                           class="form-control mb-2"
                           placeholder="Search by product name or barcode"
                           autocomplete="off" />

                    <select id="productId"
                            class="form-select">

                        <option value="">
                            -- Select Product --
                        </option>

                        @foreach (var product in ViewBag.Products)
                        {
                            <option value="@product.Id"
                                    data-sale-price="@product.SalePrice.ToString(CultureInfo.InvariantCulture)"
                                    data-barcode="@product.Barcode">

                                @product.Name (@product.Barcode)

                            </option>
                        }

                    </select>

                </div>

            </div>

            <div class="col-md-2">

                <div class="mb-3">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input id="quantity"
                           type="number"
                           step="0.001"
                           min="0.001"
                           value="1"
                           class="form-control" />

                </div>

            </div>

            <div class="col-md-2">

                <div class="mb-3">

                    <label class="form-label">
                        Sale Price
                    </label>

                    <input id="salePrice"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           readonly />

                </div>

            </div>

            <div class="col-md-2">

                <div class="mb-3">

                    <label class="form-label">
                        Discount Type
                    </label>

                    <select id="discountType"
                            class="form-select">

                        <option value="1">
                            Percentage
                        </option>

                        <option value="2">
                            Fixed Amount
                        </option>

                    </select>

                </div>

            </div>

            <div class="col-md-2">

                <div class="mb-3">

                    <label class="form-label">
                        Discount
                    </label>

                    <input id="discountValue"
                           type="number"
                           step="0.01"
                           min="0"
                           value="0"
                           class="form-control" />

                </div>

            </div>

        </div>

        <div class="row">

            <div class="col-md-3">

                <button type="button"
                        id="addItem"
                        class="btn btn-success w-100 mb-3">

                    Add Item

                </button>

            </div>

        </div>

        <!-- Items Table -->

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>

                    <tr>

                        <th>Product</th>

                        <th>Quantity</th>

                        <th>Sale Price</th>

                        <th>Gross Total</th>

                        <th>Discount</th>

                        <th>Discount Amount</th>

                        <th>Total</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody id="itemsTableBody">
                </tbody>

            </table>

        </div>

        <hr />

        <!-- Invoice Discount -->

        <div class="row justify-content-end">

            <div class="col-md-5">

                <div class="card">

                    <div class="card-body">

                        <h5 class="card-title">
                            Invoice Discount
                        </h5>

                        <div class="mb-3">

                            <label asp-for="InvoiceDiscountType"
                                   class="form-label">

                                Discount Type

                            </label>

                            <select asp-for="InvoiceDiscountType"
                                    id="invoiceDiscountType"
                                    class="form-select">

                                <option value="1">
                                    Percentage
                                </option>

                                <option value="2">
                                    Fixed Amount
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="InvoiceDiscountValue"
                                   class="form-label">

                                Discount

                            </label>

                            <input asp-for="InvoiceDiscountValue"
                                   id="invoiceDiscountValue"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   value="0" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <br />

        <!-- Totals -->

        <div class="row justify-content-end">

            <div class="col-md-5">

                <table class="table table-bordered">

                    <tbody>

                        <tr>

                            <th>
                                Subtotal
                            </th>

                            <td id="subtotal"
                                class="text-end">

                                0.00

                            </td>

                        </tr>

                        <tr>

                            <th>
                                Invoice Discount
                            </th>

                            <td id="invoiceDiscountAmount"
                                class="text-end">

                                0.00

                            </td>

                        </tr>

                        <tr>

                            <th>
                                <strong>Grand Total</strong>
                            </th>

                            <td class="text-end">

                                <strong id="grandTotal">
                                    0.00
                                </strong>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <button type="submit"
                class="btn btn-primary">

            Save Sale

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>


@section Scripts {

    <script>

        let itemIndex = 0;

        const addItemButton =
            document.getElementById("addItem");

        const itemsTableBody =
            document.getElementById("itemsTableBody");

        const productSearch =
            document.getElementById("productSearch");

        const productSelect =
            document.getElementById("productId");

        const salePriceInput =
            document.getElementById("salePrice");

        const quantityInput =
            document.getElementById("quantity");

        const discountTypeSelect =
            document.getElementById("discountType");

        const discountValueInput =
            document.getElementById("discountValue");

        const invoiceDiscountType =
            document.getElementById("invoiceDiscountType");

        const invoiceDiscountValue =
            document.getElementById("invoiceDiscountValue");

        const subtotalElement =
            document.getElementById("subtotal");

        const invoiceDiscountAmountElement =
            document.getElementById("invoiceDiscountAmount");

        const grandTotalElement =
            document.getElementById("grandTotal");


        productSelect.addEventListener(
            "change",
            updateSalePrice
        );


        productSearch.addEventListener(
            "input",
            filterProducts
        );


        productSearch.addEventListener(
            "keydown",
            function (event) {

                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();

                const barcode =
                    productSearch.value
                        .trim()
                        .toLowerCase();

                const product =
                    [...productSelect.options]
                        .find(option =>
                            option.dataset.barcode?.toLowerCase()
                            === barcode);

                if (product) {

                    productSelect.value =
                        product.value;

                    updateSalePrice();

                }

            }
        );


        invoiceDiscountType.addEventListener(
            "change",
            calculateTotals
        );


        invoiceDiscountValue.addEventListener(
            "input",
            calculateTotals
        );


        addItemButton.addEventListener(
            "click",
            function () {

                const productId =
                    productSelect.value;

                if (!productId) {

                    alert("Product is required.");

                    return;
                }


                const selectedProduct =
                    productSelect.selectedOptions[0];

                const productName =
                    selectedProduct.text;


                const quantity =
                    parseFloat(
                        quantityInput.value
                    );


                const salePrice =
                    parseFloat(
                        salePriceInput.value
                    );


                const discountType =
                    parseInt(
                        discountTypeSelect.value
                    );


                const discountValue =
                    parseFloat(
                        discountValueInput.value
                    ) || 0;


                if (!quantity || quantity <= 0) {

                    alert(
                        "Quantity must be greater than zero."
                    );

                    return;
                }


                if (
                    isNaN(salePrice) ||
                    salePrice < 0
                ) {

                    alert(
                        "Sale price is invalid."
                    );

                    return;
                }


                if (discountValue < 0) {

                    alert(
                        "Discount cannot be negative."
                    );

                    return;
                }


                const grossTotal =
                    quantity * salePrice;


                let discountAmount = 0;


                if (discountType === 1) {

                    if (discountValue > 100) {

                        alert(
                            "Percentage discount cannot exceed 100%."
                        );

                        return;
                    }

                    discountAmount =
                        grossTotal *
                        discountValue /
                        100;

                }
                else if (discountType === 2) {

                    discountAmount =
                        discountValue;

                }


                if (discountAmount > grossTotal) {
                    discountAmount = grossTotal;
                }


                const total =
                    grossTotal -
                    discountAmount;


                const row =
                    document.createElement("tr");


                const discountText =
                    discountType === 1
                        ? `${discountValue.toFixed(2)}%`
                        : discountValue.toFixed(2);


                row.innerHTML = `

                    <td>

                        ${escapeHtml(productName)}

                        <input type="hidden"
                               name="Items[${itemIndex}].ProductId"
                               value="${productId}" />

                    </td>


                    <td>

                        ${quantity.toFixed(3)}

                        <input type="hidden"
                               name="Items[${itemIndex}].Quantity"
                               value="${quantity}" />

                    </td>


                    <td>

                        ${salePrice.toFixed(2)}

                        <input type="hidden"
                               name="Items[${itemIndex}].SalePrice"
                               value="${salePrice}" />

                    </td>


                    <td>

                        ${grossTotal.toFixed(2)}

                    </td>


                    <td>

                        ${discountText}

                        <input type="hidden"
                               name="Items[${itemIndex}].DiscountType"
                               value="${discountType}" />

                        <input type="hidden"
                               name="Items[${itemIndex}].DiscountValue"
                               value="${discountValue}" />

                    </td>


                    <td>

                        ${discountAmount.toFixed(2)}

                    </td>


                    <td class="line-total">

                        ${total.toFixed(2)}

                    </td>


                    <td>

                        <button type="button"
                                class="btn btn-danger btn-sm remove-item">

                            Remove

                        </button>

                    </td>

                `;


                itemsTableBody.appendChild(row);


                itemIndex++;


                calculateTotals();


                productSelect.value = "";

                productSearch.value = "";

                quantityInput.value = "1";

                salePriceInput.value = "";

                discountTypeSelect.value = "1";

                discountValueInput.value = "0";

            }
        );


        itemsTableBody.addEventListener(
            "click",
            function (event) {

                if (
                    event.target.classList.contains(
                        "remove-item"
                    )
                ) {

                    event.target
                        .closest("tr")
                        .remove();

                    calculateTotals();

                }

            }
        );


        function calculateTotals() {

            let subtotal = 0;


            const rows =
                itemsTableBody.querySelectorAll("tr");


            rows.forEach(row => {

                const totalCell =
                    row.querySelector(".line-total");


                if (totalCell) {

                    subtotal +=
                        parseFloat(
                            totalCell.innerText
                        ) || 0;

                }

            });


            const discountType =
                parseInt(
                    invoiceDiscountType.value
                );


            const discountValue =
                parseFloat(
                    invoiceDiscountValue.value
                ) || 0;


            let invoiceDiscount = 0;


            if (discountValue > 0) {

                if (discountType === 1) {

                    invoiceDiscount =
                        subtotal *
                        discountValue /
                        100;

                }
                else if (discountType === 2) {

                    invoiceDiscount =
                        discountValue;

                }

            }


            if (invoiceDiscount > subtotal) {
                invoiceDiscount = subtotal;
            }


            const grandTotal =
                subtotal -
                invoiceDiscount;


            subtotalElement.innerText =
                subtotal.toFixed(2);


            invoiceDiscountAmountElement.innerText =
                invoiceDiscount.toFixed(2);


            grandTotalElement.innerText =
                grandTotal.toFixed(2);

        }


        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value;

            return element.innerHTML;

        }


        function updateSalePrice() {

            const selectedProduct =
                productSelect.selectedOptions[0];


            salePriceInput.value =
                selectedProduct?.dataset.salePrice
                ?? "";

        }


        function filterProducts() {

            const query =
                productSearch.value
                    .trim()
                    .toLowerCase();


            [...productSelect.options]
                .forEach(option => {

                    if (!option.value) {

                        option.hidden = false;

                        return;
                    }


                    option.hidden =
                        !option.text
                            .toLowerCase()
                            .includes(query);

                });

        }

    </script>

}
```
