@using System.Globalization
@using System.Text.Json
@model MiniStore.Application.DTOs.Sales.CreateSaleDto

@{
    ViewData["Title"] = "Point of Sale";
    var posTerminals = ViewBag.PosTerminals as List<MiniStore.Application.Dtos.Settings.PosTerminalAccessDto> ?? [];
}

<style>
    .pos-page {
        background: #f4f7fb;
        min-height: calc(100vh - 92px);
        margin: -1.5rem calc(50% - 50vw) 0;
        padding: 1.5rem max(1rem, calc((100vw - 1320px) / 2));
    }

    .pos-header,
    .pos-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(27, 48, 83, .08);
    }

    .pos-header {
        background: linear-gradient(135deg, #142850, #2563a8);
        color: white;
        padding: 1.25rem 1.5rem;
    }

    .pos-card {
        background: white;
    }

    .pos-product {
        width: 100%;
        min-height: 126px;
        text-align: start;
        border: 1px solid #e5eaf2;
        border-radius: .85rem;
        background: #fff;
        padding: .9rem;
        transition: .15s ease;
    }

    .pos-product:hover {
        border-color: #2563a8;
        box-shadow: 0 6px 16px rgba(37,99,168,.14);
        transform: translateY(-2px);
    }

    .pos-product:disabled {
        opacity: .5;
        cursor: not-allowed;
        transform: none;
    }

    .product-name {
        display: block;
        color: #18253d;
        font-weight: 700;
        line-height: 1.25;
    }

    .product-barcode {
        color: #738197;
        font-size: .78rem;
    }

    .product-price {
        color: #198754;
        font-size: 1.05rem;
        font-weight: 800;
    }

    .cart-row {
        border-bottom: 1px solid #edf0f5;
        padding: .9rem 0;
    }

    .quantity-control {
        display: inline-flex;
        align-items: center;
        border: 1px solid #dde4ee;
        border-radius: .5rem;
        overflow: hidden;
    }

    .quantity-control button {
        border: 0;
        background: #f7f9fc;
        width: 30px;
        height: 30px;
        font-weight: 700;
    }

    .quantity-control span {
        min-width: 38px;
        text-align: center;
        font-weight: 600;
    }

    .total-panel {
        background: #eff6ff;
        border-radius: .75rem;
        padding: 1rem;
    }

    .cart-empty {
        color: #7a8799;
        padding: 3.5rem 1rem;
        text-align: center;
    }

    .stock-badge {
        font-size: .72rem;
    }

    .pos-page.pos-dark { background: #111827; color: #e5e7eb; }
    .pos-page.pos-dark .pos-card { background: #1f2937; color: #e5e7eb; }
    .pos-page.pos-dark .pos-product { background: #253247; border-color: #394960; }
    .pos-page.pos-dark .product-name { color: #f8fafc; }
    .pos-page.pos-dark .form-control,
    .pos-page.pos-dark .form-select { background-color: #253247; color: #f8fafc; border-color: #4b5d75; }
    .pos-page.pos-compact .pos-product { min-height: 76px; padding: .55rem; }
    .pos-page.pos-touch .btn,
    .pos-page.pos-touch .form-control,
    .pos-page.pos-touch .form-select { min-height: 48px; }

    @@media (min-width: 992px) {
        .cart-column {
            position: sticky;
            top: 1rem;
        }
    }
</style>

<form asp-action="Create" method="post" id="posForm">
    <input type="hidden" name="channel" value="RetailPos" />

    <div class="pos-page">

        <div class="pos-header mb-4 d-flex flex-wrap gap-3 justify-content-between align-items-center">
            <div>
                <div class="text-uppercase small opacity-75">MiniStore</div>
                <h1 class="h3 mb-0" id="posHeaderTitle">Point of Sale</h1>
            </div>

            <a asp-action="Index" class="btn btn-outline-light">
                Back to Sales
            </a>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             id="validationSummary">
        </div>

        <div class="card pos-card mb-4">
            <div class="card-body">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label asp-for="PosTerminalId" class="form-label fw-semibold">POS Terminal</label>
                        <select asp-for="PosTerminalId" id="posTerminalId" class="form-select" required="@(posTerminals.Count > 0 ? "required" : null)">
                            <option value="">@(posTerminals.Count == 0 ? "Legacy POS — configure terminals in Settings" : "-- Select POS Terminal --")</option>
                            @foreach (var terminal in posTerminals)
                            {
                                <option value="@terminal.Id">@terminal.BranchName · @terminal.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="WarehouseId"
                               class="form-label fw-semibold">
                            Warehouse
                        </label>

                        <select asp-for="WarehouseId"
                                id="warehouseId"
                                class="form-select">

                            <option value="">
                                -- Select Warehouse --
                            </option>

                            @foreach (var warehouse in ViewBag.Warehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Name
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Date"
                               class="form-label fw-semibold">
                            Date
                        </label>

                        <input asp-for="Date"
                               class="form-control"
                               type="date" />
                    </div>

                    <div class="col-md-4"><label asp-for="CustomerId" class="form-label fw-semibold">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Unknown customer / walk-in</option>@foreach (var customer in ViewBag.Customers) { <option value="@customer.Id">@customer.Name</option> }</select></div>

                    <div class="col-md-4"><label asp-for="PaymentMethodId" class="form-label fw-semibold">Payment Method</label><select asp-for="PaymentMethodId" class="form-select" required><option value="">-- Select payment method --</option>@foreach (var method in ViewBag.PaymentMethods) { <option value="@method.Id">@method.Name</option> }</select></div>

                    <div class="col-md-4">
                        <label asp-for="Notes"
                               class="form-label fw-semibold">
                            Notes
                        </label>

                        <input asp-for="Notes"
                               class="form-control"
                               placeholder="Optional note" />
                    </div>

                    <div class="col-md-4" id="orderTypeGroup">
                        <label asp-for="PosOrderType" class="form-label fw-semibold">Order Type</label>
                        <select asp-for="PosOrderType" id="posOrderType" class="form-select">
                            <option value="@((int)MiniStore.Domain.Entities.PosOrderType.WalkIn)">Walk-in</option>
                            <option value="@((int)MiniStore.Domain.Entities.PosOrderType.DineIn)">Dine-in</option>
                            <option value="@((int)MiniStore.Domain.Entities.PosOrderType.Takeaway)">Takeaway</option>
                            <option value="@((int)MiniStore.Domain.Entities.PosOrderType.Delivery)">Delivery</option>
                        </select>
                    </div>

                    <div class="col-md-4" id="serviceReferenceGroup">
                        <label asp-for="ServiceReference" class="form-label fw-semibold">Table / Service Reference</label>
                        <input asp-for="ServiceReference" id="serviceReference" class="form-control" maxlength="80" placeholder="Table 12, pickup name, delivery reference..." />
                    </div>

                    <div class="col-md-4" id="guestCountGroup">
                        <label asp-for="GuestCount" class="form-label fw-semibold">Guest Count</label>
                        <input asp-for="GuestCount" id="guestCount" class="form-control" type="number" min="1" max="999" />
                    </div>

                </div>

            </div>
        </div>

        <div class="row g-4" id="posWorkspace">

            <!-- PRODUCTS -->
            <div class="col-lg-7 col-xl-8" id="productColumn">

                <div class="card pos-card h-100">

                    <div class="card-body">

                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">

                            <div>
                                <h2 class="h5 mb-1">
                                    Products
                                </h2>

                                <div class="small text-muted">
                                    Click a product to add it to the cart.
                                </div>
                            </div>

                            <div class="input-group"
                                 style="max-width: 360px;">

                                <span class="input-group-text">
                                    ⌕
                                </span>

                                <input id="productSearch"
                                       class="form-control"
                                       placeholder="Search by name or barcode"
                                       autocomplete="off" />

                            </div>

                        </div>

                        <div class="row g-3"
                             id="productGrid">

                            @foreach (var product in ViewBag.Products)
                            {
                                <div class="col-sm-6 col-xl-4 product-wrapper"
                                     data-search="@product.Name @product.Barcode">

                                    <button type="button"
                                            class="pos-product product-button"
                                            data-id="@product.Id"
                                            data-name="@product.Name"
                                            data-price="@product.SalePrice.ToString(CultureInfo.InvariantCulture)"
                                            data-barcode="@product.Barcode">

                                        <span class="product-name">
                                            @product.Name
                                        </span>

                                        <span class="product-barcode d-block mt-1">
                                            @product.Barcode
                                        </span>

                                        <span class="product-price d-block mt-3">
                                            @product.SalePrice.ToString("0.00") JOD
                                        </span>

                                        <span class="badge text-bg-light border stock-badge mt-2 product-stock">
                                            Select a warehouse
                                        </span>

                                    </button>

                                </div>
                            }

                        </div>

                        <div id="noProducts"
                             class="text-center text-muted py-5 d-none">

                            No products match your search.

                        </div>

                    </div>

                </div>

            </div>


            <!-- CART -->
            <div class="col-lg-5 col-xl-4 cart-column" id="cartColumn">

                <div class="card pos-card">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>

                                <h2 class="h5 mb-1">
                                    Current Cart
                                </h2>

                                <div class="small text-muted"
                                     id="cartCount">
                                    0 items
                                </div>

                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="clearCart">

                                Clear

                            </button>

                        </div>


                        <div id="cartItems">

                            <div class="cart-empty">

                                Your cart is empty.
                                <br />

                                Choose products to begin.

                            </div>

                        </div>


                        <div class="total-panel mt-3">

                            <div class="d-flex justify-content-between text-muted">

                                <span>
                                    Items
                                </span>

                                <span id="itemCount">
                                    0
                                </span>

                            </div>

                            <div class="d-flex justify-content-between align-items-end mt-2">

                                <span class="fw-semibold">
                                    Grand Total
                                </span>

                                <span class="fs-3 fw-bold text-primary">

                                    <span id="grandTotal">
                                        0.00
                                    </span>

                                    <small class="fs-6">
                                        JOD
                                    </small>

                                </span>

                            </div>

                        </div>


                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 mt-3"
                                id="saveSale">

                            Complete Sale

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>


<!--
    Razor generates the stock data here as JSON-like data.

    Keeping it outside the JavaScript code prevents Visual Studio
    from trying to interpret Razor's @foreach as JavaScript.
-->
<script type="application/json" id="stockData">
[
    @foreach (var stock in ViewBag.ProductStocks)
    {
        <text>
        {
            "productId": @stock.ProductId,
            "warehouseId": @stock.WarehouseId,
            "quantity": @stock.Quantity.ToString(CultureInfo.InvariantCulture)
        },
        </text>
    }
]
</script>

<script type="application/json" id="terminalAccessData">
@Html.Raw(JsonSerializer.Serialize(
    posTerminals
        .Select(x => new { x.Id, x.DefaultWarehouseId, WarehouseIds = x.Warehouses.Select(w => w.WarehouseId) })))
</script>

<script type="application/json" id="posExperienceData">
@Html.Raw(JsonSerializer.Serialize(
    (IEnumerable<MiniStore.Application.Dtos.Settings.PosRuntimeSettingsDto>)(ViewBag.PosRuntimeSettings ?? new List<MiniStore.Application.Dtos.Settings.PosRuntimeSettingsDto>())))
</script>


@section Scripts {

    <script>

        const cart = new Map();


        // Read stock data generated by Razor.
        const stockData = JSON.parse(
            document.getElementById("stockData").textContent
        );


        // Convert stock data into a fast lookup Map.
        const stockByProductWarehouse = new Map(
            stockData.map(stock => [
                `${stock.productId}-${stock.warehouseId}`,
                stock.quantity
            ])
        );


        const warehouseInput =
            document.getElementById("warehouseId");
        const terminalInput = document.getElementById("posTerminalId");
        const terminalAccess = JSON.parse(
            document.getElementById("terminalAccessData").textContent);
        const experienceSettings = JSON.parse(
            document.getElementById("posExperienceData").textContent);
        let activeExperience = null;

        const orderTypeInput = document.getElementById('posOrderType');
        const serviceReferenceGroup = document.getElementById('serviceReferenceGroup');
        const serviceReferenceInput = document.getElementById('serviceReference');
        const guestCountGroup = document.getElementById('guestCountGroup');

        function refreshOrderContext() {
            if (!activeExperience) return;
            const isDineIn = Number(orderTypeInput.value) === @((int)MiniStore.Domain.Entities.PosOrderType.DineIn);
            const hasServiceContext = Number(orderTypeInput.value) !== @((int)MiniStore.Domain.Entities.PosOrderType.WalkIn);
            serviceReferenceGroup.hidden = !hasServiceContext && !serviceReferenceInput.value;
            serviceReferenceInput.required = activeExperience.RequireServiceReference && isDineIn;
            guestCountGroup.hidden = !activeExperience.EnableGuestCount || !isDineIn;
            if (guestCountGroup.hidden) document.getElementById('guestCount').value = '';
        }

        orderTypeInput.addEventListener('change', refreshOrderContext);

        function applyPosExperience(terminalId) {
            const settings = experienceSettings.find(
                x => String(x.PosTerminalId) === String(terminalId)) ?? {
                    PosTerminalId: null,
                    ProductLayout: @((int)MiniStore.Domain.Entities.PosProductLayout.Grid),
                    Theme: @((int)MiniStore.Domain.Entities.PosTheme.Light),
                    CartPosition: @((int)MiniStore.Domain.Entities.PosCartPosition.Right),
                    AccentColor: '#2563A8', HeaderTitle: 'Point of Sale', ProductColumns: 4,
                    CompactProductCards: false, ShowBarcode: true, ShowPrice: true, ShowStock: true,
                    AutoFocusSearch: true, TouchOptimized: true,
                    EnabledOrderTypes: @((int)MiniStore.Domain.Entities.PosOrderTypeOptions.WalkIn),
                    DefaultOrderType: @((int)MiniStore.Domain.Entities.PosOrderType.WalkIn),
                    RequireServiceReference: false, EnableGuestCount: false,
                    EnableItemNotes: false, QuickAddOnBarcodeScan: true
                };
            activeExperience = settings;

            const page = document.querySelector('.pos-page');
            page.classList.toggle('pos-dark', settings.Theme === @((int)MiniStore.Domain.Entities.PosTheme.Dark));
            page.classList.toggle('pos-compact', settings.CompactProductCards);
            page.classList.toggle('pos-touch', settings.TouchOptimized);
            document.querySelector('.pos-header').style.background = settings.AccentColor;
            document.getElementById('posHeaderTitle').textContent = settings.HeaderTitle;

            document.querySelectorAll('.product-wrapper').forEach(wrapper => {
                wrapper.style.width = settings.ProductLayout === @((int)MiniStore.Domain.Entities.PosProductLayout.CompactList)
                    ? '100%'
                    : `${100 / settings.ProductColumns}%`;
            });
            document.querySelectorAll('.product-barcode').forEach(x => x.hidden = !settings.ShowBarcode);
            document.querySelectorAll('.product-price').forEach(x => x.hidden = !settings.ShowPrice);
            document.querySelectorAll('.product-stock').forEach(x => x.hidden = !settings.ShowStock);

            const productColumn = document.getElementById('productColumn');
            const cartColumn = document.getElementById('cartColumn');
            productColumn.style.order = settings.CartPosition === @((int)MiniStore.Domain.Entities.PosCartPosition.Left) ? '2' : '1';
            cartColumn.style.order = settings.CartPosition === @((int)MiniStore.Domain.Entities.PosCartPosition.Left) ? '1' : '2';
            const orderTypeFlags = {
                @((int)MiniStore.Domain.Entities.PosOrderType.WalkIn): @((int)MiniStore.Domain.Entities.PosOrderTypeOptions.WalkIn),
                @((int)MiniStore.Domain.Entities.PosOrderType.DineIn): @((int)MiniStore.Domain.Entities.PosOrderTypeOptions.DineIn),
                @((int)MiniStore.Domain.Entities.PosOrderType.Takeaway): @((int)MiniStore.Domain.Entities.PosOrderTypeOptions.Takeaway),
                @((int)MiniStore.Domain.Entities.PosOrderType.Delivery): @((int)MiniStore.Domain.Entities.PosOrderTypeOptions.Delivery)
            };
            [...orderTypeInput.options].forEach(option => {
                const enabled = (settings.EnabledOrderTypes & orderTypeFlags[Number(option.value)]) !== 0;
                option.hidden = !enabled;
                option.disabled = !enabled;
            });
            const selectedOption = orderTypeInput.selectedOptions[0];
            if (!selectedOption || selectedOption.disabled)
                orderTypeInput.value = String(settings.DefaultOrderType);
            refreshOrderContext();
            if (settings.AutoFocusSearch) document.getElementById('productSearch').focus();
        }

        terminalInput.addEventListener("change", () => {
            const terminal = terminalAccess.find(
                x => String(x.Id) === terminalInput.value);
            [...warehouseInput.options].forEach(option => {
                option.hidden = Boolean(option.value) &&
                    (!terminal || !terminal.WarehouseIds.includes(Number(option.value)));
            });
            warehouseInput.value = terminal
                ? String(terminal.DefaultWarehouseId)
                : "";
            applyPosExperience(terminalInput.value);
            updateProductAvailability();
        });

        const productSearch =
            document.getElementById("productSearch");

        const productButtons =
            [...document.querySelectorAll(".product-button")];

        const cartItems =
            document.getElementById("cartItems");


        // Warehouse changed.
        warehouseInput.addEventListener(
            "change",
            updateProductAvailability
        );


        // Product search.
        productSearch.addEventListener(
            "input",
            filterProducts
        );


        // Barcode Enter.
        productSearch.addEventListener(
            "keydown",
            event => {

                if (event.key !== "Enter")
                    return;

                event.preventDefault();

                const barcode =
                    productSearch.value.trim().toLowerCase();

                const product =
                    productButtons.find(
                        button =>
                            button.dataset.barcode.toLowerCase() === barcode
                    );

                if (product && !product.disabled && activeExperience?.QuickAddOnBarcodeScan !== false) {

                    addProduct(product);

                    productSearch.value = "";

                    filterProducts();
                }

            }
        );


        // Product buttons.
        productButtons.forEach(
            button =>
                button.addEventListener(
                    "click",
                    () => addProduct(button)
                )
        );


        // Clear cart.
        document
            .getElementById("clearCart")
            .addEventListener(
                "click",
                () => {

                    cart.clear();

                    renderCart();

                }
            );


        // Submit validation.
        document
            .getElementById("posForm")
            .addEventListener(
                "submit",
                event => {

                    if (!warehouseInput.value || cart.size === 0) {

                        event.preventDefault();

                        document
                            .getElementById("validationSummary")
                            .textContent =
                            !warehouseInput.value
                                ? "Please select a warehouse before completing the sale."
                                : "Add at least one product to the cart.";

                    }

                }
            );


        function getAvailableStock(productId) {

            if (!warehouseInput.value)
                return null;

            return stockByProductWarehouse.get(
                `${productId}-${warehouseInput.value}`
            ) ?? 0;

        }


        function updateProductAvailability() {

            productButtons.forEach(
                button => {

                    const available =
                        getAvailableStock(button.dataset.id);

                    const label =
                        button.querySelector(".product-stock");


                    if (available === null) {

                        button.disabled = false;

                        label.textContent =
                            "Select a warehouse";

                        return;
                    }


                    button.disabled =
                        available <= 0;


                    label.textContent =
                        available > 0
                            ? `Available: ${available}`
                            : "Out of stock";


                    label.className =
                        `badge stock-badge mt-2 ${
                            available > 0
                                ? "text-bg-success"
                                : "text-bg-danger"
                        }`;

                }
            );


            cart.clear();

            renderCart();

        }


        function filterProducts() {

            const query =
                productSearch.value.trim().toLowerCase();

            let visibleCount = 0;


            document
                .querySelectorAll(".product-wrapper")
                .forEach(
                    wrapper => {

                        const visible =
                            wrapper.dataset.search
                                .toLowerCase()
                                .includes(query);


                        wrapper.classList.toggle(
                            "d-none",
                            !visible
                        );


                        if (visible)
                            visibleCount++;

                    }
                );


            document
                .getElementById("noProducts")
                .classList.toggle(
                    "d-none",
                    visibleCount !== 0
                );

        }


        function addProduct(button) {

            if (!warehouseInput.value) {

                document
                    .getElementById("validationSummary")
                    .textContent =
                    "Please select a warehouse first.";

                warehouseInput.focus();

                return;
            }


            const id =
                button.dataset.id;


            const available =
                getAvailableStock(id);


            const current =
                cart.get(id);


            const nextQuantity =
                (current?.quantity ?? 0) + 1;


            if (nextQuantity > available) {

                document
                    .getElementById("validationSummary")
                    .textContent =
                    "The requested quantity exceeds available stock.";

                return;
            }


            cart.set(
                id,
                {
                    id,
                    name: button.dataset.name,
                    price: Number(button.dataset.price),
                    quantity: nextQuantity,
                    notes: current?.notes ?? ""
                }
            );


            document
                .getElementById("validationSummary")
                .textContent = "";


            renderCart();

        }


        function changeQuantity(id, change) {

            const item =
                cart.get(id);


            const nextQuantity =
                item.quantity + change;


            if (nextQuantity <= 0) {

                cart.delete(id);

            }
            else if (
                nextQuantity <= getAvailableStock(id)
            ) {

                item.quantity =
                    nextQuantity;

            }


            renderCart();

        }


        function renderCart() {

            cartItems.innerHTML = "";

            let totalQuantity = 0;

            let grandTotal = 0;


            if (cart.size === 0) {

                cartItems.innerHTML =
                    '<div class="cart-empty">Your cart is empty.<br />Choose products to begin.</div>';

            }


            [...cart.values()].forEach(
                (item, index) => {

                    const total =
                        item.price * item.quantity;


                    totalQuantity +=
                        item.quantity;


                    grandTotal +=
                        total;


                    const row =
                        document.createElement("div");


                    row.className =
                        "cart-row";


                    row.innerHTML = `
                        <div class="d-flex justify-content-between gap-2">

                            <div class="fw-semibold item-name"></div>

                            <button
                                type="button"
                                class="btn btn-sm btn-link text-danger p-0 remove-item">

                                Remove

                            </button>

                        </div>

                        <div class="small text-muted mb-2">
                            ${item.price.toFixed(2)} JOD each
                        </div>

                        <div class="d-flex justify-content-between align-items-center">

                            <div class="quantity-control">

                                <button
                                    type="button"
                                    class="decrease">

                                    −

                                </button>

                                <span>
                                    ${item.quantity}
                                </span>

                                <button
                                    type="button"
                                    class="increase">

                                    +

                                </button>

                            </div>

                            <strong>
                                ${total.toFixed(2)} JOD
                            </strong>

                        </div>

                        <div class="item-notes mt-2">
                            <input type="text" class="form-control form-control-sm item-notes-input"
                                   maxlength="200" placeholder="Preparation note for this item" />
                        </div>

                        <input
                            type="hidden"
                            name="Items[${index}].ProductId"
                            value="${item.id}" />

                        <input
                            type="hidden"
                            name="Items[${index}].Quantity"
                            value="${item.quantity}" />

                        <input
                            type="hidden"
                            name="Items[${index}].SalePrice"
                            value="${item.price}" />

                        <input
                            type="hidden"
                            class="item-notes-hidden"
                            name="Items[${index}].Notes" />
                    `;


                    row
                        .querySelector(".item-name")
                        .textContent =
                        item.name;

                    const itemNotesContainer = row.querySelector('.item-notes');
                    const itemNotesInput = row.querySelector('.item-notes-input');
                    const itemNotesHidden = row.querySelector('.item-notes-hidden');
                    const allowItemNotes = activeExperience?.EnableItemNotes === true;
                    itemNotesContainer.hidden = !allowItemNotes;
                    itemNotesInput.value = item.notes;
                    itemNotesHidden.value = allowItemNotes ? item.notes : '';
                    itemNotesInput.addEventListener('input', () => {
                        item.notes = itemNotesInput.value;
                        itemNotesHidden.value = item.notes;
                    });


                    row
                        .querySelector(".increase")
                        .addEventListener(
                            "click",
                            () => changeQuantity(item.id, 1)
                        );


                    row
                        .querySelector(".decrease")
                        .addEventListener(
                            "click",
                            () => changeQuantity(item.id, -1)
                        );


                    row
                        .querySelector(".remove-item")
                        .addEventListener(
                            "click",
                            () => {

                                cart.delete(item.id);

                                renderCart();

                            }
                        );


                    cartItems.appendChild(row);

                }
            );


            document
                .getElementById("cartCount")
                .textContent =
                `${totalQuantity} item${
                    totalQuantity === 1
                        ? ""
                        : "s"
                }`;


            document
                .getElementById("itemCount")
                .textContent =
                totalQuantity;


            document
                .getElementById("grandTotal")
                .textContent =
                grandTotal.toFixed(2);

        }


        // Initial state.
        applyPosExperience(terminalInput.value);
        updateProductAvailability();

    </script>
}
