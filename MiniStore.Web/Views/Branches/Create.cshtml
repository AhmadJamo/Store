@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
<div class="container mt-4"><h2>@Localizer["Add Branch"]</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label for="code">@Localizer["Code"]</label><input id="code" name="code" class="form-control" required /></div><div class="mb-3"><label for="name">@Localizer["Name"]</label><input id="name" name="name" class="form-control" required /></div><button class="btn btn-primary">@Localizer["Save"]</button></form></div>
