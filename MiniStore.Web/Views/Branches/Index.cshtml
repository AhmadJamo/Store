@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model List<MiniStore.Domain.Entities.Branch>
<div class="container mt-4"><div class="d-flex justify-content-between"><h2>@Localizer["Branches"]</h2><a asp-action="Create" class="btn btn-primary">@Localizer["Add Branch"]</a></div><table class="table mt-3"><thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Name"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>@foreach(var branch in Model){<tr><td>@branch.Code</td><td>@branch.Name</td><td>@(branch.IsActive ? "Active" : "Inactive")</td></tr>}</tbody></table></div>
