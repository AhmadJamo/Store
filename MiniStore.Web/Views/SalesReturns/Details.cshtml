@model MiniStore.Application.DTOs.Sales.SalesReturnDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Sales return details"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h3 mb-1">@Localizer["Sales return"] @Model.ReturnNumber</h1><div class="text-muted">@Localizer["Original sale"]: @Model.SaleInvoiceNumber</div></div>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a>
    </div>
    <div class="card shadow-sm border-0 mb-4"><div class="card-body"><strong>@Localizer["Return reason"]:</strong> @Model.Reason</div></div>
    <div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table mb-0"><thead class="table-light"><tr><th>@Localizer["Product"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Refund amount"]</th><th>@Localizer["Restocked"]</th><th>@Localizer["Restocked cost"]</th></tr></thead><tbody>
    @foreach (var item in Model.Items) { <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@item.RefundAmount.ToString("0.00")</td><td>@(item.Restocked ? Localizer["Yes"] : Localizer["No"])</td><td>@item.RestockedCostAmount.ToString("0.########")</td></tr> }
    </tbody></table></div></div>
    <div class="row justify-content-end"><div class="col-md-5"><div class="card shadow-sm border-0"><div class="card-body">
        <div class="d-flex justify-content-between"><span>@Localizer["Sales tax"]</span><strong>@Model.TaxAmount.ToString("0.00") JOD</strong></div>
        <div class="d-flex justify-content-between mt-2 fs-5"><span>@Localizer["Refund amount"]</span><strong>@Model.RefundAmount.ToString("0.00") JOD</strong></div>
    </div></div></div></div>
</div>
