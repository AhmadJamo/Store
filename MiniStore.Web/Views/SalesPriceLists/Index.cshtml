@model MiniStore.Application.Dtos.Sales.SalesPriceListPageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ViewData["Title"]="Sales price lists";var canManage=(await Authorization.AuthorizeAsync(User,null,"Permission:SalesPricing.Manage")).Succeeded;string N(decimal x)=>x.ToString("0.######");}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Localizer["Sales price lists"]</h2><p class="text-muted mb-0">@Localizer["Configure deterministic prices without changing legacy sales."]</p></div><span class="badge bg-info text-dark">@Localizer["Read-only evaluation; no stock or accounting effect"]</span></div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
 <div class="col-xl-4">
  @if(canManage){<div class="card mb-3"><div class="card-header"><strong>@Localizer["Create price list"]</strong></div><div class="card-body"><form asp-action="Create" method="post" class="row g-2"><div class="col-5"><label asp-for="ListForm.Code" class="form-label">@Localizer["Code"]</label><input asp-for="ListForm.Code" class="form-control"/></div><div class="col-7"><label asp-for="ListForm.Name" class="form-label">@Localizer["Name"]</label><input asp-for="ListForm.Name" class="form-control"/></div><div class="col-6"><label asp-for="ListForm.CurrencyCode" class="form-label">@Localizer["Currency"]</label><select asp-for="ListForm.CurrencyCode" class="form-select">@foreach(var c in Model.Currencies){<option value="@c">@c</option>}</select></div><div class="col-6"><label asp-for="ListForm.RoundingIncrement" class="form-label">@Localizer["Rounding increment"] <span title="@Localizer["The final unit price is rounded to this increment."]">?</span></label><input asp-for="ListForm.RoundingIncrement" class="form-control"/></div><div class="col-6"><label asp-for="ListForm.ValidFrom" class="form-label">@Localizer["Valid from"]</label><input asp-for="ListForm.ValidFrom" type="date" class="form-control"/></div><div class="col-6"><label asp-for="ListForm.ValidTo" class="form-label">@Localizer["Valid to"]</label><input asp-for="ListForm.ValidTo" type="date" class="form-control"/></div><div class="col-12"><button class="btn btn-primary w-100">@Localizer["Create price list"]</button></div></form></div></div>}
  <div class="card"><div class="card-header"><strong>@Localizer["Price lists"]</strong></div><div class="list-group list-group-flush">@if(Model.PriceLists.Count==0){<div class="p-3 text-muted">@Localizer["No price lists have been created."]</div>}@foreach(var x in Model.PriceLists){<a asp-action="Index" asp-route-id="@x.Id" class="list-group-item list-group-item-action @(Model.Selected?.Id==x.Id?"active":"")"><div class="d-flex justify-content-between"><strong>@x.Code</strong><span>@(x.IsActive?Localizer["Active"]:Localizer["Archived"])</span></div><div>@x.Name · @x.CurrencyCode</div></a>}</div></div>
 </div>
 <div class="col-xl-8">
 @if(Model.Selected is not null){var s=Model.Selected;<div class="card mb-3"><div class="card-header d-flex flex-wrap justify-content-between gap-2"><div><strong>@s.Code — @s.Name</strong><div class="small text-muted">@s.CurrencyCode · @Localizer["Rounding increment"] @N(s.RoundingIncrement)</div></div>@if(canManage){<form asp-action="SetListActive" method="post"><input type="hidden" name="Id" value="@s.Id"/><input type="hidden" name="Active" value="@(!s.IsActive)"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(s.RowVersion)"/><button class="btn btn-sm @(s.IsActive?"btn-outline-danger":"btn-outline-success")">@(s.IsActive?Localizer["Archive price list"]:Localizer["Activate price list"])</button></form>}</div>
 <div class="card-body"><h5>@Localizer["Price rules"]</h5>@if(s.Rules.Count==0){<p class="text-muted">@Localizer["No rules; the product channel price is used as fallback."]</p>}<div class="row g-2">@foreach(var r in s.Rules){var target=r.Scope==SalesPriceRuleScope.Product?Model.Products.FirstOrDefault(x=>x.Id==r.ProductId)?.Name:r.Scope==SalesPriceRuleScope.ProductCategory?Model.Categories.FirstOrDefault(x=>x.Id==r.ProductCategoryId)?.Name:Localizer["All products"].Value;var unit=Model.Units.FirstOrDefault(x=>x.Id==r.MeasurementUnitId);<div class="col-md-6"><div class="border rounded p-2 h-100 @(r.IsActive?"":"bg-light text-muted")"><div class="d-flex justify-content-between"><strong>@Localizer[r.Scope.ToString()]</strong><span>#@r.Priority</span></div><div>@target</div><div class="small">@Localizer["Minimum quantity"]: @N(r.MinimumQuantity) · @(unit is null?Localizer["Any compatible unit"]:$"{unit.Name} ({unit.Symbol})")</div><div class="small">@Localizer[r.ComputationType.ToString()]: @N(r.Value)</div>@if(canManage){<form asp-action="SetRuleActive" method="post" class="mt-2"><input type="hidden" name="Id" value="@r.Id"/><input type="hidden" name="PriceListId" value="@s.Id"/><input type="hidden" name="Active" value="@(!r.IsActive)"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(r.RowVersion)"/><button class="btn btn-sm @(r.IsActive?"btn-outline-danger":"btn-outline-success")">@(r.IsActive?Localizer["Archive rule"]:Localizer["Activate rule"])</button></form>}</div></div>}</div>
 @if(canManage&&s.IsActive){<hr/><h5>@Localizer["Add price rule"]</h5><form asp-action="AddRule" method="post" class="row g-2"><input asp-for="RuleForm.SalesPriceListId" type="hidden" value="@s.Id"/><div class="col-md-4"><label asp-for="RuleForm.Scope" class="form-label">@Localizer["Rule scope"] <span title="@Localizer["Product rules are more specific than category and all-product rules when priority is equal."]">?</span></label><select asp-for="RuleForm.Scope" class="form-select">@foreach(var x in Enum.GetValues<SalesPriceRuleScope>()){<option value="@x">@Localizer[x.ToString()]</option>}</select></div><div class="col-md-4"><label asp-for="RuleForm.ProductId" class="form-label">@Localizer["Product"]</label><select asp-for="RuleForm.ProductId" class="form-select"><option value="">—</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><label asp-for="RuleForm.ProductCategoryId" class="form-label">@Localizer["Category"]</label><select asp-for="RuleForm.ProductCategoryId" class="form-select"><option value="">—</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><label asp-for="RuleForm.MeasurementUnitId" class="form-label">@Localizer["Sales unit"]</label><select asp-for="RuleForm.MeasurementUnitId" class="form-select"><option value="">@Localizer["Any compatible unit"]</option>@foreach(var x in Model.Units){<option value="@x.Id">@x.Name (@x.Symbol)</option>}</select></div><div class="col-md-4"><label asp-for="RuleForm.MinimumQuantity" class="form-label">@Localizer["Minimum quantity"]</label><input asp-for="RuleForm.MinimumQuantity" class="form-control"/></div><div class="col-md-4"><label asp-for="RuleForm.Priority" class="form-label">@Localizer["Priority"] <span title="@Localizer["A lower priority number is evaluated first."]">?</span></label><input asp-for="RuleForm.Priority" class="form-control"/></div><div class="col-md-6"><label asp-for="RuleForm.ComputationType" class="form-label">@Localizer["Computation"]</label><select asp-for="RuleForm.ComputationType" class="form-select">@foreach(var x in Enum.GetValues<SalesPriceComputationType>()){<option value="@x">@Localizer[x.ToString()]</option>}</select></div><div class="col-md-6"><label asp-for="RuleForm.Value" class="form-label">@Localizer["Rule value"] <span title="@Localizer["Use a negative percentage for a discount and a positive percentage for a markup."]">?</span></label><input asp-for="RuleForm.Value" class="form-control"/></div><div class="col-md-6"><label asp-for="RuleForm.EffectiveFrom" class="form-label">@Localizer["Effective from"]</label><input asp-for="RuleForm.EffectiveFrom" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="RuleForm.EffectiveTo" class="form-label">@Localizer["Effective to"]</label><input asp-for="RuleForm.EffectiveTo" type="date" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">@Localizer["Add price rule"]</button></div></form>}</div></div>}
 <div class="card"><div class="card-header"><strong>@Localizer["Price evaluator"]</strong></div><div class="card-body"><p class="text-muted small">@Localizer["This preview explains the selected price and creates no document or transaction."]</p><form asp-action="Evaluate" method="post" class="row g-2"><div class="col-md-6"><label asp-for="EvaluationForm.PriceListId" class="form-label">@Localizer["Price list"]</label><select asp-for="EvaluationForm.PriceListId" class="form-select"><option value="">@Localizer["Customer default or product fallback"]</option>@foreach(var x in Model.PriceLists.Where(x=>x.IsActive)){<option value="@x.Id">@x.Code — @x.Name</option>}</select></div><div class="col-md-6"><label asp-for="EvaluationForm.CustomerId" class="form-label">@Localizer["Customer"]</label><select asp-for="EvaluationForm.CustomerId" class="form-select"><option value="">@Localizer["No customer"]</option>@foreach(var x in Model.Customers){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><label asp-for="EvaluationForm.ProductId" class="form-label">@Localizer["Product"]</label><select asp-for="EvaluationForm.ProductId" class="form-select"><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><label asp-for="EvaluationForm.MeasurementUnitId" class="form-label">@Localizer["Sales unit"]</label><select asp-for="EvaluationForm.MeasurementUnitId" class="form-select"><option value="">@Localizer["Select unit"]</option>@foreach(var x in Model.Units){<option value="@x.Id">@x.Name (@x.Symbol)</option>}</select></div><div class="col-md-4"><label asp-for="EvaluationForm.Quantity" class="form-label">@Localizer["Quantity"]</label><input asp-for="EvaluationForm.Quantity" class="form-control"/></div><div class="col-md-4"><label asp-for="EvaluationForm.PricingDate" class="form-label">@Localizer["Pricing date"]</label><input asp-for="EvaluationForm.PricingDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="EvaluationForm.Channel" class="form-label">@Localizer["Base price channel"]</label><select asp-for="EvaluationForm.Channel" class="form-select"><option value="Wholesale">@Localizer["Wholesale"]</option><option value="RetailPos">@Localizer["Retail POS"]</option></select></div><div class="col-md-6"><label asp-for="EvaluationForm.TaxRateId" class="form-label">@Localizer["Explicit tax override"]</label><select asp-for="EvaluationForm.TaxRateId" class="form-select"><option value="">@Localizer["Customer default or no tax"]</option>@foreach(var x in Model.TaxRates){<option value="@x.Id">@x.Name (@N(x.Rate)%)</option>}</select></div><div class="col-md-6 d-flex align-items-end"><button class="btn btn-outline-primary w-100">@Localizer["Evaluate price"]</button></div></form>
 @if(Model.Evaluation is not null){var e=Model.Evaluation;<hr/><h5>@Localizer["Evaluation result"]</h5><div class="row g-2"><div class="col-md-6"><div class="border rounded p-2"><strong>@Localizer["Source"]</strong><div>@e.SourceCode</div><small>@(e.PriceListName??Localizer["Product channel fallback"].Value) @(e.RuleId.HasValue?$"· #{e.RuleId}":"")</small></div></div><div class="col-md-6"><div class="border rounded p-2"><strong>@Localizer["Unit price"]</strong><div>@N(e.UnitPrice) @e.TransactionCurrency</div><small>@N(e.CompanyUnitPrice) @e.CompanyCurrency</small></div></div><div class="col-md-6"><div class="border rounded p-2"><strong>@Localizer["Unit conversion"]</strong><div>@N(e.Quantity) @e.UnitName → @N(e.NormalizedStockQuantity)</div></div></div><div class="col-md-6"><div class="border rounded p-2"><strong>@Localizer["Exchange rate"]</strong><div>@N(e.ExchangeRate) · @e.ExchangeRateDate</div><small>@e.ExchangeRateSource</small></div></div><div class="col-md-4"><div class="border rounded p-2"><strong>@Localizer["Net amount"]</strong><div>@N(e.LineNetAmount)</div></div></div><div class="col-md-4"><div class="border rounded p-2"><strong>@Localizer["Tax amount"]</strong><div>@N(e.TaxAmount)</div><small>@e.TaxSource @(e.TaxName is null?"":$"· {e.TaxName}")</small></div></div><div class="col-md-4"><div class="border rounded p-2"><strong>@Localizer["Total"]</strong><div>@N(e.LineTotal) @e.TransactionCurrency</div></div></div></div>}</div></div>
 </div>
</div>
