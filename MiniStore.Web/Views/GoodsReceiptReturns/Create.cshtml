@model MiniStore.Application.DTOs.Purchases.GoodsReceiptReturnCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Return received goods"]; }
<div class="d-flex justify-content-between"><div><h2>@Localizer["Return received goods"]</h2><p class="text-muted">@Model.ReceiptNumber — @Model.SupplierName — @Model.WarehouseName</p></div><a asp-controller="GoodsReceipts" asp-action="Details" asp-route-id="@Model.GoodsReceiptId" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<form asp-action="Create" method="post"><input type="hidden" asp-for="Form.GoodsReceiptId" name="GoodsReceiptId"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3 mb-3"><div class="col-md-3"><label class="form-label">@Localizer["Return date"]</label><input asp-for="Form.ReturnDate" name="ReturnDate" type="date" class="form-control"/></div><div class="col-md-9"><label class="form-label">@Localizer["Reason"]</label><input asp-for="Form.Reason" name="Reason" required maxlength="1000" class="form-control"/></div></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Remaining quantity"]</th><th>@Localizer["Return quantity"]</th><th>@Localizer["Tracking allocations"]</th></tr></thead><tbody>@for(var i=0;i<Model.Lines.Count;i++){var line=Model.Lines[i];<tr><td>@line.ProductCode — @line.ProductName<input type="hidden" name="Lines[@i].GoodsReceiptLineId" value="@line.GoodsReceiptLineId"/></td><td>@line.RemainingQuantity @line.UnitName</td><td><input name="Lines[@i].ReturnQuantity" value="@(Model.Form.Lines.ElementAtOrDefault(i)?.ReturnQuantity ?? 0)" type="number" min="0" max="@line.RemainingQuantity" step="0.000001" class="form-control"/></td><td><textarea name="Lines[@i].TrackingAllocations" maxlength="2000" class="form-control" placeholder="@Localizer["LOT:QUANTITY or one serial per line"]">@(Model.Form.Lines.ElementAtOrDefault(i)?.TrackingAllocations)</textarea>@if(!string.IsNullOrWhiteSpace(line.ReceivedTracking)){<small class="text-muted">@Localizer["Received tracking"]: @line.ReceivedTracking</small>}</td></tr>}</tbody></table></div>
<button class="btn btn-danger" type="submit">@Localizer["Post goods receipt return"]</button></form>
