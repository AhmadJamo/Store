@model List<MiniStore.Application.DTOs.Purchases.GoodsReceiptReturnDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Goods receipt returns"]; }
<h2>@Localizer["Goods receipt returns"]</h2>
@if(Model.Count==0){<div class="alert alert-info">@Localizer["No goods receipt returns found."]</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Return number"]</th><th>@Localizer["Goods receipt"]</th><th>@Localizer["Supplier"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Return date"]</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.ReturnNumber</td><td>@item.ReceiptNumber</td><td>@item.SupplierName</td><td>@item.WarehouseName</td><td>@item.ReturnDate</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr>}</tbody></table></div>}
