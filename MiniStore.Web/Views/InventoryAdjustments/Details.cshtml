@model MiniStore.Application.DTOs.Inventory.Adjustments.InventoryAdjustmentDetailsDto
@using MiniStore.Domain.Entities
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Model.Number;}
<div class="container mt-4"><div class="d-flex justify-content-between"><div><h2>@Model.Number</h2><p class="text-muted">@Model.Warehouse · @Localizer[Model.Location] · @Localizer[Model.Status.ToString()]</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">@Localizer["Back"]</a></div><div class="alert alert-light border"><strong>@Localizer["Reason"]:</strong> @Model.Reason</div>
@if(Model.Status==InventoryAdjustmentStatus.Draft){<form asp-action="Count" asp-route-id="@Model.Id" method="post"><div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Expected quantity"]</th><th>@Localizer["Counted quantity"]</th></tr></thead><tbody>@for(var i=0;i<Model.Lines.Count;i++){<tr><td>@Model.Lines[i].ProductName<input type="hidden" name="Lines[@i].ProductId" value="@Model.Lines[i].ProductId" /></td><td>@(Model.Lines[i].ExpectedQuantity?.ToString("N3")??Localizer["Hidden"].Value)</td><td><input type="number" min="0" step="0.000001" name="Lines[@i].CountedQuantity" value="@Model.Lines[i].CountedQuantity?.ToString(CultureInfo.InvariantCulture)" class="form-control" required /></td></tr>}</tbody></table></div><button class="btn btn-primary">@Localizer["Complete count"]</button></form>}
else{<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Expected quantity"]</th><th>@Localizer["Counted quantity"]</th><th>@Localizer["Variance"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductName</td><td>@line.ExpectedQuantity?.ToString("N3")</td><td>@line.CountedQuantity?.ToString("N3")</td><td class="@(line.VarianceQuantity!=0?"fw-bold":"")">@line.VarianceQuantity?.ToString("+0.###;-0.###;0")</td></tr>}</tbody></table></div>}
<div class="d-flex gap-2 mt-3">@if(Model.Status==InventoryAdjustmentStatus.Counted){<form asp-action="Approve" asp-route-id="@Model.Id" method="post"><button class="btn btn-success">@Localizer["Approve"]</button></form>}@if(Model.Status==InventoryAdjustmentStatus.Approved){<form asp-action="Post" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">@Localizer["Post"]</button></form>}@if(Model.Status is InventoryAdjustmentStatus.Draft or InventoryAdjustmentStatus.Counted or InventoryAdjustmentStatus.Approved){<form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger">@Localizer["Cancel"]</button></form>}</div></div>
