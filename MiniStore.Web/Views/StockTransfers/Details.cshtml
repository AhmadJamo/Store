```cshtml
@using MiniStore.Application.DTOs.StockTransfers
@using MiniStore.Domain.Entities
@using System.Security.Claims
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@model StockTransferDetailsDto

@{
    ViewData["Title"] = $"Stock Transfer - {Model.TransferNumber}";

    var userId =
        User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2>
            @Localizer["Stock Transfer"]
        </h2>

        <div class="text-muted">
            @Model.TransferNumber
        </div>

    </div>


    <div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to List

        </a>

    </div>

</div>


<!-- ========================================== -->
<!-- Status -->
<!-- ========================================== -->

<div class="card mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <strong>
                    @Localizer["Status:"]
                </strong>


                @switch (Model.Status)
                {
                    case StockTransferStatus.Draft:

                        <span class="badge bg-secondary">
                            @Localizer["Draft"]
                        </span>

                        break;


                    case StockTransferStatus.Submitted:

                        <span class="badge bg-primary">
                            @Localizer["Submitted"]
                        </span>

                        break;


                    case StockTransferStatus.Approved:

                        <span class="badge bg-success">
                            @Localizer["Approved"]
                        </span>

                        break;


                    case StockTransferStatus.Rejected:

                        <span class="badge bg-danger">
                            @Localizer["Rejected"]
                        </span>

                        break;


                    case StockTransferStatus.Posted:

                        <span class="badge bg-dark">
                            @Localizer["Posted"]
                        </span>

                        break;


                    case StockTransferStatus.Cancelled:

                        <span class="badge bg-warning text-dark">
                            @Localizer["Cancelled"]
                        </span>

                        break;
                }

            </div>


            <!-- ========================================== -->
            <!-- Workflow Actions -->
            <!-- ========================================== -->

            <div class="d-flex gap-2">


                <!-- Edit -->
                @if (Model.Status == StockTransferStatus.Draft &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Edit"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary">

                        <i class="bi bi-pencil"></i>
                        Edit

                    </a>
                }


                <!-- Submit -->
                @if (Model.Status == StockTransferStatus.Draft &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Submit"))
                {
                    <form asp-action="Submit"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-primary">

                            @Localizer["Submit"]

                        </button>

                    </form>
                }


                <!-- Approve -->
                @if (Model.Status == StockTransferStatus.Submitted &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Approve"))
                {
                    <form asp-action="Approve"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success">

                            @Localizer["Approve"]

                        </button>

                    </form>
                }


                <!-- Reject -->
                @if (Model.Status == StockTransferStatus.Submitted &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Reject"))
                {
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#rejectModal">

                        @Localizer["Reject"]

                    </button>
                }


                <!-- Return To Draft -->
                @if (Model.Status == StockTransferStatus.Rejected &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Edit"))
                {
                    <form asp-action="ReturnToDraft"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-warning">

                            @Localizer["Return to Draft"]

                        </button>

                    </form>
                }


                <!-- Post -->
                @if (Model.Status == StockTransferStatus.Approved &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Post"))
                {
                    <form asp-action="Post"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success">

                            @Localizer["Post"]

                        </button>

                    </form>
                }


                <!-- Cancel -->
                @if (Model.Status == StockTransferStatus.Posted &&
                                     await PermissionService.CanAsync(
                                         userId,
                                         "StockTransfers.Cancel"))
                {
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelModal">

                        @Localizer["Cancel"]

                    </button>
                }

            </div>

        </div>

    </div>

</div>


<!-- ========================================== -->
<!-- Transfer Information -->
<!-- ========================================== -->

<div class="card mb-4">

    <div class="card-header">

        <h5 class="mb-0">
            @Localizer["Transfer Information"]
        </h5>

    </div>


    <div class="card-body">

        <div class="row">


            <!-- Transfer Number -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["Transfer Number"]
                </strong>

                <div>
                    @Model.TransferNumber
                </div>

            </div>


            <!-- Created at -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["Created at"]
                </strong>

                <div>
                    @Model.CreatedAt.ToLocalTime()
                </div>

            </div>


            <!-- From Warehouse -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["From Warehouse"]
                </strong>

                <div>
                    @Model.FromWarehouseName
                </div>

            </div>


            <!-- To Warehouse -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["To Warehouse"]
                </strong>

                <div>
                    @Model.ToWarehouseName
                </div>

            </div>


            <!-- Created By -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["Created By"]
                </strong>

                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.CreatedByUserName))
                    {
                        @Model.CreatedByUserName
                    }
                    else
                    {
                        <span class="text-muted">
                            @Localizer["Unknown User"]
                        </span>
                    }
                </div>

            </div>


            <!-- Reference -->

            <div class="col-md-6 mb-3">

                <strong>
                    @Localizer["Reference"]
                </strong>

                <div>
                    @(string.IsNullOrWhiteSpace(Model.Reference)
                        ? "-"
                        : Model.Reference)
                </div>

            </div>


            <!-- Notes -->

            <div class="col-12 mb-3">

                <strong>
                    @Localizer["Notes"]
                </strong>

                <div>
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "-"
                        : Model.Notes)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================== -->
<!-- Rejection Information -->
<!-- ========================================== -->
@if (Model.Status == StockTransferStatus.Rejected)
{
    <div class="alert alert-danger mb-4">

        <h5 class="alert-heading">
            @Localizer["Rejection Information"]
        </h5>

        <hr />

        <div>

            <strong>
                @Localizer["Rejected By:"]
            </strong>

            @if (!string.IsNullOrWhiteSpace(Model.RejectedByUserName))
            {
                @Model.RejectedByUserName
            }
            else
            {
                <span class="text-muted">
                    @Localizer["Unknown User"]
                </span>
            }

        </div>

        <div>

            <strong>
                @Localizer["Rejected At:"]
            </strong>

            @(Model.RejectedAt?
                .ToLocalTime()
                .ToString()
                ?? "-")

        </div>

        <div>

            <strong>
                @Localizer["Reason:"]
            </strong>

            @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                ? "-"
                : Model.RejectionReason)

        </div>

    </div>
}


<!-- ========================================== -->
<!-- Cancellation Information -->
<!-- ========================================== -->
@if (Model.Status == StockTransferStatus.Cancelled)
{
    <div class="alert alert-warning mb-4">

        <h5 class="alert-heading">
            @Localizer["Cancellation Information"]
        </h5>

        <hr />

        <div>

            <strong>
                @Localizer["Cancelled By:"]
            </strong>

            @if (!string.IsNullOrWhiteSpace(Model.CancelledByUserName))
            {
                @Model.CancelledByUserName
            }
            else
            {
                <span class="text-muted">
                    @Localizer["Unknown User"]
                </span>
            }

        </div>

        <div>

            <strong>
                @Localizer["Cancelled At:"]
            </strong>

            @(Model.CancelledAt?
                .ToLocalTime()
                .ToString()
                ?? "-")

        </div>

        <div>

            <strong>
                @Localizer["Reason:"]
            </strong>

            @(string.IsNullOrWhiteSpace(Model.CancellationReason)
                ? "-"
                : Model.CancellationReason)

        </div>

    </div>
}


<!-- ========================================== -->
<!-- Items -->
<!-- ========================================== -->

<div class="card mb-4">

    <div class="card-header">

        <h5 class="mb-0">
            @Localizer["Transfer Items"]
        </h5>

    </div>


    <div class="card-body p-0">

        @if (Model.Items.Any())
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width: 70px;">
                                #
                            </th>

                            <th>
                                @Localizer["Product"]
                            </th>

                            <th>
                                @Localizer["Barcode"]
                            </th>

                            <th>@Localizer["From location"]</th>
                            <th>@Localizer["To location"]</th>
                            <th>@Localizer["Tracked identity selection"]</th>

                            <th class="text-end">
                                @Localizer["Quantity"]
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var itemNumber = 1;
                        }


                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @itemNumber
                                </td>

                                <td>
                                    @item.ProductName
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Barcode)
                                        ? "-"
                                        : item.Barcode)
                                </td>

                                <td><strong>@item.SourceLocationCode</strong></td>
                                <td><strong>@item.DestinationLocationCode</strong></td>
                                <td>@if(!string.IsNullOrWhiteSpace(item.TrackingAllocations)){<code class="text-wrap">@item.TrackingAllocations</code>}else{<span>—</span>}</td>

                                <td class="text-end">
                                    @item.Quantity.ToString("N3")
                                </td>

                            </tr>

                            itemNumber++;
                        }

                    </tbody>


                    <tfoot class="table-light">

                        <tr>

                            <th colspan="6"
                                class="text-end">

                                @Localizer["Total quantity"]

                            </th>

                            <th class="text-end">

                                @(Model.Items
                                    .Sum(x => x.Quantity)
                                    .ToString("N3"))

                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }
        else
        {
            <div class="p-4 text-muted">

                @Localizer["No items found."]

            </div>
        }

    </div>

</div>


