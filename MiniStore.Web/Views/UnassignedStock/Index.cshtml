@model List<MiniStore.Application.DTOs.Warehouses.UnassignedStockDto>
@using MiniStore.Domain.Entities

@{
    ViewData["Title"] = "Unassigned Stock";
    var warehouses = ViewBag.Warehouses as List<Warehouse> ?? [];
    var locations = ViewBag.Locations as List<StorageLocation> ?? [];
    int? selectedWarehouseId = ViewBag.WarehouseId;
    string? query = ViewBag.Query;
    string sort = ViewBag.Sort as string ?? "name";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between">
        <div>
            <h2>Unassigned Stock</h2>
            <p class="text-muted">
                Products received or transferred without an exact rack/bin location.
            </p>
        </div>
        <a asp-controller="WarehouseLocations"
           asp-action="Index"
           class="btn btn-outline-primary align-self-start">
            Manage locations
        </a>
    </div>

    <form method="get" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-3">
                <label for="warehouseId" class="form-label">Warehouse</label>
                <select id="warehouseId" name="warehouseId" class="form-select">
                    <option value="">All warehouses</option>
                    @foreach (var warehouse in warehouses)
                    {
                        <option value="@warehouse.Id"
                                selected="@(selectedWarehouseId == warehouse.Id)">
                            @warehouse.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-5">
                <label for="query" class="form-label">Product</label>
                <input id="query"
                       name="query"
                       value="@query"
                       class="form-control"
                       placeholder="Product name or barcode" />
            </div>

            <div class="col-md-2">
                <label for="sort" class="form-label">Sort</label>
                <select id="sort" name="sort" class="form-select">
                    <option value="name" selected="@(sort == "name")">Name</option>
                    <option value="barcode" selected="@(sort == "barcode")">Barcode</option>
                    <option value="warehouse" selected="@(sort == "warehouse")">Warehouse</option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Barcode</th>
                    <th>Warehouse</th>
                    <th>Unassigned</th>
                    <th>Assign location</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var availableLocations = locations.Where(location =>
                        location.WarehouseId == row.WarehouseId &&
                        location.Status == StorageLocationStatus.Active);

                    <tr>
                        <td>@row.ProductName</td>
                        <td>@row.Barcode</td>
                        <td>@row.WarehouseName</td>
                        <td><strong>@row.UnassignedQuantity.ToString("N3")</strong></td>
                        <td>
                            <form asp-action="Assign" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productId" value="@row.ProductId" />
                                <input type="hidden" name="warehouseId" value="@row.WarehouseId" />

                                <select name="storageLocationId" class="form-select" required>
                                    <option value="">Select rack/bin</option>
                                    @foreach (var location in availableLocations)
                                    {
                                        <option value="@location.Id">@location.Code</option>
                                    }
                                </select>

                                <input name="quantity"
                                       type="number"
                                       value="@row.UnassignedQuantity"
                                       min="0.001"
                                       max="@row.UnassignedQuantity"
                                       step="0.001"
                                       class="form-control"
                                       style="max-width: 140px" />

                                <button class="btn btn-success">Save</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            All stock has an exact location.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
