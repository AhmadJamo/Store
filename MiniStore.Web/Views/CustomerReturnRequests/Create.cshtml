@model MiniStore.Application.Dtos.Sales.CustomerReturnRequestCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Localizer["Create customer return request"]; var settings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2>@Localizer["Create customer return request"]</h2><div class="text-muted">@Model.DeliveryNumber · @Model.OrderNumber · @Model.CustomerName</div></div><a asp-controller="SalesDeliveries" asp-action="Details" asp-route-id="@Model.SalesDeliveryId" class="btn btn-outline-secondary">@Localizer["Back to delivery"]</a></div>
<div class="alert alert-info">@Localizer["This step records the customer's request only. Stock and accounting remain unchanged until approved goods are received and inspected."]</div>
<form asp-action="Create" method="post"><input type="hidden" name="SalesDeliveryId" value="@Model.SalesDeliveryId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="card card-body mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">@Localizer["Request date"]</label><input type="date" name="RequestDate" value="@Model.Form.RequestDate.ToString("yyyy-MM-dd")" min="@Model.DeliveryDate.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-8"><label class="form-label">@Localizer["Return reason"]</label><input name="Reason" value="@Model.Form.Reason" maxlength="500" class="form-control" required/></div><div class="col-12"><label class="form-label">@Localizer["Notes"]</label><textarea name="Notes" maxlength="1000" class="form-control">@Model.Form.Notes</textarea></div></div></div>
<div class="row g-3">@for(var i=0;i<Model.Lines.Count;i++){var line=Model.Lines[i];var old=Model.Form.Lines.FirstOrDefault(x=>x.SalesDeliveryLineId==line.SalesDeliveryLineId)?.StockQuantity??0;<div class="col-lg-6"><div class="card h-100"><div class="card-body"><input type="hidden" name="Lines[@i].SalesDeliveryLineId" value="@line.SalesDeliveryLineId"/><strong>@line.ProductCode — @line.ProductName</strong><div class="small text-muted">@line.WarehouseName · @line.LocationName</div><div class="row mt-2"><div class="col-4"><span class="text-muted">@Localizer["Delivered"]</span><div>@line.DeliveredQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Already requested"]</span><div>@line.AlreadyRequestedQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Remaining"]</span><div>@line.RemainingQuantity.ToQuantityDisplay(settings)</div></div></div><label class="form-label mt-3">@Localizer["Return quantity"]</label><input type="number" name="Lines[@i].StockQuantity" value="@old" min="0" max="@line.RemainingQuantity" step="any" class="form-control"/></div></div></div>}</div>
<button class="btn btn-primary mt-3" @(Model.Lines.Count==0?"disabled":null)>@Localizer["Create return request draft"]</button></form>
@if(Model.Lines.Count==0){<div class="alert alert-secondary mt-3">@Localizer["This delivery has no remaining returnable quantity."]</div>}
