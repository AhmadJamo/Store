@model IReadOnlyCollection<MiniStore.Application.Dtos.Sales.CustomerReturnRequestSummaryDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Localizer["Customer return requests"]; var settings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2>@Localizer["Customer return requests"]</h2><form method="get" class="d-flex gap-2"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Return, order or customer"]"/><button class="btn btn-outline-primary">@Localizer["Search"]</button></form></div>
<div class="alert alert-info">@Localizer["Return requests control approval before goods are received. They do not change stock, accounting or customer balances."]</div>
<div class="row g-3">@foreach(var item in Model){<div class="col-xl-4 col-md-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><strong>@item.ReturnNumber</strong><span class="badge @(item.Status==MiniStore.Domain.Entities.CustomerReturnRequestStatus.Approved?"bg-success":item.Status is MiniStore.Domain.Entities.CustomerReturnRequestStatus.Rejected or MiniStore.Domain.Entities.CustomerReturnRequestStatus.Cancelled?"bg-secondary":"bg-warning text-dark")">@Localizer[item.Status.ToString()]</span></div><div class="mt-2">@Localizer["Customer"]: @item.CustomerName</div><div>@Localizer["Sales order"]: @item.OrderNumber</div><div>@Localizer["Request date"]: @item.RequestDate</div><div>@Localizer["Quantity"]: @item.Quantity.ToQuantityDisplay(settings)</div><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-3">@Localizer["View details"]</a></div></div></div>}</div>
@if(Model.Count==0){<div class="alert alert-secondary">@Localizer["No customer return requests were found. Start from a posted sales delivery."] <a asp-controller="SalesDeliveries" asp-action="Index" class="alert-link">@Localizer["Open sales deliveries"]</a></div>}
