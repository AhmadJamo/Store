@model MiniStore.Application.Dtos.Sales.CustomerReturnRequestDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"]=Model.ReturnNumber; var rv=Convert.ToBase64String(Model.RowVersion); var settings=await GeneralSettingsService.GetAsync(); async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Model.ReturnNumber</h2><span class="badge @(Model.Status==MiniStore.Domain.Entities.CustomerReturnRequestStatus.Approved?"bg-success":Model.Status is MiniStore.Domain.Entities.CustomerReturnRequestStatus.Rejected or MiniStore.Domain.Entities.CustomerReturnRequestStatus.Cancelled?"bg-secondary":"bg-warning text-dark")">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex flex-wrap gap-2"><a asp-controller="SalesDeliveries" asp-action="Details" asp-route-id="@Model.SalesDeliveryId" class="btn btn-outline-primary">@Localizer["View source delivery"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["This request does not change stock, accounting or customer balances. An approved request must be received and inspected in the next step."]</div>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-3"><span class="text-muted">@Localizer["Customer"]</span><div>@Model.CustomerName</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Sales order"]</span><div>@Model.OrderNumber</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Source delivery"]</span><div>@Model.DeliveryNumber</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Request date"]</span><div>@Model.RequestDate</div></div></div><div class="mt-3"><span class="text-muted">@Localizer["Return reason"]</span><div>@Model.Reason</div></div>@if(Model.Notes is not null){<div class="mt-2">@Model.Notes</div>}</div>
<div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><strong>@line.ProductCode — @line.ProductName</strong><div class="small text-muted">@line.WarehouseName · @line.LocationName</div><div class="row mt-2"><div class="col-6"><span class="text-muted">@Localizer["Delivered"]</span><div>@line.DeliveredQuantity.ToQuantityDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Requested return"]</span><div>@line.RequestedQuantity.ToQuantityDisplay(settings)</div></div></div></div></div></div>}</div>
<div class="d-flex flex-wrap gap-2 mt-3">@if(Model.Status==MiniStore.Domain.Entities.CustomerReturnRequestStatus.Draft){if(await Can("CustomerReturnRequests.Submit")){<form asp-action="Submit" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-primary">@Localizer["Submit for approval"]</button></form>}}else if(Model.Status==MiniStore.Domain.Entities.CustomerReturnRequestStatus.Submitted){if(await Can("CustomerReturnRequests.Approve")){<form asp-action="Approve" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Approve return request"]</button></form>}if(await Can("CustomerReturnRequests.Reject")){<form asp-action="Reject" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Rejection reason"]"/><button class="btn btn-outline-danger">@Localizer["Reject"]</button></form>}}else if(Model.Status==MiniStore.Domain.Entities.CustomerReturnRequestStatus.Approved){<span class="badge bg-success p-2">@Localizer["Approval completed"]</span><span class="text-muted align-self-center">@Localizer["Next: receive and inspect the returned goods."]</span>}else{<span class="badge bg-secondary p-2">@Localizer["Request closed"]</span>}@if(Model.Status is not MiniStore.Domain.Entities.CustomerReturnRequestStatus.Rejected and not MiniStore.Domain.Entities.CustomerReturnRequestStatus.Cancelled && await Can("CustomerReturnRequests.Cancel")){<form asp-action="Cancel" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-secondary">@Localizer["Cancel request"]</button></form>}</div>
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
