@model MiniStore.Application.DTOs.Purchases.SupplierCommunicationDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Localizer["Supplier communication"];var canRecord=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierCommunications.RecordActivity")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><h2 class="mb-1">@Localizer["Supplier communication"] — @Model.DocumentNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></div><a asp-controller="@(Model.DocumentType==SupplierCommunicationDocumentType.Rfq?"PurchaseSourcing":"PurchaseOrders")" asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-outline-secondary">@Localizer["Back to document"]</a></div>
<div class="alert alert-warning my-3"><strong>@Localizer["Prepared does not mean sent"]</strong><div>@Localizer["The system opens your email application but does not claim sending, delivery or reply. Record each status only from actual evidence."]</div></div>
<div class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><strong>@Localizer["Supplier"]</strong><div>@Model.SupplierName</div></div><div class="col-md-4"><strong>@Localizer["Recipient email"]</strong><div>@Model.RecipientEmail</div></div><div class="col-md-4"><strong>@Localizer["Language"]</strong><div>@Localizer[Model.PreferredLanguage]</div></div><div class="col-12"><strong>@Localizer["Subject"]</strong><div>@Model.Subject</div></div><div class="col-12"><strong>@Localizer["Message"]</strong><pre class="border rounded p-3 bg-light text-wrap mb-0" style="white-space:pre-wrap">@Model.Body</pre></div></div><a href="@Model.MailtoUrl" class="btn btn-primary mt-3 align-self-start">@Localizer["Open in email application"]</a></div>
@if(Model.Attachments.Count>0){<div class="card card-body mb-3"><h3 class="h5">@Localizer["Attachments to add in the email application"]</h3><div class="d-flex flex-wrap gap-2">@foreach(var item in Model.Attachments){<a asp-action="Attachment" asp-route-id="@Model.Id" asp-route-attachmentId="@item.Id" class="btn btn-outline-secondary">@item.FileName</a>}</div></div>}
@if(canRecord)
{
<form asp-action="RecordActivity" method="post" class="card card-body mb-3"><input type="hidden" name="CommunicationId" value="@Model.Id"/><h3 class="h5">@Localizer["Record actual communication activity"]</h3><div class="row g-2"><div class="col-md-3"><label class="form-label">@Localizer["Activity"]</label><select name="Status" class="form-select" required><option value="Sent">@Localizer["Sent"]</option><option value="Delivered">@Localizer["Delivered"]</option><option value="Replied">@Localizer["Replied"]</option><option value="Failed">@Localizer["Failed"]</option><option value="FollowUp">@Localizer["FollowUp"]</option></select></div><div class="col-md-3"><label class="form-label">@Localizer["Occurred at"]</label><input type="datetime-local" name="OccurredAtUtc" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Evidence reference"]</label><input name="EvidenceReference" maxlength="500" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Summary / note"]</label><input name="Note" maxlength="2000" class="form-control"/></div><div class="col-12"><button class="btn btn-outline-primary">@Localizer["Record activity"]</button></div></div></form>
}
<div class="card card-body"><h3 class="h5">@Localizer["Communication history"]</h3>@if(Model.Activities.Count==0){<div class="text-muted">@Localizer["No sending status has been recorded yet."]</div>}else{<div class="list-group list-group-flush">@foreach(var activity in Model.Activities){<div class="list-group-item px-0"><div class="d-flex justify-content-between gap-2"><strong>@Localizer[activity.Status.ToString()]</strong><span>@activity.OccurredAtUtc.ToLocalTime()</span></div>@if(!string.IsNullOrWhiteSpace(activity.Note)){<div>@activity.Note</div>}@if(!string.IsNullOrWhiteSpace(activity.EvidenceReference)){<small class="text-muted">@Localizer["Evidence reference"]: @activity.EvidenceReference</small>}</div>}</div>}</div>
