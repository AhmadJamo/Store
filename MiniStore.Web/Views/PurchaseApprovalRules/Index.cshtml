@model MiniStore.Application.DTOs.Purchases.PurchaseApprovalRulesPageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = Localizer["Purchase approval rules"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, null,
        "Permission:PurchaseApprovalRules.Manage")).Succeeded;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2>@Localizer["Purchase approval rules"]</h2><p class="text-muted mb-0">@Localizer["Rules determine who must approve submitted purchase requests."]</p></div>
</div>
@if (canManage)
{
    <form asp-action="Create" method="post" class="card card-body mb-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">@Localizer["Rule name"]</label><input asp-for="Form.Name" name="Name" class="form-control" maxlength="150" required /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["Warehouse scope"]</label><select asp-for="Form.WarehouseId" name="WarehouseId" class="form-select"><option value="">@Localizer["All warehouses"]</option>@foreach(var warehouse in Model.Warehouses){<option value="@warehouse.Id">@warehouse.Label</option>}</select></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Minimum priority"]</label><select asp-for="Form.MinimumPriority" name="MinimumPriority" class="form-select" asp-items="Html.GetEnumSelectList<PurchaseRequestPriority>()"></select></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Maximum priority"]</label><select asp-for="Form.MaximumPriority" name="MaximumPriority" class="form-select" asp-items="Html.GetEnumSelectList<PurchaseRequestPriority>()"></select></div>
            @for (var index = 0; index < 3; index++)
            {
                <div class="col-md-4"><label class="form-label">@Localizer["Approval step"] @(index + 1)</label><select name="ApproverRoles[@index]" class="form-select"><option value="">@Localizer["None"]</option>@foreach(var role in Model.Roles){<option value="@role">@role</option>}</select></div>
            }
        </div>
        <div class="mt-3"><button class="btn btn-primary">@Localizer["Create rule"]</button></div>
    </form>
}
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Localizer["Rule name"]</th><th>@Localizer["Warehouse scope"]</th><th>@Localizer["Priority"]</th><th>@Localizer["Approval steps"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>
@foreach (var rule in Model.Rules)
{
    <tr><td>@rule.Name</td><td>@Localizer[rule.WarehouseName]</td><td>@Localizer[rule.MinimumPriority.ToString()] — @Localizer[rule.MaximumPriority.ToString()]</td><td>@string.Join(" → ", rule.ApproverRoles)</td><td>@Localizer[rule.IsActive ? "Active" : "Inactive"]</td><td>@if(canManage){<form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@rule.Id"/><input type="hidden" name="active" value="@((!rule.IsActive).ToString())"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(rule.RowVersion)"/><button class="btn btn-sm btn-outline-secondary">@Localizer[rule.IsActive ? "Deactivate" : "Activate"]</button></form>}</td></tr>
}
</tbody></table></div>
@if(Model.Rules.Count==0){<div class="alert alert-info">@Localizer["No purchase approval rules have been configured."]</div>}
