@model MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Reverse purchase document"]; }
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><h2>@Localizer["Reverse purchase document"]</h2><p class="text-muted mb-0">@Localizer[Model.Form.DocumentType.ToString()] — @Model.OriginalDocumentNumber</p></div><a asp-controller="@Model.OriginalController" asp-action="Details" asp-route-id="@Model.Form.OriginalDocumentId" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<div class="alert alert-warning my-3">@Localizer["Reversal preserves the original document and posts an opposite accounting entry. Reverse dependent documents first."]</div>
@if (Model.ExistingReversalId.HasValue) { <div class="alert alert-success">@Localizer["This purchase document has already been reversed."] <a asp-action="Details" asp-route-id="@Model.ExistingReversalId">@Localizer["View reversal"]</a></div> }
else { <form asp-action="Create" method="post" class="card card-body mt-3"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input type="hidden" name="DocumentType" value="@Model.Form.DocumentType"/><input type="hidden" name="OriginalDocumentId" value="@Model.Form.OriginalDocumentId"/><input type="hidden" name="IdempotencyKey" value="@Model.Form.IdempotencyKey"/><div class="row g-3"><div class="col-md-4"><label class="form-label">@Localizer["Original document date"]</label><input value="@Model.OriginalDocumentDate.ToString("yyyy-MM-dd")" class="form-control" disabled/></div><div class="col-md-4"><label class="form-label">@Localizer["Reversal date"]</label><input type="date" name="ReversalDate" min="@Model.OriginalDocumentDate.ToString("yyyy-MM-dd")" value="@Model.Form.ReversalDate.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-12"><label class="form-label">@Localizer["Reversal reason"]</label><textarea name="Reason" maxlength="1000" class="form-control" rows="3" required>@Model.Form.Reason</textarea></div></div><button type="submit" class="btn btn-danger mt-3 align-self-start">@Localizer["Post reversal"]</button></form> }
