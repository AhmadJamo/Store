@model IReadOnlyCollection<MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Purchase document reversals"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@Localizer["Purchase document reversals"]</h2></div>
@if (Model.Count == 0) { <div class="alert alert-info">@Localizer["No purchase document reversals were found."]</div> }
<div class="row g-3">@foreach (var item in Model) { <div class="col-12 col-md-6 col-xl-4"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@item.ReversalNumber</strong><span class="badge bg-success">@Localizer[item.Status.ToString()]</span></div><div class="text-muted">@Localizer[item.DocumentType.ToString()] — @item.OriginalDocumentNumber</div><div>@Localizer["Reversal date"]: @item.ReversalDate</div><div class="text-break">@Localizer["Reason"]: @item.Reason</div><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-3">@Localizer["View"]</a></div></div> }</div>
