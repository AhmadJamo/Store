@model MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Model.ReversalNumber; }
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><h2>@Model.ReversalNumber <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex gap-2"><a asp-controller="@Model.OriginalController" asp-action="Details" asp-route-id="@Model.OriginalDocumentId" class="btn btn-outline-primary">@Localizer["View original document"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-3"><div class="col-md-4"><strong>@Localizer["Document type"]</strong><div>@Localizer[Model.DocumentType.ToString()]</div></div><div class="col-md-4"><strong>@Localizer["Original document"]</strong><div>@Model.OriginalDocumentNumber</div></div><div class="col-md-4"><strong>@Localizer["Reversal date"]</strong><div>@Model.ReversalDate</div></div><div class="col-md-4"><strong>@Localizer["Journal entry"]</strong><div>@Model.ReversalJournalEntryNumber</div></div><div class="col-md-8"><strong>@Localizer["Reason"]</strong><div>@Model.Reason</div></div></div></div>
