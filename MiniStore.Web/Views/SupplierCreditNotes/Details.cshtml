@model MiniStore.Application.DTOs.Purchases.SupplierCreditNoteDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Model.CreditNoteNumber; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><h2>@Model.CreditNoteNumber <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex gap-2"><a asp-controller="VendorBills" asp-action="Details" asp-route-id="@Model.VendorBillId" class="btn btn-outline-primary">@Localizer["View vendor bill"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div class="row g-3"><div class="col-md-4"><strong>@Localizer["Supplier"]</strong><div>@Model.SupplierName</div></div><div class="col-md-4"><strong>@Localizer["Vendor bill"]</strong><div>@Model.VendorBillNumber — @Model.SupplierInvoiceNumber</div></div><div class="col-md-4"><strong>@Localizer["Warehouse"]</strong><div>@Model.WarehouseName</div></div><div class="col-md-4"><strong>@Localizer["Credit date"]</strong><div>@Model.CreditDate</div></div><div class="col-md-4"><strong>@Localizer["Supplier credit reference"]</strong><div>@(Model.SupplierReference ?? "-")</div></div><div class="col-md-4"><strong>@Localizer["Reason"]</strong><div>@Model.Reason</div></div></div></div>
<div class="row g-3">
@foreach (var line in Model.Lines)
{
    <div class="col-12 col-xl-6"><div class="card h-100 card-body"><strong>@line.ProductCode — @line.ProductName</strong><div class="row g-2 mt-2 small"><div class="col-6 col-md"><strong>@Localizer["Quantity"]</strong><div>@line.Quantity.ToQuantityDisplay(numberSettings) @line.UnitName</div></div><div class="col-6 col-md"><strong>@Localizer["Net amount"]</strong><div>@line.NetAmount.ToMoneyDisplay(numberSettings)</div></div><div class="col-6 col-md"><strong>@Localizer["Tax"]</strong><div>@line.TaxAmount.ToMoneyDisplay(numberSettings)</div></div><div class="col-6 col-md"><strong>@Localizer["Total"]</strong><div>@line.GrossAmount.ToMoneyDisplay(numberSettings)</div></div><div class="col-6 col-md"><strong>@Localizer["Removed inventory cost"]</strong><div>@line.RemovedInventoryCost.ToMoneyDisplay(numberSettings)</div></div></div>@if (!string.IsNullOrWhiteSpace(line.TrackingAllocations)) { <div class="small mt-2">@Localizer["Tracking allocations"]: @line.TrackingAllocations</div> }</div></div>
}
</div>
<div class="card card-body mt-3"><div class="row g-2 fw-bold"><div class="col-6 col-md">@Localizer["Net amount"]: @Model.NetAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6 col-md">@Localizer["Tax"]: @Model.TaxAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6 col-md">@Localizer["Total"]: @Model.TotalAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6 col-md">@Localizer["Removed inventory cost"]: @Model.RemovedInventoryCost.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div></div></div>
