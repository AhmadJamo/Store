@model MiniStore.Application.DTOs.Purchases.SupplierCreditNoteCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Create supplier credit note"]; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between gap-2"><div><h2>@Localizer["Create supplier credit note"]</h2><p class="text-muted">@Model.VendorBillNumber — @Model.SupplierInvoiceNumber — @Model.SupplierName</p></div><a asp-controller="VendorBills" asp-action="Details" asp-route-id="@Model.VendorBillId" class="btn btn-outline-secondary align-self-start">@Localizer["Back"]</a></div>
<form asp-action="Create" method="post"><input type="hidden" name="VendorBillId" value="@Model.VendorBillId"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3 mb-3"><div class="col-md-3"><label class="form-label">@Localizer["Credit date"]</label><input name="CreditDate" value="@Model.Form.CreditDate.ToString("yyyy-MM-dd")" type="date" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Supplier credit reference"]</label><input name="SupplierReference" value="@Model.Form.SupplierReference" maxlength="100" class="form-control"/></div><div class="col-md-6"><label class="form-label">@Localizer["Reason"]</label><input name="Reason" value="@Model.Form.Reason" required maxlength="1000" class="form-control"/></div></div>
<div class="row g-3">
@for (var i = 0; i < Model.Lines.Count; i++)
{
    var line = Model.Lines[i]; var entered = Model.Form.Lines.ElementAtOrDefault(i);
    <div class="col-12 col-xl-6"><div class="card h-100 card-body"><input type="hidden" name="Lines[@i].VendorBillLineId" value="@line.VendorBillLineId"/><strong>@line.ProductCode — @line.ProductName</strong><div class="row g-2 my-2 small"><div class="col-4"><span class="text-muted">@Localizer["Billed"]</span><div>@line.BilledQuantity.ToQuantityDisplay(numberSettings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Credited"]</span><div>@line.CreditedQuantity.ToQuantityDisplay(numberSettings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Available to credit"]</span><div>@line.RemainingQuantity.ToQuantityDisplay(numberSettings) @line.UnitName</div></div></div><label class="form-label">@Localizer["Return and credit quantity"]</label><input name="Lines[@i].Quantity" value="@((entered?.Quantity ?? 0).ToQuantityInput(numberSettings))" type="number" min="0" max="@line.RemainingQuantity.ToInputNumber()" step="0.000001" class="form-control"/><label class="form-label mt-2">@Localizer["Tracking allocations"]</label><textarea name="Lines[@i].TrackingAllocations" maxlength="2000" class="form-control" placeholder="@Localizer["LOT:QUANTITY or one serial per line"]">@entered?.TrackingAllocations</textarea>@if (!string.IsNullOrWhiteSpace(line.ReceivedTracking)) { <small class="text-muted">@Localizer["Received tracking"]: @line.ReceivedTracking</small> }</div></div>
}
</div>
@if (Model.Lines.Count > 0) { <button class="btn btn-danger mt-3" type="submit">@Localizer["Post supplier credit note"]</button> } else { <div class="alert alert-success mt-3">@Localizer["Vendor bill is credited in full."]</div> }
</form>
