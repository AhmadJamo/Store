@model IReadOnlyList<MiniStore.Application.DTOs.Purchases.SupplierCreditNoteDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Supplier credit notes"]; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="mb-3"><h2 class="mb-1">@Localizer["Supplier credit notes"]</h2><p class="text-muted mb-0">@Localizer["Posted credits and billed goods returned to suppliers."]</p></div>
<div class="row g-3">
@foreach (var note in Model)
{
    <div class="col-12 col-lg-6"><div class="card h-100 card-body"><div class="d-flex justify-content-between gap-2"><div><a asp-action="Details" asp-route-id="@note.Id" class="fw-bold">@note.CreditNoteNumber</a><div class="text-muted">@note.SupplierName</div></div><span class="badge bg-success align-self-start">@Localizer[note.Status.ToString()]</span></div><div class="row g-2 mt-2 small"><div class="col-6"><strong>@Localizer["Vendor bill"]</strong><div>@note.VendorBillNumber</div></div><div class="col-6"><strong>@Localizer["Credit date"]</strong><div>@note.CreditDate</div></div><div class="col-6"><strong>@Localizer["Total"]</strong><div>@note.TotalAmount.ToMoneyDisplay(numberSettings) @note.CurrencyCode</div></div><div class="col-6"><strong>@Localizer["Reason"]</strong><div>@note.Reason</div></div></div></div></div>
}
</div>
@if (Model.Count == 0) { <div class="alert alert-info">@Localizer["No supplier credit notes were found."]</div> }
