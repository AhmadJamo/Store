@model MiniStore.Application.Dtos.Sales.SalesQuotationDetailsDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Model.QuotationNumber; var rv=Convert.ToBase64String(Model.RowVersion); var settings=await GeneralSettingsService.GetAsync(); async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@Model.QuotationNumber</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex flex-wrap gap-2"><a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary">@Localizer[Model.Status == SalesQuotationStatus.Draft ? "Preview PDF" : "Download PDF"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["This quotation has no stock or accounting effect."]</div>
@if(Model.SalesQuotationTemplateId.HasValue){<div class="alert alert-primary"><strong>@Localizer["Quotation template"]: @Model.TemplateCode v@Model.TemplateVersion — @Model.TemplateName</strong><div class="small">@Localizer["Template content and selected options were frozen when this quotation was created."]</div></div>}
@if(Model.DocumentDesignId.HasValue){<div class="alert alert-secondary"><strong>@Localizer["Document design"]: @Model.DesignCode v@Model.DesignVersion — @Model.DesignName</strong><div class="small">@Localizer["The selected document design version is frozen for this quotation."]</div></div>}
@if(Model.Introduction is not null||Model.TermsAndConditions is not null||Model.FooterNotes is not null){<div class="card card-body mb-3"><h5>@Localizer["Proposal content"]</h5>@if(Model.Introduction is not null){<div class="text-prewrap">@Model.Introduction</div>}@if(Model.TermsAndConditions is not null){<div class="mt-3"><strong>@Localizer["Terms and conditions"]</strong><div class="text-prewrap">@Model.TermsAndConditions</div></div>}@if(Model.FooterNotes is not null){<div class="mt-3"><strong>@Localizer["Footer notes"]</strong><div class="text-prewrap">@Model.FooterNotes</div></div>}</div>}
<div class="row g-3 mb-3"><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Customer snapshot"]</h5><div><strong>@Model.CustomerCode — @Model.CustomerName</strong></div>@if(Model.CustomerLegalName is not null){<div>@Model.CustomerLegalName</div>}@if(Model.CustomerTaxNumber is not null){<div>@Localizer["Tax number"]: @Model.CustomerTaxNumber</div>}@if(Model.Address is not null){<div class="mt-2">@Model.Address</div>}<div class="mt-2">@Localizer["Payment terms"]: @Model.PaymentTermDays @Localizer["days"]</div></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-body"><h5>@Localizer["Quotation terms"]</h5><div>@Localizer["Quotation date"]: @Model.QuotationDate</div><div>@Localizer["Valid until"]: @Model.ValidUntil</div><div>@Localizer["Currency"]: @Model.CurrencyCode</div><div>@Localizer["Exchange rate"]: @Model.ExchangeRate.ToQuantityDisplay(settings) (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div>@if(Model.Notes is not null){<div class="mt-2">@Model.Notes</div>}</div></div></div></div>
<h5>@Localizer["Quotation lines"]</h5><div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><strong>@line.ProductCode — @line.ProductName</strong><span>@line.Quantity.ToQuantityDisplay(settings) @line.UnitName</span></div>@if(line.TemplateItemType.HasValue){<div class="small"><span class="badge bg-light text-dark">@Localizer[line.TemplateItemType.ToString()!]</span> @line.TemplateSection @if(line.TemplateOptionGroup is not null){<span>· @line.TemplateOptionGroup</span>}</div>}<div class="small text-muted">@line.PriceSourceCode · @line.TaxSourceCode</div><div class="row g-2 mt-2"><div class="col-6"><span class="text-muted">@Localizer["Unit price"]</span><div>@line.UnitPrice.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div><div class="col-6"><span class="text-muted">@Localizer["Net amount"]</span><div>@line.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Tax amount"]</span><div>@line.TaxAmount.ToMoneyDisplay(settings) @if(line.TaxName is not null){<small>(@line.TaxName @line.TaxRatePercent?.ToString("0.####")%)</small>}</div></div><div class="col-6"><span class="text-muted">@Localizer["Total"]</span><div>@line.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div>@if(line.Notes is not null){<div class="mt-2">@line.Notes</div>}</div></div></div>}</div>
<div class="card card-body my-3"><div class="row text-center"><div class="col-4"><span class="text-muted">@Localizer["Net amount"]</span><div class="fs-5">@Model.NetAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Tax amount"]</span><div class="fs-5">@Model.TaxAmount.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Total"]</span><div class="fs-5">@Model.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div></div></div>
<div class="d-flex flex-wrap gap-2 align-items-start">
@if(Model.Status==SalesQuotationStatus.Draft && await Can("SalesQuotations.Send")){<form asp-action="Send" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-primary">@Localizer["Send quotation"]</button></form>}else if(Model.Status!=SalesQuotationStatus.Draft){<span class="badge bg-success p-2">@Localizer["Draft step completed"]</span>}
@if(Model.Status==SalesQuotationStatus.Sent){if(Model.ValidUntil<DateOnly.FromDateTime(DateTime.Today)){if(await Can("SalesQuotations.Cancel")){<form asp-action="Expire" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-warning">@Localizer["Mark expired"]</button></form>}}else{if(await Can("SalesQuotations.Accept")){<form asp-action="Accept" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Accept quotation"]</button></form>}if(await Can("SalesQuotations.Reject")){<form asp-action="Reject" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Rejection reason"]"/><button class="btn btn-outline-danger">@Localizer["Reject quotation"]</button></form>}}}
@if(Model.Status is SalesQuotationStatus.Draft or SalesQuotationStatus.Sent){if(await Can("SalesQuotations.Cancel")){<form asp-action="Cancel" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel quotation"]</button></form>}}
@if(Model.Status==SalesQuotationStatus.Accepted){if(Model.SalesOrderId.HasValue){<span class="badge bg-success p-2">@Localizer["Sales order created"]</span>@if(await Can("SalesOrders.View")){<a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-primary">@Localizer["View sales order"]</a>}}else if(await Can("SalesOrders.Create")){<form asp-controller="SalesOrders" asp-action="CreateFromQuotation" method="post"><input type="hidden" name="QuotationId" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-primary">@Localizer["Create sales order"]</button></form>}else{<div class="alert alert-success mb-0">@Localizer["Accepted — awaiting authorized sales order conversion."]</div>}}
</div>
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
