@model MiniStore.Application.Dtos.Sales.SalesQuotationCreatePageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Create sales quotation"];var initial=Model.Form.Lines.Count==0?new List<MiniStore.Application.Dtos.Sales.CreateSalesQuotationLineDto>{new()}:Model.Form.Lines;}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2>@Localizer["Create sales quotation"]</h2><p class="text-muted mb-0">@Localizer["Prices, units, currency, tax and customer details are frozen when the draft is created."]</p></div><span class="badge bg-info text-dark">@Localizer["No stock or accounting effect"]</span></div>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-9"><label class="form-label">@Localizer["Quotation template"]</label><select name="templateId" class="form-select"><option value="0">@Localizer["No template"]</option>@foreach(var t in Model.Templates){<option value="@t.Id" selected="@(Model.AppliedTemplate?.Id==t.Id?"selected":null)">@t.Label</option>}</select></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary w-100">@Localizer["Apply template"]</button></div></div></form>
@if(Model.AppliedTemplate is not null){<div class="alert alert-primary"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@Model.AppliedTemplate.Code v@Model.AppliedTemplate.Version — @Model.AppliedTemplate.Name</strong><span>@Localizer[Model.AppliedTemplate.AllowAdditionalLines?"Additional products allowed":"Additional products prohibited"]</span></div>@if(Model.AppliedTemplate.Description is not null){<div>@Model.AppliedTemplate.Description</div>}@if(Model.AppliedTemplate.Category is not null||Model.AppliedTemplate.Tags is not null){<div class="small mt-1">@Model.AppliedTemplate.Category · @Model.AppliedTemplate.Tags</div>}<div class="small mt-1">@Localizer["Template products are repriced for this customer and quotation date."]</div></div>}
<form asp-action="Create" method="post" id="quotation-form"><input asp-for="Form.RequestKey" name="RequestKey" type="hidden"/><input asp-for="Form.SalesQuotationTemplateId" name="SalesQuotationTemplateId" type="hidden"/><input asp-for="Form.SalesQuotationTemplateVersion" name="SalesQuotationTemplateVersion" type="hidden"/>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-6"><label class="form-label">@Localizer["Customer"]</label><select asp-for="Form.CustomerId" name="CustomerId" id="customer" class="form-select" required><option value="">@Localizer["Select customer"]</option>@foreach(var x in Model.Customers){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-6"><label class="form-label">@Localizer["Customer address"]</label><select asp-for="Form.CustomerAddressId" name="CustomerAddressId" id="address" class="form-select"><option value="">@Localizer["No address"]</option>@foreach(var x in Model.Addresses){<option value="@x.Id" data-customer="@x.CustomerId">@x.Label</option>}</select></div><div class="col-md-4"><label class="form-label">@Localizer["Quotation date"]</label><input asp-for="Form.QuotationDate" name="QuotationDate" type="date" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Valid until"]</label><input asp-for="Form.ValidUntil" name="ValidUntil" type="date" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Base price channel"]</label><select asp-for="Form.Channel" name="Channel" class="form-select" disabled="@(Model.AppliedTemplate is not null)"><option value="Wholesale">@Localizer["Wholesale"]</option><option value="RetailPos">@Localizer["Retail POS"]</option></select>@if(Model.AppliedTemplate is not null){<input asp-for="Form.Channel" name="Channel" type="hidden"/>}</div><div class="col-md-6"><label class="form-label">@Localizer["Price list"]</label><select asp-for="Form.PriceListId" name="PriceListId" class="form-select" disabled="@(Model.AppliedTemplate is not null)"><option value="">@Localizer["Customer default or product fallback"]</option>@foreach(var x in Model.PriceLists){<option value="@x.Id">@x.Label</option>}</select>@if(Model.AppliedTemplate is not null){<input asp-for="Form.PriceListId" name="PriceListId" type="hidden"/>}</div><div class="col-md-6"><label class="form-label">@Localizer["Notes"]</label><input asp-for="Form.Notes" name="Notes" maxlength="1000" class="form-control"/></div></div></div>
<h5>@Localizer["Quotation lines"]</h5><div id="lines">@for(var i=0;i<initial.Count;i++){var line=initial[i];var fromTemplate=line.SalesQuotationTemplateItemId.HasValue;<div class="card card-body mb-2 quotation-line @(fromTemplate?"border-primary":"")">@if(fromTemplate){<input name="Lines[@i].SalesQuotationTemplateItemId" data-name="SalesQuotationTemplateItemId" value="@line.SalesQuotationTemplateItemId" type="hidden"/><input name="Lines[@i].ProductId" data-name="ProductId" value="@line.ProductId" type="hidden"/><input name="Lines[@i].MeasurementUnitId" data-name="MeasurementUnitId" value="@line.MeasurementUnitId" type="hidden"/><input name="Lines[@i].TaxRateId" data-name="TaxRateId" value="@line.TaxRateId" type="hidden"/><div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><div><strong>@line.ProductLabel</strong><div class="text-muted">@line.TemplateSectionTitle @if(line.TemplateOptionGroupName is not null){<span>· @line.TemplateOptionGroupName</span>}</div></div><span class="badge bg-light text-dark">@Localizer[line.TemplateItemType?.ToString()??""]</span></div><div class="row g-2"><div class="col-md-3"><div class="form-check mt-4">@if(line.TemplateItemType==SalesQuotationTemplateItemType.Required){<input type="hidden" name="Lines[@i].IsSelected" data-name="IsSelected" value="true"/><input type="checkbox" checked disabled class="form-check-input"/>}else{<input type="checkbox" name="Lines[@i].IsSelected" data-name="IsSelected" value="true" checked="@line.IsSelected" class="form-check-input"/>}<label class="form-check-label">@Localizer["Include in quotation"]</label></div></div><div class="col-md-3"><label class="form-label">@Localizer["Quantity"]</label><input name="Lines[@i].Quantity" data-name="Quantity" value="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="@line.MinimumQuantity" max="@line.MaximumQuantity" step="0.000001" readonly="@(!line.AllowQuantityChange)" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Sales unit"]</label><input value="@line.UnitLabel" readonly class="form-control"/></div><div class="col-md-4"><label class="form-label">@Localizer["Line notes"]</label><input name="Lines[@i].Notes" data-name="Notes" value="@line.Notes" maxlength="500" class="form-control"/></div></div>}else{<div class="row g-2"><input name="Lines[@i].IsSelected" data-name="IsSelected" value="true" type="hidden"/><div class="col-12"><input class="form-control product-search" placeholder="@Localizer["Search product by name, code or barcode"]"/></div><div class="col-lg-4"><label class="form-label">@Localizer["Product"]</label><select name="Lines[@i].ProductId" data-name="ProductId" class="form-select product-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id" data-search="@x.SearchText" selected="@(x.Id==line.ProductId?"selected":null)">@x.Label</option>}</select></div><div class="col-lg-2"><label class="form-label">@Localizer["Sales unit"]</label><select name="Lines[@i].MeasurementUnitId" data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var x in Model.Units){<option value="@x.Id" selected="@(x.Id==line.MeasurementUnitId?"selected":null)">@x.Label</option>}</select></div><div class="col-lg-2"><label class="form-label">@Localizer["Quantity"]</label><input name="Lines[@i].Quantity" data-name="Quantity" value="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0.000001" step="0.000001" class="form-control" required/></div><div class="col-lg-3"><label class="form-label">@Localizer["Tax rate"]</label><select name="Lines[@i].TaxRateId" data-name="TaxRateId" class="form-select"><option value="">@Localizer["Customer default or no tax"]</option>@foreach(var x in Model.TaxRates){<option value="@x.Id" selected="@(x.Id==line.TaxRateId?"selected":null)">@x.Label</option>}</select></div><div class="col-lg-1 d-flex align-items-end"><button type="button" class="btn btn-outline-danger remove-line">×</button></div><div class="col-12"><input name="Lines[@i].Notes" data-name="Notes" value="@line.Notes" maxlength="500" class="form-control" placeholder="@Localizer["Line notes"]"/></div></div>}</div>}</div>
@if(Model.AppliedTemplate?.AllowAdditionalLines!=false){<button type="button" id="add-line" class="btn btn-outline-secondary mb-3">@Localizer["Add custom line"]</button>}<div><button class="btn btn-primary">@Localizer["Create draft"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a></div></form>
<template id="line-template"><div class="card card-body mb-2 quotation-line"><div class="row g-2"><input data-name="IsSelected" value="true" type="hidden"/><div class="col-12"><input class="form-control product-search" placeholder="@Localizer["Search product by name, code or barcode"]"/></div><div class="col-lg-4"><label class="form-label">@Localizer["Product"]</label><select data-name="ProductId" class="form-select product-select" required><option value="">@Localizer["Select product"]</option>@foreach(var x in Model.Products){<option value="@x.Id" data-search="@x.SearchText">@x.Label</option>}</select></div><div class="col-lg-2"><label class="form-label">@Localizer["Sales unit"]</label><select data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var x in Model.Units){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-lg-2"><label class="form-label">@Localizer["Quantity"]</label><input data-name="Quantity" value="1" type="number" min="0.000001" step="0.000001" class="form-control" required/></div><div class="col-lg-3"><label class="form-label">@Localizer["Tax rate"]</label><select data-name="TaxRateId" class="form-select"><option value="">@Localizer["Customer default or no tax"]</option>@foreach(var x in Model.TaxRates){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-lg-1 d-flex align-items-end"><button type="button" class="btn btn-outline-danger remove-line">×</button></div><div class="col-12"><input data-name="Notes" maxlength="500" class="form-control" placeholder="@Localizer["Line notes"]"/></div></div></div></template>
<script>document.addEventListener('DOMContentLoaded',()=>{const box=document.getElementById('lines'),tpl=document.getElementById('line-template'),customer=document.getElementById('customer'),address=document.getElementById('address');function reindex(){[...box.querySelectorAll('.quotation-line')].forEach((r,i)=>r.querySelectorAll('[data-name]').forEach(x=>x.name=`Lines[${i}].${x.dataset.name}`));}function addressFilter(){const id=customer.value;[...address.options].forEach((o,i)=>{if(i===0)return;o.hidden=o.dataset.customer!==id;});if(address.selectedOptions[0]?.hidden)address.value='';}box.addEventListener('input',e=>{if(!e.target.classList.contains('product-search'))return;const term=e.target.value.toLowerCase(),select=e.target.closest('.quotation-line').querySelector('.product-select');[...select.options].forEach((o,i)=>{if(i===0)return;o.hidden=!o.dataset.search.toLowerCase().includes(term);});});box.addEventListener('click',e=>{if(e.target.classList.contains('remove-line')){e.target.closest('.quotation-line').remove();reindex();}});const add=document.getElementById('add-line');if(add)add.onclick=()=>{box.append(tpl.content.cloneNode(true));reindex();};customer.addEventListener('change',addressFilter);addressFilter();reindex();});</script>
