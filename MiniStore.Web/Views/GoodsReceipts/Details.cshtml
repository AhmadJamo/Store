@model MiniStore.Application.DTOs.Purchases.GoodsReceiptDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.ReceiptNumber; var canReturn = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:GoodsReceiptReturns.Create")).Succeeded; }
<div class="d-flex justify-content-between"><h2>@Model.ReceiptNumber <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div>@if(canReturn){<a asp-controller="GoodsReceiptReturns" asp-action="Create" asp-route-goodsReceiptId="@Model.Id" class="btn btn-outline-danger">@Localizer["Return received goods"]</a>} <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div>@Localizer["Purchase order"]: @Model.PurchaseOrderNumber</div><div>@Localizer["Warehouse"]: @Model.WarehouseName</div><div>@Localizer["Receipt date"]: @Model.ReceiptDate</div>@if(!string.IsNullOrWhiteSpace(Model.Notes)){<div>@Localizer["Notes"]: @Model.Notes</div>}</div>
<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Receive quantity"]</th><th>@Localizer["Stock quantity"]</th><th>@Localizer["Unit cost"]</th><th>@Localizer["Lot number"]</th><th>@Localizer["Serial numbers"]</th><th>@Localizer["Manufacture date"]</th><th>@Localizer["Expiration date"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductCode — @line.ProductName</td><td>@line.ReceivedQuantity @line.UnitName</td><td>@line.StockQuantity</td><td>@line.UnitCost</td><td>@line.LotNumber</td><td class="text-break">@line.SerialNumbers</td><td>@line.ManufactureDate</td><td>@line.ExpirationDate</td></tr>}</tbody></table></div>
