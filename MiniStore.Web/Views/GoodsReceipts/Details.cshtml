@model MiniStore.Application.DTOs.Purchases.GoodsReceiptDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.ReceiptNumber; var canReceive = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:GoodsReceipts.Create")).Succeeded; var canReturn = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:GoodsReceiptReturns.Create")).Succeeded; var canAllocate = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:LandedCosts.Create")).Succeeded; var canReverse = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseDocumentReversals.Create")).Succeeded; var reversal = ViewBag.Reversal as MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex justify-content-between"><h2>@Model.ReceiptNumber <span class="badge @(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Posted?"bg-success":"bg-secondary")">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex flex-wrap gap-2 align-items-center">@if(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Draft&&canReceive){<a asp-action="Scan" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Continue scanning"]</a>}else if(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Posted){<span class="badge bg-success">@Localizer["Receipt posted"]</span>} @if(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Posted&&canAllocate){<a asp-controller="LandedCosts" asp-action="Create" asp-route-goodsReceiptId="@Model.Id" class="btn btn-outline-primary">@Localizer["Allocate landed costs"]</a>} @if(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Posted&&canReturn){<a asp-controller="GoodsReceiptReturns" asp-action="Create" asp-route-goodsReceiptId="@Model.Id" class="btn btn-outline-danger">@Localizer["Return received goods"]</a>} @if(Model.Status==MiniStore.Domain.Entities.GoodsReceiptStatus.Posted&&reversal is null&&canReverse){<a asp-controller="PurchaseDocumentReversals" asp-action="Create" asp-route-documentType="GoodsReceipt" asp-route-originalDocumentId="@Model.Id" class="btn btn-outline-danger">@Localizer["Reverse document"]</a>}else if(reversal is not null){<a asp-controller="PurchaseDocumentReversals" asp-action="Details" asp-route-id="@reversal.Id" class="btn btn-outline-success">@Localizer["Reversed"]</a>} <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body my-3"><div>@Localizer["Purchase order"]: @Model.PurchaseOrderNumber</div><div>@Localizer["Warehouse"]: @Model.WarehouseName</div><div>@Localizer["Receipt date"]: @Model.ReceiptDate</div>@if(!string.IsNullOrWhiteSpace(Model.Notes)){<div>@Localizer["Notes"]: @Model.Notes</div>}</div>
<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Receive quantity"]</th><th>@Localizer["Stock quantity"]</th><th>@Localizer["Unit cost"]</th><th>@Localizer["Lot number"]</th><th>@Localizer["Serial numbers"]</th><th>@Localizer["Manufacture date"]</th><th>@Localizer["Expiration date"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductCode — @line.ProductName</td><td>@line.ReceivedQuantity.ToQuantityDisplay(numberSettings) @line.UnitName</td><td>@line.StockQuantity.ToQuantityDisplay(numberSettings)</td><td>@line.UnitCost.ToMoneyDisplay(numberSettings)</td><td>@line.LotNumber</td><td class="text-break">@line.SerialNumbers</td><td>@line.ManufactureDate</td><td>@line.ExpirationDate</td></tr>}</tbody></table></div>
