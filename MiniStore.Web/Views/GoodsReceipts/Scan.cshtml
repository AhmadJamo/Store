@model MiniStore.Application.DTOs.Purchases.GoodsReceiptScanPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Barcode receiving"]; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Localizer["Barcode receiving"]</h2><div class="text-muted">@Model.Receipt.ReceiptNumber — @Model.Receipt.PurchaseOrderNumber — @Model.Receipt.WarehouseName</div></div><a asp-action="Details" asp-route-id="@Model.Receipt.Id" class="btn btn-outline-secondary">@Localizer["Details"]</a></div>
<div class="alert alert-info">@Localizer["Scanning updates this draft only. Inventory and accounting change after you explicitly post the receipt."]</div>
<form asp-action="RecordScan" method="post" class="card card-body mb-4"><input type="hidden" name="GoodsReceiptId" value="@Model.Receipt.Id"/><input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey"/><div class="row g-3"><div class="col-md-5"><label class="form-label">@Localizer["Product barcode or code"]</label><input name="ProductScan" class="form-control form-control-lg" autofocus autocomplete="off" required/></div><div class="col-md-2"><label class="form-label">@Localizer["Quantity"]</label><input name="Quantity" type="number" value="1" min="0.000001" step="0.000001" class="form-control form-control-lg" required/></div><div class="col-md-2"><label class="form-label">@Localizer["Lot number"]</label><input name="LotNumber" class="form-control" maxlength="100"/></div><div class="col-md-3"><label class="form-label">@Localizer["Serial numbers"]</label><input name="SerialNumbers" class="form-control" maxlength="2000"/></div><div class="col-md-3"><label class="form-label">@Localizer["Manufacture date"]</label><input name="ManufactureDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Expiration date"]</label><input name="ExpirationDate" type="date" class="form-control"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary btn-lg w-100">@Localizer["Record scan"]</button></div></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Barcode"]</th><th>@Localizer["Tracking"]</th><th>@Localizer["Ordered"]</th><th>@Localizer["Previously received"]</th><th>@Localizer["Draft quantity"]</th><th>@Localizer["Remaining quantity"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.ProductCode — @line.ProductName</td><td><code>@line.Barcode</code></td><td>@Localizer[line.TrackingPolicy.ToString()]</td><td>@line.OrderedQuantity @line.UnitName</td><td>@line.PreviouslyPostedQuantity</td><td><strong>@line.DraftQuantity</strong></td><td>@line.RemainingQuantity</td></tr>}</tbody></table></div>
<form asp-action="PostDraft" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Receipt.Id"/><button class="btn btn-success" disabled="@(Model.Receipt.Lines.Count==0)">@Localizer["Review complete — post goods receipt"]</button></form>
