@model MiniStore.Application.DTOs.Purchases.GoodsReceiptScanPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Barcode receiving"];
    var numberSettings = await GeneralSettingsService.GetAsync();
    var staged = Model.Receipt.ReceivingRoute == MiniStore.Domain.Entities.PurchaseReceivingRoute.ReceiveInspectStore;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Localizer["Barcode receiving"]</h2><div class="text-muted">@Model.Receipt.ReceiptNumber — @Model.Receipt.PurchaseOrderNumber — @Model.Receipt.WarehouseName</div></div><a asp-action="Details" asp-route-id="@Model.Receipt.Id" class="btn btn-outline-secondary">@Localizer["Details"]</a></div>
<div class="alert alert-info">@(staged ? Localizer["Scanning updates this draft only. Inventory and accounting change after quality approval and storage."] : Localizer["Scanning updates this draft only. Inventory and accounting change after you explicitly post the receipt."])</div>
<form asp-action="RecordScan" method="post" class="card card-body mb-4">
    <input type="hidden" name="GoodsReceiptId" value="@Model.Receipt.Id" /><input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
    <div class="row g-3">
        <div class="col-md-5"><label class="form-label">@Localizer["Product barcode or code"]</label><input name="ProductScan" class="form-control form-control-lg" autofocus autocomplete="off" required /></div>
        <div class="col-md-2"><label class="form-label">@Localizer["Quantity"]</label><input name="Quantity" type="number" value="1" min="0.000001" step="0.000001" class="form-control form-control-lg" required /></div>
        <div class="col-md-2"><label class="form-label">@Localizer["Lot number"]</label><input name="LotNumber" class="form-control" maxlength="100" /></div>
        <div class="col-md-3"><label class="form-label">@Localizer["Serial numbers"]</label><input name="SerialNumbers" class="form-control" maxlength="2000" /></div>
        <div class="col-md-3"><label class="form-label">@Localizer["Manufacture date"]</label><input name="ManufactureDate" type="date" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">@Localizer["Expiration date"]</label><input name="ExpirationDate" type="date" class="form-control" /></div>
        <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary btn-lg w-100">@Localizer["Record scan"]</button></div>
    </div>
</form>
<div class="row g-3">
    @foreach (var line in Model.Lines)
    {
        <div class="col-lg-6"><div class="card card-body h-100">
            <div class="d-flex justify-content-between gap-2"><strong>@line.ProductCode — @line.ProductName</strong><code>@line.Barcode</code></div>
            <div class="small text-muted mb-2">@Localizer["Tracking"]: @Localizer[line.TrackingPolicy.ToString()]</div>
            <div class="row g-2"><div class="col-6">@Localizer["Ordered"]: <strong>@line.OrderedQuantity.ToQuantityDisplay(numberSettings)</strong> @line.UnitName</div><div class="col-6">@Localizer["Previously received"]: <strong>@line.PreviouslyPostedQuantity.ToQuantityDisplay(numberSettings)</strong></div><div class="col-6">@Localizer["Draft quantity"]: <strong>@line.DraftQuantity.ToQuantityDisplay(numberSettings)</strong></div><div class="col-6">@Localizer["Remaining quantity"]: <strong>@line.RemainingQuantity.ToQuantityDisplay(numberSettings)</strong></div></div>
        </div></div>
    }
</div>
<form asp-action="PostDraft" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Receipt.Id" /><button class="btn btn-success" disabled="@(Model.Receipt.Lines.Count == 0)">@(staged ? Localizer["Review complete — send to inspection"] : Localizer["Review complete — post goods receipt"])</button></form>
