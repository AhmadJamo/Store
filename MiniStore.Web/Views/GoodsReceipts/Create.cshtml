@model MiniStore.Application.DTOs.Purchases.GoodsReceiptCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Receive goods"]; }
<div class="d-flex justify-content-between"><div><h2>@Localizer["Receive goods"]</h2><p class="text-muted">@Model.PurchaseOrder!.OrderNumber</p></div><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrder.Id" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<form asp-action="Create" method="post"><input type="hidden" asp-for="Form.PurchaseOrderId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 mb-3"><div class="col-md-4"><label class="form-label">@Localizer["Receipt date"]</label><input asp-for="Form.ReceiptDate" type="date" class="form-control"/></div><div class="col-md-8"><label class="form-label">@Localizer["Notes"]</label><input asp-for="Form.Notes" class="form-control" maxlength="1000"/></div></div><p class="text-muted">@Localizer["Enter only quantities physically received. Posting increases inventory and cannot be edited."]</p><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Remaining quantity"]</th><th>@Localizer["Receive quantity"]</th><th>@Localizer["Lot number"]</th><th>@Localizer["Serial numbers"]</th><th>@Localizer["Manufacture date"]</th><th>@Localizer["Expiration date"]</th></tr></thead><tbody>@for(var i=0;i<Model.RemainingLines.Count;i++){var line=Model.RemainingLines[i];<tr><td>@line.ProductCode — @line.ProductName<input type="hidden" asp-for="Form.Lines[i].PurchaseOrderLineId" value="@line.PurchaseOrderLineId"/></td><td>@line.RemainingQuantity @line.UnitName</td><td><input asp-for="Form.Lines[i].ReceivedQuantity" class="form-control" min="0" max="@line.RemainingQuantity" step="0.000001"/></td><td><input asp-for="Form.Lines[i].LotNumber" class="form-control" maxlength="100"/></td><td><input asp-for="Form.Lines[i].SerialNumbers" class="form-control" maxlength="2000"/></td><td><input asp-for="Form.Lines[i].ManufactureDate" type="date" class="form-control"/></td><td><input asp-for="Form.Lines[i].ExpirationDate" type="date" class="form-control"/></td></tr>}</tbody></table><button class="btn btn-primary">@Localizer["Post goods receipt"]</button></form>
