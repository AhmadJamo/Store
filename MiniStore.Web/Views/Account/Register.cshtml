@model MiniStore.Application.Saas.RegisterCompanyCommand
@using System.Globalization
@{ Layout="_PublicLayout"; var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"]=ar?"إنشاء شركة":"Create company"; var plans=(IReadOnlyList<MiniStore.Application.Saas.PlanCardDto>)ViewBag.Plans; }
<div class="container py-5"><div class="glass p-4 p-lg-5 mx-auto" style="max-width:850px"><h1>@(ar?"ابدأ تجربتك المجانية":"Start your free trial")</h1><p class="muted">@(ar?"أنشئ حساب المالك والشركة. لن يتم طلب بطاقة دفع خلال التجربة.":"Create the owner and company account. No payment card is required for the trial.")</p><div asp-validation-summary="All" class="alert alert-danger"></div><form method="post"><div class="row g-3"><div class="col-md-6"><label>@(ar?"اسم الشركة":"Company name")</label><input asp-for="CompanyName" class="form-control" required maxlength="200"></div><div class="col-md-6"><label>@(ar?"عنوان الشركة":"Company address")</label><div class="input-group"><span class="input-group-text">app/</span><input asp-for="CompanySlug" class="form-control" required pattern="[a-z0-9][a-z0-9-]{1,61}[a-z0-9]"></div></div><div class="col-md-6"><label>@(ar?"اسم مستخدم المالك":"Owner username")</label><input asp-for="OwnerUsername" class="form-control" required autocomplete="username"></div><div class="col-md-6"><label>@(ar?"البريد الإلكتروني":"Email")</label><input asp-for="OwnerEmail" type="email" class="form-control" required autocomplete="email"></div><div class="col-md-6"><label>@(ar?"كلمة المرور":"Password")</label><input asp-for="Password" type="password" class="form-control" required autocomplete="new-password"></div><div class="col-md-6"><label>@(ar?"الخطة":"Plan")</label><select asp-for="PlanId" class="form-select" required>@foreach(var p in plans){<option value="@p.Id" selected="@(ViewBag.PlanId is int id && id==p.Id)">@(ar?p.NameArabic:p.NameEnglish) — @p.MonthlyPrice @p.Currency</option>}</select></div></div><button class="btn btn-accent btn-lg w-100 mt-4">@(ar?"إنشاء الشركة وبدء 14 يوماً مجاناً":"Create company and start 14-day trial")</button></form></div></div>
