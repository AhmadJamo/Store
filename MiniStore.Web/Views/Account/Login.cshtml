@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">

    <div class="col-md-5">

        <div class="card mt-5">

            <div class="card-body">

                <h2 class="text-center mb-4">
                    Mini Store
                </h2>

                <h4 class="text-center mb-4">
                    Login
                </h4>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Login"
                      method="post">

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">

                        <label class="form-label">
                            Username
                        </label>

                        <input type="text"
                               name="username"
                               class="form-control"
                               autocomplete="username"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>

                        <input type="password"
                               name="password"
                               class="form-control"
                               autocomplete="current-password"
                               required />

                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Login

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>