@model List<MiniStore.Application.DTOs.Purchases.VendorBillDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Vendor bills"]; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["Vendor bills"]</h2>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Search by bill or supplier invoice number"]" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">@Localizer["Search"]</button></div>
</form>
<table class="table table-striped align-middle">
    <thead><tr><th>@Localizer["Bill number"]</th><th>@Localizer["Supplier invoice number"]</th><th>@Localizer["Supplier"]</th><th>@Localizer["Purchase order"]</th><th>@Localizer["Bill date"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var bill in Model)
    {
        <tr><td>@bill.BillNumber</td><td>@bill.SupplierInvoiceNumber</td><td>@bill.SupplierName</td><td>@bill.PurchaseOrderNumber</td><td>@bill.BillDate</td><td>@bill.TotalAmount @bill.CurrencyCode</td><td>@Localizer[bill.Status.ToString()]</td><td><a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr>
    }
    </tbody>
</table>
