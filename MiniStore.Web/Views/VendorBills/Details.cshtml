@model MiniStore.Application.DTOs.Purchases.VendorBillDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.BillNumber; var numberSettings = await GeneralSettingsService.GetAsync(); }
@{ var canPay = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierPayments.Create")).Succeeded; var canCredit = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierCreditNotes.Create")).Succeeded; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2>@Model.BillNumber <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex flex-wrap gap-2 align-items-center">@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted && Model.OutstandingAmount > 0 && canPay){<a asp-controller="SupplierPayments" asp-action="Create" asp-route-vendorBillId="@Model.Id" class="btn btn-primary">@Localizer["Pay vendor bill"]</a>}else if(Model.IsSettledInFull){<span class="badge bg-success">@Localizer[Model.IsPaidInFull ? "Paid in full" : "Settled in full"]</span>}@if(Model.CanCreateCreditNote && canCredit){<a asp-controller="SupplierCreditNotes" asp-action="Create" asp-route-vendorBillId="@Model.Id" class="btn btn-outline-danger">@Localizer["Create supplier credit note"]</a>}else if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted && !Model.CanCreateCreditNote){<span class="badge bg-success">@Localizer["Credited in full"]</span>}<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><strong>@Localizer["Supplier"]:</strong> @Model.SupplierName</div><div class="col-md-4"><strong>@Localizer["Supplier invoice number"]:</strong> @Model.SupplierInvoiceNumber</div><div class="col-md-4"><strong>@Localizer["Purchase order"]:</strong> @Model.PurchaseOrderNumber</div><div class="col-md-4"><strong>@Localizer["Bill date"]:</strong> @Model.BillDate</div><div class="col-md-8"><strong>@Localizer["Notes"]:</strong> @Model.Notes</div></div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Quantity"]</th><th>@Localizer["Unit price"]</th><th>@Localizer["Net amount"]</th><th>@Localizer["Tax"]</th><th>@Localizer["Total"]</th><th>@Localizer["GRNI clearing"]</th></tr></thead><tbody>
@foreach(var line in Model.Lines){<tr><td>@line.ProductCode — @line.ProductName</td><td>@line.Quantity.ToQuantityDisplay(numberSettings) @line.UnitName</td><td>@line.UnitPrice.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@line.NetAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@line.TaxAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode (@line.TaxPercent.ToDisplayNumber(numberSettings.DecimalPlaces)%)</td><td>@line.GrossAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@line.ReceiptClearingAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td></tr>}
</tbody><tfoot><tr class="fw-bold"><td colspan="3">@Localizer["Totals"]</td><td>@Model.NetAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@Model.TaxAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@Model.TotalAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td><td>@Model.ReceiptClearingAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td></tr></tfoot></table></div>
<div class="card card-body mt-3"><div><strong>@Localizer["Paid amount"]:</strong> @Model.PaidAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div><strong>@Localizer["Credited amount"]:</strong> @Model.CreditedAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div><strong>@Localizer["Outstanding amount"]:</strong> @Model.OutstandingAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div></div>
@if(Model.Match is not null)
{
    <div class="card mt-3"><div class="card-header"><strong>@Localizer["Three-way match"]</strong></div><div class="card-body">
        <p>@Localizer["Quantity tolerance percent"]: @Model.Match.QuantityTolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)% — @Localizer["Price tolerance percent"]: @Model.Match.PriceTolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</p>
        @if(Model.Match.Exceptions.Count == 0){<div class="alert alert-success mb-0">@Localizer["Matched within configured tolerances."]</div>}
        else
        {
            @if(Model.Match.WasOverridden){<div class="alert alert-warning">@Localizer["Match override reason"]: @Model.Match.OverrideReason</div>}
            <table class="table table-sm"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Exception type"]</th><th>@Localizer["Expected"]</th><th>@Localizer["Actual"]</th><th>@Localizer["Variance"]</th><th>@Localizer["Tolerance"]</th></tr></thead><tbody>@foreach(var exception in Model.Match.Exceptions){<tr><td>@exception.ProductCode — @exception.ProductName</td><td>@Localizer[exception.Type.ToString()]</td><td>@exception.ExpectedValue.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</td><td>@exception.ActualValue.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</td><td>@exception.VariancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td><td>@exception.TolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td></tr>}</tbody></table>
        }
    </div></div>
}
