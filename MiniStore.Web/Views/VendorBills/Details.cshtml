@model MiniStore.Application.DTOs.Purchases.VendorBillDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.BillNumber; var numberSettings = await GeneralSettingsService.GetAsync(); }
@{ var canApprove=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:VendorBills.Approve")).Succeeded; var canOverride=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:VendorBills.OverrideMatch")).Succeeded; var canPost=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:VendorBills.Post")).Succeeded; var canCancel=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:VendorBills.Cancel")).Succeeded; var canPay = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierPayments.Create")).Succeeded; var canCredit = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:SupplierCreditNotes.Create")).Succeeded; var canReverse=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseDocumentReversals.Create")).Succeeded; var reversal=ViewBag.Reversal as MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto; var rowVersion=Convert.ToBase64String(Model.RowVersion); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2>@Model.BillNumber <span class="badge @(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted ? "bg-success" : "bg-secondary")">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex flex-wrap gap-2 align-items-center">@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Draft && canApprove){<form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><button class="btn btn-primary">@Localizer["Approve vendor bill"]</button></form>}else if(Model.Status is MiniStore.Domain.Entities.VendorBillStatus.Approved or MiniStore.Domain.Entities.VendorBillStatus.Posted){<span class="badge bg-success">@Localizer["Approval completed"]</span>}@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Approved && canPost){<form asp-action="Post" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><button class="btn btn-success">@Localizer["Post vendor bill"]</button></form>}else if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted){<span class="badge bg-success">@Localizer["Posting completed"]</span>}@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted && Model.OutstandingAmount > 0 && canPay){<a asp-controller="SupplierPayments" asp-action="Create" asp-route-vendorBillId="@Model.Id" class="btn btn-primary">@Localizer["Pay vendor bill"]</a>}else if(Model.IsSettledInFull){<span class="badge bg-success">@Localizer[Model.IsPaidInFull ? "Paid in full" : "Settled in full"]</span>}@if(Model.CanCreateCreditNote && canCredit){<a asp-controller="SupplierCreditNotes" asp-action="Create" asp-route-vendorBillId="@Model.Id" class="btn btn-outline-danger">@Localizer["Create supplier credit note"]</a>}else if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Posted && Model.HasReceiptBasedLines && !Model.CanCreateCreditNote){<span class="badge bg-success">@Localizer["Credited in full"]</span>}@if(Model.Status==MiniStore.Domain.Entities.VendorBillStatus.Posted&&reversal is null&&canReverse){<a asp-controller="PurchaseDocumentReversals" asp-action="Create" asp-route-documentType="VendorBill" asp-route-originalDocumentId="@Model.Id" class="btn btn-outline-danger">@Localizer["Reverse document"]</a>}else if(reversal is not null){<a asp-controller="PurchaseDocumentReversals" asp-action="Details" asp-route-id="@reversal.Id" class="btn btn-outline-success">@Localizer["Reversed"]</a>}<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Draft && canOverride){<form asp-action="ApproveOverride" method="post" class="card card-body border-warning mb-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><label class="form-label">@Localizer["Match override reason"]</label><div class="d-flex flex-wrap gap-2"><textarea name="reason" required maxlength="1000" class="form-control flex-grow-1"></textarea><button class="btn btn-warning">@Localizer["Approve with match override"]</button></div></form>}
@if((Model.Status is MiniStore.Domain.Entities.VendorBillStatus.Draft or MiniStore.Domain.Entities.VendorBillStatus.Approved) && canCancel){<form asp-action="Cancel" method="post" class="card card-body border-danger mb-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><label class="form-label">@Localizer["Cancellation reason"]</label><div class="d-flex flex-wrap gap-2"><textarea name="reason" required maxlength="1000" class="form-control flex-grow-1"></textarea><button class="btn btn-outline-danger">@Localizer["Cancel vendor bill"]</button></div></form>}
@if(Model.Status == MiniStore.Domain.Entities.VendorBillStatus.Cancelled){<div class="alert alert-secondary"><strong>@Localizer["Cancelled"]</strong>@if(!string.IsNullOrWhiteSpace(Model.CancellationReason)){<span> — @Model.CancellationReason</span>}</div>}
<div class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><strong>@Localizer["Supplier"]:</strong> @Model.SupplierName</div><div class="col-md-4"><strong>@Localizer["Supplier invoice number"]:</strong> @Model.SupplierInvoiceNumber</div><div class="col-md-4"><strong>@Localizer["Purchase order"]:</strong> @Model.PurchaseOrderNumber</div><div class="col-md-4"><strong>@Localizer["Bill date"]:</strong> @Model.BillDate</div><div class="col-md-8"><strong>@Localizer["Exchange rate"]:</strong> 1 @Model.CurrencyCode = @Model.ExchangeRate.ToString("0.############") @Model.CompanyCurrencyCode (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div><div class="col-md-8"><strong>@Localizer["Notes"]:</strong> @Model.Notes</div></div></div>
@if(Model.Attachments.Count > 0){<div class="card card-body mb-3"><h3 class="h5">@Localizer["Attachments"]</h3><div class="d-flex flex-wrap gap-2">@foreach(var attachment in Model.Attachments){<a asp-action="DownloadAttachment" asp-route-id="@Model.Id" asp-route-attachmentId="@attachment.Id" class="btn btn-outline-secondary"><i class="bi bi-paperclip"></i> @attachment.FileName</a>}</div></div>}
<div class="row g-3">@foreach(var line in Model.Lines){<div class="col-12 col-xl-6"><div class="card card-body h-100"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@line.ProductCode — @line.ProductName</strong><span class="badge bg-secondary">@Localizer[line.BillingPolicy.ToString()]</span></div><div class="row g-2 mt-1"><div class="col-6"><strong>@Localizer["Quantity"]:</strong> @line.Quantity.ToQuantityDisplay(numberSettings) @line.UnitName</div><div class="col-6"><strong>@Localizer["Unit price"]:</strong> @line.UnitPrice.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6"><strong>@Localizer["Net amount"]:</strong> @line.NetAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6"><strong>@Localizer["Tax"]:</strong> @line.TaxAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div class="col-6"><strong>@Localizer["Total"]:</strong> @line.GrossAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div>@if(line.BillingPolicy == MiniStore.Domain.Entities.PurchaseBillingPolicy.ReceivedQuantity){<div class="col-6"><strong>@Localizer["GRNI clearing"]:</strong> @line.ReceiptClearingAmount.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode</div>}else{<div class="col-6"><strong>@Localizer["Posting destination"]:</strong> @Localizer["Purchase expense account"]</div>}</div></div></div>}</div>
<div class="card card-body mt-3 fw-bold"><div>@Localizer["Net amount"]: @Model.NetAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div>@Localizer["Tax"]: @Model.TaxAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div>@Localizer["Total"]: @Model.TotalAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div></div>
<div class="alert alert-info"><strong>@Localizer["Company currency equivalent"]:</strong> @Model.CompanyTotalAmount.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode (@Localizer["Net amount"] @Model.CompanyNetAmount.ToMoneyDisplay(numberSettings) + @Localizer["Tax"] @Model.CompanyTaxAmount.ToMoneyDisplay(numberSettings))</div>
<div class="card card-body mt-3"><div><strong>@Localizer["Paid amount"]:</strong> @Model.PaidAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div><strong>@Localizer["Credited amount"]:</strong> @Model.CreditedAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div><div><strong>@Localizer["Outstanding amount"]:</strong> @Model.OutstandingAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</div></div>
@if(Model.Match is not null)
{
    <div class="card mt-3"><div class="card-header"><strong>@Localizer["Three-way match"]</strong></div><div class="card-body">
        <p>@Localizer["Quantity tolerance percent"]: @Model.Match.QuantityTolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)% — @Localizer["Price tolerance percent"]: @Model.Match.PriceTolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</p>
        @if(Model.Match.Exceptions.Count == 0){<div class="alert alert-success mb-0">@Localizer["Matched within configured tolerances."]</div>}
        else
        {
            @if(Model.Match.WasOverridden){<div class="alert alert-warning">@Localizer["Match override reason"]: @Model.Match.OverrideReason</div>}
            <table class="table table-sm"><thead><tr><th>@Localizer["Product"]</th><th>@Localizer["Exception type"]</th><th>@Localizer["Expected"]</th><th>@Localizer["Actual"]</th><th>@Localizer["Variance"]</th><th>@Localizer["Tolerance"]</th></tr></thead><tbody>@foreach(var exception in Model.Match.Exceptions){<tr><td>@exception.ProductCode — @exception.ProductName</td><td>@Localizer[exception.Type.ToString()]</td><td>@exception.ExpectedValue.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</td><td>@exception.ActualValue.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</td><td>@exception.VariancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td><td>@exception.TolerancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td></tr>}</tbody></table>
        }
    </div></div>
}
