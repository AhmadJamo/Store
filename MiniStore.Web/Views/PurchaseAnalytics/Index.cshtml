@model MiniStore.Application.DTOs.Purchases.PurchaseAnalyticsDto
@using MiniStore.Application.DTOs.Purchases
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=L["Purchase analytics"];var numberSettings=await GeneralSettingsService.GetAsync();}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@L["Purchase analytics"]</h2><p class="text-muted mb-0">@L["Traceable purchasing performance from source documents."]</p></div></div>

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["From"]</label><input name="From" value="@Model.Query.From.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["To"]</label><input name="To" value="@Model.Query.To.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["Supplier"]</label><select name="SupplierId" class="form-select"><option value="">@L["All suppliers"]</option>@foreach(var option in Model.SupplierOptions){<option value="@option.Id" selected="@(Model.Query.SupplierId==option.Id)">@option.Label</option>}</select></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["Buyer"]</label><select name="BuyerUserId" class="form-select"><option value="">@L["All buyers"]</option>@foreach(var option in Model.BuyerOptions){<option value="@option.UserId" selected="@(Model.Query.BuyerUserId==option.UserId)">@option.DisplayName</option>}</select></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["Order status"]</label><select name="OrderStatus" class="form-select"><option value="">@L["All statuses"]</option>@foreach(var status in Enum.GetValues<PurchaseOrderStatus>()){<option value="@status" selected="@(Model.Query.OrderStatus==status)">@L[status.ToString()]</option>}</select></div>
        <div class="col-sm-6 col-lg-2"><label class="form-label">@L["Group by"]</label><select name="GroupBy" class="form-select">@foreach(var group in Enum.GetValues<PurchaseAnalyticsGroupBy>()){<option value="@group" selected="@(Model.Query.GroupBy==group)">@L[$"Analytics group {group}"]</option>}</select></div>
        <div class="col-12"><button class="btn btn-primary">@L["Apply"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@L["Reset"]</a></div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="card card-body h-100"><span class="text-muted">@L["Open confirmed orders"]</span><strong class="fs-3">@Model.OpenOrders</strong><small>@L["Unconfirmed"]: @Model.UnconfirmedOrders · <span class="text-danger">@L["Overdue"]: @Model.OverdueOrders</span></small></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card card-body h-100"><span class="text-muted">@L["Vendor bill spend"]</span><strong class="fs-3">@Model.VendorBillSpend.ToMoneyDisplay(numberSettings)</strong><small>@L["Outstanding payables"]: @Model.OutstandingPayables.ToMoneyDisplay(numberSettings)</small></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card card-body h-100"><span class="text-muted">@L["Receipt value"]</span><strong class="fs-3">@Model.ReceiptValue.ToMoneyDisplay(numberSettings)</strong><small>@L["Average delivery days"]: @Model.AverageDeliveryDays.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</small></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card card-body h-100"><span class="text-muted">@L["Open match exceptions"]</span><strong class="fs-3">@Model.OpenMatchExceptionCount</strong><small>@L["All exceptions"]: @Model.MatchExceptionCount · @L["Overrides"]: @Model.MatchOverrideCount</small></div></div>
</div>

<section class="card card-body mb-4">
    <h3 class="h5">@L["Legacy and modern workflow comparison"]</h3>
    <p class="text-muted">@L["New legacy direct purchase creation is retired; prior records remain available for reference."]</p>
    <div class="row g-3"><div class="col-md-6"><div class="border rounded p-3 h-100"><strong>@L["Legacy direct purchases"]</strong><div class="fs-4">@Model.LegacyPurchaseCount</div><div>@Model.LegacyPurchaseValue.ToMoneyDisplay(numberSettings)</div></div></div><div class="col-md-6"><div class="border rounded p-3 h-100"><strong>@L["Modern purchase orders"]</strong><div class="fs-4">@Model.ModernPurchaseOrderCount</div><div>@Model.ModernPurchaseOrderValue.ToMoneyDisplay(numberSettings)</div></div></div></div>
</section>

<section class="mb-4"><h3 class="h5">@L["Spend, cost and seasonality trends"]</h3><div class="row g-3">@foreach(var x in Model.Trends){<div class="col-12 col-md-6 col-xl-4"><div class="card card-body h-100"><strong>@x.GroupLabel</strong><div class="row g-2 mt-1"><div class="col-6"><small class="text-muted">@L["Orders"]</small><div>@x.OrderCount · @x.OrderedValue.ToMoneyDisplay(numberSettings)</div></div><div class="col-6"><small class="text-muted">@L["Billed spend"]</small><div>@x.BillCount · @x.Spend.ToMoneyDisplay(numberSettings)</div></div><div class="col-6"><small class="text-muted">@L["Average unit price"]</small><div>@x.AverageUnitPrice.ToMoneyDisplay(numberSettings)</div></div><div class="col-6"><small class="text-muted">@L["Price variance"]</small><div class="@(x.PriceVariance>0?"text-danger":x.PriceVariance<0?"text-success":"")">@x.PriceVariance.ToMoneyDisplay(numberSettings)</div></div></div></div></div>}@if(Model.Trends.Count==0){<div class="text-muted">@L["No purchasing activity in the selected period."]</div>}</div></section>

<section class="mb-4"><h3 class="h5">@L["Buyer workload"]</h3><div class="row g-3">@foreach(var x in Model.BuyerWorkloads){<div class="col-12 col-md-6 col-xl-4"><div class="card card-body h-100"><strong class="text-break">@x.BuyerDisplayName</strong><div>@L["Orders"]: @x.OrderCount</div><div>@L["Open"]: @x.OpenOrders · @L["Overdue"]: @x.OverdueOrders</div><div>@L["Ordered value"]: @x.OrderedValue.ToMoneyDisplay(numberSettings)</div></div></div>}@if(Model.BuyerWorkloads.Count==0){<div class="text-muted">@L["No buyer workload in the selected period."]</div>}</div></section>

<section class="mb-4"><h3 class="h5">@L["Open matching exceptions"]</h3><div class="row g-3">@foreach(var x in Model.OpenExceptions){<div class="col-12 col-md-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@x.VendorBillNumber</strong><span class="badge bg-danger">@x.ExceptionCount</span></div><div>@x.SupplierName</div><small>@L["Maximum variance"]: @x.MaximumVariancePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</small><a asp-controller="VendorBills" asp-action="Details" asp-route-id="@x.VendorBillId" class="btn btn-sm btn-outline-primary mt-2 align-self-start">@L["Open source document"]</a></div></div>}@if(Model.OpenExceptions.Count==0){<div class="text-muted">@L["No open matching exceptions in the selected period."]</div>}</div></section>

<section class="mb-4"><h3 class="h5">@L["KPI definitions and sources"]</h3><div class="row g-3">@foreach(var x in Model.Kpis){<div class="col-12 col-md-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@L[x.Label]</strong><span class="fs-5">@x.Value</span></div><div class="small mt-2"><strong>@L["Source"]:</strong> @L[x.Source]</div><div class="small"><strong>@L["Period"]:</strong> @x.Period</div><p class="small text-muted mb-0 mt-2">@L[x.Explanation]</p></div></div>}</div></section>

<section class="mb-4"><h3 class="h5">@L["Procure-to-pay acceptance journey"]</h3><p class="text-muted">@L["Each stage links to its source documents so the result can be verified."]</p><div class="row g-3">@foreach(var x in Model.AcceptanceJourney){var allowed=(await AuthorizationService.AuthorizeAsync(User,null,$"Permission:{x.RequiredPermission}")).Succeeded;<div class="col-12 col-md-6 col-xl-3"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@L[x.Label]</strong><span class="badge bg-primary">@x.Count</span></div><small class="text-muted my-2">@L[x.Explanation]</small>@if(allowed){<a asp-controller="@x.Controller" asp-action="@x.Action" class="btn btn-sm btn-outline-primary align-self-start">@L["Open source documents"]</a>}</div></div>}</div></section>

<section><h3 class="h5">@L["Supplier performance"]</h3><div class="row g-3">@foreach(var x in Model.Suppliers){<div class="col-12 col-lg-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@x.SupplierName</strong><span>@L["Orders"]: @x.OrderCount</span></div><div class="row g-2 mt-1"><div class="col-6"><small class="text-muted">@L["Fill rate"]</small><div>@x.FillRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</div></div><div class="col-6"><small class="text-muted">@L["On-time rate"]</small><div>@x.OnTimeRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</div></div><div class="col-6"><small class="text-muted">@L["Return rate"]</small><div>@x.ReturnRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</div></div><div class="col-6"><small class="text-muted">@L["Average delivery days"]</small><div>@x.AverageDeliveryDays.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</div></div><div class="col-6"><small class="text-muted">@L["Billed spend"]</small><div>@x.BilledSpend.ToMoneyDisplay(numberSettings)</div></div><div class="col-6"><small class="text-muted">@L["Outstanding balance"]</small><div>@x.OutstandingBalance.ToMoneyDisplay(numberSettings)</div></div></div></div></div>}@if(Model.Suppliers.Count==0){<div class="text-muted">@L["No purchasing activity in the selected period."]</div>}</div></section>
