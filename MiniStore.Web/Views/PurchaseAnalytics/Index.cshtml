@model MiniStore.Application.DTOs.Purchases.PurchaseAnalyticsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> L
@{ViewData["Title"]=L["Purchase analytics"];var numberSettings=await GeneralSettingsService.GetAsync();}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@L["Purchase analytics"]</h2><form method="get" class="d-flex gap-2"><input name="From" value="@Model.Query.From.ToString("yyyy-MM-dd")" type="date" class="form-control"/><input name="To" value="@Model.Query.To.ToString("yyyy-MM-dd")" type="date" class="form-control"/><button class="btn btn-primary">@L["Apply"]</button></form></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card card-body h-100"><span class="text-muted">@L["Open confirmed orders"]</span><strong class="fs-3">@Model.OpenOrders</strong><small class="text-danger">@L["Overdue"]: @Model.OverdueOrders</small></div></div><div class="col-md-3"><div class="card card-body h-100"><span class="text-muted">@L["Receipt value"]</span><strong class="fs-3">@Model.ReceiptValue.ToMoneyDisplay(numberSettings)</strong><small>@L["Landed costs"]: @Model.LandedCostTotal.ToMoneyDisplay(numberSettings)</small></div></div><div class="col-md-3"><div class="card card-body h-100"><span class="text-muted">@L["Vendor bill spend"]</span><strong class="fs-3">@Model.VendorBillSpend.ToMoneyDisplay(numberSettings)</strong><small>@L["Outstanding payables"]: @Model.OutstandingPayables.ToMoneyDisplay(numberSettings)</small></div></div><div class="col-md-3"><div class="card card-body h-100"><span class="text-muted">@L["Match exceptions"]</span><strong class="fs-3">@Model.MatchExceptionCount</strong><small>@L["Overrides"]: @Model.MatchOverrideCount</small></div></div></div>
<h4>@L["Supplier performance"]</h4><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>@L["Supplier"]</th><th>@L["Orders"]</th><th>@L["Ordered value"]</th><th>@L["Fill rate"]</th><th>@L["On-time rate"]</th><th>@L["Average delivery days"]</th><th>@L["Return rate"]</th><th>@L["Billed spend"]</th><th>@L["Price variance"]</th><th>@L["Outstanding balance"]</th><th>@L["Match exceptions"]</th></tr></thead><tbody>@foreach(var x in Model.Suppliers){<tr><td>@x.SupplierName</td><td>@x.OrderCount</td><td>@x.OrderedValue.ToMoneyDisplay(numberSettings)</td><td>@x.FillRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td><td>@x.OnTimeRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td><td>@x.AverageDeliveryDays.ToDisplayNumber(numberSettings.QuantityDecimalPlaces)</td><td>@x.ReturnRatePercent.ToDisplayNumber(numberSettings.DecimalPlaces)%</td><td>@x.BilledSpend.ToMoneyDisplay(numberSettings)</td><td class="@(x.PriceVariance>0?"text-danger":x.PriceVariance<0?"text-success":"")">@x.PriceVariance.ToMoneyDisplay(numberSettings)</td><td>@x.OutstandingBalance.ToMoneyDisplay(numberSettings)</td><td>@x.MatchExceptions</td></tr>}@if(Model.Suppliers.Count==0){<tr><td colspan="11" class="text-center text-muted">@L["No purchasing activity in the selected period."]</td></tr>}</tbody></table></div>
