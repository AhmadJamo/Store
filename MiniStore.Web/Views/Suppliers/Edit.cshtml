@model MiniStore.Application.DTOs.Suppliers.UpdateSupplierDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Edit supplier"]; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1 class="h2">@Localizer["Edit supplier"]</h1><p class="text-muted mb-0">@Localizer["Update supplier details and product assignments together."]</p></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back to suppliers"]</a></div>
<form asp-action="Edit" method="post">
    <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
    <partial name="_FormFields" model="Model" />
    <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-success">@Localizer["Save Changes"]</button><a asp-controller="SupplierPurchasing" asp-action="Index" asp-route-supplierId="@Context.Request.RouteValues["id"]" class="btn btn-outline-primary">@Localizer["Open purchasing data"]</a><a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a></div>
</form>
@section Scripts { <partial name="_SupplierFormScripts" /> }
