@model MiniStore.Application.DTOs.Suppliers.UpdateSupplierDto

@{
    ViewData["Title"] = "Edit Supplier";
}

<h1>Edit Supplier</h1>

<form asp-action="Edit" method="post">

    <div class="mb-3">

        <label asp-for="Name"
               class="form-label">
            Supplier Name
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Phone"
               class="form-label">
            Phone
        </label>

        <input asp-for="Phone"
               class="form-control" />

        <span asp-validation-for="Phone"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Address"
               class="form-label">
            Address
        </label>

        <textarea asp-for="Address"
                  class="form-control">
        </textarea>

        <span asp-validation-for="Address"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>