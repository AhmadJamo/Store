@model List<MiniStore.Application.DTOs.Suppliers.SupplierDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Suppliers"]; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h1 class="h2 mb-1">@Localizer["Suppliers"]</h1><p class="text-muted mb-0">@Localizer["Manage supplier profiles, contacts, accounting and supplied products."]</p></div>
    @if(await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier)??"System","Suppliers.Create")){<a asp-action="Create" class="btn btn-primary">@Localizer["Add supplier"]</a>}
</div>
<div class="row g-3">
@if(Model.Count==0){<div class="col-12"><div class="alert alert-info">@Localizer["No suppliers found."]</div></div>}
@foreach(var supplier in Model){
 <div class="col-lg-6 col-xl-4"><article class="card h-100"><div class="card-body">
  <div class="d-flex justify-content-between gap-2 mb-3"><div><h2 class="h5 mb-1">@supplier.Name</h2>@if(!string.IsNullOrWhiteSpace(supplier.LegalName)){<div class="small text-muted">@supplier.LegalName</div>}</div><span class="badge @(supplier.IsActive?"bg-success":"bg-secondary") align-self-start">@(supplier.IsActive?Localizer["Active"]:Localizer["Inactive"])</span></div>
  <dl class="row small mb-0"><dt class="col-5">@Localizer["Contact person"]</dt><dd class="col-7">@(supplier.ContactPerson??"—")</dd><dt class="col-5">@Localizer["Phone"]</dt><dd class="col-7">@(supplier.Phone??"—")</dd><dt class="col-5">@Localizer["Email"]</dt><dd class="col-7 text-break">@(supplier.Email??"—")</dd><dt class="col-5">@Localizer["Assigned products"]</dt><dd class="col-7"><span class="badge text-bg-light border">@supplier.ProductCount</span></dd><dt class="col-5">@Localizer["Payment terms"]</dt><dd class="col-7">@supplier.PaymentTermsDays @Localizer["days"]</dd></dl>
 </div><div class="card-footer d-flex flex-wrap gap-2">
  @if(await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier)??"System","Suppliers.Edit")){<a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary">@Localizer["Edit profile"]</a>}
  <a asp-controller="SupplierPurchasing" asp-action="Index" asp-route-supplierId="@supplier.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Purchasing data"]</a>
  @if(await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier)??"System","Suppliers.Delete")){<form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Are you sure you want to delete this item?"]');"><button class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button></form>}
 </div></article></div>
}
</div>
