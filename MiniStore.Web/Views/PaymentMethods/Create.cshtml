@{ var accounts = ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4"><h2>Add Payment Method</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>Name</label><input name="name" class="form-control" placeholder="Cash, bank transfer, card" required /></div><div class="mb-3"><label>Cash or bank account</label><select name="accountId" class="form-select" required><option value="">Select account</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select></div><button class="btn btn-primary">Save</button></form></div>
