@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ var accounts = ViewBag.Accounts as List<MiniStore.Application.Dtos.Accounting.AccountDto> ?? []; }
<div class="container mt-4"><h2>@Localizer["Add Payment Method"]</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>@Localizer["Name"]</label><input name="name" class="form-control" placeholder="@Localizer["Cash, bank transfer, card"]" required /></div><div class="mb-3"><label>@Localizer["Cash or bank account"]</label><select name="accountId" class="form-select" required><option value="">@Localizer["Select account"]</option>@foreach (var account in accounts) { <option value="@account.Id">@account.Code — @account.Name</option> }</select></div><button class="btn btn-primary">@Localizer["Save"]</button></form></div>
