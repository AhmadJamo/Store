@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model List<MiniStore.Domain.Entities.PaymentMethod>
<div class="container mt-4"><div class="d-flex justify-content-between"><h2>@Localizer["Payment Methods"]</h2><a asp-action="Create" class="btn btn-primary">@Localizer["Add Payment Method"]</a></div><table class="table mt-3"><thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Settlement account ID"]</th><th>@Localizer["Status"]</th></tr></thead><tbody>@foreach (var method in Model) { <tr><td>@method.Name</td><td>@method.AccountId</td><td>@(method.IsActive ? "Active" : "Inactive")</td></tr> }</tbody></table></div>
