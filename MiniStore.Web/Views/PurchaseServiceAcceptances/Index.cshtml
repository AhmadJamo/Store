@model IReadOnlyList<MiniStore.Application.DTOs.Purchases.PurchaseServiceAcceptanceDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Service completions"]; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3"><div><h2 class="mb-1">@Localizer["Service completions"]</h2><p class="text-muted mb-0">@Localizer["Evidence that purchased services were completed without changing warehouse stock."]</p></div></div>
<div class="row g-3">
@foreach (var item in Model)
{
    <div class="col-12 col-lg-6"><div class="card h-100 card-body"><div class="d-flex flex-wrap justify-content-between gap-2"><div><strong>@item.AcceptanceNumber</strong><div class="text-muted">@Localizer["Purchase order"]: @item.PurchaseOrderNumber</div></div><span>@item.CompletionDate</span></div><div class="mt-2">@Localizer["Completed quantity"]: @item.Lines.Sum(x => x.CompletedQuantity).ToQuantityDisplay(numberSettings)</div><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-3 align-self-start">@Localizer["Details"]</a></div></div>
}
</div>
@if (Model.Count == 0) { <div class="alert alert-info">@Localizer["No service completions have been recorded."]</div> }
