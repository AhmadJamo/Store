@model MiniStore.Application.DTOs.Purchases.PurchaseServiceAcceptanceDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Model.AcceptanceNumber; var numberSettings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between gap-2"><div><h2>@Model.AcceptanceNumber <span class="badge bg-success">@Localizer["Completed"]</span></h2><p class="text-muted">@Localizer["Completion date"]: @Model.CompletionDate</p></div><a asp-action="Index" class="btn btn-outline-secondary align-self-start">@Localizer["Back"]</a></div>
<div class="card card-body mb-3"><div><strong>@Localizer["Purchase order"]:</strong> <a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@Model.PurchaseOrderId">@Model.PurchaseOrderNumber</a></div>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="mt-2"><strong>@Localizer["Notes"]:</strong> @Model.Notes</div> }</div>
<div class="row g-3">@foreach (var line in Model.Lines) { <div class="col-12 col-lg-6"><div class="card card-body h-100"><strong>@line.ProductCode — @line.ProductName</strong><div class="text-muted">@line.UnitName</div><div class="mt-3">@Localizer["Completed quantity"]: <strong>@line.CompletedQuantity.ToQuantityDisplay(numberSettings)</strong></div></div></div> }</div>
