@model MiniStore.Application.Dtos.Sales.CustomerPaymentDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"]=Model.PaymentNumber;var settings=await GeneralSettingsService.GetAsync();var rv=Convert.ToBase64String(Model.RowVersion);async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded;var badge=Model.Status==CustomerPaymentStatus.Posted?"bg-success":"bg-secondary"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@Model.PaymentNumber</h2><span class="badge @badge">@Localizer[Model.Status.ToString()]</span></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-4"><strong>@Localizer["Customer"]:</strong> @Model.CustomerName</div><div class="col-md-4"><strong>@Localizer["Payment date"]:</strong> @Model.PaymentDate</div><div class="col-md-4"><strong>@Localizer["Payment method"]:</strong> @Model.PaymentMethodName</div><div class="col-md-4"><strong>@Localizer["Total"]:</strong> @Model.TotalAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div><div class="col-md-8"><strong>@Localizer["Exchange rate"]:</strong> 1 @Model.CurrencyCode = @Model.ExchangeRate.ToQuantityDisplay(settings) @Model.CompanyCurrencyCode (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div></div></div>
<h5>@Localizer["Invoice allocations"]</h5><div class="row g-3 mb-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><a asp-controller="CustomerInvoices" asp-action="Details" asp-route-id="@line.CustomerInvoiceId"><strong>@line.InvoiceNumber</strong></a><div class="d-flex justify-content-between mt-2"><span>@Localizer["Payment allocation"]</span><span>@line.Amount.ToMoneyDisplay(settings) @Model.CurrencyCode</span></div><div class="small text-muted">@Localizer["Receivable carrying amount"]: @line.ReceivableCarryingAmount.ToMoneyDisplay(settings) @Model.CompanyCurrencyCode</div></div></div></div>}</div>
<div class="card card-body mb-3"><h5>@Localizer["Accounting posting evidence"]</h5><div>@Localizer["Journal entry"]: @if(Model.JournalEntryId.HasValue&&await Can("JournalEntries.View")){<a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@Model.JournalEntryId">@Model.JournalEntryNumber</a>}else{@Model.JournalEntryNumber}</div>@if(Model.ReversalJournalEntryId.HasValue){<div>@Localizer["Reversal journal entry"]: @if(await Can("JournalEntries.View")){<a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@Model.ReversalJournalEntryId">@Model.ReversalJournalEntryNumber</a>}else{@Model.ReversalJournalEntryNumber}</div>}</div>
@if(Model.Status==CustomerPaymentStatus.Posted&&await Can("CustomerPayments.Reverse")){<form asp-action="Reverse" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input type="date" name="ReversalDate" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required class="form-control" style="max-width:12rem"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Reversal reason"]" style="min-width:16rem"/><button class="btn btn-outline-danger">@Localizer["Reverse customer payment"]</button></form>}else if(Model.Status==CustomerPaymentStatus.Reversed){<span class="badge bg-secondary p-2">@Localizer["Customer payment reversed"]</span>}
@if(Model.Notes is not null){<div class="card card-body mt-3"><strong>@Localizer["Notes"]</strong><div>@Model.Notes</div></div>}
