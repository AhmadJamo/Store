@model MiniStore.Application.Dtos.Sales.CustomerPaymentCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ ViewData["Title"] = Localizer["Record customer payment"]; var settings = await GeneralSettingsService.GetAsync(); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Localizer["Record customer payment"]</h2><div class="text-muted">@Model.CustomerName — @Model.CurrencyCode</div></div><a asp-controller="CustomerInvoices" asp-action="Details" asp-route-id="@Model.Form.SourceCustomerInvoiceId" class="btn btn-outline-secondary">@Localizer["Back to invoice"]</a></div>
<form asp-action="Create" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Form.SourceCustomerInvoiceId" name="SourceCustomerInvoiceId"/><div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">@Localizer["Payment date"]</label><input type="date" asp-for="Form.PaymentDate" name="PaymentDate" class="form-control"/></div><div class="col-md-4"><label class="form-label">@Localizer["Payment method"]</label><select asp-for="Form.PaymentMethodId" name="PaymentMethodId" class="form-select"><option value="">@Localizer["Select payment method"]</option>@foreach(var method in Model.PaymentMethods){<option value="@method.Id">@method.Name</option>}</select></div><div class="col-md-4"><label class="form-label">@Localizer["External reference"]</label><input asp-for="Form.ExternalReference" name="ExternalReference" class="form-control"/></div><div class="col-12"><label class="form-label">@Localizer["Notes"]</label><textarea asp-for="Form.Notes" name="Notes" class="form-control"></textarea></div></div></div>
@if(Model.OpenInvoices.Count==0){<div class="alert alert-info">@Localizer["There are no outstanding posted invoices for this customer and currency."]</div>}
else{<div class="row g-3">@for(var i=0;i<Model.OpenInvoices.Count;i++){var invoice=Model.OpenInvoices[i];var existing=Model.Form.Lines.FirstOrDefault(x=>x.CustomerInvoiceId==invoice.CustomerInvoiceId);<div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><a asp-controller="CustomerInvoices" asp-action="Details" asp-route-id="@invoice.CustomerInvoiceId"><strong>@invoice.InvoiceNumber</strong></a><span>@invoice.DueDate</span></div><input type="hidden" name="Lines[@i].CustomerInvoiceId" value="@invoice.CustomerInvoiceId"/><div class="row g-2 mt-2"><div class="col-6"><span class="text-muted">@Localizer["Invoice total"]</span><div>@invoice.TotalAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Paid amount"]</span><div>@invoice.PaidAmount.ToMoneyDisplay(settings)</div></div><div class="col-6"><span class="text-muted">@Localizer["Outstanding balance"]</span><div>@invoice.OutstandingAmount.ToMoneyDisplay(settings) @Model.CurrencyCode</div></div><div class="col-6"><label class="form-label">@Localizer["Payment allocation"]</label><input type="number" name="Lines[@i].Amount" value="@((existing?.Amount??0).ToMoneyInput(settings))" min="0" max="@invoice.OutstandingAmount.ToInputNumber()" step="0.01" class="form-control"/></div></div></div></div></div>}</div><button class="btn btn-primary mt-3">@Localizer["Post customer payment"]</button>}</form>
