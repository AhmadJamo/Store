@using Microsoft.AspNetCore.Identity
@using System.Globalization
@using System.Security.Claims
@model List<IdentityUser>
@{ var ar = CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"] = ar ? "المستخدمون" : "Users"; var userRoles = ViewBag.UserRoles as IReadOnlyDictionary<string, IReadOnlyList<string>>; var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? ""; var canCreate = await PermissionService.CanAsync(userId, "Users.Create"); }
<div class="container-fluid py-3"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>@ViewData["Title"]</h2><p class="text-muted mb-0">@(ar ? "مستخدمو الشركة الحالية وأدوارهم المحلية." : "Active-company users and their local roles.")</p></div>@if(canCreate){<a asp-action="Create" class="btn btn-primary">+ @(ar ? "إضافة مستخدم" : "Add user")</a>}</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>@(ar ? "اسم المستخدم" : "Username")</th><th>@(ar ? "البريد" : "Email")</th><th>@(ar ? "دور الشركة" : "Company role")</th><th>@(ar ? "البريد مؤكد" : "Email confirmed")</th></tr></thead><tbody>
@foreach(var user in Model){ var names = userRoles is not null && userRoles.TryGetValue(user.Id, out var assigned) ? assigned : []; <tr><td>@user.UserName</td><td>@user.Email</td><td>@if(names.Count>0){@string.Join(", ", names)}else{<span class="text-muted">@(ar ? "بدون دور" : "No role")</span>}</td><td><span class="badge @(user.EmailConfirmed ? "text-bg-success" : "text-bg-secondary")">@(user.EmailConfirmed ? (ar ? "نعم" : "Yes") : (ar ? "لا" : "No"))</span></td></tr>}
</tbody></table></div></div></div>
