@model MiniStore.Application.DTOs.Products.ProductListPageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer

@{ ViewData["Title"] = "Products"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@Localizer["Products"]</h1>
        <div class="text-muted">@string.Format(Localizer["{0} product(s) found."], Model.TotalCount)</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="ProductCategories" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Product categories"]</a>
        @if (await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System", "Products.Create"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> @Localizer["Add Product"]</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4">
            <label class="form-label">@Localizer["Search"]</label>
            <input name="Search" value="@Model.Query.Search" class="form-control" placeholder="@Localizer["Search by name, product code, or barcode..."]" />
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Product type"]</label>
            <select name="ProductType" class="form-select">
                <option value="">@Localizer["All types"]</option>
                @foreach (var type in Enum.GetValues<ProductType>())
                { <option value="@type" selected="@(Model.Query.ProductType == type ? "selected" : null)">@Localizer[type.ToString()]</option> }
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Product category"]</label>
            <select name="ProductCategoryId" class="form-select">
                <option value="">@Localizer["All categories"]</option>
                @foreach (var category in Model.Categories)
                { <option value="@category.Id" selected="@(Model.Query.ProductCategoryId == category.Id)">@category.Name</option> }
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Tracking policy"]</label>
            <select name="TrackingPolicy" class="form-select">
                <option value="">@Localizer["All tracking policies"]</option>
                @foreach (var policy in Enum.GetValues<ProductTrackingPolicy>())
                { <option value="@policy" selected="@(Model.Query.TrackingPolicy == policy)">@Localizer[policy.ToString()]</option> }
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Availability"]</label>
            <select name="IsActive" class="form-select">
                <option value="">@Localizer["All statuses"]</option>
                <option value="true" selected="@(Model.Query.IsActive == true ? "selected" : null)">@Localizer["Active"]</option>
                <option value="false" selected="@(Model.Query.IsActive == false ? "selected" : null)">@Localizer["Inactive"]</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Sales channel"]</label>
            <select name="channel" class="form-select" onchange="applyChannel(this.form, this.value)">
                <option value="">@Localizer["All channels"]</option>
                <option value="pos" selected="@(Model.Query.IsSellableInPos == true && Model.Query.IsSellableInSales is null ? "selected" : null)">@Localizer["POS"]</option>
                <option value="sales" selected="@(Model.Query.IsSellableInSales == true && Model.Query.IsSellableInPos is null ? "selected" : null)">@Localizer["Sales invoices"]</option>
                <option value="ingredients" selected="@(Model.Query.IsSellableInPos == false && Model.Query.IsSellableInSales == false ? "selected" : null)">@Localizer["Ingredients only"]</option>
            </select>
            <input type="hidden" name="IsSellableInPos" value="@(Model.Query.IsSellableInPos?.ToString().ToLowerInvariant())" />
            <input type="hidden" name="IsSellableInSales" value="@(Model.Query.IsSellableInSales?.ToString().ToLowerInvariant())" />
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label">@Localizer["Sort by"]</label>
            <select name="SortBy" class="form-select">
                <option value="name" selected="@(Model.Query.SortBy == "name" ? "selected" : null)">@Localizer["Name"]</option>
                <option value="code" selected="@(Model.Query.SortBy == "code" ? "selected" : null)">@Localizer["Product code"]</option>
                <option value="type" selected="@(Model.Query.SortBy == "type" ? "selected" : null)">@Localizer["Product type"]</option>
                <option value="category" selected="@(Model.Query.SortBy == "category" ? "selected" : null)">@Localizer["Product category"]</option>
                <option value="tracking" selected="@(Model.Query.SortBy == "tracking" ? "selected" : null)">@Localizer["Tracking policy"]</option>
                <option value="price" selected="@(Model.Query.SortBy == "price" ? "selected" : null)">@Localizer["Retail Price"]</option>
            </select>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["Apply filters"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Clear"]</a>
            <div class="form-check ms-auto align-self-center">
                <input type="checkbox" name="SortDescending" value="true" class="form-check-input" id="sort-desc" checked="@(Model.Query.SortDescending ? "checked" : null)" />
                <label for="sort-desc" class="form-check-label">@Localizer["Descending"]</label>
            </div>
        </div>
    </div>
</form>

<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead><tr>
        <th>@Localizer["Product code"]</th><th>@Localizer["Name"]</th><th>@Localizer["Product type"]</th><th>@Localizer["Product category"]</th><th>@Localizer["Tracking policy"]</th>
        <th>@Localizer["Barcode"]</th><th>@Localizer["Stock unit"]</th><th>@Localizer["Sales channel"]</th>
        <th>@Localizer["Retail Price"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th>
    </tr></thead>
    <tbody>
    @if (Model.Items.Count == 0)
    { <tr><td colspan="11" class="text-center text-muted py-4">@Localizer["No products found."]</td></tr> }
    @foreach (var product in Model.Items)
    {
        <tr>
            <td><code>@product.ProductCode</code></td>
            <td>@product.Name</td>
            <td><span class="badge text-bg-light">@Localizer[product.ProductType.ToString()]</span></td>
            <td>@(product.ProductCategoryName ?? Localizer["Not assigned"].Value)</td>
            <td>@Localizer[product.TrackingPolicy.ToString()]</td>
            <td>@(product.Barcode ?? Localizer["Not assigned"].Value)</td>
            <td>@Localizer[product.StockUnit.ToString()]</td>
            <td>
                @if (product.IsSellableInPos) { <span class="badge text-bg-primary">@Localizer["POS"]</span> }
                @if (product.IsSellableInSales) { <span class="badge text-bg-info">@Localizer["Sales"]</span> }
                @if (!product.IsSellableInPos && !product.IsSellableInSales) { <span class="text-muted">@Localizer["Ingredients only"]</span> }
            </td>
            <td>@product.SalePrice.ToString("N2")</td>
            <td><span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">@Localizer[product.IsActive ? "Active" : "Inactive"]</span></td>
            <td class="text-nowrap">
                @if (await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System", "Products.Edit"))
                { <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning">@Localizer["Edit"]</a> }
                @if (await PermissionService.CanAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System", "Products.Delete"))
                { <form asp-action="Delete" method="post" class="d-inline" asp-route-id="@product.Id"><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm-delete="true">@Localizer["Delete"]</button></form> }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="@Localizer["Product pages"]"><ul class="pagination">
    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
    {
        <li class="page-item @(pageNumber == Model.Query.Page ? "active" : null)">
            <a class="page-link"
               asp-action="Index"
               asp-route-Search="@Model.Query.Search"
               asp-route-ProductType="@Model.Query.ProductType"
               asp-route-ProductCategoryId="@Model.Query.ProductCategoryId"
               asp-route-TrackingPolicy="@Model.Query.TrackingPolicy"
               asp-route-IsSellableInPos="@Model.Query.IsSellableInPos"
               asp-route-IsSellableInSales="@Model.Query.IsSellableInSales"
               asp-route-IsActive="@Model.Query.IsActive"
               asp-route-SortBy="@Model.Query.SortBy"
               asp-route-SortDescending="@Model.Query.SortDescending"
               asp-route-Page="@pageNumber"
               asp-route-PageSize="@Model.Query.PageSize">@pageNumber</a>
        </li>
    }
    </ul></nav>
}

@section Scripts {
<script>
function applyChannel(form, channel) {
    const pos = form.querySelector('input[name="IsSellableInPos"]');
    const sales = form.querySelector('input[name="IsSellableInSales"]');
    pos.value = channel === 'pos' ? 'true' : (channel === 'ingredients' ? 'false' : '');
    sales.value = channel === 'sales' ? 'true' : (channel === 'ingredients' ? 'false' : '');
}
</script>
}
