


@model List<MiniStore.Application.DTOs.Products.ProductDto>

@{
    ViewData["Title"] = "Products";
}


<h1>Products</h1>

<p class="text-muted">
    @Model.Count product(s) found.
</p>

<form asp-action="Index"
      method="get"
      class="mb-3">

    <div class="input-group">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search by name or barcode..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>

    </div>

</form>
<p>
    @if (await PermissionService.CanAsync(
         User,
         "Products.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Product
        </a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Barcode</th>
            <th>Purchase Price</th>
            <th>Sale Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6"
                    class="text-center text-muted">
                    No products found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var product in Model)
            {
                <tr>

                    <td>@product.Id</td>

                    <td>@product.Name</td>

                    <td>@product.Barcode</td>

                    <td>@product.PurchasePrice</td>

                    <td>@product.SalePrice</td>

                    <td>

                        @if (await PermissionService.CanAsync(
         User,
         "Products.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@product.Id"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
          User,
          "Products.Delete"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@product.Id"
                               class="btn btn-danger">
                                Delete
                            </a>
                        }
                    </td>

                </tr>
            }
        }

    </tbody>

</table>