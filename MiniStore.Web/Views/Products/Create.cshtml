@model MiniStore.Application.DTOs.Products.CreateProductDto

@{
    ViewData["Title"] = "Create Product";
}

<h1>Create Product</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Product Name
        </label>

        <input asp-for="Name" class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Barcode" class="form-label">
            Barcode
        </label>

        <input asp-for="Barcode" class="form-control" />

        <span asp-validation-for="Barcode"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PurchasePrice" class="form-label">
            Purchase Price
        </label>

        <input asp-for="PurchasePrice"
               type="number"
               step="0.001"
               class="form-control" />

        <span asp-validation-for="PurchasePrice"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SalePrice" class="form-label">
            Retail Price
        </label>

        <input asp-for="SalePrice"
               type="number"
               step="0.001"
               class="form-control" />

        <span asp-validation-for="SalePrice"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WholesalePrice" class="form-label">Wholesale Price</label>
        <input asp-for="WholesalePrice" type="number" step="0.001" class="form-control" />
        <span asp-validation-for="WholesalePrice" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
