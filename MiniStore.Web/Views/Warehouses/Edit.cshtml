@model MiniStore.Application.DTOs.Warehouses.UpdateWarehouseDto

@{
    ViewData["Title"] = "Edit Warehouse";
}

<h1>Edit Warehouse</h1>

<form asp-action="Edit" method="post">

    <div class="mb-3">

        <label asp-for="Name"
               class="form-label">
            Warehouse Name
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>