@model List<MiniStore.Application.DTOs.Warehouses.WarehouseDto>

@{
    ViewData["Title"] = "Warehouses";
}

<h1>Warehouses</h1>

<p class="text-muted">
    @Model.Count warehouse(s) found.
</p>

<p>
    @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Warehouse
        </a>
        <a asp-controller="WarehouseLocations" asp-action="Index" class="btn btn-outline-primary">Locations & product search</a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Use</th>
            <th>Control</th>
            <th>POS</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6"
                    class="text-center text-muted">
                    No warehouses found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var warehouse in Model)
            {
                <tr>

                    <td>
                        @warehouse.Id
                    </td>

                    <td>
                        @warehouse.Name
                    </td>

                    <td>@warehouse.Type</td>
                    <td>@warehouse.ControlMode</td>
                    <td>@(warehouse.AllowPosSales ? "Allowed" : "Not allowed")</td>

                    <td>

                        @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@warehouse.Id"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline" asp-route-id="@warehouse.Id" onsubmit="return confirm('Are you sure you want to delete this item?');">
<button type="submit" class="btn btn-sm btn-danger">Delete</button></form>
                        }

                    </td>

                </tr>
            }
        }

    </tbody>

</table>
