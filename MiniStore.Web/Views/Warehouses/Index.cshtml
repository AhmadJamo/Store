@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@model List<MiniStore.Application.DTOs.Warehouses.WarehouseDto>

@{
    ViewData["Title"] = "Warehouses";
}

<h1>@Localizer["Warehouses"]</h1>

<p class="text-muted">
    @Model.Count warehouse(s) found.
</p>

<p>
    @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            @Localizer["Add Warehouse"]
        </a>
        <a asp-controller="WarehouseLocations" asp-action="Index" class="btn btn-outline-primary">@Localizer["Locations & product search"]</a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>@Localizer["Id"]</th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Use"]</th>
            <th>@Localizer["Control"]</th>
            <th>@Localizer["POS"]</th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6"
                    class="text-center text-muted">
                    @Localizer["No warehouses found."]
                </td>
            </tr>
        }
        else
        {
            @foreach (var warehouse in Model)
            {
                <tr>

                    <td>
                        @warehouse.Id
                    </td>

                    <td>
                        @warehouse.Name
                    </td>

                    <td>@warehouse.Type</td>
                    <td>@warehouse.ControlMode</td>
                    <td>@(warehouse.AllowPosSales ? "Allowed" : "Not allowed")</td>

                    <td>

                        @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@warehouse.Id"
                               class="btn btn-warning">
                                @Localizer["Edit"]
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "Warehouses.Delete"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline" asp-route-id="@warehouse.Id" onsubmit="return confirm('@Localizer["Are you sure you want to delete this item?"]');">
<button type="submit" class="btn btn-sm btn-danger">@Localizer["Delete"]</button></form>
                        }

                    </td>

                </tr>
            }
        }

    </tbody>

</table>
