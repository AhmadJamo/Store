@model MiniStore.Application.Dtos.Sales.SalesDeliveryCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Localizer["Prepare sales delivery"];var settings=await GeneralSettingsService.GetAsync();}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Localizer["Prepare sales delivery"]</h2><div class="text-muted">@Model.OrderNumber</div></div><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-outline-secondary">@Localizer["Back to sales order"]</a></div>
@if(Model.OrderStatus!=MiniStore.Domain.Entities.SalesOrderStatus.Confirmed){<div class="alert alert-warning">@Localizer["Only a confirmed non-cancelled sales order can be delivered."]</div>}
@foreach(var reservation in Model.Reservations){<div class="card mb-3"><div class="card-header d-flex flex-wrap justify-content-between gap-2"><div><strong>@reservation.WarehouseName</strong><span class="text-muted ms-2">@Localizer["Reserved at"] @reservation.ReservedAt.ToLocalTime()</span></div>@if(reservation.HasOpenDraft){<a asp-action="Details" asp-route-id="@reservation.OpenDraftId" class="btn btn-sm btn-success">@Localizer["View prepared delivery"]</a>}</div><div class="card-body">@if(!reservation.HasOpenDraft&&Model.OrderStatus==MiniStore.Domain.Entities.SalesOrderStatus.Confirmed){<form asp-action="Create" method="post"><input type="hidden" name="SalesOrderId" value="@Model.SalesOrderId"/><input type="hidden" name="InventoryReservationId" value="@reservation.ReservationId"/><div class="row g-3 mb-3"><div class="col-md-4"><label class="form-label">@Localizer["Delivery date"]</label><input name="DeliveryDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-8"><label class="form-label">@Localizer["Notes"]</label><input name="Notes" maxlength="1000" class="form-control"/></div></div><div class="row g-3">@for(var i=0;i<reservation.Lines.Count;i++){var line=reservation.Lines[i];<div class="col-lg-6"><div class="border rounded p-3 h-100"><strong>@line.ProductCode — @line.ProductName</strong><div class="small text-muted">@reservation.WarehouseName · @line.LocationName</div><div class="small mb-2">@Localizer["Reserved remaining"]: @line.RemainingQuantity.ToQuantityDisplay(settings)</div><input type="hidden" name="Lines[@i].InventoryReservationLineId" value="@line.InventoryReservationLineId"/><label class="form-label">@Localizer["Delivery quantity"]</label><input name="Lines[@i].StockQuantity" type="number" min="0" max="@line.RemainingQuantity" step="0.000001" value="@line.RemainingQuantity" class="form-control"/>@if(line.TrackingPolicy!=MiniStore.Domain.Entities.ProductTrackingPolicy.None){<label class="form-label mt-2">@Localizer["Lot or serial allocation"] <span title="@Localizer["Leave empty to use the warehouse picking policy, or enter LOT:QUANTITY / one serial per line."]" role="img" aria-label="@Localizer["Help"]">?</span></label><textarea name="Lines[@i].TrackingAllocations" maxlength="4000" class="form-control" rows="2"></textarea>}</div></div>}</div><button class="btn btn-primary mt-3">@Localizer["Prepare delivery draft"]</button></form>}</div></div>}
@if(Model.Reservations.Count==0){<div class="alert alert-info">@Localizer["No active reserved quantity is available for delivery."] <a asp-controller="SalesOrders" asp-action="Reserve" asp-route-id="@Model.SalesOrderId">@Localizer["Open inventory reservation"]</a></div>}
