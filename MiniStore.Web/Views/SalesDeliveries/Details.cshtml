@model MiniStore.Application.Dtos.Sales.SalesDeliveryDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject MiniStore.Application.Services.GeneralSettingsService GeneralSettingsService
@{ViewData["Title"]=Model.DeliveryNumber;var rv=Convert.ToBase64String(Model.RowVersion);var settings=await GeneralSettingsService.GetAsync();async Task<bool> Can(string p)=>(await Authorization.AuthorizeAsync(User,null,$"Permission:{p}")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>@Model.DeliveryNumber</h2><span class="badge @(Model.Status==MiniStore.Domain.Entities.SalesDeliveryStatus.Posted?"bg-success":Model.Status==MiniStore.Domain.Entities.SalesDeliveryStatus.Cancelled?"bg-secondary":"bg-warning text-dark")">@Localizer[Model.Status.ToString()]</span></div><div class="d-flex flex-wrap gap-2"><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-outline-primary">@Localizer["View sales order"]</a><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="alert alert-info">@Localizer["Posting this delivery consumes its reservation, reduces physical stock and records cost of goods sold. It does not create a customer invoice or payment."]</div>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-3"><span class="text-muted">@Localizer["Sales order"]</span><div>@Model.OrderNumber</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Warehouse"]</span><div>@Model.WarehouseName</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Delivery date"]</span><div>@Model.DeliveryDate</div></div><div class="col-md-3"><span class="text-muted">@Localizer["Cost of goods sold"]</span><div>@Model.TotalCostOfGoodsSold.ToMoneyDisplay(settings)</div></div></div>@if(Model.Notes is not null){<div class="mt-3">@Model.Notes</div>}</div>
<div class="row g-3">@foreach(var line in Model.Lines){<div class="col-lg-6"><div class="card h-100"><div class="card-body"><strong>@line.ProductCode — @line.ProductName</strong><div class="small text-muted">@line.WarehouseName · @line.LocationName</div><div class="row mt-2"><div class="col-4"><span class="text-muted">@Localizer["Quantity"]</span><div>@line.StockQuantity.ToQuantityDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Unit cost"]</span><div>@line.UnitCost.ToMoneyDisplay(settings)</div></div><div class="col-4"><span class="text-muted">@Localizer["Cost"]</span><div>@line.CostOfGoodsSold.ToMoneyDisplay(settings)</div></div></div>@if(line.TrackingAllocations is not null){<div class="mt-2"><span class="text-muted">@Localizer["Tracking allocation"]</span><pre class="mb-0">@line.TrackingAllocations</pre></div>}</div></div></div>}</div>
<div class="d-flex flex-wrap gap-2 mt-3">@if(Model.Status==MiniStore.Domain.Entities.SalesDeliveryStatus.Draft){if(await Can("SalesDeliveries.Post")){<form asp-action="Post" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Post sales delivery"]</button></form>}if(await Can("SalesDeliveries.Cancel")){<form asp-action="Cancel" method="post" class="d-flex gap-2"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><input name="Reason" maxlength="500" required class="form-control" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel delivery draft"]</button></form>}}else if(Model.Status==MiniStore.Domain.Entities.SalesDeliveryStatus.Posted){<span class="badge bg-success p-2">@Localizer["Posting completed"]</span>@if(Model.HasRemainingDelivery&&await Can("SalesDeliveries.Create")){<a asp-action="Create" asp-route-salesOrderId="@Model.SalesOrderId" class="btn btn-primary">@Localizer["Prepare remaining delivery"]</a>}}else{<span class="badge bg-secondary p-2">@Localizer["Delivery draft cancelled"]</span>}</div>
<h5 class="mt-4">@Localizer["History"]</h5><div class="list-group">@foreach(var h in Model.History){<div class="list-group-item"><strong>@Localizer[h.Action.ToString()]</strong> — @h.UserId — @h.CreatedAtUtc.ToLocalTime() @if(h.Reason is not null){<span>— @h.Reason</span>}</div>}</div>
