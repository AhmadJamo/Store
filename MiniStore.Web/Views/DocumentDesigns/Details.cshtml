@model MiniStore.Application.Dtos.Settings.DocumentDesignDetailsDto
@using MiniStore.Domain.Entities
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ var d=Model.Design; ViewData["Title"] = d.Name; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@d.Name</h2><div class="text-muted"><span class="badge bg-light text-dark">@Localizer[d.DocumentType.ToString()]</span> <code>@d.Code</code> · v@d.Version · @Localizer[Model.Status.ToString()]</div></div><div class="d-flex flex-wrap gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a><a asp-action="Create" asp-route-sourceDesignId="@Model.Id" class="btn btn-outline-primary">@Localizer["Create new version"]</a>@if(Model.Status==DocumentDesignStatus.Draft){<form asp-action="Activate" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-success">@Localizer["Activate"]</button></form>}@if(Model.Status!=DocumentDesignStatus.Archived){<form asp-action="Archive" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">@Localizer["Archive"]</button></form>}@if(Model.Status==DocumentDesignStatus.Active&&!d.IsDefault){<form asp-action="SetDefault" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-primary">@Localizer["Set as default"]</button></form>}</div></div>
@if(d.IsDefault){<div class="alert alert-primary">@Localizer["This is the default design for this document type."]</div>}
<div class="row g-3"><div class="col-lg-5"><div class="card h-100"><div class="card-header"><strong>@Localizer["Design settings"]</strong></div><div class="card-body"><dl class="row mb-0">
<dt class="col-6">@Localizer["Language"]</dt><dd class="col-6">@Localizer[d.DefaultLanguage.ToString()]</dd><dt class="col-6">@Localizer["Paper"]</dt><dd class="col-6">@Localizer[d.PageSize.ToString()] · @Localizer[d.Orientation.ToString()]</dd><dt class="col-6">@Localizer["Font"]</dt><dd class="col-6">@d.FontFamily</dd><dt class="col-6">@Localizer["Header layout"]</dt><dd class="col-6">@Localizer[d.HeaderLayout.ToString()]</dd><dt class="col-6">@Localizer["Logo placement"]</dt><dd class="col-6">@Localizer[d.LogoPlacement.ToString()]</dd><dt class="col-6">@Localizer["Organization name placement"]</dt><dd class="col-6">@Localizer[d.OrganizationNamePlacement.ToString()]</dd><dt class="col-6">@Localizer["Created"]</dt><dd class="col-6">@Model.CreatedAtUtc.ToLocalTime()</dd></dl></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header"><strong>@Localizer["Configured sections"]</strong></div><div class="list-group list-group-flush">@foreach(var s in d.Sections.OrderBy(x=>x.Sequence)){<div class="list-group-item d-flex justify-content-between"><div><strong>@s.Sequence. @s.Title</strong>@if(!string.IsNullOrWhiteSpace(s.TitleArabic)){<div dir="rtl">@s.TitleArabic</div>}<div class="small text-muted">@Localizer[s.SectionType.ToString()] @if(s.PageBreakBefore){<span>· @Localizer["New page"]</span>}</div></div><span class="badge @(s.IsVisible?"bg-success":"bg-secondary")">@Localizer[s.IsVisible?"Visible":"Hidden"]</span></div>}</div></div></div></div>
