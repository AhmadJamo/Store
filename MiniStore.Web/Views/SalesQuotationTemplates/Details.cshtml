@model MiniStore.Application.Dtos.Sales.SalesQuotationTemplateDetailsDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ViewData["Title"]=Model.Name;var canManage=(await Authorization.AuthorizeAsync(User,null,"Permission:SalesQuotationTemplates.Manage")).Succeeded;var rv=Convert.ToBase64String(Model.RowVersion);}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2>@Model.Code v@Model.Version — @Model.Name</h2><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span> @if(Model.IsDefault){<span class="badge bg-primary">@Localizer["Default"]</span>}</div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a>@if(canManage){<a asp-action="Create" asp-route-sourceTemplateId="@Model.Id" class="btn btn-outline-primary">@Localizer["Create new version"]</a>}</div></div>
<div class="row g-3 mb-3"><div class="col-lg-6"><div class="card card-body h-100"><h5>@Localizer["Template policy"]</h5><div>@Localizer["Category"]: @(Model.Category??"—")</div><div>@Localizer["Tags"]: @(Model.Tags??"—")</div><div>@Localizer["Validity days"]: @Model.ValidityDays</div><div>@Localizer["Base price channel"]: @Localizer[Model.Channel.ToString()]</div><div>@Localizer["Price list"]: @(Model.PriceListName??Localizer["Customer default or product fallback"].Value)</div><div>@Localizer["Additional products"]: @Localizer[Model.AllowAdditionalLines?"Allowed":"Not allowed"]</div></div></div><div class="col-lg-6"><div class="card card-body h-100"><h5>@Localizer["Reusable content"]</h5>@if(Model.Description is not null){<p>@Model.Description</p>}@if(Model.Introduction is not null){<div><strong>@Localizer["Introduction"]</strong><div class="text-prewrap">@Model.Introduction</div></div>}@if(Model.TermsAndConditions is not null){<div class="mt-2"><strong>@Localizer["Terms and conditions"]</strong><div class="text-prewrap">@Model.TermsAndConditions</div></div>}@if(Model.FooterNotes is not null){<div class="mt-2"><strong>@Localizer["Footer notes"]</strong><div class="text-prewrap">@Model.FooterNotes</div></div>}</div></div></div>
<h5>@Localizer["Template items"]</h5><div class="row g-3">@foreach(var i in Model.Items){<div class="col-lg-6"><div class="card card-body h-100"><div class="d-flex justify-content-between gap-2"><strong>@i.Sequence. @i.ProductName</strong><span class="badge bg-light text-dark">@Localizer[i.ItemType.ToString()]</span></div><div class="text-muted">@i.SectionTitle @if(i.OptionGroupName is not null){<span>· @i.OptionGroupName (@i.GroupMinimumSelections–@i.GroupMaximumSelections)</span>}</div><div class="mt-2">@Localizer["Default quantity"]: @i.DefaultQuantity @i.UnitName · @Localizer["Allowed quantity"]: @i.MinimumQuantity–@i.MaximumQuantity</div><div class="small">@Localizer[i.AllowQuantityChange?"Quantity can be changed":"Fixed quantity"] · @Localizer[i.IsDefaultSelected?"Selected by default":"Not selected by default"]</div>@if(i.Notes is not null){<div class="mt-2">@i.Notes</div>}</div></div>}</div>
@if(canManage){<div class="d-flex flex-wrap gap-2 mt-3">@if(Model.Status==SalesQuotationTemplateStatus.Draft){<form asp-action="Activate" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-success">@Localizer["Activate template"]</button></form>}@if(Model.Status==SalesQuotationTemplateStatus.Active&&!Model.IsDefault){<form asp-action="SetDefault" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-outline-primary">@Localizer["Make default"]</button></form>}@if(Model.Status!=SalesQuotationTemplateStatus.Archived){<form asp-action="Archive" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rv"/><button class="btn btn-outline-danger">@Localizer["Archive template"]</button></form>}</div>}
