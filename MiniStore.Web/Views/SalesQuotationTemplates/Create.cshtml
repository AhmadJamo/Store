@model MiniStore.Application.Dtos.Sales.SalesQuotationTemplatePageDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ViewData["Title"]=Localizer["Create quotation template"];var rows=Model.Form.Items.Count==0?new List<MiniStore.Application.Dtos.Sales.CreateSalesQuotationTemplateItemDto>{new(){Sequence=1,SectionTitle="General"}}:Model.Form.Items;}
<div class="mb-3"><h2>@Localizer["Create quotation template"]</h2><p class="text-muted">@Localizer["Templates store configuration, not prices. Products are repriced for the customer and quotation date when applied."]</p></div>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<form asp-action="Create" method="post" id="template-form"><input asp-for="Form.SourceTemplateId" name="SourceTemplateId" type="hidden"/>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-md-3"><label class="form-label">@Localizer["Code"]</label><input asp-for="Form.Code" name="Code" maxlength="50" required class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Version"]</label><input asp-for="Form.Version" name="Version" type="number" min="1" max="9999" required class="form-control"/></div><div class="col-md-7"><label class="form-label">@Localizer["Name"]</label><input asp-for="Form.Name" name="Name" maxlength="150" required class="form-control"/></div><div class="col-md-6"><label class="form-label">@Localizer["Description"]</label><input asp-for="Form.Description" name="Description" maxlength="1000" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Category"]</label><input asp-for="Form.Category" name="Category" maxlength="100" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Tags"]</label><input asp-for="Form.Tags" name="Tags" maxlength="500" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Validity days"]</label><input asp-for="Form.ValidityDays" name="ValidityDays" type="number" min="0" max="3650" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Base price channel"]</label><select asp-for="Form.Channel" name="Channel" class="form-select"><option value="Wholesale">@Localizer["Wholesale"]</option><option value="RetailPos">@Localizer["Retail POS"]</option></select></div><div class="col-md-4"><label class="form-label">@Localizer["Price list"]</label><select asp-for="Form.SalesPriceListId" name="SalesPriceListId" class="form-select"><option value="">@Localizer["Customer default or product fallback"]</option>@foreach(var x in Model.PriceLists){<option value="@x.Id">@x.Label</option>}</select></div><div class="col-md-3"><div class="form-check mt-4"><input asp-for="Form.AllowAdditionalLines" name="AllowAdditionalLines" class="form-check-input"/><label class="form-check-label">@Localizer["Allow additional products"]</label></div><div class="form-check"><input asp-for="Form.IsDefault" name="IsDefault" class="form-check-input"/><label class="form-check-label">@Localizer["Make default when activated"]</label></div></div><div class="col-md-6"><label class="form-label">@Localizer["Document design"]</label><select asp-for="Form.DocumentDesignId" name="DocumentDesignId" class="form-select"><option value="">@Localizer["Use default quotation design"]</option>@foreach(var x in Model.Designs){<option value="@x.Id">@x.Label</option>}</select><div class="form-text"><a asp-controller="DocumentDesigns" asp-action="Index">@Localizer["Manage document designs"]</a></div></div></div></div>
<div class="card card-body mb-3"><div class="row g-3"><div class="col-lg-4"><label class="form-label">@Localizer["Introduction"]</label><textarea asp-for="Form.Introduction" name="Introduction" maxlength="4000" rows="5" class="form-control"></textarea></div><div class="col-lg-4"><label class="form-label">@Localizer["Terms and conditions"]</label><textarea asp-for="Form.TermsAndConditions" name="TermsAndConditions" maxlength="8000" rows="5" class="form-control"></textarea></div><div class="col-lg-4"><label class="form-label">@Localizer["Footer notes"]</label><textarea asp-for="Form.FooterNotes" name="FooterNotes" maxlength="4000" rows="5" class="form-control"></textarea></div></div></div>
<h5>@Localizer["Template items"]</h5><div id="items">@for(var i=0;i<rows.Count;i++){var x=rows[i];<div class="card card-body mb-2 template-item"><div class="row g-2"><div class="col-md-1"><label class="form-label">@Localizer["Sequence"]</label><input name="Items[@i].Sequence" data-name="Sequence" value="@x.Sequence" type="number" min="1" max="9999" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Section"]</label><input name="Items[@i].SectionTitle" data-name="SectionTitle" value="@x.SectionTitle" maxlength="150" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Product"]</label><select name="Items[@i].ProductId" data-name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var p in Model.Products){<option value="@p.Id" selected="@(p.Id==x.ProductId?"selected":null)">@p.Label</option>}</select></div><div class="col-md-3"><label class="form-label">@Localizer["Sales unit"]</label><select name="Items[@i].MeasurementUnitId" data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var u in Model.Units){<option value="@u.Id" selected="@(u.Id==x.MeasurementUnitId?"selected":null)">@u.Label</option>}</select></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-danger remove-item">×</button></div><div class="col-md-2"><label class="form-label">@Localizer["Type"]</label><select name="Items[@i].ItemType" data-name="ItemType" class="form-select" asp-items="Html.GetEnumSelectList<SalesQuotationTemplateItemType>()"></select></div><div class="col-md-2"><label class="form-label">@Localizer["Default quantity"]</label><input name="Items[@i].DefaultQuantity" data-name="DefaultQuantity" value="@x.DefaultQuantity" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Minimum quantity"]</label><input name="Items[@i].MinimumQuantity" data-name="MinimumQuantity" value="@x.MinimumQuantity" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Maximum quantity"]</label><input name="Items[@i].MaximumQuantity" data-name="MaximumQuantity" value="@x.MaximumQuantity" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Tax rate"]</label><select name="Items[@i].TaxRateId" data-name="TaxRateId" class="form-select"><option value="">@Localizer["Customer default or no tax"]</option>@foreach(var t in Model.TaxRates){<option value="@t.Id" selected="@(t.Id==x.TaxRateId?"selected":null)">@t.Label</option>}</select></div><div class="col-md-2"><div class="form-check mt-4"><input name="Items[@i].AllowQuantityChange" data-name="AllowQuantityChange" value="true" checked="@x.AllowQuantityChange" type="checkbox" class="form-check-input"/><label class="form-check-label">@Localizer["Quantity editable"]</label></div><div class="form-check"><input name="Items[@i].IsDefaultSelected" data-name="IsDefaultSelected" value="true" checked="@x.IsDefaultSelected" type="checkbox" class="form-check-input"/><label class="form-check-label">@Localizer["Selected by default"]</label></div></div><div class="col-md-2"><label class="form-label">@Localizer["Option group code"]</label><input name="Items[@i].OptionGroupCode" data-name="OptionGroupCode" value="@x.OptionGroupCode" maxlength="50" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Option group name"]</label><input name="Items[@i].OptionGroupName" data-name="OptionGroupName" value="@x.OptionGroupName" maxlength="150" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Minimum selections"]</label><input name="Items[@i].GroupMinimumSelections" data-name="GroupMinimumSelections" value="@x.GroupMinimumSelections" type="number" min="0" max="100" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Maximum selections"]</label><input name="Items[@i].GroupMaximumSelections" data-name="GroupMaximumSelections" value="@x.GroupMaximumSelections" type="number" min="0" max="100" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Line notes"]</label><input name="Items[@i].Notes" data-name="Notes" value="@x.Notes" maxlength="500" class="form-control"/></div></div></div>}</div>
<button id="add-item" type="button" class="btn btn-outline-secondary mb-3">@Localizer["Add template item"]</button><div><button class="btn btn-primary">@Localizer["Create draft"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a></div></form>
<template id="item-template"><div class="card card-body mb-2 template-item"><div class="row g-2"><div class="col-md-1"><label class="form-label">@Localizer["Sequence"]</label><input data-name="Sequence" value="1" type="number" min="1" max="9999" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Section"]</label><input data-name="SectionTitle" value="General" maxlength="150" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Product"]</label><select data-name="ProductId" class="form-select" required><option value="">@Localizer["Select product"]</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Label</option>}</select></div><div class="col-md-3"><label class="form-label">@Localizer["Sales unit"]</label><select data-name="MeasurementUnitId" class="form-select" required><option value="">@Localizer["Select unit"]</option>@foreach(var u in Model.Units){<option value="@u.Id">@u.Label</option>}</select></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-danger remove-item">×</button></div><div class="col-md-2"><label class="form-label">@Localizer["Type"]</label><select data-name="ItemType" class="form-select"><option value="Required">@Localizer["Required"]</option><option value="Optional">@Localizer["Optional"]</option><option value="Alternative">@Localizer["Alternative"]</option></select></div><div class="col-md-2"><label class="form-label">@Localizer["Default quantity"]</label><input data-name="DefaultQuantity" value="1" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Minimum quantity"]</label><input data-name="MinimumQuantity" value="1" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Maximum quantity"]</label><input data-name="MaximumQuantity" value="1" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Tax rate"]</label><select data-name="TaxRateId" class="form-select"><option value="">@Localizer["Customer default or no tax"]</option>@foreach(var t in Model.TaxRates){<option value="@t.Id">@t.Label</option>}</select></div><div class="col-md-2"><div class="form-check mt-4"><input data-name="AllowQuantityChange" value="true" type="checkbox" class="form-check-input"/><label class="form-check-label">@Localizer["Quantity editable"]</label></div><div class="form-check"><input data-name="IsDefaultSelected" value="true" checked type="checkbox" class="form-check-input"/><label class="form-check-label">@Localizer["Selected by default"]</label></div></div><div class="col-md-2"><label class="form-label">@Localizer["Option group code"]</label><input data-name="OptionGroupCode" maxlength="50" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Option group name"]</label><input data-name="OptionGroupName" maxlength="150" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Minimum selections"]</label><input data-name="GroupMinimumSelections" value="0" type="number" min="0" max="100" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Maximum selections"]</label><input data-name="GroupMaximumSelections" value="0" type="number" min="0" max="100" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Line notes"]</label><input data-name="Notes" maxlength="500" class="form-control"/></div></div></div></template>
<script>document.addEventListener('DOMContentLoaded',()=>{const initialTypes=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows.Select(x=>(int)x.ItemType)));document.querySelectorAll('#items [data-name="ItemType"]').forEach((x,i)=>{if(i<initialTypes.length)x.value=String(initialTypes[i]);});const box=document.getElementById('items'),tpl=document.getElementById('item-template');function reindex(){[...box.querySelectorAll('.template-item')].forEach((r,i)=>r.querySelectorAll('[data-name]').forEach(x=>x.name=`Items[${i}].${x.dataset.name}`));}box.addEventListener('click',e=>{if(e.target.classList.contains('remove-item')){e.target.closest('.template-item').remove();reindex();}});document.getElementById('add-item').onclick=()=>{box.append(tpl.content.cloneNode(true));reindex();};reindex();});</script>
