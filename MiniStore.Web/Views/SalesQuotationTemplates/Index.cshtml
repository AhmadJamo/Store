@model List<MiniStore.Application.Dtos.Sales.SalesQuotationTemplateSummaryDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{ViewData["Title"]=Localizer["Quotation templates"];var canManage=(await Authorization.AuthorizeAsync(User,null,"Permission:SalesQuotationTemplates.Manage")).Succeeded;}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2>@Localizer["Quotation templates"]</h2><p class="text-muted">@Localizer["Build reusable, versioned offers with required products, options and alternative groups."]</p></div>@if(canManage){<a asp-action="Create" class="btn btn-primary">@Localizer["Create quotation template"]</a>}</div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-7"><label class="form-label">@Localizer["Search"]</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Code, name, category or tag"]"/></div><div class="col-md-3"><label class="form-label">@Localizer["Status"]</label><select name="status" class="form-select"><option value="">@Localizer["All statuses"]</option>@foreach(var s in Enum.GetValues<SalesQuotationTemplateStatus>()){<option value="@s" selected="@(ViewBag.Status?.ToString()==s.ToString()?"selected":null)">@Localizer[s.ToString()]</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">@Localizer["Apply"]</button></div></div></form>
@if(Model.Count==0){<div class="alert alert-info">@Localizer["No quotation templates found."]</div>}
<div class="row g-3">@foreach(var t in Model){<div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><strong>@t.Code v@t.Version</strong><span class="badge bg-secondary">@Localizer[t.Status.ToString()]</span></div><h5 class="mt-2">@t.Name @if(t.IsDefault){<span class="badge bg-primary">@Localizer["Default"]</span>}</h5>@if(t.Category is not null){<div class="text-muted">@t.Category</div>}<div class="small mt-2">@Localizer["Items"]: @t.ItemCount · @Localizer["Options"]: @t.OptionalItemCount · @Localizer["Validity days"]: @t.ValidityDays</div>@if(t.Tags is not null){<div class="small mt-2">@t.Tags</div>}</div><div class="card-footer bg-transparent"><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-primary w-100">@Localizer["View template"]</a></div></div></div>}</div>
