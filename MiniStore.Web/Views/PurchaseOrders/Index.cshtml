@model List<MiniStore.Application.DTOs.Purchases.PurchaseOrderDto>
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Purchase orders"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@Localizer["Purchase orders"]</h2></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="status" class="form-select"><option value="">@Localizer["All statuses"]</option>@foreach(var value in Enum.GetValues<PurchaseOrderStatus>()){<option value="@value" selected="@(ViewBag.Status?.ToString()==value.ToString())">@Localizer[value.ToString()]</option>}</select></div><div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Search"]" /></div><div class="col-md-2"><button class="btn btn-outline-primary">@Localizer["Filter"]</button></div></form>
@if(Model.Count==0){<div class="alert alert-info">@Localizer["No purchase orders found."]</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Localizer["Purchase order"]</th><th>@Localizer["Supplier"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Expected date"]</th><th>@Localizer["Status"]</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.OrderNumber</td><td>@item.SupplierName</td><td>@item.WarehouseName</td><td>@item.ExpectedDate</td><td>@Localizer[item.Status.ToString()]</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr>}</tbody></table></div>}
