@model MiniStore.Application.DTOs.Purchases.PurchaseOrderDto
@using MiniStore.Domain.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@inject MiniStore.Application.Services.SupplierCommunicationService SupplierCommunicationService
@{
    ViewData["Title"] = Model.OrderNumber;
    var rowVersion = Convert.ToBase64String(Model.RowVersion);
    var canApprove = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.Approve")).Succeeded;
    var canConfirm = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.Confirm")).Succeeded;
    var canCancel = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.Cancel")).Succeeded;
    var canClose = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.Close")).Succeeded;
    var canReopen = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.Reopen")).Succeeded;
    var canReceive = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:GoodsReceipts.Create")).Succeeded;
    var canCompleteService = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseServiceAcceptances.Create")).Succeeded;
    var canBill = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:VendorBills.Create")).Succeeded;
    var canCreateTemplate = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseTemplates.Create")).Succeeded;
    var canConfigureFulfillment = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.ConfigureFulfillment")).Succeeded;
    var canRecordDirectDelivery = (await AuthorizationService.AuthorizeAsync(User, null, "Permission:PurchaseOrders.RecordDirectDelivery")).Succeeded;
    var canPrepareSupplierEmail=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierCommunications.Prepare")).Succeeded;
    var canViewSupplierCommunication=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:SupplierCommunications.View")).Succeeded;
    var canRecordSupplierConfirmation=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseOrders.RecordSupplierConfirmation")).Succeeded;
    var communications=canViewSupplierCommunication?await SupplierCommunicationService.GetByDocumentAsync(SupplierCommunicationDocumentType.PurchaseOrder,Model.Id):new List<MiniStore.Application.DTOs.Purchases.SupplierCommunicationDto>();
    var numberSettings = await GeneralSettingsService.GetAsync();
    var remainingToReceive = Model.Lines.Sum(x => x.RemainingToReceive);
    var remainingToComplete = Model.Lines.Sum(x => x.RemainingToComplete);
    var remainingToDeliver = Model.Lines.Sum(x => x.RemainingToDeliver);
    var unsettledReceived = Model.Lines.Sum(x => x.UnsettledReceivedQuantity);
    var availableToBill = Model.Lines.Sum(x => x.AvailableToBill);
}

<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center">
    <h2 class="mb-0">@Model.OrderNumber <span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></h2>
    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a>
</div>

@if(Model.Status is PurchaseOrderStatus.Approved or PurchaseOrderStatus.Confirmed)
{
<div class="card card-body mt-3"><h3 class="h5">@Localizer["Supplier communication and delivery confirmation"]</h3><div class="d-flex flex-wrap gap-2">@if(canPrepareSupplierEmail){<form asp-controller="SupplierCommunications" asp-action="Prepare" method="post"><input type="hidden" name="DocumentType" value="PurchaseOrder"/><input type="hidden" name="DocumentId" value="@Model.Id"/><input type="hidden" name="SupplierId" value="@Model.SupplierId"/><input type="hidden" name="PreferredLanguage" value="ar-JO"/><button class="btn btn-outline-primary">@Localizer["Prepare Arabic PO email"]</button></form><form asp-controller="SupplierCommunications" asp-action="Prepare" method="post"><input type="hidden" name="DocumentType" value="PurchaseOrder"/><input type="hidden" name="DocumentId" value="@Model.Id"/><input type="hidden" name="SupplierId" value="@Model.SupplierId"/><input type="hidden" name="PreferredLanguage" value="en-US"/><button class="btn btn-outline-primary">@Localizer["Prepare English PO email"]</button></form>}</div>@if(canRecordSupplierConfirmation){<form asp-action="RecordSupplierConfirmation" method="post" class="border rounded p-3 mt-3"><input type="hidden" name="PurchaseOrderId" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rowVersion"/><div class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">@Localizer["Confirmed delivery date"]</label><input name="ConfirmedExpectedDate" type="date" value="@Model.ExpectedDate.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Supplier confirmation reference"]</label><input name="ConfirmationReference" maxlength="250" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Confirmation note"]</label><input name="Note" maxlength="1000" class="form-control"/></div><div class="col-md-1"><button class="btn btn-primary w-100">@Localizer["Record"]</button></div></div></form>}</div>
}
@if(communications.Count>0){<div class="card card-body mt-3"><h3 class="h5">@Localizer["Communication history"]</h3><div class="row g-2">@foreach(var communication in communications){<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@communication.SupplierName</strong><span class="badge bg-secondary">@Localizer[communication.Status.ToString()]</span></div><div class="small text-muted">@communication.PreferredLanguage · @communication.CreatedAtUtc.ToLocalTime()</div><a asp-controller="SupplierCommunications" asp-action="Details" asp-route-id="@communication.Id" class="btn btn-sm btn-outline-secondary mt-2">@Localizer["Open communication"]</a></div></div>}</div></div>}
@if(Model.SupplierConfirmations.Count>0){<div class="card card-body mt-3"><h3 class="h5">@Localizer["Supplier delivery confirmations"]</h3><div class="list-group list-group-flush">@foreach(var confirmation in Model.SupplierConfirmations){<div class="list-group-item px-0"><strong>@confirmation.ConfirmedExpectedDate</strong> <span class="text-muted">(@confirmation.PreviousExpectedDate → @confirmation.ConfirmedExpectedDate)</span><div>@confirmation.ConfirmationReference</div>@if(!string.IsNullOrWhiteSpace(confirmation.Note)){<small>@confirmation.Note</small>}</div>}</div></div>}
<div class="card card-body my-3">
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3"><strong>@Localizer["Supplier"]</strong><div>@Model.SupplierName</div></div>
        <div class="col-sm-6 col-lg-3"><strong>@Localizer["Warehouse"]</strong><div>@Model.WarehouseName</div></div>
        <div class="col-sm-6 col-lg-3"><strong>@Localizer["Order date"]</strong><div>@Model.OrderDate</div></div>
        <div class="col-sm-6 col-lg-3"><strong>@Localizer["Expected date"]</strong><div>@Model.ExpectedDate</div></div>
        <div class="col-sm-6 col-lg-3"><strong>@Localizer["Fulfillment route"]</strong><div>@Localizer[Model.FulfillmentRoute.ToString()]</div></div>
        @if (Model.Status is PurchaseOrderStatus.Confirmed or PurchaseOrderStatus.Closed) { <div class="col-12"><strong>@Localizer["Exchange rate"]</strong><div>1 @Model.CurrencyCode = @Model.ExchangeRate.ToString("0.############") @Model.CompanyCurrencyCode (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div></div> }
    </div>
    @if (Model.PurchaseAgreementId.HasValue) { <div class="mt-3"><a asp-controller="PurchaseAgreements" asp-action="Details" asp-route-id="@Model.PurchaseAgreementId">@Localizer["Created from purchase agreement"]</a></div> }
    @if (Model.FulfillmentRoute == PurchaseFulfillmentRoute.Dropship) { <div class="alert alert-info mt-3 mb-0"><strong>@Localizer["Direct delivery configured"]</strong><div>@Model.DropshipRecipientName · @Model.DropshipAddress</div>@if(!string.IsNullOrWhiteSpace(Model.DropshipCustomerReference)){<div>@Localizer["Customer reference"]: @Model.DropshipCustomerReference</div>}<small>@Localizer["Supplier delivery to the customer is recorded without internal warehouse stock movement."]</small></div> }
    @if (Model.Status == PurchaseOrderStatus.Closed)
    {
        <div class="alert alert-success mt-3 mb-0">
            <strong>@(Model.ClosureType == PurchaseOrderClosureType.Automatic ? Localizer["Completed and closed automatically"] : Localizer["Remaining quantity closed"])</strong>
            @if (Model.ClosedAtUtc.HasValue) { <span> — @Localizer["Closed at"] @Model.ClosedAtUtc.Value.ToLocalTime()</span> }
            @if (!string.IsNullOrWhiteSpace(Model.ClosureReason)) { <div class="mt-1">@Localizer["Closure reason"]: @Model.ClosureReason</div> }
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card h-100 card-body"><strong>@Localizer["Fulfillment status"]</strong><div class="mt-2"><span class="badge @(Model.Progress.IsFullyReceived ? "bg-success" : "bg-warning text-dark")">@(Model.Progress.IsFullyReceived ? Localizer["Fulfillment completed"] : Localizer["Fulfillment in progress"])</span></div><small class="text-muted mt-2">@Localizer["Remaining to receive"]: @remainingToReceive.ToQuantityDisplay(numberSettings) · @Localizer["Remaining to deliver"]: @remainingToDeliver.ToQuantityDisplay(numberSettings) · @Localizer["Remaining service completion"]: @remainingToComplete.ToQuantityDisplay(numberSettings)</small></div></div>
    <div class="col-md-4"><div class="card h-100 card-body"><strong>@Localizer["Settlement status"]</strong><div class="mt-2"><span class="badge @(Model.Progress.IsFullySettled ? "bg-success" : "bg-warning text-dark")">@(Model.Progress.IsFullySettled ? Localizer["Fully settled"] : Localizer["Settlement in progress"])</span></div><small class="text-muted mt-2">@Localizer["Received quantity awaiting bill or return"]: @unsettledReceived.ToQuantityDisplay(numberSettings)</small></div></div>
    <div class="col-md-4"><div class="card h-100 card-body"><strong>@Localizer["Order status"]</strong><div class="mt-2"><span class="badge bg-secondary">@Localizer[Model.Status.ToString()]</span></div><small class="text-muted mt-2">@(Model.Status == PurchaseOrderStatus.Closed ? Localizer["No further receipt is allowed"] : Localizer["Available actions depend on receiving and settlement progress"])</small></div></div>
</div>

<h3 class="h5">@Localizer["Order lines and progress"]</h3>
<div class="row g-3 mb-3">
@foreach (var line in Model.Lines)
{
    var lineComplete = line.RemainingToReceive <= 0 && line.RemainingToDeliver <= 0 && line.RemainingToComplete <= 0 && line.UnsettledReceivedQuantity <= 0;
    <div class="col-12 col-xl-6"><div class="card h-100 card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2"><div><strong>@line.ProductCode — @line.ProductName</strong><div class="text-muted">@line.UnitName · @Localizer[line.BillingPolicy.ToString()]</div></div><span class="badge @(lineComplete ? "bg-success" : "bg-warning text-dark")">@(lineComplete ? Localizer["Line completed"] : Localizer["In progress"])</span></div>
        <div class="row g-2 mt-2 small">
            <div class="col-6 col-md"><strong>@Localizer["Ordered"]</strong><div>@line.OrderedQuantity.ToQuantityDisplay(numberSettings)</div></div>
            <div class="col-6 col-md"><strong>@Localizer["Received"]</strong><div>@line.ReceivedQuantity.ToQuantityDisplay(numberSettings)</div></div>
            @if (line.BillingPolicy == PurchaseBillingPolicy.DirectDelivery) { <div class="col-6 col-md"><strong>@Localizer["Delivered to customer"]</strong><div>@line.DirectDeliveredQuantity.ToQuantityDisplay(numberSettings)</div></div> }
            @if (line.BillingPolicy == PurchaseBillingPolicy.ServiceCompletion) { <div class="col-6 col-md"><strong>@Localizer["Service completed"]</strong><div>@line.ServiceCompletedQuantity.ToQuantityDisplay(numberSettings)</div></div> }
            <div class="col-6 col-md"><strong>@Localizer["Returned"]</strong><div>@line.ReturnedQuantity.ToQuantityDisplay(numberSettings)</div></div>
            <div class="col-6 col-md"><strong>@Localizer["Billed"]</strong><div>@line.BilledQuantity.ToQuantityDisplay(numberSettings)</div></div>
            <div class="col-6 col-md"><strong>@Localizer["Awaiting settlement"]</strong><div>@line.UnsettledReceivedQuantity.ToQuantityDisplay(numberSettings)</div></div>
        </div>
        <div class="border-top mt-3 pt-2 small">@Localizer["Unit price"]: @line.UnitPrice.ToMoneyDisplay(numberSettings) @Model.CurrencyCode · @Localizer["Gross amount"]: @line.GrossAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode @if(Model.Status is PurchaseOrderStatus.Confirmed or PurchaseOrderStatus.Closed){<text> · @Localizer["Company currency equivalent"]: @((line.GrossAmount*Model.ExchangeRate).ToMoneyDisplay(numberSettings)) @Model.CompanyCurrencyCode</text>}</div>
        @if(line.DemandAllocations.Count>0){<div class="border-top mt-2 pt-2 small"><strong>@Localizer["Demand allocation"]</strong>@foreach(var allocation in line.DemandAllocations){<div>@Localizer[allocation.SourceType.ToString()] · @allocation.SourceReference · @allocation.AllocatedStockQuantity.ToQuantityDisplay(numberSettings)</div>}</div>}
        @if(line.DirectDeliveryEvents.Count>0){<div class="border-top mt-2 pt-2 small"><strong>@Localizer["Delivery evidence"]</strong>@foreach(var delivery in line.DirectDeliveryEvents){<div>@delivery.DeliveryDate · @delivery.Quantity.ToQuantityDisplay(numberSettings) · @delivery.ProofReference @if(!string.IsNullOrWhiteSpace(delivery.TrackingNumber)){<text> · @delivery.TrackingNumber</text>}</div>}</div>}
    </div></div>
}
</div>

<div class="d-flex flex-wrap gap-2 align-items-center">
@if (Model.Status == PurchaseOrderStatus.Draft && canApprove) { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><button class="btn btn-primary">@Localizer["Approve"]</button></form> }
else if (Model.Status is PurchaseOrderStatus.Approved or PurchaseOrderStatus.Confirmed or PurchaseOrderStatus.Closed) { <span class="badge bg-success">@Localizer["Approval completed"]</span> }
@if (Model.Status == PurchaseOrderStatus.Approved && canConfirm) { <form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><button class="btn btn-success">@Localizer["Confirm"]</button></form> }
else if (Model.Status is PurchaseOrderStatus.Confirmed or PurchaseOrderStatus.Closed) { <span class="badge bg-success">@Localizer["Confirmation completed"]</span> }
@if ((Model.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Approved) && canCancel) { <form asp-action="Cancel" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><input required name="reason" maxlength="1000" class="form-control w-auto" placeholder="@Localizer["Cancellation reason"]"/><button class="btn btn-outline-danger">@Localizer["Cancel"]</button></form> }
@if (Model.Status == PurchaseOrderStatus.Confirmed && Model.FulfillmentRoute == PurchaseFulfillmentRoute.Warehouse && remainingToReceive > 0 && canReceive) { <a asp-controller="GoodsReceipts" asp-action="Create" asp-route-purchaseOrderId="@Model.Id" class="btn btn-primary">@Localizer["Receive goods"]</a> }
else if (Model.Lines.Any(x => x.BillingPolicy == PurchaseBillingPolicy.ReceivedQuantity) && remainingToReceive <= 0) { <span class="badge bg-success">@Localizer["Receiving completed"]</span> }
@if (Model.Status == PurchaseOrderStatus.Confirmed && remainingToComplete > 0 && canCompleteService) { <a asp-controller="PurchaseServiceAcceptances" asp-action="Create" asp-route-purchaseOrderId="@Model.Id" class="btn btn-primary">@Localizer["Record service completion"]</a> }
else if (Model.Lines.Any(x => x.BillingPolicy == PurchaseBillingPolicy.ServiceCompletion) && remainingToComplete <= 0) { <span class="badge bg-success">@Localizer["Service completion finished"]</span> }
@if (Model.Status == PurchaseOrderStatus.Confirmed && availableToBill > 0 && canBill) { <a asp-controller="VendorBills" asp-action="Create" asp-route-purchaseOrderId="@Model.Id" class="btn btn-outline-primary">@Localizer["Create vendor bill"]</a> }
else if (Model.Progress.IsFullySettled && Model.Lines.Any(x => x.ReceivedQuantity > 0 || x.DirectDeliveredQuantity > 0)) { <span class="badge bg-success">@Localizer["Settlement completed"]</span> }
</div>

@if(Model.Status==PurchaseOrderStatus.Draft && Model.FulfillmentRoute==PurchaseFulfillmentRoute.Warehouse && canConfigureFulfillment)
{
<form asp-action="ConfigureDropship" method="post" class="card card-body mt-3"><input type="hidden" name="PurchaseOrderId" value="@Model.Id"/><input type="hidden" name="RowVersion" value="@rowVersion"/><h3 class="h5">@Localizer["Configure direct delivery"]</h3><p class="text-muted">@Localizer["Use this when the supplier will deliver directly to the customer without entering your warehouse."]</p><div class="row g-2"><div class="col-md-4"><label class="form-label">@Localizer["Recipient name"]</label><input name="RecipientName" required maxlength="200" class="form-control"/></div><div class="col-md-5"><label class="form-label">@Localizer["Delivery address"]</label><input name="Address" required maxlength="1000" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Customer reference"]</label><input name="CustomerReference" maxlength="100" class="form-control"/></div><div class="col-12"><button class="btn btn-outline-primary">@Localizer["Set as direct delivery"]</button></div></div></form>
}

@if(Model.Status==PurchaseOrderStatus.Confirmed && Model.FulfillmentRoute==PurchaseFulfillmentRoute.Dropship && remainingToDeliver>0 && canRecordDirectDelivery)
{
<div class="card card-body mt-3"><h3 class="h5">@Localizer["Record customer delivery"]</h3><p class="text-muted">@Localizer["Record supplier proof only after the customer receives the quantity. This does not add warehouse stock."]</p>@foreach(var line in Model.Lines.Where(x=>x.RemainingToDeliver>0)){<form asp-action="RecordDirectDelivery" method="post" class="border rounded p-3 mb-2"><input type="hidden" name="PurchaseOrderId" value="@Model.Id"/><input type="hidden" name="PurchaseOrderLineId" value="@line.Id"/><input type="hidden" name="RowVersion" value="@rowVersion"/><strong>@line.ProductCode — @line.ProductName</strong><div class="row g-2 mt-1"><div class="col-sm-6 col-lg-2"><label class="form-label">@Localizer["Quantity"]</label><input name="Quantity" type="number" min="0.000001" max="@line.RemainingToDeliver" step="0.000001" required class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">@Localizer["Delivery date"]</label><input name="DeliveryDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required class="form-control"/></div><div class="col-lg-3"><label class="form-label">@Localizer["Proof reference"]</label><input name="ProofReference" required maxlength="250" class="form-control"/></div><div class="col-lg-2"><label class="form-label">@Localizer["Carrier"]</label><input name="Carrier" maxlength="150" class="form-control"/></div><div class="col-lg-2"><label class="form-label">@Localizer["Tracking number"]</label><input name="TrackingNumber" maxlength="150" class="form-control"/></div><div class="col-lg-1 d-flex align-items-end"><button class="btn btn-primary w-100">@Localizer["Record"]</button></div></div></form>}</div>
}
else if(Model.FulfillmentRoute==PurchaseFulfillmentRoute.Dropship && remainingToDeliver<=0){<div class="alert alert-success mt-3">@Localizer["Customer delivery completed"]</div>}

@if (Model.Progress.CanCloseRemaining && canClose)
{
    <form asp-action="CloseRemaining" method="post" class="card card-body mt-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><h3 class="h5">@Localizer["Close remaining quantity"]</h3><p class="text-muted">@Localizer["Use this when no more quantities will be received. A reason is required and the action remains in the order history."]</p><div class="row g-2 align-items-end"><div class="col-md-9"><label class="form-label">@Localizer["Remaining quantity closure reason"]</label><textarea name="reason" required maxlength="1000" class="form-control" rows="2"></textarea></div><div class="col-md-3"><button class="btn btn-warning w-100">@Localizer["Close remaining"]</button></div></div></form>
}
@if (Model.Progress.CanReopen && canReopen)
{
    <form asp-action="Reopen" method="post" class="card card-body mt-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="rowVersion" value="@rowVersion"/><h3 class="h5">@Localizer["Reopen purchase order"]</h3><p class="text-muted">@Localizer["Reopening restores the confirmed state so the remaining quantity can be received. A reason is required."]</p><div class="row g-2 align-items-end"><div class="col-md-9"><label class="form-label">@Localizer["Reopen reason"]</label><textarea name="reason" required maxlength="1000" class="form-control" rows="2"></textarea></div><div class="col-md-3"><button class="btn btn-outline-warning w-100">@Localizer["Reopen"]</button></div></div></form>
}

@if (canCreateTemplate)
{
    <form asp-controller="PurchaseTemplates" asp-action="CreateFromOrder" method="post" class="card card-body mt-3"><input type="hidden" name="PurchaseOrderId" value="@Model.Id"/><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">@Localizer["Template name"]</label><input name="Name" required maxlength="150" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Needed in days"]</label><input name="NeededInDays" type="number" min="0" max="3650" value="7" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Priority"]</label><select name="Priority" class="form-select"><option value="2">@Localizer["Normal"]</option><option value="1">@Localizer["Low"]</option><option value="3">@Localizer["High"]</option><option value="4">@Localizer["Urgent"]</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary">@Localizer["Save as purchase template"]</button></div></div></form>
}

@if (Model.History.Count > 0)
{
    <div class="card card-body mt-3"><h3 class="h5">@Localizer["Closure history"]</h3><div class="list-group list-group-flush">
    @foreach (var entry in Model.History)
    {
        <div class="list-group-item px-0"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@Localizer[entry.Action.ToString()]</strong><span class="text-muted">@entry.CreatedAtUtc.ToLocalTime()</span></div><div class="small">@Localizer[entry.FromStatus.ToString()] → @Localizer[entry.ToStatus.ToString()] · @entry.UserId</div>@if (!string.IsNullOrWhiteSpace(entry.Reason)) { <div class="mt-1">@entry.Reason</div> }</div>
    }
    </div></div>
}
