@model MiniStore.Application.DTOs.Purchases.SupplierPortalPageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@using MiniStore.Domain.Entities
@{ViewData["Title"]=$"{Localizer["Supplier portal"]} — {Model.DocumentNumber}";var idempotency=Guid.NewGuid().ToString("N");}
<div class="d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><h2>@Localizer["Supplier portal"]</h2><div class="text-muted">@Model.SupplierName</div></div><div><strong>@Model.DocumentNumber</strong><div>@Localizer[Model.DocumentType.ToString()]</div></div></div>
<div class="card card-body my-3"><div class="row g-2">@if(Model.ResponseDeadline.HasValue){<div class="col-md-4"><strong>@Localizer["Supplier response deadline"]</strong><div>@Model.ResponseDeadline</div></div>}@if(Model.ExpectedDate.HasValue){<div class="col-md-4"><strong>@Localizer["Expected delivery date"]</strong><div>@Model.ExpectedDate</div></div>}<div class="col-md-4"><strong>@Localizer["Currency"]</strong><div>@Model.CurrencyCode</div></div></div></div>
<h3 class="h5">@Localizer["Document lines"]</h3><div class="row g-3">@foreach(var line in Model.Lines){<div class="col-12 col-lg-6"><div class="card card-body h-100"><strong>@line.ProductCode — @line.ProductName</strong><div>@Localizer["Quantity"]: @line.Quantity.ToString("0.######") @line.UnitName</div>@if(line.UnitPrice.HasValue){<div>@Localizer["Unit price"]: @line.UnitPrice.Value.ToString("0.######") @Model.CurrencyCode</div>}</div></div>}</div>
@if(Model.DocumentType==SupplierExternalDocumentType.Rfq&&Model.CanSubmitQuotation){<form asp-action="Quotation" method="post" class="card card-body mt-3"><input type="hidden" name="Token" value="@Model.Token"/><input type="hidden" name="IdempotencyKey" value="@idempotency"/><h3 class="h5">@Localizer["Submit supplier quotation"]</h3><div class="row g-2"><div class="col-md-3"><label class="form-label">@Localizer["Currency"]</label><input name="CurrencyCode" value="@Model.CurrencyCode" maxlength="3" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Supplier reference"]</label><input name="SupplierReference" maxlength="100" class="form-control"/></div><div class="col-md-3"><label class="form-label">@Localizer["Quotation date"]</label><input name="QuotationDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Valid until"]</label><input name="ValidUntilDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today.AddDays(14)).ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Lead time days"]</label><input name="LeadTimeDays" type="number" min="0" max="3650" class="form-control" required/></div><div class="col-md-9"><label class="form-label">@Localizer["Payment terms"]</label><input name="PaymentTerms" maxlength="500" class="form-control"/></div>@for(var i=0;i<Model.Lines.Count;i++){<div class="col-12"><div class="border rounded p-3"><input type="hidden" name="Lines[@i].DocumentLineId" value="@Model.Lines[i].Id"/><strong>@Model.Lines[i].ProductCode — @Model.Lines[i].ProductName</strong><div class="row g-2 mt-1"><div class="col-sm-6 col-lg-3"><label class="form-label">@Localizer["Quoted quantity"]</label><input name="Lines[@i].Quantity" type="number" min="0.000001" step="0.000001" value="@Model.Lines[i].Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required/></div><div class="col-sm-6 col-lg-3"><label class="form-label">@Localizer["Unit price"]</label><input name="Lines[@i].UnitPrice" type="number" min="0" step="0.000001" class="form-control" required/></div><div class="col-sm-6 col-lg-3"><label class="form-label">@Localizer["Discount percent"]</label><input name="Lines[@i].DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control"/></div><div class="col-sm-6 col-lg-3"><label class="form-label">@Localizer["Tax percent"]</label><input name="Lines[@i].TaxPercent" type="number" min="0" max="100" step="0.01" class="form-control"/></div></div></div></div>}<div class="col-12"><label class="form-label">@Localizer["Notes"]</label><textarea name="Notes" maxlength="1000" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">@Localizer["Submit quotation"]</button></div></div></form>}else if(Model.DocumentType==SupplierExternalDocumentType.Rfq){<div class="alert alert-success mt-3">@Localizer["Quotation submission completed"]</div>}
@if(Model.DocumentType==SupplierExternalDocumentType.PurchaseOrder){@if(Model.CanConfirmOrder){<form asp-action="ConfirmOrder" method="post" class="card card-body mt-3"><input type="hidden" name="Token" value="@Model.Token"/><input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")"/><h3 class="h5">@Localizer["Confirm purchase order delivery date"]</h3><div class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">@Localizer["Confirmed delivery date"]</label><input name="ConfirmedExpectedDate" type="date" value="@Model.ExpectedDate?.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Confirmation reference"]</label><input name="ConfirmationReference" maxlength="250" class="form-control" required/></div><div class="col-md-4"><label class="form-label">@Localizer["Note"]</label><input name="Note" maxlength="1000" class="form-control"/></div><div class="col-md-1"><button class="btn btn-primary w-100">@Localizer["Confirm"]</button></div></div></form>}@if(Model.CanSubmitDeliveryNotice){<form asp-action="DeliveryNotice" method="post" class="card card-body mt-3"><input type="hidden" name="Token" value="@Model.Token"/><input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")"/><h3 class="h5">@Localizer["Submit delivery notice"]</h3><div class="row g-2 align-items-end"><div class="col-md-2"><label class="form-label">@Localizer["Delivery date"]</label><input name="DeliveryDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-3"><label class="form-label">@Localizer["Delivery reference"]</label><input name="Reference" maxlength="250" class="form-control" required/></div><div class="col-md-2"><label class="form-label">@Localizer["Carrier"]</label><input name="Carrier" maxlength="150" class="form-control"/></div><div class="col-md-2"><label class="form-label">@Localizer["Tracking number"]</label><input name="TrackingNumber" maxlength="150" class="form-control"/></div><div class="col-md-3"><button class="btn btn-outline-primary w-100">@Localizer["Submit for internal review"]</button></div></div></form>}}
