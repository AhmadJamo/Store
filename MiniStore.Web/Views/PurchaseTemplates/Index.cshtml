@model List<MiniStore.Application.DTOs.Purchases.PurchaseTemplateDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ViewData["Title"]=Localizer["Purchase templates"];var canGenerate=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseTemplates.Generate")).Succeeded;var canManage=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseTemplates.Manage")).Succeeded;}
<h2>@Localizer["Purchase templates"]</h2>@foreach(var x in Model){<div class="card mb-3"><div class="card-header d-flex justify-content-between"><strong>@x.TemplateNumber — @x.Name</strong><span>@(x.IsActive?Localizer["Active"]:Localizer["Inactive"])</span></div><div class="card-body"><div>@Localizer["Supplier"]: @x.SupplierName — @Localizer["Warehouse"]: @x.WarehouseName — @Localizer["Generated requests"]: @x.GenerationCount</div><ul>@foreach(var line in x.Lines){<li>@line.Product — @line.Quantity @line.UnitName</li>}</ul>@if(x.IsActive&&canGenerate){<form asp-action="Generate" method="post" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-primary btn-sm">@Localizer["Generate purchase request draft"]</button></form>}@if(canManage){<form asp-action="SetActive" method="post" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="active" value="@(!x.IsActive)"/><button class="btn btn-outline-secondary btn-sm">@(x.IsActive?Localizer["Deactivate"]:Localizer["Activate"])</button></form>}</div></div>}
