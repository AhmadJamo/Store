@using System.Globalization
@{ Layout="_PublicLayout"; var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"]=ar?"نظام إدارة أعمال متكامل":"Modern ERP"; }
<section class="hero"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="badge text-bg-success mb-3">SaaS ERP + POS</span><h1 class="display-3 fw-bold">@(ar ? "أدر شركتك من مكان واحد" : "Run your entire business from one place")</h1><p class="lead muted my-4">@(ar ? "المحاسبة والمبيعات والمشتريات والمخزون ونقاط البيع ضمن منصة آمنة تدعم الفروع والمستودعات." : "Accounting, sales, purchasing, inventory and POS in one secure platform built for branches and warehouses.")</p><div class="d-flex gap-3"><a class="btn btn-accent btn-lg" asp-controller="Account" asp-action="Register">@(ar?"ابدأ التجربة":"Start free trial")</a><a class="btn btn-outline-light btn-lg" href="#features">@(ar?"اكتشف المزايا":"Explore features")</a></div></div><div class="col-lg-5"><div class="glass p-4"><div class="d-flex justify-content-between"><strong>@(ar?"ملخص الأعمال":"Business overview")</strong><span class="accent">● Live</span></div><hr><div class="row g-3 text-center"><div class="col-6"><div class="glass p-3"><div class="muted">@(ar?"المبيعات":"Sales")</div><h3>24.8K</h3></div></div><div class="col-6"><div class="glass p-3"><div class="muted">@(ar?"المخزون":"Inventory")</div><h3>98.4%</h3></div></div></div></div></div></div></div></section>
<section id="features" class="container pb-5"><div class="row g-4">@foreach(var item in (ar?new[]{("محاسبة مترابطة","قيود تلقائية وشجرة حسابات تفصيلية."),("مخزون احترافي","مواقع ورفوف وتحويلات وتزويد."),("نقاط بيع مرنة","واجهات للمطاعم والمقاهي والمتاجر.")}:new[]{("Connected accounting","Automated journals and a detailed chart of accounts."),("Professional inventory","Locations, racks, transfers and replenishment."),("Flexible POS","Experiences for restaurants, cafés and retail.")})){<div class="col-md-4"><div class="glass p-4 h-100"><h3>@item.Item1</h3><p class="muted">@item.Item2</p></div></div>}</div></section>
