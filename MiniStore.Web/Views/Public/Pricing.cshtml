@model IReadOnlyList<MiniStore.Application.Saas.PlanCardDto>
@using System.Globalization
@{ Layout="_PublicLayout"; var ar=CultureInfo.CurrentUICulture.Name.StartsWith("ar"); ViewData["Title"]=ar?"الخطط والأسعار":"Plans & Pricing"; }
<div class="container py-5"><div class="text-center mb-5"><h1 class="display-5 fw-bold">@(ar?"خطة تناسب حجم عملك":"A plan that grows with your business")</h1><p class="muted">@(ar?"جميع الأسعار والحدود واضحة قبل الاشتراك.":"Clear pricing and limits before you subscribe.")</p></div><div class="row g-4 justify-content-center">@foreach(var p in Model){<div class="col-lg-4"><div class="glass plan p-4 h-100"><h2>@(ar?p.NameArabic:p.NameEnglish)</h2><p class="muted">@(ar?p.DescriptionArabic:p.DescriptionEnglish)</p><div class="display-5 fw-bold my-4">@p.MonthlyPrice <small class="fs-6">@p.Currency / @(ar?"شهر":"month")</small></div><ul class="list-unstyled">@foreach(var l in p.Limits){<li class="py-2 border-bottom border-secondary">✓ @l.Key: @(l.Value?.ToString() ?? (ar?"غير محدود":"Unlimited"))</li>}</ul><a class="btn btn-accent w-100 mt-3" asp-controller="Account" asp-action="Register" asp-route-planId="@p.Id">@(ar?"ابدأ الآن":"Get started")</a></div></div>}</div></div>
