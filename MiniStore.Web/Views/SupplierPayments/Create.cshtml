@model MiniStore.Application.DTOs.Purchases.SupplierPaymentCreatePageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Create supplier payment"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>@Localizer["Create supplier payment"]</h2><div class="text-muted">@Model.SupplierName — @Model.CurrencyCode</div></div><a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()<input type="hidden" asp-for="Form.SourceVendorBillId" name="SourceVendorBillId" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="card card-body mb-3"><div class="row g-3">
        <div class="col-md-4"><label class="form-label">@Localizer["Payment date"]</label><input type="date" asp-for="Form.PaymentDate" name="PaymentDate" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">@Localizer["Payment method"]</label><select asp-for="Form.PaymentMethodId" name="PaymentMethodId" class="form-select"><option value="">@Localizer["Select payment method"]</option>@foreach(var method in Model.PaymentMethods){<option value="@method.Id">@method.Name</option>}</select></div>
        <div class="col-md-4"><label class="form-label">@Localizer["External reference"]</label><input asp-for="Form.ExternalReference" name="ExternalReference" class="form-control" /></div>
        <div class="col-12"><label class="form-label">@Localizer["Notes"]</label><textarea asp-for="Form.Notes" name="Notes" class="form-control"></textarea></div>
    </div></div>
    @if(Model.OpenBills.Count == 0){<div class="alert alert-info">@Localizer["There are no outstanding vendor bills for this supplier and currency."]</div>}
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Localizer["Bill number"]</th><th>@Localizer["Supplier invoice number"]</th><th>@Localizer["Bill date"]</th><th>@Localizer["Bill total"]</th><th>@Localizer["Paid amount"]</th><th>@Localizer["Outstanding balance"]</th><th>@Localizer["Payment allocation"]</th></tr></thead><tbody>
        @for(var i=0;i<Model.OpenBills.Count;i++){var bill=Model.OpenBills[i]; var existing=Model.Form.Lines.FirstOrDefault(x=>x.VendorBillId==bill.VendorBillId);<tr><td>@bill.BillNumber<input type="hidden" name="Lines[@i].VendorBillId" value="@bill.VendorBillId" /></td><td>@bill.SupplierInvoiceNumber</td><td>@bill.BillDate</td><td>@bill.TotalAmount @Model.CurrencyCode</td><td>@bill.PaidAmount @Model.CurrencyCode</td><td>@bill.OutstandingAmount @Model.CurrencyCode</td><td><input type="number" name="Lines[@i].Amount" value="@(existing?.Amount ?? 0)" min="0" max="@bill.OutstandingAmount" step="0.01" class="form-control" /></td></tr>}
        </tbody></table></div><button class="btn btn-primary">@Localizer["Post supplier payment"]</button>
    }
</form>
