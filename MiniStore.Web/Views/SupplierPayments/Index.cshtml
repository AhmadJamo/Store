@model List<MiniStore.Application.DTOs.Purchases.SupplierPaymentDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@{ ViewData["Title"] = Localizer["Supplier payments"]; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@Localizer["Supplier payments"]</h2></div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="@Localizer["Search by payment number or external reference"]" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">@Localizer["Search"]</button></div>
</form>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>@Localizer["Payment number"]</th><th>@Localizer["Supplier"]</th><th>@Localizer["Payment date"]</th><th>@Localizer["Payment method"]</th><th>@Localizer["External reference"]</th><th>@Localizer["Total"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
    <tbody>@foreach(var payment in Model){<tr><td>@payment.PaymentNumber</td><td>@payment.SupplierName</td><td>@payment.PaymentDate</td><td>@payment.PaymentMethodName</td><td>@payment.ExternalReference</td><td>@payment.TotalAmount @payment.CurrencyCode</td><td>@Localizer[payment.Status.ToString()]</td><td><a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td></tr>}</tbody>
</table></div>
