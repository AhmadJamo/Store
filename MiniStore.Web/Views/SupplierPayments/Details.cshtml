@model MiniStore.Application.DTOs.Purchases.SupplierPaymentDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<MiniStore.Web.SharedResource> Localizer
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewData["Title"] = Model.PaymentNumber; var numberSettings = await GeneralSettingsService.GetAsync(); var canReverse=(await AuthorizationService.AuthorizeAsync(User,null,"Permission:PurchaseDocumentReversals.Create")).Succeeded; var reversal=ViewBag.Reversal as MiniStore.Application.DTOs.Purchases.PurchaseDocumentReversalDto; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@Model.PaymentNumber <span class="badge bg-success">@Localizer[Model.Status.ToString()]</span></h2><div class="d-flex gap-2">@if(Model.Status==MiniStore.Domain.Entities.SupplierPaymentStatus.Posted&&reversal is null&&canReverse){<a asp-controller="PurchaseDocumentReversals" asp-action="Create" asp-route-documentType="SupplierPayment" asp-route-originalDocumentId="@Model.Id" class="btn btn-outline-danger">@Localizer["Reverse document"]</a>}else if(reversal is not null){<a asp-controller="PurchaseDocumentReversals" asp-action="Details" asp-route-id="@reversal.Id" class="btn btn-outline-success">@Localizer["Reversed"]</a>}<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back"]</a></div></div>
<div class="card card-body mb-3"><div class="row g-2">
    <div class="col-md-4"><strong>@Localizer["Supplier"]:</strong> @Model.SupplierName</div><div class="col-md-4"><strong>@Localizer["Payment date"]:</strong> @Model.PaymentDate</div><div class="col-md-4"><strong>@Localizer["Payment method"]:</strong> @Model.PaymentMethodName</div>
    <div class="col-md-4"><strong>@Localizer["External reference"]:</strong> @Model.ExternalReference</div><div class="col-md-8"><strong>@Localizer["Exchange rate"]:</strong> 1 @Model.CurrencyCode = @Model.ExchangeRate.ToString("0.############") @Model.CompanyCurrencyCode (@Model.ExchangeRateDate · @Model.ExchangeRateSource)</div><div class="col-md-8"><strong>@Localizer["Notes"]:</strong> @Model.Notes</div>
</div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>@Localizer["Bill number"]</th><th>@Localizer["Supplier invoice number"]</th><th>@Localizer["Allocated amount"]</th></tr></thead>
<tbody>@foreach(var line in Model.Lines){<tr><td><a asp-controller="VendorBills" asp-action="Details" asp-route-id="@line.VendorBillId">@line.BillNumber</a></td><td>@line.SupplierInvoiceNumber</td><td>@line.Amount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td></tr>}</tbody>
<tfoot><tr class="fw-bold"><td colspan="2">@Localizer["Total"]</td><td>@Model.TotalAmount.ToMoneyDisplay(numberSettings) @Model.CurrencyCode</td></tr></tfoot></table></div>
<div class="alert alert-info"><strong>@Localizer["Company currency equivalent"]:</strong> @Model.CompanyCurrencyAmount.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode · <strong>@Localizer["Payable carrying amount"]:</strong> @Model.PayableCarryingAmount.ToMoneyDisplay(numberSettings) @Model.CompanyCurrencyCode</div>
