@using MiniStore.Domain.Entities
@using MiniStore.Application.DTOs.StockTransfers

@model List<StockTransferDto>

@{
    ViewData["Title"] = "Stock Transfers";

    var selectedStatus =
        ViewBag.Status as StockTransferStatus?;

    var search =
        ViewBag.Search as string;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Stock Transfers</h2>
            <p class="text-muted mb-0">
                Manage warehouse-to-warehouse stock transfers.
            </p>
        </div>

        @if (User.HasClaim("Permission", "StockTransfers.Create"))
        {
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                New Transfer
            </a>
        }
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">
                        <label for="search"
                               class="form-label">
                            Search
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Transfer number or reference..." />
                    </div>

                    <div class="col-md-4">
                        <label for="status"
                               class="form-label">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="">
                                All statuses
                            </option>

                            @foreach (var status in Enum.GetValues<StockTransferStatus>())
                            {
                                if (selectedStatus == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Transfers Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">

                <strong>
                    Stock Transfers
                </strong>

                <span class="text-muted">
                    @Model.Count transfer(s)
                </span>

            </div>
        </div>

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No stock transfers found
                    </h5>

                    <p class="text-muted mb-0">
                        There are no transfers matching the current filters.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Transfer #
                                </th>

                                <th>
                                    From Warehouse
                                </th>

                                <th>
                                    To Warehouse
                                </th>

                                <th class="text-center">
                                    Items
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created At
                                </th>

                                <th>
                                    Reference
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var transfer in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @transfer.TransferNumber
                                        </strong>
                                    </td>

                                    <td>
                                        @transfer.FromWarehouseName
                                    </td>

                                    <td>
                                        @transfer.ToWarehouseName
                                    </td>

                                    <td class="text-center">
                                        @transfer.ItemsCount
                                    </td>

                                    <td>

                                        @switch (transfer.Status)
                                        {
                                            case StockTransferStatus.Draft:
                                                <span class="badge bg-secondary">
                                                    Draft
                                                </span>
                                                break;

                                            case StockTransferStatus.Submitted:
                                                <span class="badge bg-warning text-dark">
                                                    Submitted
                                                </span>
                                                break;

                                            case StockTransferStatus.Approved:
                                                <span class="badge bg-info text-dark">
                                                    Approved
                                                </span>
                                                break;

                                            case StockTransferStatus.Rejected:
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                                break;

                                            case StockTransferStatus.Posted:
                                                <span class="badge bg-success">
                                                    Posted
                                                </span>
                                                break;

                                            case StockTransferStatus.Cancelled:
                                                <span class="badge bg-dark">
                                                    Cancelled
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td>
                                        @transfer.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(transfer.Reference))
                                        {
                                            @transfer.Reference
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@transfer.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>
                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>