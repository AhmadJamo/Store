@using MiniStore.Application.DTOs.StockTransfers
@using MiniStore.Domain.Entities

@model StockTransferDetailsDto

@{
    ViewData["Title"] = "Stock Transfer Details";

    string GetStatusClass(StockTransferStatus status)
    {
        return status switch
        {
            StockTransferStatus.Draft => "bg-secondary",
            StockTransferStatus.Submitted => "bg-warning text-dark",
            StockTransferStatus.Approved => "bg-info text-dark",
            StockTransferStatus.Rejected => "bg-danger",
            StockTransferStatus.Posted => "bg-success",
            StockTransferStatus.Cancelled => "bg-dark",
            _ => "bg-secondary"
        };
    }

    string GetStatusText(StockTransferStatus status)
    {
        return status switch
        {
            StockTransferStatus.Draft => "Draft",
            StockTransferStatus.Submitted => "Submitted",
            StockTransferStatus.Approved => "Approved",
            StockTransferStatus.Rejected => "Rejected",
            StockTransferStatus.Posted => "Posted",
            StockTransferStatus.Cancelled => "Cancelled",
            _ => status.ToString()
        };
    }

    string GetActionText(StockTransferHistoryAction action)
    {
        return action switch
        {
            StockTransferHistoryAction.Submitted => "Submitted",
            StockTransferHistoryAction.Approved => "Approved",
            StockTransferHistoryAction.Rejected => "Rejected",
            StockTransferHistoryAction.ReturnedToDraft => "Returned to Draft",
            StockTransferHistoryAction.Posted => "Posted",
            StockTransferHistoryAction.Cancelled => "Cancelled",
            _ => action.ToString()
        };
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">
            Stock Transfer
        </h2>

        <div class="text-muted">
            @Model.TransferNumber
        </div>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

</div>


<!-- Status -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="row align-items-center">

            <div class="col-md-8">

                <div class="text-muted small mb-1">
                    Current Status
                </div>

                <span class="badge @GetStatusClass(Model.Status) fs-6">
                    @GetStatusText(Model.Status)
                </span>

            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                @if (Model.Status == StockTransferStatus.Draft &&
                     User.HasClaim("Permission", "StockTransfers.Submit"))
                {
                    <form asp-action="Submit"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-primary">
                            Submit
                        </button>

                    </form>
                }

                @if (Model.Status == StockTransferStatus.Submitted)
                {
                    @if (User.HasClaim("Permission", "StockTransfers.Approve"))
                    {
                        <form asp-action="Approve"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success">
                                Approve
                            </button>

                        </form>
                    }

                    @if (User.HasClaim("Permission", "StockTransfers.Reject"))
                    {
                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectModal">
                            Reject
                        </button>
                    }
                }

                @if (Model.Status == StockTransferStatus.Rejected &&
                     User.HasClaim("Permission", "StockTransfers.Edit"))
                {
                    <form asp-action="ReturnToDraft"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-warning">
                            Return to Draft
                        </button>

                    </form>
                }

                @if (Model.Status == StockTransferStatus.Approved &&
                     User.HasClaim("Permission", "StockTransfers.Post"))
                {
                    <form asp-action="Post"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success">
                            Post
                        </button>

                    </form>
                }

                @if (Model.Status == StockTransferStatus.Posted &&
                     User.HasClaim("Permission", "StockTransfers.Cancel"))
                {
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelModal">
                        Cancel
                    </button>
                }

            </div>

        </div>

    </div>

</div>


<!-- Transfer Information -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Transfer Information</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    Transfer Number
                </label>

                <div class="fw-semibold">
                    @Model.TransferNumber
                </div>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    Created At
                </label>

                <div>
                    @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    From Warehouse
                </label>

                <div class="fw-semibold">
                    @Model.FromWarehouseName
                </div>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    To Warehouse
                </label>

                <div class="fw-semibold">
                    @Model.ToWarehouseName
                </div>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    Reference
                </label>

                <div>
                    @(string.IsNullOrWhiteSpace(Model.Reference)
                        ? "-"
                        : Model.Reference)
                </div>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label text-muted">
                    Created By
                </label>

                <div>
                    @Model.CreatedByUserId
                </div>

            </div>

            <div class="col-12 mb-3">

                <label class="form-label text-muted">
                    Notes
                </label>

                <div class="border rounded p-3 bg-light">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "-"
                        : Model.Notes)
                </div>

            </div>

        </div>

    </div>

</div>


<!-- Rejection Information -->
@if (Model.Status == StockTransferStatus.Rejected ||
     !string.IsNullOrWhiteSpace(Model.RejectionReason))
{
    <div class="alert alert-danger">

        <h6 class="alert-heading">
            Rejection Information
        </h6>

        <div>
            <strong>Reason:</strong>
            @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                ? "-"
                : Model.RejectionReason)
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.RejectedByUserId))
        {
            <div class="mt-1">
                <strong>Rejected By:</strong>
                @Model.RejectedByUserId
            </div>
        }

        @if (Model.RejectedAt.HasValue)
        {
            <div class="mt-1">
                <strong>Rejected At:</strong>
                @Model.RejectedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </div>
        }

    </div>
}


<!-- Cancellation Information -->
@if (Model.Status == StockTransferStatus.Cancelled ||
     !string.IsNullOrWhiteSpace(Model.CancellationReason))
{
    <div class="alert alert-dark">

        <h6 class="alert-heading">
            Cancellation Information
        </h6>

        <div>
            <strong>Reason:</strong>
            @(string.IsNullOrWhiteSpace(Model.CancellationReason)
                ? "-"
                : Model.CancellationReason)
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.CancelledByUserId))
        {
            <div class="mt-1">
                <strong>Cancelled By:</strong>
                @Model.CancelledByUserId
            </div>
        }

        @if (Model.CancelledAt.HasValue)
        {
            <div class="mt-1">
                <strong>Cancelled At:</strong>
                @Model.CancelledAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </div>
        }

    </div>
}


<!-- Items -->

<div class="card shadow-sm mb-4">

    <div class="card-header d-flex justify-content-between">

        <strong>Transfer Items</strong>

        <span class="badge bg-secondary">
            @Model.Items.Count item(s)
        </span>

    </div>

    <div class="card-body p-0">

        @if (!Model.Items.Any())
        {
            <div class="p-4 text-muted text-center">
                No items found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Barcode</th>
                            <th class="text-end">Quantity</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            var itemNumber = 1;
                        }

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @itemNumber
                                </td>

                                <td>
                                    <strong>
                                        @item.ProductName
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Barcode)
                                        ? "-"
                                        : item.Barcode)
                                </td>

                                <td class="text-end">
                                    @item.Quantity.ToString("N3")
                                </td>

                            </tr>

                            itemNumber++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Workflow Summary -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Workflow Summary</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 mb-3">

                <div class="text-muted small">
                    Submitted By
                </div>

                <div>
                    @(Model.SubmittedByUserId ?? "-")
                </div>

                @if (Model.SubmittedAt.HasValue)
                {
                    <div class="small text-muted">
                        @Model.SubmittedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                }

            </div>

            <div class="col-md-4 mb-3">

                <div class="text-muted small">
                    Approved By
                </div>

                <div>
                    @(Model.ApprovedByUserId ?? "-")
                </div>

                @if (Model.ApprovedAt.HasValue)
                {
                    <div class="small text-muted">
                        @Model.ApprovedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                }

            </div>

            <div class="col-md-4 mb-3">

                <div class="text-muted small">
                    Posted By
                </div>

                <div>
                    @(Model.PostedByUserId ?? "-")
                </div>

                @if (Model.PostedAt.HasValue)
                {
                    <div class="small text-muted">
                        @Model.PostedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- Workflow History -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Workflow History</strong>
    </div>

    <div class="card-body p-0">

        @if (!Model.History.Any())
        {
            <div class="p-4 text-muted text-center">
                No workflow history found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>From</th>
                            <th>To</th>
                            <th>User</th>
                            <th>Reason</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var history in Model.History.OrderBy(x => x.CreatedAt))
                        {
                            <tr>

                                <td>
                                    @history.CreatedAt
                                    .ToLocalTime()
                                    .ToString("yyyy-MM-dd HH:mm")
                                </td>

                                <td>
                                    <strong>
                                        @GetActionText(history.Action)
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @GetStatusText(history.FromStatus)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @GetStatusClass(history.ToStatus)">
                                        @GetStatusText(history.ToStatus)
                                    </span>
                                </td>

                                <td>
                                    @history.UserId
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(history.Reason)
                                        ? "-"
                                        : history.Reason)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Reject Modal -->

<div class="modal fade"
     id="rejectModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="Reject"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Reject Stock Transfer
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label class="form-label">
                            Rejection Reason
                        </label>

                        <textarea name="reason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Reject Transfer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Cancel Modal -->

<div class="modal fade"
     id="cancelModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="Cancel"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Cancel Stock Transfer
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="alert alert-warning">
                        Cancelling a posted transfer will reverse
                        the stock movement.
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Cancellation Reason
                        </label>

                        <textarea name="reason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Cancel Transfer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>