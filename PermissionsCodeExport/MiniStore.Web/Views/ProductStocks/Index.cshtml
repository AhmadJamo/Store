@model List<MiniStore.Application.DTOs.ProductStocks.ProductStockDto>

@{
    ViewData["Title"] = "Stock";
}

<h1>Stock</h1>

<p class="text-muted">
    @Model.Count stock record(s) found.
</p>

<p>
    @if (await PermissionService.CanAsync(
     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
     "ProductStock.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Stock
        </a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Product</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5"
                    class="text-center text-muted">
                    No stock records found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var stock in Model)
            {
                <tr>
                    <td>
                        @stock.Id
                    </td>

                    <td>
                        @stock.ProductName
                    </td>

                    <td>
                        @stock.WarehouseName
                    </td>

                    <td>
                        @stock.Quantity
                    </td>

                    <td>

                        @if (await PermissionService.CanAsync(
                       User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                       "ProductStock.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@stock.Id"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
                     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                     "ProductStock.Delete"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@stock.Id"
                               class="btn btn-danger">
                                Delete
                            </a>
                        }

                    </td>
                </tr>
            }
        }

    </tbody>

</table>