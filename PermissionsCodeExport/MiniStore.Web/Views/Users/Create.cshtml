@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Create User";

    var roles =
        ViewBag.Roles
        as List<IdentityRole>;
}

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card">

            <div class="card-header">
                <h4 class="mb-0">
                    Create User
                </h4>
            </div>

            <div class="card-body">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <label class="form-label">
                            Username
                        </label>

                        <input type="text"
                               name="username"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>

                        <input type="password"
                               name="password"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Role
                        </label>

                        <select name="role"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Role --
                            </option>

                            @if (roles != null)
                            {
                                foreach (var role in roles)
                                {
                                    <option value="@role.Name">
                                        @role.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Create User
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>