@{
    ViewData["Title"] = "Settings";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">⚙️ Settings</h2>
        <p class="text-muted mb-0">
            Manage system configuration and business rules.
        </p>
    </div>

    <div class="row g-4">

        <!-- General -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🏢 General</h5>
                    <p class="card-text text-muted">
                        Company information, currency, language and general system settings.
                    </p>

                    <a asp-action="General"
                       class="btn btn-primary">
                        Open Settings
                    </a>
                </div>
            </div>
        </div>

        <!-- Invoices -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🧾 Invoices</h5>
                    <p class="card-text text-muted">
                        Invoice numbering, prefixes and invoice generation settings.
                    </p>

                    <a asp-action="Invoices"
                       class="btn btn-primary">
                        Open Settings
                    </a>
                </div>
            </div>
        </div>

        <!-- Sales -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">💰 Sales</h5>
                    <p class="card-text text-muted">
                        Configure sales behavior, pricing and sales rules.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Discounts -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🏷️ Discounts</h5>
                    <p class="card-text text-muted">
                        Configure discount types, limits and permissions.
                    </p>

                    <a asp-action="Discounts"
                       class="btn btn-primary">
                        Open Settings
                    </a>
                </div>
            </div>
        </div>

        <!-- Taxes -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🧮 Taxes</h5>
                    <p class="card-text text-muted">
                        Configure tax rates, tax profiles and tax calculation rules.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Inventory -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">📦 Inventory</h5>
                    <p class="card-text text-muted">
                        Configure stock behavior, costing and inventory rules.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Payments -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">💳 Payments</h5>
                    <p class="card-text text-muted">
                        Configure cash, card, bank transfer and credit payments.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Numbering -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🔢 Numbering</h5>
                    <p class="card-text text-muted">
                        Configure numbering sequences for system documents.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Printing -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🖨️ Printing</h5>
                    <p class="card-text text-muted">
                        Configure invoice formats, paper sizes and printing behavior.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Security -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">🔐 Security</h5>
                    <p class="card-text text-muted">
                        Configure security, sessions and access rules.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <!-- Audit -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">📋 Audit</h5>
                    <p class="card-text text-muted">
                        Configure system activity and audit logging.
                    </p>

                    <button class="btn btn-outline-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>