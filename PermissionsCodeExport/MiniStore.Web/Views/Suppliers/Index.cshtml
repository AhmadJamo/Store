@model List<MiniStore.Application.DTOs.Suppliers.SupplierDto>

@{
    ViewData["Title"] = "Suppliers";
}

<h1>Suppliers</h1>

<p class="text-muted">
    @Model.Count supplier(s) found.
</p>

<p>
    @if (await PermissionService.CanAsync(
    User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
    "Suppliers.Create"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Supplier
        </a>
    }
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5"
                    class="text-center text-muted">
                    No suppliers found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>
                        @supplier.Id
                    </td>

                    <td>
                        @supplier.Name
                    </td>

                    <td>
                        @supplier.Phone
                    </td>

                    <td>
                        @supplier.Address
                    </td>

                    <td>

                        @if (await PermissionService.CanAsync(
                     User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                     "Suppliers.Edit"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@supplier.Id"
                               class="btn btn-warning">
                                Edit
                            </a>
                        }

                        @if (await PermissionService.CanAsync(
                         User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "System",
                         "Suppliers.Delete"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@supplier.Id"
                               class="btn btn-danger">
                                Delete
                            </a>
                        }

                    </td>
                </tr>
            }
        }

    </tbody>

</table>